@using DataTrace.Domain.Evaluation
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">型号限值 · @Recipe.Code @Recipe.Name</MudText>
    </TitleContent>
    <DialogContent>
    <div class="dt-dialog-scroll">
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" Variant="Variant.Outlined">
        「目标值」仅用于显示与工艺参考，<b>不参与 OK/NG 判定</b>；判定只看规格限与预警限。
    </MudAlert>

        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
            这里填的是<b>本型号的覆盖值</b>，留空的项沿用点位默认限值（不是「不判」）。
            五个字段全部留空的点位等于没有覆盖，保存时会被丢弃。<InfoHint Topic="HelpTexts.CoverablePoints" />
        </MudAlert>
        <MudText Typo="Typo.caption" Class="dt-muted mb-3">
            生效值预览按默认值与当前输入逐项合并；目标值仅供参考，不参与 OK/NG 判定。
        </MudText>

        @if (!string.IsNullOrEmpty(_error))
        {
            @* 报错放在最上方：这个表格可以拉到几十行，错误写在底部时用户点「保存」只会看到什么都没发生。 *@
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@_error</MudAlert>
        }

        @if (_rows.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="dt-muted py-3">还没有配置任何点位，请先到「工站配置」里添加点位。</MudText>
        }
        else
        {
            <MudText Typo="Typo.caption" Class="dt-muted mb-2">
                共 @_rows.Count 个点位，其中 @_rows.Count(r => r.IsOverridden) 个被本型号覆盖，本次已编辑 @_rows.Count(r => r.IsEdited) 个。限值单位取自点位配置，不在此处修改。<InfoHint Topic="HelpTexts.LimitMergeRule" />
            </MudText>
            <div class="dt-recipe-limit-toolbar" role="group" aria-label="筛选型号限值点位">
                <MudTextField T="string" Value="_searchText" ValueChanged="OnSearchChanged"
                              Label="搜索工站或点位" Placeholder="工站编号、名称或点位名称"
                              Immediate="true" Clearable="true" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Class="dt-recipe-limit-search"
                              aria-label="按工站或点位搜索" />
                <label class="dt-recipe-limit-filter">
                    <input type="checkbox" @bind="_onlyOverriddenOrEdited" />
                    仅显示已覆盖或已编辑
                </label>
                <MudText Typo="Typo.caption" Class="dt-muted" role="status" aria-live="polite">
                    显示 @VisibleRows.Count / @_rows.Count 个点位
                </MudText>
            </div>
            @if (_rows.Any(r => !r.Tag.Enabled))
            {
                @* 停用点位必须留在矩阵里：以前按"启用中"过滤，用户打开对话框什么都没改，
                   一保存就把这些点位的覆盖值删了 —— 重新启用后判定会悄悄回落到点位默认限值。 *@
                <MudText Typo="Typo.caption" Class="dt-muted mb-2">
                    标着「已停用」的点位当前不参与采集，覆盖值仍会保留，重新启用后生效。
                </MudText>
            }
            @* 限值矩阵刻意不折叠成卡片：五个字段并排才能横向比对；窄屏改为整表横向滚动。 *@
            <div class="dt-scroll-x dt-recipe-limit-matrix">
                <MudTable Items="VisibleRows" Dense="true" Hover="true" Breakpoint="Breakpoint.None"
                           RowClassFunc="@((row, _) => row.Error is null ? "" : "dt-row-error")">
                <HeaderContent>
                    <MudTh>点位</MudTh>
                    <MudTh>点位默认限值</MudTh>
                    <MudTh>规格下限</MudTh>
                    <MudTh>规格上限</MudTh>
                    <MudTh>预警下限</MudTh>
                    <MudTh>预警上限</MudTh>
                    <MudTh>目标值 <InfoHint Topic="HelpTexts.TargetValue" /></MudTh>
                    <MudTh>生效值预览</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Class="dt-nowrap">
                        @context.StationCode · @context.Tag.Name
                        @if (!string.IsNullOrWhiteSpace(context.Tag.Unit))
                        {
                            <MudText Typo="Typo.caption" Class="dt-muted">（@context.Tag.Unit）</MudText>
                        }
                        @if (!context.Tag.Enabled)
                        {
                            <MudText Typo="Typo.caption" Class="dt-muted">（已停用）</MudText>
                        }
                        @if (context.Error is not null)
                        {
                            <MudText Typo="Typo.caption" Class="dt-text-error">@context.Error</MudText>
                        }
                    </MudTd>
                    <MudTd Class="dt-nowrap">
                        <MudText Typo="Typo.caption" Class="dt-muted">
                            规格 @DisplayLabels.LimitRange(context.Tag.LowerLimit, context.Tag.UpperLimit)@UnitText(context)
                            · 预警 @DisplayLabels.LimitRange(context.Tag.WarningLowerLimit, context.Tag.WarningUpperLimit)@UnitText(context)
                            · 目标 @(context.Tag.TargetValue?.ToString("0.###") ?? "-")@UnitText(context)
                        </MudText>
                    </MudTd>
                    <MudTd><MudNumericField @bind-Value="context.Lower" @bind-Value:after="@(() => context.Error = null)" Placeholder="默认" Variant="Variant.Outlined"
                                             Margin="Margin.Dense" Class="dt-limit-field dt-recipe-limit-input"
                                             aria-label="@FieldName(context, "规格下限")" /></MudTd>
                    <MudTd><MudNumericField @bind-Value="context.Upper" @bind-Value:after="@(() => context.Error = null)" Placeholder="默认" Variant="Variant.Outlined"
                                             Margin="Margin.Dense" Class="dt-limit-field dt-recipe-limit-input"
                                             aria-label="@FieldName(context, "规格上限")" /></MudTd>
                    <MudTd><MudNumericField @bind-Value="context.WarningLower" @bind-Value:after="@(() => context.Error = null)" Placeholder="默认" Variant="Variant.Outlined"
                                             Margin="Margin.Dense" Class="dt-limit-field dt-recipe-limit-input"
                                             aria-label="@FieldName(context, "预警下限")" /></MudTd>
                    <MudTd><MudNumericField @bind-Value="context.WarningUpper" @bind-Value:after="@(() => context.Error = null)" Placeholder="默认" Variant="Variant.Outlined"
                                             Margin="Margin.Dense" Class="dt-limit-field dt-recipe-limit-input"
                                             aria-label="@FieldName(context, "预警上限")" /></MudTd>
                    <MudTd><MudNumericField @bind-Value="context.Target" @bind-Value:after="@(() => context.Error = null)" Placeholder="默认" Variant="Variant.Outlined"
                                             Margin="Margin.Dense" Class="dt-limit-field dt-recipe-limit-input"
                                             aria-label="@FieldName(context, "目标值")" /></MudTd>
                    <MudTd DataLabel="生效值预览" Class="dt-nowrap">
                        @{ var effective = TagLimits.From(context.Tag).Override(context.ToLimits()); }
                        <MudText Typo="Typo.caption">规格 @DisplayLabels.LimitRange(effective.Lower, effective.Upper)@UnitText(context)</MudText>
                        <MudText Typo="Typo.caption">预警 @DisplayLabels.LimitRange(effective.WarningLower, effective.WarningUpper)@UnitText(context)</MudText>
                        <MudText Typo="Typo.caption" Class="dt-muted">目标 @(effective.Target?.ToString("0.###") ?? "—")@UnitText(context)</MudText>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="dt-muted pa-3">没有符合条件的点位；筛选只影响显示，不影响保存。</MudText>
                </NoRecordsContent>
                </MudTable>
            </div>
        }
    </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Submit">保存</MudButton>
        <InfoHint Topic="HelpTexts.LimitEffect" />
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance? MudDialog { get; set; }

    [Parameter] public Recipe Recipe { get; set; } = new();

    [Parameter] public IReadOnlyList<Station> Stations { get; set; } = [];

    private readonly List<Row> _rows = [];
    private string? _error;
    private string _searchText = "";
    private bool _onlyOverriddenOrEdited;

    private List<Row> VisibleRows
    {
        get
        {
            var search = _searchText.Trim();
            return _rows.Where(row =>
                    (!_onlyOverriddenOrEdited || row.IsOverridden || row.IsEdited)
                    && (search.Length == 0
                        || row.StationCode.Contains(search, StringComparison.OrdinalIgnoreCase)
                        || row.StationName.Contains(search, StringComparison.OrdinalIgnoreCase)
                        || row.Tag.Name.Contains(search, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }
    }

    protected override void OnInitialized()
    {
        foreach (var station in Stations.OrderBy(s => s.Sequence))
        {
            // 可覆盖点位 = 数值型，含已停用的（见 RecipeLimitScope）：停用点位的覆盖值
            // 必须留在矩阵里，否则"打开→保存"这一步就会把没展示的行删掉。
            foreach (var tag in station.Tags.Where(RecipeLimitScope.CanOverride))
            {
                var existing = RecipeLimitResolver.FindOverride(Recipe, tag.Id);
                _rows.Add(new Row
                {
                    Tag = tag,
                    StationCode = station.Code,
                    StationName = station.Name,
                    LimitId = existing?.Id ?? 0,
                    Lower = existing?.LowerLimit,
                    Upper = existing?.UpperLimit,
                    WarningLower = existing?.WarningLowerLimit,
                    WarningUpper = existing?.WarningUpperLimit,
                    Target = existing?.TargetValue,
                    InitialLimits = new TagLimits(
                        existing?.LowerLimit,
                        existing?.UpperLimit,
                        existing?.WarningLowerLimit,
                        existing?.WarningUpperLimit,
                        existing?.TargetValue)
                });
            }
        }
    }

    private void OnSearchChanged(string? value) => _searchText = value ?? "";

    /// <summary>限值单位属于点位配置，不在这里编辑；输入与预览都带上，避免 MPa / kPa 混填。</summary>
    private static string UnitText(Row row)
        => string.IsNullOrWhiteSpace(row.Tag.Unit) ? "" : $" {row.Tag.Unit}";

    private static string FieldName(Row row, string field)
        => string.IsNullOrWhiteSpace(row.Tag.Unit)
            ? $"{row.StationCode} {row.Tag.Name} {field}"
            : $"{row.StationCode} {row.Tag.Name} 单位 {row.Tag.Unit} {field}";

    private void Cancel() => MudDialog?.Cancel();

    private void Submit()
    {
        var result = _rows.Where(r => !r.IsBlank).Select(r => r.ToLimit()).ToList();

        // 一次把所有行都判完并就地标红：表格可能拉到几十行，只报第一条的话
        // 用户看到顶部一句提示，根本不知道是哪一格拦住了保存。
        var bad = 0;
        foreach (var row in _rows)
        {
            // 规则本身在 TagLimits.ConsistencyError()：工站配置页与这里必须共用一份。
            // 校验对象是"生效限值"（覆盖值合并点位默认值），否则只改黄线时
            // 会因为看不到默认红线而漏判。
            row.Error = row.IsBlank
                ? null
                : TagLimits.From(row.Tag).Override(row.ToLimits()).ConsistencyError();
            if (row.Error is not null)
            {
                bad++;
            }
        }

        if (bad > 0)
        {
            _error = $"{bad} 个点位的限值互相矛盾，已在表中标红。";
            return;
        }

        _error = null;
        MudDialog?.Close(DialogResult.Ok(result));
    }

    private sealed class Row
    {
        public required TagDefinition Tag { get; init; }
        public required string StationCode { get; init; }
        public required string StationName { get; init; }
        public int LimitId { get; init; }
        public required TagLimits InitialLimits { get; init; }
        public double? Lower { get; set; }
        public double? Upper { get; set; }
        public double? WarningLower { get; set; }
        public double? WarningUpper { get; set; }
        public double? Target { get; set; }

        /// <summary>整行的一致性校验结果。黄线红线是跨字段的关系，所以标在行上而不是某个输入框上。</summary>
        public string? Error { get; set; }

        /// <summary>五个字段全空 = 不覆盖，保存时丢弃。</summary>
        public bool IsBlank
            => Lower is null && Upper is null && WarningLower is null && WarningUpper is null && Target is null;

        public bool IsOverridden => !IsBlank;

        public bool IsEdited => InitialLimits.DiffersFrom(ToLimits());

        public TagLimits ToLimits() => new(Lower, Upper, WarningLower, WarningUpper, Target);

        public RecipeLimit ToLimit() => new()
        {
            Id = LimitId,
            TagId = Tag.Id,
            LowerLimit = Lower,
            UpperLimit = Upper,
            WarningLowerLimit = WarningLower,
            WarningUpperLimit = WarningUpper,
            TargetValue = Target
        };
    }
}

@using DataTrace.Web.Services
@inject PasswordPolicy Passwords

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">重置密码 · @UserName</MudText>
    </TitleContent>
    <DialogContent>
        <form @onsubmit="Submit" @onsubmit:preventDefault="true">
            <MudText Typo="Typo.body2" Class="dt-muted mb-3">@Passwords.HelperText</MudText>
            <MudTextField @bind-Value="_password" @bind-Value:after="Revalidate" Label="新密码" Immediate="true"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                          AdornmentAriaLabel="@(_showPassword ? "隐藏密码" : "显示密码")"
                          HelperText="@Passwords.HelperText"
                          Error="@(_passwordError is not null)" ErrorText="@_passwordError" />
            <MudTextField @bind-Value="_confirm" @bind-Value:after="Revalidate" Label="确认新密码" Immediate="true" Class="mt-3"
                          InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showConfirm = !_showConfirm)"
                          AdornmentAriaLabel="@(_showConfirm ? "隐藏密码" : "显示密码")"
                          Error="@(_confirmError is not null)" ErrorText="@_confirmError" />
        </form>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="dt-muted align-self-center mr-auto">输入框内按回车即可提交</MudText>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">确认重置</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance? MudDialog { get; set; }

    [Parameter] public string UserName { get; set; } = "";

    private string _password = "";
    private string _confirm = "";
    private string? _passwordError;
    private string? _confirmError;
    private bool _showPassword;
    private bool _showConfirm;

    /// <summary>确认框是否已经提交过一次；没提交过时不报"两次不一致"。</summary>
    private bool _confirmTouched;

    private void Cancel() => MudDialog?.Cancel();

    private bool Validate()
    {
        _passwordError = Passwords.Validate(_password);
        // "两次不一致"只在提交过一次之后才报：绑在 @bind-Value:after 上时，用户刚在确认框
        // 敲下第一个字符就会看到红字，那不是校验，是添乱。
        _confirmError = _confirmTouched && _password != _confirm ? "两次输入的密码不一致" : null;
        return _passwordError is null && _confirmError is null;
    }

    /// <summary>输入框 change 回调用的无返回值版本（@bind-Value:after 不接受带值的委托）。</summary>
    private void Revalidate() => Validate();

    private void Submit()
    {
        _confirmTouched = true;
        if (!Validate())
        {
            return;
        }

        MudDialog?.Close(DialogResult.Ok(_password));
    }
}

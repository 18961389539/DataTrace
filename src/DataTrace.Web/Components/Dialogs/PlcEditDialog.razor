@using DataTrace.Domain.Enums
@using DataTrace.Domain.Entities
@using DataTrace.Plc.Addresses
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "新增 PLC 连接" : $"编辑 PLC · {Model.Name}")</MudText>
    </TitleContent>
    <DialogContent>
        @* 用真 form 包住：在输入框里按回车即可保存，与查询页一致；按钮在 form 外，不会重复提交。 *@
        <form @onsubmit="Submit" @onsubmit:preventDefault="true">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_draft.Name" @bind-Value:after="Revalidate" Label="名称" Required="true" Immediate="true"
                              Placeholder="如：一号线主 PLC"
                              Error="@(_nameError is not null)" ErrorText="@_nameError" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="PlcBrand" @bind-Value="_draft.Brand" @bind-Value:after="Revalidate" Label="品牌">
                    @foreach (var brand in Enum.GetValues<PlcBrand>())
                    {
                        <MudSelectItem T="PlcBrand" Value="brand">@BrandText(brand)</MudSelectItem>
                    }
                </MudSelect>
                <InfoHint Topic="HelpTexts.SimulatorBrand" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_draft.Host" @bind-Value:after="Revalidate" Label="IP 地址" Required="true"
                              Immediate="true" Placeholder="192.168.1.10"
                              Error="@(_hostError is not null)" ErrorText="@_hostError" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="_draft.Port" @bind-Value:after="Revalidate" Label="端口" Min="1" Max="65535"
                                 Error="@(_portError is not null)" ErrorText="@_portError"
                                 HelperText="@PortHint(_draft.Brand)" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="_draft.TimeoutMs" Label="超时 (ms)" Min="200" Max="30000" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="FloatWordOrder" @bind-Value="_draft.FloatWordOrder" Label="Float 字序"
                           HelperText="需与 PLC 侧浮点寄存器顺序一致；A 为最高字节，读到的值差几个数量级通常是这里不对">
                    @foreach (var order in Enum.GetValues<FloatWordOrder>())
                    {
                        <MudSelectItem T="FloatWordOrder" Value="order">@DisplayLabels.WordOrder(order)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="HeartbeatAddress" @bind-Value:after="Revalidate" Label="心跳地址" Immediate="true"
                              HelperText="@HeartbeatHelper"
                              Error="@(_heartbeatError is not null)" ErrorText="@_heartbeatError" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="HeartbeatIntervalMs" Label="心跳周期 (ms)" Min="100" Max="60000" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="HeartbeatMode" @bind-Value="_heartbeatMode" Label="心跳模式"
                           HelperText="递增：周期+1；翻转：0/1 交替写入">
                    <MudSelectItem T="HeartbeatMode" Value="HeartbeatMode.Increment">递增</MudSelectItem>
                    <MudSelectItem T="HeartbeatMode" Value="HeartbeatMode.Toggle">翻转</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_draft.Extra" Label="额外参数" Immediate="true"
                              HelperText="@ExtraHelper(_draft.Brand)"
                              Error="@(_extraError is not null)" ErrorText="@_extraError" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="_draft.MergeGapWords" Label="合并间隙字数" Min="1" Max="512"
                                 HelperText="地址间隔小于该值时会合并成一次批量读取" />
                <InfoHint Topic="HelpTexts.MergeGap" />
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-center">
                <MudSwitch @bind-Value="_draft.StringHighByteFirst" Label="字符串高字节在前" Color="Color.Primary" />
                <MudSwitch @bind-Value="_draft.Enabled" Label="启用" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
        </form>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="dt-muted align-self-center mr-auto">输入框内按回车即可保存</MudText>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Submit">保存</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance? MudDialog { get; set; }

    [Parameter] public PlcConnection Model { get; set; } = new();

    [Parameter] public bool IsNew { get; set; }

    [Parameter] public string HeartbeatAddress { get; set; } = "";

    [Parameter] public int HeartbeatIntervalMs { get; set; } = 1000;

    private HeartbeatMode _heartbeatMode = HeartbeatMode.Increment;
    private string? _nameError;
    private string? _hostError;
    private string? _portError;
    private string? _heartbeatError;

    /// <summary>
    /// 编辑副本。直接绑调用方实体的话，用户点「取消」后父页表格里仍留着改到一半的名称和 IP
    /// （PlcConfig 取消时不重载），所以进来先克隆，只有确定才把副本交回去。
    /// </summary>
    private PlcConnection _draft = new();

    protected override void OnInitialized()
    {
        _draft = CloneForEdit(Model);
        _heartbeatMode = _draft.Heartbeat?.Mode ?? HeartbeatMode.Increment;
        HeartbeatAddress = _draft.Heartbeat?.Address ?? HeartbeatAddress;
        HeartbeatIntervalMs = _draft.Heartbeat?.IntervalMs > 0 ? _draft.Heartbeat.IntervalMs : HeartbeatIntervalMs;
    }

    private static PlcConnection CloneForEdit(PlcConnection source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        Brand = source.Brand,
        Host = source.Host,
        Port = source.Port,
        TimeoutMs = source.TimeoutMs,
        FloatWordOrder = source.FloatWordOrder,
        StringHighByteFirst = source.StringHighByteFirst,
        MergeGapWords = source.MergeGapWords,
        Enabled = source.Enabled,
        Extra = source.Extra,
        Stations = source.Stations,
        Heartbeat = source.Heartbeat is null
            ? null
            : new HeartbeatSettings
            {
                Id = source.Heartbeat.Id,
                PlcConnectionId = source.Heartbeat.PlcConnectionId,
                Address = source.Heartbeat.Address,
                IntervalMs = source.Heartbeat.IntervalMs,
                Mode = source.Heartbeat.Mode,
                Enabled = source.Heartbeat.Enabled
            }
    };

    private static string BrandText(PlcBrand brand) => brand switch
    {
        PlcBrand.Simulator => "模拟器（内置）",
        PlcBrand.MitsubishiMc3E => "三菱 MC 3E",
        PlcBrand.SiemensS7 => "西门子 S7",
        PlcBrand.ModbusTcp => "Modbus TCP",
        PlcBrand.OmronFins => "欧姆龙 FINS",
        _ => brand.ToString()
    };

    private static string PortHint(PlcBrand brand) => brand switch
    {
        PlcBrand.ModbusTcp => "Modbus TCP 常用 502",
        PlcBrand.Simulator => "模拟器默认 6000",
        _ => "三菱/西门子/欧姆龙常用 5000 段"
    };

    private void Cancel() => MudDialog?.Cancel();

    private bool Validate()
    {
        // 错误标在各自字段下方：这份表单有十来个输入框，底部一条汇总提示很容易被看成说的不是自己刚改的那格。
        _nameError = string.IsNullOrWhiteSpace(_draft.Name) ? "请填写连接名称" : null;
        _hostError = string.IsNullOrWhiteSpace(_draft.Host) ? "请填写 PLC 的 IP 地址" : null;
        _portError = _draft.Port is <= 0 or > 65535 ? "端口需在 1–65535 之间" : null;
        _heartbeatError = HeartbeatError();
        if (!ValidateExtra())
        {
            return false;
        }

        return _nameError is null && _hostError is null && _portError is null && _heartbeatError is null;
    }

    /// <summary>
    /// 心跳地址按当前品牌校验；留空即不写心跳，不算错。
    /// </summary>
    /// <remarks>
    /// 心跳写的是字（EncodeInt16），位地址与品牌不符的写法都进不了驱动，
    /// 与其等到采集时看到"心跳写不进去"，不如在这里拦住。
    /// </remarks>
    private string? HeartbeatError()
    {
        if (string.IsNullOrWhiteSpace(HeartbeatAddress))
        {
            return null;
        }

        return PlcAddressValidator.TryValidate(_draft.Brand, HeartbeatAddress, out _, out var error) ? null : error;
    }

    private string HeartbeatHelper
        => _draft.Brand switch
        {
            // 以前新建时预填 D0：那是三菱的写法，换成西门子/Modbus 就是一条永远写不进去的配置。
            PlcBrand.SiemensS7 => "留空表示不写心跳；西门子示例 MW10、DB1.DBW0（不支持位地址）",
            PlcBrand.ModbusTcp => "留空表示不写心跳；Modbus 示例 40001（不支持线圈）",
            PlcBrand.OmronFins => "留空表示不写心跳；欧姆龙示例 D100、CIO100",
            _ => "留空表示不写心跳；三菱示例 D100（不支持 M 等位地址）"
        };

    /// <summary>给输入框的 change 回调用的无返回值版本（@bind-Value:after 不接受带值的委托）。</summary>
    private string? _extraError;


    private static string ExtraHelper(PlcBrand brand) => brand switch
    {
        PlcBrand.ModbusTcp => "Modbus 站号（1–247 的整数，写入 Extra）。留空默认 1",
        PlcBrand.SiemensS7 => "西门子机架/插槽，格式 rack,slot（如 0,1）。留空默认 0,1",
        _ => "一般可留空；部分协议用于站号等扩展参数"
    };

    private bool ValidateExtra()
    {
        _extraError = null;
        var extra = (_draft.Extra ?? "").Trim();
        if (extra.Length == 0)
        {
            return true;
        }

        if (_draft.Brand == PlcBrand.ModbusTcp)
        {
            if (!byte.TryParse(extra, out var station) || station is < 1 or > 247)
            {
                _extraError = "Modbus 站号须为 1–247 的整数";
                return false;
            }
        }
        else if (_draft.Brand == PlcBrand.SiemensS7)
        {
            if (!TryParseSiemensRackSlot(extra, out _, out _))
            {
                _extraError = "西门子 Extra 格式应为 rack,slot（如 0,1）";
                return false;
            }
        }

        return true;
    }

    private static bool TryParseSiemensRackSlot(string extra, out int rack, out int slot)
    {
        rack = 0;
        slot = 1;
        var parts = extra.Replace('/', ',').Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 2)
        {
            return false;
        }

        return int.TryParse(parts[0], out rack) && int.TryParse(parts[1], out slot)
               && rack is >= 0 and <= 7 && slot is >= 0 and <= 31;
    }

    private void Revalidate() => Validate();

    private void Submit()
    {
        if (!Validate())
        {
            return;
        }

        _draft.Name = _draft.Name.Trim();
        _draft.Host = _draft.Host.Trim();
        _draft.Heartbeat ??= new HeartbeatSettings();
        _draft.Heartbeat.Address = (HeartbeatAddress ?? "").Trim();
        _draft.Heartbeat.IntervalMs = HeartbeatIntervalMs;
        _draft.Heartbeat.Mode = _heartbeatMode;
        _draft.Heartbeat.Enabled = !string.IsNullOrWhiteSpace(_draft.Heartbeat.Address);
        _draft.Extra = string.IsNullOrWhiteSpace(_draft.Extra) ? null : _draft.Extra.Trim();
        MudDialog?.Close(DialogResult.Ok(_draft));
    }
}

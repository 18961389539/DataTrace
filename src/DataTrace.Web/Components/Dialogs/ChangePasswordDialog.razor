@using DataTrace.Web.Services
@inject PasswordPolicy Passwords

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">修改密码</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="dt-muted mb-3">
            改的是你当前登录的这个账号。修改成功后本次登录保持有效，下次登录请用新密码。
        </MudText>
        <form @onsubmit="Submit" @onsubmit:preventDefault="true">
            <MudTextField @bind-Value="_current" @bind-Value:after="ValidateCurrent" Label="当前密码" Immediate="true"
                          InputType="@(_showCurrent ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showCurrent ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showCurrent = !_showCurrent)"
                          AdornmentAriaLabel="@(_showCurrent ? "隐藏当前密码" : "显示当前密码")"
                          Error="@(_currentError is not null)" ErrorText="@_currentError" />
            <MudTextField @bind-Value="_password" @bind-Value:after="ValidatePassword" Label="新密码" Immediate="true" Class="mt-3"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                          AdornmentAriaLabel="@(_showPassword ? "隐藏新密码" : "显示新密码")"
                          HelperText="@Passwords.HelperText"
                          Error="@(_passwordError is not null)" ErrorText="@_passwordError" />
            <MudTextField @bind-Value="_confirm" @bind-Value:after="ValidateConfirm" Label="确认新密码" Immediate="true" Class="mt-3"
                          InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showConfirm = !_showConfirm)"
                          AdornmentAriaLabel="@(_showConfirm ? "隐藏确认密码" : "显示确认密码")"
                          Error="@(_confirmError is not null)" ErrorText="@_confirmError" />
        </form>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="dt-muted align-self-center mr-auto">输入框内按回车即可提交</MudText>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">确认修改</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance? MudDialog { get; set; }

    private string _current = "";
    private string _password = "";
    private string _confirm = "";
    private string? _currentError;
    private string? _passwordError;
    private string? _confirmError;
    private bool _showCurrent;
    private bool _showPassword;
    private bool _showConfirm;

    /// <summary>确认框是否已经提交过一次。没提交过时不报"不一致"。</summary>
    private bool _confirmTouched;

    private void Cancel() => MudDialog?.Cancel();

    private void ValidateCurrent()
        => _currentError = string.IsNullOrEmpty(_current) ? "请填写当前密码" : null;

    private void ValidatePassword()
        => _passwordError = string.IsNullOrEmpty(_password) ? "请填写新密码" : Passwords.Validate(_password);

    /// <summary>
    /// 确认框的"两次不一致"只在提交过一次之后才报：绑在 @bind-Value:after 上会在用户
    /// 刚敲下第一个字符时就弹出红字，那不是校验，是添乱。
    /// </summary>
    private void ValidateConfirm()
        => _confirmError = _confirmTouched && _confirm != _password ? "两次输入的新密码不一致" : null;

    private void Submit()
    {
        _confirmTouched = true;
        ValidateCurrent();
        ValidatePassword();
        ValidateConfirm();
        if (_currentError is not null || _passwordError is not null || _confirmError is not null)
        {
            return;
        }

        if (string.Equals(_current, _password, StringComparison.Ordinal))
        {
            _passwordError = "新密码不能与当前密码相同";
            return;
        }

        MudDialog?.Close(DialogResult.Ok(new ChangePasswordRequest(_current, _password)));
    }

    public sealed record ChangePasswordRequest(string CurrentPassword, string NewPassword);
}

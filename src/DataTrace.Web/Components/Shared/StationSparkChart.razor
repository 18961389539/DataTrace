@* 工站迷你曲线：按 VersionKey（采集快照标识）与判定色判断是否重画，
   替代旧的"首/中/末三点指纹"——三点之外的波形变化不再漏刷，
   同一条曲线在同一件产品内也不因无关刷新而反复抽稀。 *@
<LineChart Series="_series" ViewWidth="240" Height="48"
           ShowAxis="false" ShowLegend="false" ShowPoints="false" MaxPoints="80"
           EmptyText="无曲线点" />

@code {
    [Parameter] public string CurveName { get; set; } = "";
    [Parameter] public float[] Values { get; set; } = [];

    /// <summary>判定三态：ng=判据违例（红）、ok=判据全过（主色）、none=未判定（中性色）。
    /// 整站 NG 不改变曲线自己的颜色 —— 颜色之外，标签上的文字与图标同步表达结果（WCAG 1.4.1）。</summary>
    [Parameter] public string Tone { get; set; } = "none";

    /// <summary>数据版本标识：月库+记录 Id+曲线 Key。同一条曲线同一件产品内值不会变，
    /// 版本不变就不重画 —— 替代三点采样指纹，中段变化不再漏刷。</summary>
    [Parameter] public string VersionKey { get; set; } = "";

    private IReadOnlyList<LineSeries> _series = [];
    private string? _fingerprint;
    private bool _render;

    protected override void OnParametersSet()
    {
        var fingerprint = $"{VersionKey}|{Tone}";
        if (fingerprint == _fingerprint)
        {
            _render = false;
            return;
        }

        _fingerprint = fingerprint;
        _render = true;
        if (Values.Length == 0)
        {
            _series = [];
            return;
        }

        _series =
        [
            new LineSeries
            {
                Name = CurveName,
                Values = Values,
                Color = Tone switch
                {
                    "ng" => ChartColors.Alert,
                    "ok" => ChartColors.Primary,
                    _ => ChartColors.Secondary
                }
            }
        ];
    }

    protected override bool ShouldRender() => _render;
}

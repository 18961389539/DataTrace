@implements IDisposable

<MudTooltip Arrow="true" RootClass="dt-help-popover">
    <ChildContent>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                 Color="@FreshnessColor" Icon="@FreshnessIcon" aria-label="@AccessibleText">
            @FreshnessText
            <span class="dt-live-cadence-secondary">· 节拍 @CadenceText</span>
        </MudChip>
    </ChildContent>
    <TooltipContent>
        <HelpContent Topic="HelpTexts.StaleData" />
        <HelpContent Topic="HelpTexts.Cadence" />
    </TooltipContent>
</MudTooltip>

@code {
    [Parameter] public DateTime? LastBeat { get; set; }
    [Parameter] public string FreshnessText { get; set; } = "";
    [Parameter] public Color FreshnessColor { get; set; } = Color.Default;
    [Parameter] public string FreshnessIcon { get; set; } = Icons.Material.Filled.Schedule;

    private DateTime _now = DateTime.Now;
    private Timer? _timer;
    private string AccessibleText => $"{FreshnessText}；最近工站节拍 {CadenceText}";

    protected override void OnInitialized()
    {
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            _now = DateTime.Now;
            StateHasChanged();
        }), null, 1000, 1000);
    }

    private string CadenceText
    {
        get
        {
            if (LastBeat is null) return "尚无节拍";
            var span = _now - LastBeat.Value;
            if (span.TotalSeconds < 5) return "刚刚";
            if (span.TotalSeconds < 60) return $"{(int)span.TotalSeconds} 秒前";
            if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} 分前";
            return LastBeat.Value.ToString("HH:mm:ss");
        }
    }

    public void Dispose() => _timer?.Dispose();
}

@using DataTrace.Application.Realtime
@using DataTrace.Domain.Constants
@using DataTrace.Domain.Enums
@inject NavigationManager Nav

@* 工站卡片。
   看板每 5 秒有一次定时重画，用来推进相对时间；整页重画会把每张卡的点位、
   tooltip、迷你曲线全部 diff 一遍。这里用指纹把重画限制在「数据真的变了」的时候，
   相对时间交给卡片内部的 LiveRelative 自己走。
   布局口径（看板 UX 审查）：工站状态与产品判定分开显示；参数用「汇总 + 重点行」；
   曲线用标签切换、每条曲线自己的判定着色；刷新按数据版本判断，不比采样点。 *@

<MudPaper Class="@CardClass">
    <MudStack Row="true" AlignItems="AlignItems.Start" Class="dt-station-header">
        <div class="dt-station-heading">
            <MudTooltip Text="@StationTitle" Arrow="true" Placement="Placement.Top">
                <MudText Typo="Typo.subtitle1" Class="dt-station-title">@StationTitle</MudText>
            </MudTooltip>
            <div class="dt-station-subline">
                @* 采集中仍显示上一件的完成数据：明确标注「最近完成」，避免被当成当前产品的实时值。 *@
                <MudText Typo="Typo.caption" Class="dt-muted dt-flash dt-station-ident" @key="@BeatKey">
                    @(string.IsNullOrWhiteSpace(Station.LastPalletCode) ? "等待托盘" : Station.LastPalletCode)
                    · @(Station.LastSerialNo ?? "-")
                    · @(Station.State == StationRuntimeState.Busy ? "最近完成 " : "")
                    <LiveRelative Time="Station.LastCompleteTime" />
                </MudText>
                <div class="dt-station-meta">
                    <span class="dt-station-meta-label">节拍</span>
                    <span class="dt-station-meta-value">@CadenceText</span>
                </div>
                @* 只有"不止试了一次"才出现：一次就写回成功是常态，常驻一个「回写 1 次」只是噪音。
                   回写重试变多意味着握手通道在变差，比等到彻底写不回去早得多。 *@
                @if (WriteBackText is { } writeBack)
                {
                    <div class="dt-station-meta">
                        <span class="dt-station-meta-label">回写</span>
                        <span class="dt-station-meta-value">@writeBack</span>
                    </div>
                }
            </div>
        </div>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="dt-station-chips">
            @* 双状态：左芯片是工站运行状态（采集中/空闲/故障），右芯片是最近一次产品判定（OK/NG/未判定）。
               两者语义独立 —— 采集中不等于 NG，故障也不代表上一件被判废。 *@
            <MudChip T="string" Size="Size.Small" Color="@StateColor" Icon="@StateIcon"
                     Class="dt-station-status">@StateLabel</MudChip>
            @if (HasLastOutcome)
            {
                <MudTooltip Text="@OutcomeTooltip" Arrow="true" Placement="Placement.Top">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@OutcomeColor"
                             Icon="@OutcomeIcon" Class="dt-station-outcome">@OutcomeLabel</MudChip>
                </MudTooltip>
            }
        </MudStack>
        @if (Station.LastRecordId is > 0 && !string.IsNullOrEmpty(Station.LastMonthKey))
        {
            <MudTooltip Text="查看本站明细" Arrow="true" Placement="Placement.Top">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                               Color="Color.Default" Class="dt-station-detail-link"
                               Href="@DetailUrl"
                               aria-label="查看本站明细" />
            </MudTooltip>
        }
    </MudStack>

    @if (Station.LastTags.Count == 0 && Station.LastCurves.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="dt-muted mt-4">本站还没有采集数据</MudText>
    }
    else
    {
        @* 参数汇总：总数 + 各判定类计数。无数据与未配置判定单独列出，绝不归入「正常」；
           全部正常时才说「均正常」。 *@
        <div class="dt-point-summary">
            <span class="dt-point-summary-label">@TagSummaryText</span>
            <span>@TagsToDisplay.Count / @Station.LastTags.Count</span>
        </div>
        <div class="dash-tags @(HasManyTags ? "dense" : null)">
            @foreach (var tag in TagsToDisplay)
            {
                @* 卡片里只放短芯片「超限/预警/无数据/未判定」，完整说明放进 Tooltip，
                   避免长句把工站卡撑满；触屏长按也能看到 tooltip。 *@
                <div class="@TagClass(tag)">
                    <span class="dash-tag-label">
                        @tag.Name
                        @if (tag.OutOfLimit)
                        {
                            <MudTooltip Arrow="true" RootClass="dt-help-popover">
                                <ChildContent>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined" Class="ml-1"
                                             Icon="@Icons.Material.Filled.Error">超限</MudChip>
                                </ChildContent>
                                <TooltipContent>
                                    <HelpContent Topic="HelpTexts.LimitThreeTiers" />
                                </TooltipContent>
                            </MudTooltip>
                        }
                        else if (tag.Warning)
                        {
                            <MudTooltip Arrow="true" RootClass="dt-help-popover">
                                <ChildContent>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="ml-1"
                                             Icon="@Icons.Material.Filled.Warning">预警</MudChip>
                                </ChildContent>
                                <TooltipContent>
                                    <HelpContent Topic="HelpTexts.LimitThreeTiers" />
                                </TooltipContent>
                            </MudTooltip>
                        }
                        else if (IsNoData(tag))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="ml-1"
                                     Icon="@Icons.Material.Filled.HelpOutline">无数据</MudChip>
                        }
                        else if (IsUnjudged(tag))
                        {
                            <MudTooltip Text="该点位没有配置判定限值，不参与合格判定" Arrow="true">
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="ml-1"
                                         Icon="@Icons.Material.Filled.Rule">未判定</MudChip>
                            </MudTooltip>
                        }
                    </span>
                    <span class="dash-tag-value dt-flash" @key="@tag.Display">@tag.Display @tag.Unit</span>
                    @if (HasLimitScale(tag) && ShouldShowLimitScale(tag))
                    {
                        <div class="dt-limit-scale" role="img" aria-label="@LimitScaleDescription(tag)">
                            <div class="dt-limit-track">
                                <span class="dt-limit-spec-band"></span>
                                @if (tag.WarningLowerLimit is { } warningLower)
                                {
                                    <span class="dt-limit-band" style="@LowerWarningStyle(tag, warningLower)"></span>
                                }
                                @if (tag.WarningUpperLimit is { } warningUpper)
                                {
                                    <span class="dt-limit-band" style="@UpperWarningStyle(tag, warningUpper)"></span>
                                }
                                <span class="dt-limit-marker @LimitMarkerClass(tag)" style="@MarkerStyle(tag)"></span>
                            </div>
                        </div>
                        <div class="dt-limit-labels">
                            <span>@FormatLimit(tag.LowerLimit)</span>
                            <span>@FormatLimit(tag.UpperLimit)</span>
                        </div>
                        @if (tag.OutOfLimit)
                        {
                            <div class="dt-tag-exceedance">@ExceedanceText(tag)</div>
                        }
                    }
                </div>
            }
        </div>
        @if (HasManyTags && (HiddenTagCount > 0 || _showAllTags))
        {
            @* 隐藏区里还有异常时优先说异常：操作者点开就是为了看它们。
               行序在刷新之间稳定（异常优先 + 原顺序兜底），点击不会踩空。 *@
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="dt-point-expand"
                       StartIcon="@(_showAllTags ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                       UserAttributes="@ExpandButtonAttributes" OnClick="ToggleTagDetails">
                @(_showAllTags
                    ? "收起点位"
                    : HiddenAttentionCount > 0
                        ? $"还有 {HiddenAttentionCount} 项异常"
                        : $"查看其余 {HiddenTagCount} 个点位")
            </MudButton>
        }
        @if (SelectedCurve is { } selected)
        {
            @* 曲线标签 = 选择器 + 每条曲线自己的判定（颜色 + 图标 + 文字三通道）。
               默认选中第一条 NG 曲线（有异常时入口直接落在异常上），否则第一条；
               选中态按曲线 Key 在刷新之间保持。 *@
            <div class="dt-curve-tabs" role="tablist" aria-label="曲线选择">
                @foreach (var curve in Station.LastCurves)
                {
                    var isSelected = curve.Key == SelectedCurveKey;
                    <MudTooltip Text="@CurveTabTooltip(curve)" Arrow="true">
                        <MudChip T="string" Size="Size.Small"
                                 Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                 Color="@CurveChipColor(curve)"
                                 Icon="@CurveChipIcon(curve)"
                                 OnClick="@(() => SelectCurve(curve.Key))"
                                 Class="dt-curve-tab"
                                 role="tab"
                                 aria-selected="@isSelected.ToString().ToLowerInvariant()">
                            @curve.Name @CurveJudgementText(curve)
                        </MudChip>
                    </MudTooltip>
                }
                @if (DetailUrl is { } detailUrl)
                {
                    <MudLink Href="@detailUrl" Underline="Underline.None" Class="dt-curve-all-link">
                        全部 @Station.LastCurves.Count 条
                    </MudLink>
                }
            </div>
            <div class="dt-station-curve" role="group" aria-label="@($"曲线 {selected.Name}")">
                <StationSparkChart CurveName="@selected.Name" Values="selected.Values"
                                   Tone="@CurveTone(selected)"
                                   VersionKey="@($"{Station.LastMonthKey}:{Station.LastRecordId}:{selected.Key}")" />
            </div>
            @if (selected.Judgement == Judgement.Ng && !string.IsNullOrEmpty(selected.JudgementReason))
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="dt-curve-reason">@selected.JudgementReason</MudText>
            }
        }
        @if (OnOpenDetails.HasDelegate)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="dt-station-open-details mt-1"
                       StartIcon="@Icons.Material.Filled.ViewSidebar" OnClick="@(() => OnOpenDetails.InvokeAsync())">
                打开工站详情
            </MudButton>
        }
    }

    @if (!string.IsNullOrEmpty(Station.LastError))
    {
        <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-2">@Station.LastError</MudText>
    }
</MudPaper>

@code {
    [Parameter] public StationRuntimeStatus Station { get; set; } = default!;

    /// <summary>点击「打开工站详情」：由宿主页面打开侧边详情面板，保留看板上下文。</summary>
    [Parameter] public EventCallback OnOpenDetails { get; set; }

    /// <summary>概览参数行数（用户在工具栏配置 3–6 行）；null 用系统默认。</summary>
    [Parameter] public int? PreviewTagLimitOverride { get; set; }

    /// <summary>点位数不超过此值时全部平铺（与旧行为一致）；超过才折叠为「汇总 + 重点行」。</summary>
    private const int FullDisplayTagLimit = 5;

    private string? _fingerprint;
    private bool _render;
    private bool _showAllTags;
    private bool _interactionChanged;
    private int? _stationId;
    private string? _selectedCurveKey;
    private int? _previewLimit;

    protected override void OnParametersSet()
    {
        if (_stationId != Station.StationId)
        {
            _stationId = Station.StationId;
            _showAllTags = false;
            _selectedCurveKey = null;
        }
        if (Station.LastTags.Count <= FullDisplayTagLimit)
            _showAllTags = false;

        var fingerprint = BuildFingerprint();
        _render = fingerprint != _fingerprint || PreviewTagLimit != _previewLimit;
        _fingerprint = fingerprint;
        _previewLimit = PreviewTagLimit;
    }

    protected override bool ShouldRender() => _render || _interactionChanged;

    protected override void OnAfterRender(bool firstRender) => _interactionChanged = false;

    private string BeatKey => $"{Station.LastPalletCode}|{Station.LastSerialNo}";

    private string StationTitle => $"{Station.StationCode} {Station.StationName}";

    private string CadenceText => DurationFormat.Text(Station.LastDurationMs);

    private string? DetailUrl
        => Station.LastRecordId is > 0 && !string.IsNullOrEmpty(Station.LastMonthKey)
            ? $"/query/{Station.LastMonthKey}/{Station.LastRecordId}"
            : null;

    /// <summary>
    /// 响应码回写的重试情况。常态（一次就成功、或还没采过）返回 null，不渲染。
    /// </summary>
    /// <remarks>
    /// 回写在落库之后发生，所以它进不了那一条记录，只能作为工站的当前状态显示。
    /// <c>Attempts == 0</c> 表示"还没写过"，那时不显示 —— 常驻一个「未写回」会把
    /// 还没跑过的工位说成有问题的工位，而真正的写回失败已经带着原因进了卡片的错误提示。
    /// </remarks>
    private string? WriteBackText => Station.LastWriteBackAttempts switch
    {
        0 => null,
        1 => Station.LastWriteBackOk ? null : "写回失败",
        _ => Station.LastWriteBackOk
            ? $"重试 {Station.LastWriteBackAttempts} 次后成功"
            : $"重试 {Station.LastWriteBackAttempts} 次仍失败"
    };

    // ---------- 工站状态与产品判定的双芯片 ----------

    private bool HasLastOutcome => Station.LastRecordId is > 0 || Station.LastJudgement != Judgement.None;

    private string OutcomeLabel => Station.LastJudgement switch
    {
        Judgement.Ng => "上次 NG",
        Judgement.Ok => "上次 OK",
        _ => "上次未判定"
    };

    private Color OutcomeColor => Station.LastJudgement switch
    {
        Judgement.Ng => Color.Error,
        Judgement.Ok => Color.Success,
        _ => Color.Default
    };

    private string OutcomeIcon => Station.LastJudgement switch
    {
        Judgement.Ng => Icons.Material.Filled.Cancel,
        Judgement.Ok => Icons.Material.Filled.CheckCircle,
        _ => Icons.Material.Filled.Remove
    };

    private string OutcomeTooltip
        => Station.State == StationRuntimeState.Busy
            ? "采集中：卡片显示的是上一件完成时的数据，当前件完成后刷新"
            : "最近一次完成产品的判定";

    // ---------- 参数分类汇总 ----------

    private bool HasManyTags => Station.LastTags.Count > FullDisplayTagLimit;

    private int PreviewTagLimit => PreviewTagLimitOverride ?? SystemDefaults.StationCardPreviewTags;

    private int OutOfLimitCount => Station.LastTags.Count(t => t.OutOfLimit);
    private int WarningCount => Station.LastTags.Count(t => t.Warning && !t.OutOfLimit);
    private int NoDataCount => Station.LastTags.Count(IsNoData);
    private int UnjudgedCount => Station.LastTags.Count(t => IsUnjudged(t) && !IsNoData(t));

    /// <summary>
    /// 参数汇总：总数 + 非零异常类计数。无数据与未配置判定单独列出 ——
    /// 它们不是"正常"，混进正常会把没读到的传感器说成健康的。
    /// </summary>
    private string TagSummaryText
    {
        get
        {
            var parts = new List<string>();
            if (OutOfLimitCount > 0) parts.Add($"超限 {OutOfLimitCount}");
            if (WarningCount > 0) parts.Add($"预警 {WarningCount}");
            if (NoDataCount > 0) parts.Add($"无数据 {NoDataCount}");
            if (UnjudgedCount > 0) parts.Add($"未判定 {UnjudgedCount}");
            return parts.Count == 0
                ? $"参数 {Station.LastTags.Count} 项：均正常"
                : $"参数 {Station.LastTags.Count} 项：{string.Join(" · ", parts)}";
        }
    }

    /// <summary>无数据：数值与文本都没有 —— 读取失败、点位没读到值。不能当正常。</summary>
    private static bool IsNoData(StationLiveTag tag)
        => tag.NumericValue is null && string.IsNullOrWhiteSpace(tag.TextValue);

    /// <summary>未判定：有限值但没配任何判定限值（或文本类点位），不参与合格判定。</summary>
    private static bool IsUnjudged(StationLiveTag tag)
        => !tag.OutOfLimit && !tag.Warning && tag.LowerLimit is null && tag.UpperLimit is null;

    /// <summary>需要操作者注意的行：超限、预警、无数据。未判定单独计数，不挤占异常位。</summary>
    private static bool IsAttentionTag(StationLiveTag tag) => tag.OutOfLimit || tag.Warning || IsNoData(tag);

    private IReadOnlyList<StationLiveTag> OrderedTags
        => HasManyTags
            ? Station.LastTags.Select((tag, index) => (Tag: tag, Index: index))
                .OrderByDescending(item => item.Tag.OutOfLimit)
                .ThenByDescending(item => item.Tag.Warning)
                .ThenByDescending(item => IsNoData(item.Tag))
                .ThenByDescending(item => IsUnjudged(item.Tag) && !IsNoData(item.Tag))
                .ThenBy(item => item.Index)
                .Select(item => item.Tag)
                .ToList()
            : Station.LastTags;

    /// <summary>
    /// 概览行：异常（超限/预警/无数据）优先占满配额，但不超配额 ——
    /// 异常再多也只显示前 N 行，剩下的进「还有 N 项异常」，卡片高度恒定。
    /// </summary>
    private IReadOnlyList<StationLiveTag> PreviewTags
    {
        get
        {
            var tags = OrderedTags;
            if (!HasManyTags) return tags;

            var attentionTags = tags.Where(IsAttentionTag).Take(PreviewTagLimit).ToList();
            var remainingSlots = Math.Max(0, PreviewTagLimit - attentionTags.Count);
            return attentionTags
                .Concat(tags.Where(tag => !IsAttentionTag(tag)).Take(remainingSlots))
                .ToList();
        }
    }

    private IReadOnlyList<StationLiveTag> TagsToDisplay
        => _showAllTags ? OrderedTags : PreviewTags;

    private int HiddenTagCount => Math.Max(0, OrderedTags.Count - PreviewTags.Count);

    private int HiddenAttentionCount
        => _showAllTags
            ? 0
            : OrderedTags.Count(IsAttentionTag) - PreviewTags.Count(IsAttentionTag);

    private Dictionary<string, object> ExpandButtonAttributes
        => new() { ["aria-expanded"] = _showAllTags.ToString().ToLowerInvariant() };

    private string CardClass => $"dash-station {Presentation.CssClass}";
    private Color StateColor => Presentation.Color;
    private string? StateIcon => Presentation.Icon;
    private string StateLabel => Presentation.Label;

    /// <summary>卡片边框、状态芯片、图标与文案共用一份优先级和映射。</summary>
    private StationPresentation Presentation
    {
        get
        {
            // 停用态用 Color.Default 而不是 Color.Dark：暗色主题下卡片底色本身就很深，
            // Dark 底 + 深字的胶囊几乎和卡片融成一块，看不出这里有个状态。
            if (Station.State == StationRuntimeState.Disabled)
                return new("disabled", "停用", Color.Default, Icons.Material.Filled.Block);
            if (Station.State == StationRuntimeState.Fault)
                return new("fault", "故障", Color.Error, Icons.Material.Filled.Report);
            if (Station.State == StationRuntimeState.Busy)
                return new("busy", "采集中", Color.Info, Icons.Material.Filled.Sync);
            if (Station.LastJudgement == Judgement.Ng)
                return new("ng", "NG", Color.Error, Icons.Material.Filled.Cancel);
            if (Station.LastJudgement == Judgement.Ok)
                return new("ok", "OK", Color.Success, Icons.Material.Filled.CheckCircle);
            return new("", Station.LastJudgement == Judgement.None ? "未判定" : "空闲", Color.Default, null);
        }
    }

    private sealed record StationPresentation(string CssClass, string Label, Color Color, string? Icon);

    // ---------- 曲线选择与每曲线判定 ----------

    /// <summary>
    /// 选中曲线：先记住操作者的选择（按曲线 Key，跨刷新稳定）；
    /// 没选过或选中的曲线消失时，第一条 NG 曲线优先，否则第一条。
    /// </summary>
    private string SelectedCurveKey
    {
        get
        {
            var curves = Station.LastCurves;
            if (curves.Count == 0)
            {
                return "";
            }

            if (_selectedCurveKey is { } key && curves.Any(c => c.Key == key))
            {
                return key;
            }

            return curves.FirstOrDefault(c => c.Judgement == Judgement.Ng)?.Key ?? curves[0].Key;
        }
    }

    private StationLiveCurve? SelectedCurve
        => Station.LastCurves.FirstOrDefault(c => c.Key == SelectedCurveKey);

    private void SelectCurve(string key)
    {
        _selectedCurveKey = key;
        _interactionChanged = true;
    }

    private static string CurveJudgementText(StationLiveCurve curve)
        => curve.Judgement switch
        {
            Judgement.Ng => "NG",
            Judgement.Ok => "OK",
            _ => "未判定"
        };

    private static Color CurveChipColor(StationLiveCurve curve)
        => curve.Judgement switch
        {
            Judgement.Ng => Color.Error,
            Judgement.Ok => Color.Success,
            _ => Color.Default
        };

    private static string CurveChipIcon(StationLiveCurve curve)
        => curve.Judgement switch
        {
            Judgement.Ng => Icons.Material.Filled.Cancel,
            Judgement.Ok => Icons.Material.Filled.CheckCircle,
            _ => Icons.Material.Filled.Remove
        };

    private static string CurveTone(StationLiveCurve curve)
        => curve.Judgement switch
        {
            Judgement.Ng => "ng",
            Judgement.Ok => "ok",
            _ => "none"
        };

    private static string CurveTabTooltip(StationLiveCurve curve)
        => curve.Judgement switch
        {
            Judgement.Ng => $"{curve.Name}：波形判据违例。{(string.IsNullOrEmpty(curve.JudgementReason) ? "" : curve.JudgementReason)}",
            Judgement.Ok => $"{curve.Name}：波形判据全部通过",
            _ => $"{curve.Name}：未配置波形判据，不参与曲线判定"
        };

    /// <summary>点位行样式：红区（超规格）优先于黄区（预警带）。</summary>
    private static string TagClass(StationLiveTag tag)
        => tag.OutOfLimit ? "dash-tag out" : tag.Warning ? "dash-tag warn" : "dash-tag";

    private bool ShouldShowLimitScale(StationLiveTag tag)
        => !HasManyTags || _showAllTags || IsAttentionTag(tag);

    private void ToggleTagDetails()
    {
        _showAllTags = !_showAllTags;
        _interactionChanged = true;
    }

    private static bool HasLimitScale(StationLiveTag tag)
        => tag.NumericValue is { } value && double.IsFinite(value)
           && tag.LowerLimit is { } lower && double.IsFinite(lower)
           && tag.UpperLimit is { } upper && double.IsFinite(upper) && upper > lower;

    private static string LowerWarningStyle(StationLiveTag tag, double warning)
        => BandStyle(tag.LowerLimit!.Value, warning, tag.LowerLimit.Value, tag.UpperLimit!.Value);

    private static string UpperWarningStyle(StationLiveTag tag, double warning)
        => BandStyle(warning, tag.UpperLimit!.Value, tag.LowerLimit!.Value, tag.UpperLimit.Value);

    private static string BandStyle(double start, double end, double lower, double upper)
        => $"left:{ScalePercent(start, lower, upper):0.##}%;width:{Math.Max(0, ScalePercent(end, lower, upper) - ScalePercent(start, lower, upper)):0.##}%";

    private static string MarkerStyle(StationLiveTag tag)
        => $"left:{ScalePercent(tag.NumericValue!.Value, tag.LowerLimit!.Value, tag.UpperLimit!.Value):0.##}%";

    private static double ScalePercent(double value, double lower, double upper)
        => Math.Clamp((value - lower) / (upper - lower) * 100, 0, 100);

    private static string LimitMarkerClass(StationLiveTag tag)
        => tag.OutOfLimit ? "out" : tag.Warning ? "warn" : "ok";

    private static string LimitScaleDescription(StationLiveTag tag)
        => $"{tag.Name} 当前值 {FormatLimit(tag.NumericValue)}，规格范围 {FormatLimit(tag.LowerLimit)} 至 {FormatLimit(tag.UpperLimit)}";

    private static string ExceedanceText(StationLiveTag tag)
    {
        if (tag.NumericValue is not { } value) return "超出规格范围";
        if (tag.LowerLimit is { } lower && value < lower)
            return $"低于下限 {FormatLimit(lower - value)}{tag.Unit}";
        if (tag.UpperLimit is { } upper && value > upper)
            return $"高于上限 {FormatLimit(value - upper)}{tag.Unit}";
        return "超出规格范围";
    }

    private static string FormatLimit(double? value)
        => value?.ToString("0.###", Culture) ?? "—";

    private string BuildFingerprint()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(Station.StationCode).Append('|')
          .Append((int)Station.State).Append('|')
          .Append((int)Station.LastJudgement).Append('|')
          .Append(Station.LastPalletCode).Append('|')
          .Append(Station.LastSerialNo).Append('|')
          .Append(Station.LastError).Append('|')
          .Append(Station.LastDurationMs).Append('|')
          .Append(Station.LastRecordId).Append('|');

        foreach (var tag in Station.LastTags)
        {
            sb.Append(tag.Name).Append(':').Append(tag.Display).Append(tag.Unit)
              .Append(':').Append(tag.NumericValue?.ToString("R", Culture))
              .Append(':').Append(tag.LowerLimit?.ToString("R", Culture))
              .Append(':').Append(tag.UpperLimit?.ToString("R", Culture))
              .Append(':').Append(tag.WarningLowerLimit?.ToString("R", Culture))
              .Append(':').Append(tag.WarningUpperLimit?.ToString("R", Culture))
              .Append(tag.OutOfLimit ? "!" : "").Append(tag.Warning ? "?" : "").Append('|');
        }

        // 曲线按稳定 Key + 长度 + 自身判定比较：同一件产品内值不变，
        // 中段采样变化也不再是"可能变了"的信号 —— 记录标识就是版本。
        foreach (var curve in Station.LastCurves)
        {
            sb.Append(curve.Key).Append(':').Append(curve.Name)
              .Append(':').Append(curve.Values.Length)
              .Append(':').Append(curve.Judgement is null ? "n" : curve.Judgement == Judgement.Ng ? "!" : "ok")
              .Append('|');
        }

        return sb.ToString();
    }

    private static System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.InvariantCulture;
}

@using DataTrace.Application.Configuration
@using DataTrace.Application.Runtime
@using DataTrace.Domain.Constants
@using DataTrace.Domain.Entities
@using DataTrace.Domain.Enums
@using DataTrace.Web.Services
@inject IRuntimeStore Store
@inject IConfigRepository Config
@inject NavigationManager Nav

<MudPaper Class="dt-filter-card mb-3">
    <form @onsubmit="SubmitSearchAsync" @onsubmit:preventDefault="true">
        <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Class="flex-wrap">
            <MudTextField T="string" @bind-Value="_serialNo" Label="产品流水号"
                          Placeholder="输入完整流水号，精确匹配"
                          Immediate="true" Disabled="_loading"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Tag"
                          Class="dt-trace-search-field" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@(_loading ? Icons.Material.Filled.Sync : Icons.Material.Filled.Search)"
                       Disabled="_loading">
                @(_loading ? "追溯中…" : "查询履历")
            </MudButton>
            <MudButton Variant="Variant.Text" OnClick="ClearSearch" Disabled="_loading"
                       StartIcon="@Icons.Material.Filled.RestartAlt">清空</MudButton>
        </MudStack>
    </form>
</MudPaper>

@if (_error is not null)
{
    @* 失败给两个出口：重试（月库被占用的场景多半下一次就过）与返回查询列表。
       原来只剩一个搜索框，页面看起来像被清空了。 *@
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
        <div class="d-flex align-center flex-wrap gap-2">
            <span>@_error</span>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="_loading" OnClick="RetryAsync">重试</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" Href="/query">返回查询</MudButton>
        </div>
    </MudAlert>
}
else if (_loading && _traces.Count == 0)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="150px" />
}
else
{
    @* 重新查询时保留上一份履历、顶部压一条进度条：整个面板高度差一个量级，
       先抽掉再撑回来会把页面跳动一下，操作工也失去了对照。 *@
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
    }
}
@if (_searched && _error is null && _traces.Count == 0)
{
    <MudAlert Severity="Severity.Info" Dense="true">
        没有找到完全匹配的流水号。请核对编号，或确认对应月库记录仍在保留期内。
    </MudAlert>
}
else if (_traces.Count > 0 && SelectedTrace is { } trace)
{
    @if (_traces.Count > 1)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            该流水号关联到多个生产会话，不能合并推断；请选择要查看的会话。
        </MudAlert>
        <MudPaper Class="dt-filter-card mb-3">
            <MudSelect T="string" Value="_selectedTraceKey" ValueChanged="SelectTraceAsync"
                       Label="生产会话" Dense="true" ShrinkLabel="true">
                @foreach (var candidate in _traces)
                {
                    <MudSelectItem T="string" Value="@TraceKey(candidate)">
                        @TraceOption(candidate)
                    </MudSelectItem>
                }
            </MudSelect>
        </MudPaper>
    }

    <MudPaper Class="pa-3 mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap mb-2">
            <MudText Typo="Typo.subtitle1" Class="dt-trace-serial">@trace.Records[0].SerialNo</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@TraceStatusColor(trace)">
                @TraceStatusText(trace)
            </MudChip>
            <MudSpacer />
            <MudText Typo="Typo.caption" Class="dt-muted">
                @StationCoverageText(trace)
            </MudText>
        </MudStack>
        <MudStack Row="true" Spacing="3" Class="flex-wrap dt-trace-summary">
            <MudText Typo="Typo.caption"><span class="dt-muted">型号</span> @RecipeLabel(trace)</MudText>
            <MudText Typo="Typo.caption"><span class="dt-muted">托盘</span> @trace.Records[0].PalletCode</MudText>
            <MudText Typo="Typo.caption"><span class="dt-muted">会话</span> @TraceKey(trace)</MudText>
            <MudText Typo="Typo.caption"><span class="dt-muted">起止</span> @TraceTimeRange(trace)</MudText>
            <MudText Typo="Typo.caption">
                <span class="dt-muted">最终判定</span> @FinalJudgement(trace)
            </MudText>
            @if (FirstNg(trace) is { } firstNg)
            {
                @* 判定只说"任一站 NG 即 NG"；首因把"从哪一站、哪一刻、因为什么"钉出来，
                   否则看到 NG 只能从履历里自己找，多件多站时一眼看不出来。 *@
                <MudText Typo="Typo.caption" Class="dt-trace-first-ng">
                    <span class="dt-muted">首因</span> @firstNg
                </MudText>
            }
        </MudStack>
    </MudPaper>

    @if (trace.Session is null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            记录没有有效的会话关联。以下为流水号匹配到的记录，但系统无法保证它们属于同一完整生产过程。
        </MudAlert>
    }
    @if (_stations.Count == 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            当前没有可用的工站路线配置，无法判断缺站；实际采集记录仍可在下方逐条查看。
        </MudAlert>
    }

    <MudPaper Class="pa-3 mb-3 dt-trace-history">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2 flex-wrap">
            <MudText Typo="Typo.subtitle2">工站履历</MudText>
            @if (MissingStationCount(trace) > 0)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">
                    当前路线缺 @MissingStationCount(trace) 站
                </MudChip>
            }
            @if (trace.Records.Any(r => r.ResultCode == ResultCodes.ProcessAbnormal))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error">检测到跳站/流程异常</MudChip>
            }
            <MudSpacer />
            @* 全链路时长放在标题行：逐站间隔只有跟它对照才知道"这段算不算长"。 *@
            @if (TotalSpan(trace) is { } total)
            {
                <MudText Typo="Typo.caption" Class="dt-muted">
                    全链路 @DurationFormat.Text((int)total.TotalMilliseconds)
                </MudText>
            }
        </MudStack>
        @* 原来是常驻在结果顶部的 Info alert，一次查询就占三行；口径说明降级成履历里的一行小字。 *@
        <MudText Typo="Typo.caption" Class="dt-muted mb-1">
            缺站按当前启用工站对照；历史期间工艺路线有调整时提示仅供参考。间隔是本站触发距上一站完成的时间，缺站时它就是跨过缺站的真实时间。
        </MudText>
        <div class="dt-trace-timeline">
            @foreach (var row in Timeline(trace))
            {
                var step = row.Step;
                var stepRecords = row.Records;
                <div class="@StepClass(step)">
                    <div class="dt-trace-rail" aria-hidden="true">
                        <span class="dt-trace-marker">
                            @(step.Record is null
                                ? "!"
                                : step.Record.ResultCode != ResultCodes.Success || step.Record.Judgement == Judgement.Ng
                                    ? "×"
                                    : step.Record.Judgement == Judgement.Ok ? "✓" : "·")
                        </span>
                    </div>
                    <div class="dt-trace-station-card">
                        <div class="dt-trace-station-head">
                            <div class="dt-trace-station-identity">
                                <span class="dt-trace-station-code">@step.Code</span>
                                <span class="dt-trace-station-name">@step.Name</span>
                            </div>
                            @if (step.Record is { } record)
                            {
                                <div class="dt-trace-station-status">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                             Color="@JudgementColor(record.Judgement)">
                                        @DisplayLabels.JudgementText(record.Judgement)
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="@ResultColor(record)">
                                        @ResultCodes.Describe(record.ResultCode)
                                    </MudChip>
                                </div>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                                    @StepStatus(step, trace)
                                </MudChip>
                            }
                        </div>

                        @if (step.Record is { } summaryRecord)
                        {
                            <div class="dt-trace-station-meta">
                                <span class="dt-trace-step-time">@summaryRecord.TriggerTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                @* 间隔与本站耗时并排：一眼能看出时间花在"路上"还是花在"这一站"。 *@
                                @if (row.Transit is { } transit)
                                {
                                    <span class="dt-trace-transit">间隔 +@DurationFormat.Text((int)transit.TotalMilliseconds)</span>
                                    @* 比例条是纯装饰（数值已经写在旁边），但它让"哪一段最长"不用逐个读数字。 *@
                                    @if (row.Share > 0)
                                    {
                                        <span class="dt-trace-share" aria-hidden="true">
                                            <span class="dt-trace-share-fill" style="@($"width:{row.Share * 100:0.#}%")"></span>
                                        </span>
                                    }
                                }
                                @if (summaryRecord.DurationMs > 0)
                                {
                                    <span>本站 @DurationFormat.Text(summaryRecord.DurationMs)</span>
                                }
                                <span>@summaryRecord.TagValues.Count 点位 · @summaryRecord.Curves.Count 曲线</span>
                                @if (summaryRecord.TagValues.Any(v => v.IsOutOfLimit))
                                {
                                    <span class="dt-trace-over-limit">
                                        @summaryRecord.TagValues.Count(v => v.IsOutOfLimit) 项超限
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(summaryRecord.ErrorMessage))
                                {
                                    <MudTooltip Text="@summaryRecord.ErrorMessage">
                                        <span class="dt-trace-record-error">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Warning" />
                                            采集信息
                                        </span>
                                    </MudTooltip>
                                }
                                @if (stepRecords.Count > 1)
                                {
                                    <MudText Typo="Typo.caption" Class="dt-muted">本工站 @stepRecords.Count 条记录</MudText>
                                }
                                @foreach (var detailRecord in stepRecords)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                               EndIcon="@Icons.Material.Filled.ChevronRight"
                                               Href="@DetailUrl(trace, detailRecord)">
                                        @(stepRecords.Count > 1 ? $"{detailRecord.TriggerTime:HH:mm:ss} 明细" : "查看明细")
                                    </MudButton>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @* 链路的两头：会话何时结束、上报推没推出去。缺了这一节，时序到末站就断了，
               而"这件最后到底有没有进 MES"正是现场最常问的一句。 *@
            <div class="dt-trace-endpoints">
                <div class="dt-trace-endpoint">
                    <span class="dt-trace-endpoint-label">会话结束</span>
                    <span>@SessionEndText(trace)</span>
                </div>
                <div class="dt-trace-endpoint">
                    <span class="dt-trace-endpoint-label">MES 推送</span>
                    <span>@MesText()</span>
                </div>
            </div>
        </div>
    </MudPaper>
}
else
{
    <MudPaper Class="pa-4">
        <MudText Typo="Typo.body2" Class="dt-muted">
            输入产品流水号后，可查看该次生产的工站顺序、采集结果及各站明细。
        </MudText>
    </MudPaper>
}

@code {
    [Parameter] public string? InitialSerialNo { get; set; }
    [Parameter] public EventCallback<string?> OnSearchCompleted { get; set; }

    private string? _serialNo;
    private string? _appliedInitialSerial;
    private string? _selectedTraceKey;
    private string? _error;
    private bool _loading;
    private bool _searched;
    private IReadOnlyList<CollectSessionTrace> _traces = [];
    private IReadOnlyList<Station> _stations = [];
    private Dictionary<string, string> _recipeNames = new(StringComparer.Ordinal);

    /// <summary>当前会话的 MES 出站记录；null 表示没有记录（未启用 MES，或还没入队）。</summary>
    private MesSessionOutbox? _mesOutbox;
    private bool _mesLoaded;

    private CollectSessionTrace? SelectedTrace
        => _traces.FirstOrDefault(x => TraceKey(x) == _selectedTraceKey);

    protected override async Task OnParametersSetAsync()
    {
        var initial = InitialSerialNo?.Trim() ?? "";
        if (string.Equals(initial, _appliedInitialSerial, StringComparison.Ordinal))
        {
            return;
        }

        _appliedInitialSerial = initial;
        _serialNo = initial;
        if (!string.IsNullOrWhiteSpace(initial))
        {
            await SearchAsync(syncUrl: false);
        }
        else
        {
            ClearResult();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var snapshot = await Config.GetSnapshotAsync();
        _stations = snapshot.Stations
            .Where(s => s.Enabled)
            .OrderBy(s => s.Sequence)
            .ThenBy(s => s.Id)
            .ToList();
        _recipeNames = snapshot.Recipes
            .Where(r => !string.IsNullOrWhiteSpace(r.Code))
            .GroupBy(r => r.Code, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.First().Name ?? "", StringComparer.Ordinal);
    }

    private Task SubmitSearchAsync() => SearchAsync();

    /// <summary>错误面板里的重试：沿用同一个流水号再查一次，不重复写入地址栏。</summary>
    private Task RetryAsync() => SearchAsync(syncUrl: false);

    private async Task SearchAsync(bool syncUrl = true)
    {
        var serialNo = _serialNo?.Trim() ?? "";
        if (serialNo.Length == 0)
        {
            ClearResult();
            _searched = false;
            _error = "请输入完整产品流水号。";
            return;
        }

        _serialNo = serialNo;
        _appliedInitialSerial = serialNo;
        // 不先清空旧结果：履历高度差一个量级，先抽掉再撑回来会让整个页面跳一下，
        // 操作工也失去了对照。旧内容保留，顶部压一条进度条，查完无缝替换。
        _error = null;
        _loading = true;
        _searched = true;
        try
        {
            _traces = await Store.FindSessionTracesBySerialNoAsync(serialNo);
            _selectedTraceKey = _traces.Count > 0 ? TraceKey(_traces[0]) : null;
        }
        catch (Exception ex)
        {
            // 失败不清掉上一份履历：错误说明与重试按钮已经在页面上，旧结果留着还能对照。
            _selectedTraceKey = null;
            _error = $"追溯查询失败：{ex.Message}";
        }
        finally
        {
            _loading = false;
        }

        await LoadMesAsync();

        if (syncUrl)
        {
            await OnSearchCompleted.InvokeAsync(serialNo);
        }
    }

    private async Task ClearSearch()
    {
        _serialNo = "";
        _appliedInitialSerial = "";
        ClearResult();
        _searched = false;
        await OnSearchCompleted.InvokeAsync(null);
    }

    private void ClearResult()
    {
        _traces = [];
        _selectedTraceKey = null;
        _error = null;
        _mesOutbox = null;
        _mesLoaded = false;
    }

    private async Task SelectTraceAsync(string? key)
    {
        _selectedTraceKey = key;
        await LoadMesAsync();
    }

    /// <summary>
    /// 取当前会话的 MES 出站记录。
    /// </summary>
    /// <remarks>
    /// 读不到只影响时序末尾那一节，所以失败不往上抛：整页已经查到履历了，
    /// 因为查不到一条出站记录就把履历一起判失败是本末倒置。读失败与"没有记录"都在界面上如实说。
    /// </remarks>
    private async Task LoadMesAsync()
    {
        _mesOutbox = null;
        _mesLoaded = false;
        if (SelectedTrace is not { SessionId: { } sessionId } trace)
        {
            _mesLoaded = true;
            return;
        }

        try
        {
            _mesOutbox = await Config.FindMesOutboxAsync(trace.MonthKey, sessionId);
        }
        catch
        {
            // 保持 null：界面会把 null 说成"没有记录或读不到"，不会说成"已推送"。
        }

        _mesLoaded = true;
    }

    private string TraceKey(CollectSessionTrace trace)
        => trace.SessionId is { } sessionId
            ? $"{trace.MonthKey}:S{sessionId}"
            : $"{trace.MonthKey}:R{trace.Records[0].Id}";

    private string TraceOption(CollectSessionTrace trace)
    {
        var start = trace.Session?.StartTime ?? trace.Records[0].TriggerTime;
        var status = trace.Session?.Status switch
        {
            SessionStatus.Closed => "已结束",
            SessionStatus.Abnormal => "流程异常",
            SessionStatus.Open => "进行中",
            _ => "会话缺失"
        };
        var key = trace.SessionId is { } sessionId
            ? $"{trace.MonthKey}/{sessionId}"
            : $"{trace.MonthKey}/记录 {trace.Records[0].Id}";
        return $"{start:yyyy-MM-dd HH:mm:ss} · {status} · {key}";
    }

    private IReadOnlyList<TraceStep> RouteSteps(CollectSessionTrace trace)
    {
        var byStation = trace.Records
            .GroupBy(r => r.StationId)
            .ToDictionary(g => g.Key, g => g.OrderBy(r => r.TriggerTime).ThenBy(r => r.Id).Last());
        var steps = _stations
            .Select(s => new TraceStep(s.Id, s.Code, s.Name, true, byStation.GetValueOrDefault(s.Id)))
            .ToList();
        var configuredIds = _stations.Select(s => s.Id).ToHashSet();
        steps.AddRange(trace.Records
            .Where(r => !configuredIds.Contains(r.StationId))
            .GroupBy(r => r.StationId)
            .Select(g =>
            {
                var record = g.OrderBy(r => r.TriggerTime).ThenBy(r => r.Id).Last();
                return new TraceStep(record.StationId, record.StationCode, "当前未启用", false, record);
            })
            .OrderBy(s => s.Record?.TriggerTime));
        return steps;
    }

    private static IReadOnlyList<CollectRecord> RecordsForStep(TraceStep step, CollectSessionTrace trace)
        => trace.Records
            .Where(r => r.StationId == step.StationId)
            .OrderBy(r => r.TriggerTime)
            .ThenBy(r => r.Id)
            .ToList();

    private int ExpectedStationCount => _stations.Count;

    private string StationCoverageText(CollectSessionTrace trace)
        => _stations.Count == 0
            ? $"当前路线未配置 · 记录 {trace.Records.Count} 条"
            : $"工站 {PresentStationCount(trace)}/{ExpectedStationCount} · 记录 {trace.Records.Count} 条";

    private int PresentStationCount(CollectSessionTrace trace)
        => trace.Records.Select(r => r.StationId).Distinct().Count(id => _stations.Any(s => s.Id == id));

    private int MissingStationCount(CollectSessionTrace trace)
    {
        var visited = trace.Records.Select(r => r.StationId).ToHashSet();
        return _stations.Count(s => !visited.Contains(s.Id));
    }

    private string TraceStatusText(CollectSessionTrace trace)
    {
        if (trace.Session is null)
        {
            return "会话关联缺失";
        }

        if (trace.Session.Status == SessionStatus.Abnormal ||
            trace.Records.Any(r => r.ResultCode == ResultCodes.ProcessAbnormal))
        {
            return "流程异常";
        }

        if (trace.Session.Status == SessionStatus.Open)
        {
            return $"进行中 · 已采集 {PresentStationCount(trace)}/{ExpectedStationCount}";
        }

        if (_stations.Count == 0)
        {
            return "会话已结束 · 路线不可判定";
        }

        var missing = MissingStationCount(trace);
        return missing > 0 ? $"会话已结束 · 当前路线缺 {missing} 站" : "工序完成";
    }

    private Color TraceStatusColor(CollectSessionTrace trace)
    {
        if (trace.Session is null || trace.Session.Status == SessionStatus.Abnormal ||
            trace.Records.Any(r => r.ResultCode == ResultCodes.ProcessAbnormal))
        {
            return Color.Error;
        }

        if (trace.Session.Status == SessionStatus.Open)
        {
            return Color.Warning;
        }

        return _stations.Count == 0 ? Color.Info : Color.Success;
    }

    private string StepClass(TraceStep step)
    {
        var state = step.Record is null
            ? "dt-trace-missing"
            : step.Record.ResultCode != ResultCodes.Success || step.Record.Judgement == Judgement.Ng
                ? "dt-trace-fault"
                : step.Record.Judgement == Judgement.Ok ? "dt-trace-ok" : "dt-trace-unjudged";
        return $"dt-trace-timeline-item {state}{(step.IsConfigured ? "" : " dt-trace-unconfigured")}";
    }

    private static string StepStatus(TraceStep step, CollectSessionTrace trace)
    {
        if (step.Record is null)
        {
            return trace.Session?.Status == SessionStatus.Open ? "待过站" : "缺记录";
        }

        if (step.Record.ResultCode != ResultCodes.Success)
        {
            return ResultCodes.Describe(step.Record.ResultCode);
        }

        return DisplayLabels.JudgementText(step.Record.Judgement);
    }

    private static Color JudgementColor(Judgement judgement)
        => judgement switch
        {
            Judgement.Ok => Color.Success,
            Judgement.Ng => Color.Error,
            _ => Color.Default
        };

    private static Color ResultColor(CollectRecord record)
        => record.ResultCode == ResultCodes.Success ? Color.Success : Color.Error;

    private string RecipeLabel(CollectSessionTrace trace)
    {
        var code = trace.Records.Select(r => r.RecipeCode).FirstOrDefault(c => !string.IsNullOrWhiteSpace(c));
        if (string.IsNullOrWhiteSpace(code))
        {
            return "未选型号";
        }

        return _recipeNames.TryGetValue(code, out var name) && !string.IsNullOrWhiteSpace(name)
            ? $"{code} · {name}"
            : code;
    }

    private string TraceTimeRange(CollectSessionTrace trace)
    {
        var start = trace.Session?.StartTime ?? trace.Records[0].TriggerTime;
        var end = trace.Session?.EndTime ?? trace.Records.Max(r => r.CompleteTime);
        return $"{start:yyyy-MM-dd HH:mm:ss} — {end:yyyy-MM-dd HH:mm:ss}";
    }

    private static string FinalJudgement(CollectSessionTrace trace)
    {
        var judgement = trace.Session?.Judgement ?? Judgement.None;
        if (judgement == Judgement.None && trace.Records.Count > 0)
        {
            judgement = trace.Records[^1].Judgement;
        }
        return DisplayLabels.JudgementText(judgement);
    }

    /// <summary>
    /// 首因一行：工站 + 时刻 + 结果码 + 原因。判定不是 NG、或旧数据没有记首因时整行不显示。
    /// 原因直接铺在行内而不是塞进悬浮提示：车间大屏多为触摸，悬浮不是总能触发的交互。
    /// </summary>
    private static string? FirstNg(CollectSessionTrace trace)
    {
        var session = trace.Session;
        if (session?.FirstNgAt is not { } at)
        {
            return null;
        }

        var parts = new List<string>
        {
            string.IsNullOrWhiteSpace(session.FirstNgStationCode) ? "未知工站" : session.FirstNgStationCode,
            at.ToString("yyyy-MM-dd HH:mm:ss")
        };
        if (session.FirstNgResultCode is { } code)
        {
            parts.Add(ResultCodes.Describe(code));
        }

        if (!string.IsNullOrWhiteSpace(session.FirstNgReason))
        {
            parts.Add(session.FirstNgReason);
        }

        return string.Join(" · ", parts);
    }

    private string DetailUrl(CollectSessionTrace trace, CollectRecord record)
    {
        var serial = Uri.EscapeDataString(_serialNo?.Trim() ?? record.SerialNo);
        var back = $"query?view=trace&trace={serial}";
        return $"/query/{trace.MonthKey}/{record.Id}?back={Uri.EscapeDataString(back)}";
    }

    private sealed record TraceStep(int StationId, string Code, string Name, bool IsConfigured, CollectRecord? Record);

    /// <summary>时序上的一行：这一站的记录、它距上一站完成的间隔，以及该间隔占全链路的比例。</summary>
    private sealed record TimelineRow(
        TraceStep Step,
        IReadOnlyList<CollectRecord> Records,
        TimeSpan? Transit,
        double Share);

    /// <summary>
    /// 按工艺顺序铺开时序，并逐站算出与上一站之间的间隔。
    /// </summary>
    /// <remarks>
    /// 间隔取自"上一站的完成时刻 → 这一站的触发时刻"，缺站的站不推进基准 ——
    /// 于是跨过缺站的那一段会如实变长，正好是排查"这件为什么慢了"要看的地方。
    /// 比例只算一次全链路总时长，逐行复用，避免每行都去扫一遍记录。
    /// </remarks>
    private IReadOnlyList<TimelineRow> Timeline(CollectSessionTrace trace)
    {
        var total = TotalSpan(trace);
        DateTime? previousComplete = null;
        var rows = new List<TimelineRow>();
        foreach (var step in RouteSteps(trace))
        {
            var transit = PalletTimeline.Transit(previousComplete, step.Record?.TriggerTime);
            rows.Add(new TimelineRow(
                step,
                RecordsForStep(step, trace),
                transit,
                PalletTimeline.Share(transit, total)));
            if (step.Record is { } record)
            {
                previousComplete = record.CompleteTime == default ? record.TriggerTime : record.CompleteTime;
            }
        }

        return rows;
    }

    /// <summary>整条链路时长：首站触发到末站完成。少于两站或时刻缺失时为 null。</summary>
    private static TimeSpan? TotalSpan(CollectSessionTrace trace)
    {
        if (trace.Session?.StartTime is not { } start || trace.Records.Count == 0)
        {
            return null;
        }

        var lastComplete = trace.Records
            .Where(record => record.CompleteTime != default)
            .Select(record => record.CompleteTime)
            .DefaultIfEmpty()
            .Max();
        return lastComplete == default ? null : PalletTimeline.Total(start, lastComplete);
    }

    private static string SessionEndText(CollectSessionTrace trace)
        => trace.Session?.EndTime is { } end
            ? $"{end:yyyy-MM-dd HH:mm:ss}"
            : trace.Session is null
                ? "会话关联缺失，无法判定"
                : "尚未结束";

    /// <summary>时序终点那一句：推没推出去、试了几次、上次为什么没成。</summary>
    private string MesText()
    {
        if (!_mesLoaded)
        {
            return "读取中…";
        }

        if (_mesOutbox is not { } outbox)
        {
            return "没有出站记录（MES 可能未启用，或这件还没入队）";
        }

        var attempts = outbox.AttemptCount > 0 ? $"，已尝试 {outbox.AttemptCount} 次" : "";
        var lastAttempt = outbox.LastAttemptAt is { } at ? $"，上次 {at:HH:mm:ss}" : "";
        return outbox.Status switch
        {
            MesOutboxStatus.Succeeded => $"已推送{(outbox.LastAttemptAt is { } successAt ? $"（{successAt:HH:mm:ss}）" : "")}{attempts}",
            MesOutboxStatus.Failed => $"推送失败{attempts}{lastAttempt}{(string.IsNullOrWhiteSpace(outbox.LastError) ? "" : $"：{outbox.LastError}")}",
            _ => $"排队等待推送{attempts}{lastAttempt}"
        };
    }
}

@* 页头的「本页说明」入口：打开主题目录，一次聚焦阅读一条完整说明。
   内容来自 HelpTexts.ForPage —— 页面只写 HelpRoute，不自己列 topic，避免两处口径漂移。
   Topics 为空时整枚按钮都不渲染（页面没挂详解就不该凭空多一个入口）。
   和 ⓘ（InfoHint）一样用真按钮：只有可聚焦元素才让键盘与读屏用户拿得到，
   代价是必须恒定带 aria-label（AccessibleNameE2ETests 会普查每个可见控件）。 *@
@using DataTrace.Web.Components.Dialogs
@inject IDialogService DialogService

@if (Topics.Count > 0)
{
    @* 宽屏带文字帮助发现入口；窄屏只显示图标，避免页头被顶宽。 *@
    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
               StartIcon="@Icons.Material.Outlined.HelpCenter" Class="dt-page-help"
               aria-label="本页说明" OnClick="OpenHelpAsync">
        <span class="d-none d-md-inline">本页说明</span>
    </MudButton>
}

@code {
    /// <summary>本页对应的路由（相对路径，见 <see cref="HelpTexts.ForPage"/>）。</summary>
    [Parameter] public string Route { get; set; } = "";

    private IReadOnlyList<HelpTopic> Topics => HelpTexts.ForPage(Route);
    private IReadOnlyList<PageHelpSection> GuideSections => HelpTexts.GuideForPage(Route);

    private async Task OpenHelpAsync()
    {
        var parameters = new DialogParameters
        {
            ["Topics"] = Topics,
            ["GuideSections"] = GuideSections
        };

        await DialogService.ShowAsync<PageHelpDialog>("本页说明", parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Large,
                FullWidth = true,
                CloseOnEscapeKey = true
            });
    }
}

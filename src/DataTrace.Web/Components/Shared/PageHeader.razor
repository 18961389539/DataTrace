@* 页头统一结构：h5 标题 + 标题后状态标签 + 右侧统计/操作 + 可选说明。
   标题保持 h5 —— Routes.razor 的 PageFocusOnNavigate 以 h5 为选择器，
   而 app.css 靠 .dt-page-title 抑制那次程序性聚焦画出的焦点环。
   浏览器标签页标题也在这里统一设置，避免各页漏写导致一直停在 App.razor 的 "DataTrace"。 *@
<PageTitle>@(string.IsNullOrWhiteSpace(Title) ? "DataTrace" : $"{Title} · DataTrace")</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2"
         Class="@($"mb-{(string.IsNullOrWhiteSpace(Description) ? 3 : 2)} flex-wrap")">
    <MudText Typo="Typo.h5" Class="dt-page-title">@Title</MudText>
    @ChildContent
    <MudSpacer />
    @if (Busy)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary"
                             aria-label="正在刷新" />
    }
    @* 刷新期间右端的统计（"共 N 条"）还是上一轮的数字：整块压淡并标 aria-busy，
       免得用户把过期数字当成刚查出来的结果。 *@
    <span class="dt-page-actions" aria-busy="@(Busy ? "true" : "false")">@Actions</span>
    @if (!string.IsNullOrWhiteSpace(HelpRoute))
    {
        <PageHelp Route="@HelpRoute" />
    }
</MudStack>
@if (!string.IsNullOrWhiteSpace(Description))
{
    <MudText Typo="Typo.body2" Class="dt-muted mb-3">@Description</MudText>
}

@code {
    [Parameter] public string Title { get; set; } = "";

    /// <summary>标题下方的一句话说明；留空则页头自带更大间距。</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>紧跟标题的状态标签（MudChip 等）。与 Actions 混用，必须显式写成 &lt;ChildContent&gt;。</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>靠右的统计文字或操作按钮。</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>正在取数。为 true 时页头右端显示进度圈，并把统计文字整块压淡。</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>本页「本页说明」入口对应的路由（相对路径，见 HelpTexts.ForPage）；留空则不显示。</summary>
    [Parameter] public string? HelpRoute { get; set; }
}

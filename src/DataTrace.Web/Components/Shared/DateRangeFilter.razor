@* 时间区间筛选：预设按钮 + 起止日期，全站共用一套语义与一套选中态。
   不用 MudGrid 的 12 栏切宽度：日期控件被压到 168px 时 "2026/9/21" 会裁成 "2026/9/2"。 *@
@using DataTrace.Domain
@using DataTrace.Domain.Constants
@using System.Globalization

<div class="dt-range">
    <div class="dt-range-presets">
        <MudText Typo="Typo.caption" Class="dt-muted">快捷区间</MudText>
        <div class="dt-range-buttons">
            @if (IncludeShifts)
            {
                <MudButton Size="Size.Small" Variant="@(IsShiftSelected(CurrentShift) ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary" Disabled="Disabled" OnClick="@(() => SelectShiftAsync(CurrentShift))">本班次</MudButton>
                <MudButton Size="Size.Small" Variant="@(IsShiftSelected(PreviousShift) ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Primary" Disabled="Disabled" OnClick="@(() => SelectShiftAsync(PreviousShift))">上一班次</MudButton>
            }
            @foreach (var preset in Presets)
            {
                var range = preset.Range();
                var selected = IsSelected(range);
                <MudButton Size="Size.Small"
                           Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                           Color="@(selected ? Color.Primary : Color.Default)"
                           Disabled="Disabled"
                           aria-label="@($"时间区间 {preset.Label}")"
                           OnClick="@(() => SelectAsync(range))">@preset.Label</MudButton>
            }
        </div>
    </div>

    <MudDatePicker Class="dt-range-date" Label="开始日期" Date="From?.Date" DateChanged="SetFromAsync" Disabled="Disabled" />
    <MudDatePicker Class="dt-range-date" Label="结束日期" Date="To?.Date" DateChanged="SetToAsync"
                   Error="@Invalid" ErrorText="@ReversedRangeMessage" Disabled="Disabled" />
</div>

@code {
    /// <summary>含今天在内的最近 N 天；"昨天"是完整的昨天一天。</summary>
    private static readonly (string Label, Func<(DateTime From, DateTime To)> Range)[] Presets =
    [
        ("今天", () => (DateTime.Today, DateTime.Today)),
        ("昨天", () => (DateTime.Today.AddDays(-1), DateTime.Today.AddDays(-1))),
        ("近 7 天", () => (DateTime.Today.AddDays(-6), DateTime.Today)),
        ("近 30 天", () => (DateTime.Today.AddDays(-29), DateTime.Today)),
        ("本月", () => (new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1), DateTime.Today)),
    ];

    [Parameter] public DateTime? From { get; set; }
    [Parameter] public EventCallback<DateTime?> FromChanged { get; set; }
    [Parameter] public DateTime? To { get; set; }
    [Parameter] public EventCallback<DateTime?> ToChanged { get; set; }

    /// <summary>区间一变就回调，页面在这里发起查询：改了日期忘了点按钮是最容易踩的坑。</summary>
    [Parameter] public EventCallback OnRangeChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IncludeShifts { get; set; }
    [Parameter] public int ShiftStartHour { get; set; } = SystemDefaults.ShiftStartHour;
    [Parameter] public int ShiftLengthHours { get; set; } = SystemDefaults.ShiftLengthHours;

    private ShiftWindow CurrentShift => ShiftWindow.Containing(DateTime.Now, ShiftStartHour, ShiftLengthHours);
    private ShiftWindow PreviousShift => ShiftWindow.Containing(CurrentShift.Start.AddTicks(-1), ShiftStartHour, ShiftLengthHours);
    private bool IsShiftSelected(ShiftWindow shift) => From == shift.Start && To == shift.End.AddTicks(-1);

    private async Task SelectShiftAsync(ShiftWindow shift)
    {
        await FromChanged.InvokeAsync(shift.Start);
        await ToChanged.InvokeAsync(shift.End.AddTicks(-1));
        await OnRangeChanged.InvokeAsync();
    }

    /// <summary>倒置区间的提示语，唯一出处。</summary>
    public const string ReversedRangeMessage = "开始日期不能晚于结束日期";

    /// <summary>
    /// 区间是否倒置。组件把结束日期标红，页面在发起查询前也该挡同一道 ——
    /// 这句校验曾经在三个页面各抄了一遍。
    /// </summary>
    public static bool IsReversed(DateTime? from, DateTime? to)
        => QueryStart(from) > QueryEnd(to);

    public static DateTime QueryStart(DateTime? value) => value ?? DateTime.Today;

    public static DateTime QueryEnd(DateTime? value)
        => value is { } time && time.TimeOfDay != TimeSpan.Zero ? time : EndOfInclusive(value);

    public static string UrlValue(DateTime value)
        => Uri.EscapeDataString(value.ToString(value.TimeOfDay == TimeSpan.Zero ? "yyyy-MM-dd" : "yyyy-MM-dd'T'HH:mm:ss.fffffff", CultureInfo.InvariantCulture));

    /// <summary>区间起点（含）。留空取 fallback，fallback 也留空则取今天。</summary>
    public static DateTime StartOf(DateTime? value, DateTime? fallback = null)
        => (value ?? fallback ?? DateTime.Today).Date;

    /// <summary>区间终点当天的最后一刻（含）：按日期筛选却要吃掉整个自然日时才用得上。</summary>
    public static DateTime EndOfInclusive(DateTime? value, DateTime? fallback = null)
        => StartOf(value, fallback).AddDays(1).AddTicks(-1);

    /// <summary>页头统计位上那句 "2026-09-15 ~ 2026-09-21"。</summary>
    public static string Format(DateTime? from, DateTime? to)
        => from?.TimeOfDay != TimeSpan.Zero && from is not null || to?.TimeOfDay != TimeSpan.Zero && to is not null
            ? $"{QueryStart(from):yyyy-MM-dd HH:mm} ~ {QueryEnd(to).AddTicks(1):yyyy-MM-dd HH:mm}"
            : $"{StartOf(from):yyyy-MM-dd} ~ {StartOf(to):yyyy-MM-dd}";

    private bool Invalid => IsReversed(From, To);

    private bool IsSelected((DateTime From, DateTime To) range)
        => From == range.From && To == range.To;

    private async Task SelectAsync((DateTime From, DateTime To) range)
    {
        await FromChanged.InvokeAsync(range.From);
        await ToChanged.InvokeAsync(range.To);
        await OnRangeChanged.InvokeAsync();
    }

    private async Task SetFromAsync(DateTime? value)
    {
        if (value?.Date == From?.Date) return;
        await FromChanged.InvokeAsync(value?.Date);
        await ToChanged.InvokeAsync(To?.Date);
        await OnRangeChanged.InvokeAsync();
    }

    private async Task SetToAsync(DateTime? value)
    {
        if (value?.Date == To?.Date) return;
        await FromChanged.InvokeAsync(From?.Date);
        await ToChanged.InvokeAsync(value?.Date);
        await OnRangeChanged.InvokeAsync();
    }
}

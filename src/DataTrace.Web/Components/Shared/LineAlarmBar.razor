@using DataTrace.Application.Alarms
@implements IDisposable
@inject ILineAlarmBoard Board
@inject IJSRuntime Js

@if (_alarms.Count > 0)
{
    <section class="dt-alarm-bar @(_urgentCount > 0 ? "dt-alarm-bar--urgent" : "dt-alarm-bar--attention")"
             aria-label="整线异常">
        <div class="dt-alarm-bar-row">
            <div class="dt-alarm-bar-summary" role="status" aria-live="polite">
                <strong>整线异常</strong>
                <span>当前异常 @_activeCount</span>
                <span>已恢复待确认 @_recoveredCount</span>
                @if (_urgentCount > 0)
                {
                    <span class="dt-alarm-bar-blocker">采集阻断 @_urgentCount</span>
                }
                @if (_muted)
                {
                    <span class="dt-alarm-bar-note">声音已静音</span>
                }
            </div>
            <div class="dt-alarm-bar-actions">
                <button type="button" class="dt-alarm-bar-button" aria-expanded="@_expanded"
                        aria-controls="dt-alarm-details" @onclick="ToggleExpanded">
                    @(_expanded ? "收起详情" : "展开详情")
                </button>
                <a class="dt-alarm-bar-button" href="/alarms">报警列表</a>
                <button type="button" class="dt-alarm-bar-button" @onclick="ToggleMute">
                    @(_muted ? "重新响铃" : "静音")
                </button>
            </div>
        </div>

        @if (_urgentCount > 0)
        {
            <div class="dt-sr-only" role="alert" aria-live="assertive">
                采集阻断：@UrgentAnnouncement
            </div>
        }

        <div id="dt-alarm-details" class="dt-alarm-bar-details" hidden="@(!_expanded)">
            <section>
                <h2 class="dt-alarm-bar-group-title">当前仍在发生（@_activeCount）</h2>
                @if (_activeCount > 0)
                {
                    <ul>
                        @foreach (var alarm in _activeAlarms)
                        {
                            <li>@alarm.Message</li>
                        }
                    </ul>
                }
                else
                {
                    <p>当前没有仍在发生的异常。</p>
                }
            </section>
            <section>
                <h2 class="dt-alarm-bar-group-title">已恢复，待接手（@_recoveredCount）</h2>
                @if (_recoveredCount > 0)
                {
                    <ul>
                        @foreach (var alarm in _recoveredAlarms)
                        {
                            <li>@DisplayMessage(alarm)</li>
                        }
                    </ul>
                }
                else
                {
                    <p>没有已恢复待接手的异常。</p>
                }
            </section>
        </div>
    </section>
}

@code {
    private const string RecoveredSuffix = "（已恢复，仍待接手）";

    private IReadOnlyList<LineAlarm> _alarms = [];
    private string? _mutedSignature;
    private bool _sounding;
    private bool _expanded;

    private IReadOnlyList<LineAlarm> _activeAlarms => _alarms.Where(alarm => !IsRecovered(alarm)).ToList();

    private IReadOnlyList<LineAlarm> _recoveredAlarms => _alarms.Where(IsRecovered).ToList();

    private IReadOnlyList<LineAlarm> _urgentAlarms =>
        _activeAlarms.Where(IsUrgentCurrentBlocker).ToList();

    private int _activeCount => _activeAlarms.Count;

    private int _recoveredCount => _recoveredAlarms.Count;

    private int _urgentCount => _urgentAlarms.Count;

    private bool _muted => _alarms.Count > 0 && Signature == _mutedSignature;

    private bool ShouldSound => _alarms.Count > 0 && !_muted;

    private string Signature => string.Join('|', _alarms.Select(a => a.Key));

    private string UrgentAnnouncement => string.Join("；", _urgentAlarms.Select(alarm => alarm.Message));

    protected override void OnInitialized()
    {
        _alarms = Board.Current.Alarms;
        Board.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShouldSound == _sounding)
        {
            return;
        }

        _sounding = ShouldSound;
        try
        {
            await Js.InvokeVoidAsync(_sounding ? "dtAlarm.start" : "dtAlarm.stop");
        }
        catch (JSException)
        {
            // 工控机浏览器拦自动播放或没有音频设备时，红条仍然在。
        }
    }

    private void OnChanged() => _ = InvokeAsync(Refresh);

    private void Refresh()
    {
        _alarms = Board.Current.Alarms;
        StateHasChanged();
    }

    private void ToggleExpanded() => _expanded = !_expanded;

    private void ToggleMute()
    {
        _mutedSignature = _muted ? null : Signature;
    }

    private static bool IsRecovered(LineAlarm alarm)
        => alarm.Message.EndsWith(RecoveredSuffix, StringComparison.Ordinal);

    private static bool IsUrgentCurrentBlocker(LineAlarm alarm)
        => alarm.Kind is LineAlarmKind.HeartbeatStale
            or LineAlarmKind.StationFault
            or LineAlarmKind.CollectionOverdue
            or LineAlarmKind.ConsecutiveProcess;

    private static string DisplayMessage(LineAlarm alarm)
        => IsRecovered(alarm)
            ? alarm.Message[..^RecoveredSuffix.Length].TrimEnd()
            : alarm.Message;

    public void Dispose()
    {
        Board.Changed -= OnChanged;
        if (_sounding)
        {
            _ = Js.InvokeVoidAsync("dtAlarm.stop");
        }
    }
}

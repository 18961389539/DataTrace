@using DataTrace.Application.Alarms
@implements IDisposable
@inject ILineAlarmBoard Board
@inject IJSRuntime Js

@if (_alarms.Count > 0)
{
    <div class="dt-alarm-bar" role="alert" aria-live="assertive">
        @* dt-alarm-alert 只是个钩子：暗色档下 filled 的 Error 底色取的是暗色调色板的 #ef9a9a，
           整条横幅会成为夜班屏幕上最亮的块（见 app.css 里 html.dt-theme-dark 的那条覆盖）。 *@
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-0 dt-alarm-alert" NoIcon="false">
            <div class="dt-alarm-bar-row">
                <div>
                    @foreach (var alarm in _visibleAlarms)
                    {
                        <div>@alarm.Message</div>
                    }
                    @if (_hiddenCount > 0)
                    {
                        @* 折叠掉的条数必须自己报出来：只剩前几条时，看不出"后面还有"，
                           容易被当成异常只有这几条，接手完前几条就以为处理完了。 *@
                        <div class="dt-alarm-bar-more">另有 @_hiddenCount 条异常未逐条铺开，进「去接手」查看并逐条处理。</div>
                    }
                    @if (_muted)
                    {
                        <div class="dt-alarm-bar-note">声音已静音，异常仍在。</div>
                    }
                </div>
                <div class="dt-alarm-bar-actions">
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small" Href="/alarms">
                        去接手
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small"
                               OnClick="ToggleMute">
                        @(_muted ? "重新响铃" : "静音")
                    </MudButton>
                </div>
            </div>
        </MudAlert>
    </div>
}

@code {
    /// <summary>
    /// 横幅最多逐条铺开的条数。异常成串时（换型、停线、批量超限）全铺出来能占到半屏，
    /// 把 KPI 与工站卡整块挤到折叠线以下，而横幅本身还滚动不到 —— 车间看到的反而更少。
    /// </summary>
    private const int MaxLines = 4;

    private IReadOnlyList<LineAlarm> _alarms = [];
    private string? _mutedSignature;
    private bool _sounding;

    /// <summary>报警页按「最久没人接手」排序，取前几条就是等得最久的，正是横幅该叫人看的。</summary>
    private IReadOnlyList<LineAlarm> _visibleAlarms =>
        _alarms.Count <= MaxLines ? _alarms : _alarms.Take(MaxLines).ToList();

    private int _hiddenCount => Math.Max(0, _alarms.Count - MaxLines);

    private bool _muted => _alarms.Count > 0 && Signature == _mutedSignature;

    private bool ShouldSound => _alarms.Count > 0 && !_muted;

    private string Signature => string.Join('|', _alarms.Select(a => a.Key));

    protected override void OnInitialized()
    {
        _alarms = Board.Current.Alarms;
        Board.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShouldSound == _sounding)
        {
            return;
        }

        _sounding = ShouldSound;
        try
        {
            await Js.InvokeVoidAsync(_sounding ? "dtAlarm.start" : "dtAlarm.stop");
        }
        catch (JSException)
        {
            // 工控机浏览器拦自动播放或没有音频设备时，红条仍然在。
        }
    }

    private void OnChanged() => _ = InvokeAsync(Refresh);

    private void Refresh()
    {
        _alarms = Board.Current.Alarms;
        StateHasChanged();
    }

    private void ToggleMute()
    {
        _mutedSignature = _muted ? null : Signature;
    }

    public void Dispose()
    {
        Board.Changed -= OnChanged;
        if (_sounding)
        {
            _ = Js.InvokeVoidAsync("dtAlarm.stop");
        }
    }
}

@* ECharts 绘图；图例保留为 HTML，以便显示抽稀前的真实极值。 *@
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime Js

@if (ShowLegend && _plots.Count > 0)
{
    <div class="dt-legend">
        @foreach (var plot in _plots)
        {
            <span class="dt-legend-item">
                <span class="dt-legend-swatch" style="@($"background:{plot.Color}")"></span>
                <span>@LegendText(plot)</span>
                <span class="dt-muted">@ChartUtil.Label(plot.Min) ~ @ChartUtil.Label(plot.Max)</span>
            </span>
        }
    </div>
}

<div class="dt-chart-box">
    @if (_plots.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="dt-muted py-3">@EmptyText</MudText>
    }
    <div @ref="_chartElement" class="dt-chart" style="@ChartStyle"
         tabindex="@(ShowAxis ? "0" : null)"
         role="img" aria-label="@ChartAccessibilityLabel"
         aria-keyshortcuts="@(ShowAxis ? "ArrowLeft ArrowRight Escape" : null)"
         hidden="@(_plots.Count == 0)"></div>
    @if (ShowAxis && _plots.Count > 0)
    {
        <MudText Typo="Typo.caption" Class="dt-muted">
            @ChartGuidance
        </MudText>
        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ToggleDataTable"
                   aria-expanded="@(_showDataTable ? "true" : "false")" aria-controls="@_dataTableId">
            @(_showDataTable ? "收起数值表" : $"展开数值表（{DisplayedPointCount} 个图表采样点）")
        </MudButton>
        @if (_showDataTable)
        {
            <div class="table-responsive">
                <table id="@_dataTableId" class="mud-table-root" aria-label="图表采样点数值表">
                    <caption>图表实际绘制的采样点。密集数据按极值保留策略抽稀，原始数据请使用对应的数据导出功能。</caption>
                    <thead>
                        <tr>
                            <th scope="col">原始点序号</th>
                            <th scope="col">@SeriesAxisName</th>
                            <th scope="col">序列</th>
                            <th scope="col">数值</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in DataTablePoints())
                        {
                            <tr>
                                <td>@point.SourceIndex</td>
                                <td>@point.XText</td>
                                <td>@point.SeriesName</td>
                                <td>@point.ValueText</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<LineSeries> Series { get; set; } = [];

    /// <summary>有坐标轴时用于保持图表宽高比。</summary>
    [Parameter] public int ViewWidth { get; set; } = 900;

    /// <summary>
    /// 有坐标轴时用于宽高比；迷你图使用固定像素高度。
    /// </summary>
    [Parameter] public int Height { get; set; } = 260;

    [Parameter] public bool ShowAxis { get; set; } = true;

    [Parameter] public bool ShowLegend { get; set; } = true;

    [Parameter] public bool ShowPoints { get; set; } = true;

    [Parameter] public int MaxPoints { get; set; } = 600;

    [Parameter] public string XStartText { get; set; } = "";

    [Parameter] public string XEndText { get; set; } = "";

    /// <summary>X 轴含义，用于悬停提示文案（位移 / 时间 / 序号）。</summary>
    [Parameter] public string SeriesAxisName { get; set; } = "X";

    [Parameter] public string EmptyText { get; set; } = "暂无曲线数据";

    /// <summary>完整时间戳仅在调用方提供真实采集时间时启用；否则横轴仍按实际 X 值或采样序号。</summary>
    [Parameter] public bool EnableZoom { get; set; } = true;

    /// <summary>
    /// ECharts 分组名：同组的多张图共享坐标轴指针与提示（联动游标），
    /// 用于详情面板的"多路独立曲线、横轴语义一致"场景。null 不参与联动。
    /// </summary>
    [Parameter] public string? ConnectGroup { get; set; }

    /// <summary>模块地址带版本：脚本更新后浏览器不会继续用旧模块；测试也引用同一常量。</summary>
    public const string ModulePath = "./js/echarts-line-chart.js?v=20261025-readout2";

    private readonly List<Plot> _plots = [];
    private ElementReference _chartElement;
    private IJSObjectReference? _module;
    private double _xMin;
    private double _xMax;
    private double _yMin;
    private double _yMax;
    private bool _annotated;
    private bool _timeAxis;
    private bool _showDataTable;
    private readonly string _dataTableId = $"dt-chart-data-{Guid.NewGuid():N}";

    private string ChartStyle => ShowAxis
        ? $"aspect-ratio:{Math.Max(1, ViewWidth)} / {Math.Max(1, Height)}"
        : $"height:{Math.Max(1, Height)}px";

    private string ChartAccessibilityLabel => _plots.Count == 0
        ? EmptyText
        : $"{SeriesAxisName}{(_plots.Any(plot => plot.IsDiscrete) ? " 离散状态阶梯图" : " 折线图")}：{string.Join("、", _plots.Select(plot => plot.Name))}";

    private int DisplayedPointCount => _plots.Sum(plot => plot.X.Length);

    private string ChartGuidance
    {
        get
        {
            var sampled = _plots.Sum(plot => plot.SourceCount) - DisplayedPointCount;
            var axisHint = _timeAxis
                ? "横轴使用实际采集时间"
                : $"{SeriesAxisName}为横轴";
            var zoomHint = EnableZoom ? "可用滚轮或图下滑块缩放" : "";
            var discreteHint = _plots.Any(plot => plot.IsDiscrete) ? "；离散状态以阶梯线表示" : "";
            var samplingHint = sampled > 0
                ? $"；密集数据已抽稀，按区段保留极值（原始 {_plots.Sum(plot => plot.SourceCount)} 点，图表显示 {DisplayedPointCount} 点）"
                : "";
            return $"{axisHint}{(zoomHint.Length > 0 ? "；" + zoomHint : "")}{discreteHint}{samplingHint}。点击图表固定读数，聚焦后可用左右方向键逐点查看、Esc 取消；数值表适合触屏和键盘通读。";
        }
    }

    protected override void OnParametersSet() => Rebuild();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await Js.InvokeAsync<IJSObjectReference>("import", ModulePath);
        await _module.InvokeVoidAsync("update", _chartElement, BuildOptions());
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("dispose", _chartElement);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void Rebuild()
    {
        _plots.Clear();
        _showDataTable = false;
        _timeAxis = false;
        // 首尾标注与刻度文字各占一行，只有一行留白时两者会叠成一团
        _annotated = ShowAxis && (!string.IsNullOrEmpty(XStartText) || !string.IsNullOrEmpty(XEndText));

        var dataSeries = Series.Where(series => series.Values.Length > 0).ToArray();
        _timeAxis = dataSeries.Length > 0 && dataSeries.All(series =>
            series.TimeValues is { Length: > 0 } times && times.Length >= series.Values.Length);
        foreach (var series in dataSeries)
        {
            _plots.Add(Prepare(series, _timeAxis));
        }

        if (_plots.Count == 0)
        {
            return;
        }

        var yMin = _plots.Min(p => p.Min);
        var yMax = _plots.Max(p => p.Max);
        var pad = (yMax - yMin) * 0.05;
        _yMin = yMin - pad;
        _yMax = yMax + pad;

        _xMin = _plots.Min(p => p.X.Length == 0 ? 0 : p.X.Min());
        _xMax = _plots.Max(p => p.X.Length == 0 ? 0 : p.X.Max());
        if (_timeAxis)
        {
            _xMin = _plots.Min(plot => plot.X.Min());
            _xMax = _plots.Max(plot => plot.X.Max());
        }
        if (Math.Abs(_xMax - _xMin) < 1e-9)
        {
            _xMin -= 0.5;
            _xMax += 0.5;
        }
    }

    private object BuildOptions()
    {
        return new
        {
            showAxis = ShowAxis,
            showLegend = ShowLegend,
            annotated = _annotated,
            showPoints = ShowPoints,
            enableZoom = EnableZoom,
            xType = _timeAxis ? "time" : "value",
            connectGroup = ConnectGroup,
            xMin = _xMin,
            xMax = _xMax,
            yMin = _yMin,
            yMax = _yMax,
            xStartText = XStartText,
            xEndText = XEndText,
            ariaLabel = ChartAccessibilityLabel,
            series = _plots.Select(plot => new
            {
                name = plot.Name,
                color = plot.Color,
                showSymbol = plot.IsDiscrete || (ShowPoints && plot.X.Length <= 120),
                isDiscrete = plot.IsDiscrete,
                data = BuildPoints(plot)
            }).ToArray()
        };
    }

    /// <summary>
    /// 抽稀与量程计算交给 <see cref="ChartUtil.SampleEnvelope"/>，那里才是能直接单测的地方。
    /// X 就是点序号的情形（XValues 为空）先拿下标再建两列：否则要为一列最终只会留下
    /// <see cref="MaxPoints"/> 个元素的序号，先铺满整条原始长度（最多两万个）。
    /// </summary>
    private Plot Prepare(LineSeries series, bool useTimeAxis)
    {
        var values = series.Values;
        if (useTimeAxis && series.TimeValues is { } times)
        {
            var timeIndices = ChartUtil.SampleIndices(values, MaxPoints);
            var sampledTimes = timeIndices.Select(index => times[index]).ToArray();
            var xs = sampledTimes.Select(ToUnixMilliseconds).ToArray();
            var ys = timeIndices.Select(index => values[index]).ToArray();
            var (min, max) = ChartUtil.Range(values);
            return new Plot(series.Name, series.Color, series.Unit, xs, ys, min, max, false,
                timeIndices, sampledTimes, series.IsDiscrete, values.Length);
        }

        // 自带数值 X 轴（如位移曲线）时按它抽稀；X 列比数据短就退回采样序号。
        if (series.XValues is { Length: > 0 } custom && custom.Length >= values.Length)
        {
            var xsForValues = custom.Length == values.Length ? custom : custom[..values.Length];
            var customIndices = ChartUtil.SampleIndices(values, MaxPoints);
            var xs = customIndices.Select(index => (double)xsForValues[index]).ToArray();
            var ys = customIndices.Select(index => values[index]).ToArray();
            var (min, max) = ChartUtil.Range(values);
            return new Plot(series.Name, series.Color, series.Unit, xs, ys, min, max, false,
                customIndices, null, series.IsDiscrete, values.Length);
        }

        var (rangeMin, rangeMax) = ChartUtil.Range(values);
        var sampleIndices = ChartUtil.SampleIndices(values, MaxPoints);
        var indexX = sampleIndices.Select(index => (double)index).ToArray();
        var indexY = sampleIndices.Select(index => values[index]).ToArray();
        return new Plot(series.Name, series.Color, series.Unit, indexX, indexY, rangeMin, rangeMax, true,
            sampleIndices, null, series.IsDiscrete, values.Length);
    }

    private object[] BuildPoints(Plot plot)
    {
        var points = new object[plot.X.Length];
        for (var i = 0; i < plot.X.Length; i++)
        {
            var unit = string.IsNullOrEmpty(plot.Unit) ? "" : " " + plot.Unit;
            var xText = XText(plot, i);
            var tooltip = $"{SeriesAxisName} {xText} → {plot.Name} {ChartUtil.Label(plot.Y[i])}{unit}";
            var xValue = plot.TimeValues is null ? (object)plot.X[i] : ToUnixMilliseconds(plot.TimeValues[i]);
            points[i] = new { value = new[] { xValue, (object)plot.Y[i] }, tip = tooltip };
        }

        return points;
    }

    private static string LegendText(Plot plot)
        => string.IsNullOrEmpty(plot.Unit) ? plot.Name : $"{plot.Name}（{plot.Unit}）";

    private void ToggleDataTable() => _showDataTable = !_showDataTable;

    private IEnumerable<DataTablePoint> DataTablePoints()
    {
        foreach (var plot in _plots)
        {
            for (var i = 0; i < plot.X.Length; i++)
            {
                yield return new DataTablePoint(
                    plot.SourceIndices[i] + 1,
                    XText(plot, i),
                    plot.Name,
                    string.IsNullOrEmpty(plot.Unit) ? ChartUtil.Label(plot.Y[i]) : $"{ChartUtil.Label(plot.Y[i])} {plot.Unit}");
            }
        }
    }

    private static string XText(Plot plot, int index)
        => plot.TimeValues is { } times
            ? times[index].ToString("yyyy-MM-dd HH:mm:ss.fff", CultureInfo.InvariantCulture)
            : plot.IndexAxis
                ? plot.X[index].ToString("0", CultureInfo.InvariantCulture)
                : ChartUtil.Label(plot.X[index]);

    private static double ToUnixMilliseconds(DateTime time)
        => new DateTimeOffset(time).ToUnixTimeMilliseconds();

    private sealed record DataTablePoint(int SourceIndex, string XText, string SeriesName, string ValueText);

    private sealed record Plot(
        string Name,
        string Color,
        string? Unit,
        double[] X,
        float[] Y,
        double Min,
        double Max,
        bool IndexAxis,
        int[] SourceIndices,
        DateTime[]? TimeValues,
        bool IsDiscrete,
        int SourceCount);
}

@using System.Text.RegularExpressions

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">快速查找</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @ref="_input" @bind-Value="_value" @bind-Value:after="StateHasChanged"
                      Label="流水号或托盘码" Placeholder="扫码枪扫描后回车"
                      Immediate="true" Clearable="true" Variant="Variant.Outlined"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.QrCodeScanner"
                      OnKeyDown="OnKeyDown" />
        <MudText Typo="Typo.caption" Class="dt-muted mt-2">
            回车自动识别：形如 20261012-002061 按流水号查询，其余按托盘码查询。
            结果会打开「数据查询」并保留条件，可直接继续核对。
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Disabled="@(string.IsNullOrWhiteSpace(_value))" OnClick="@(() => Submit(serial: false))">按托盘码</MudButton>
        <MudButton Disabled="@(string.IsNullOrWhiteSpace(_value))" Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@(() => Submit(serial: null))">
            查询
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance? MudDialog { get; set; }

    private MudTextField<string>? _input;
    private string? _value;

    private static readonly Regex SerialPattern = new(@"^\d{8}-\d+$", RegexOptions.Compiled);

    public sealed record LookupRequest(string Value, bool IsSerial);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _input is not null)
        {
            // MudDialog 打开后还会把焦点收到自己的容器上，稍等一拍再抢回来。
            await Task.Delay(180);
            await _input.FocusAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            Submit(serial: null);
        }
    }

    private void Cancel() => MudDialog?.Cancel();

    /// <param name="serial">null = 按格式自动识别；true/false = 用户明确指定。</param>
    private void Submit(bool? serial)
    {
        var value = _value?.Trim();
        if (string.IsNullOrEmpty(value))
        {
            return;
        }

        MudDialog?.Close(DialogResult.Ok(new LookupRequest(value, serial ?? SerialPattern.IsMatch(value))));
    }
}

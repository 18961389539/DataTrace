@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Http
@using DataTrace.Web.Services
@inject CustomerBrandingStore Branding
@inject IJSRuntime Js

<MudThemeProvider Theme="DataTraceTheme.Current" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>@_siteName</PageTitle>

<MudLayout>
    @* 不写 Color="Dark"：那会把主题里的 AppbarBackground/AppbarText 变成死配置，
       暗色下顶栏 #0d151c 与抽屉 #18232d 是两种深色，浅色下也绕开了主题。 *@
    <MudAppBar Elevation="1">
        <MudTooltip Text="展开/收起菜单">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           Class="dt-appbar-menu"
                           aria-label="展开或收起菜单" OnClick="@Toggle" />
        </MudTooltip>
        @* 顶栏品牌：客户厂名（customer.json / Customer:SiteName），可选 Logo *@
        @if (!string.IsNullOrEmpty(_logoUrl))
        {
            <img src="@_logoUrl" alt="" class="dt-brand-logo" />
        }
        <MudText Typo="Typo.subtitle1">@_siteName</MudText>
        <MudSpacer />
        <div class="dt-appbar-utilities">
            <PwaInstallButton />
            <ThemeModeSwitch IsDarkMode="_isDarkMode" OnToggle="ToggleThemeAsync" />
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="dt-appbar-identity">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mr-3 dt-appbar-chip">
                        @RoleLabel(context.User)
                    </MudChip>
                    <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="mr-1" aria-label="@context.User.Identity?.Name" />
                    <MudText Class="mr-4 d-none d-sm-flex">@context.User.Identity?.Name</MudText>
                    @* 退出走 POST 表单：GET 带副作用会被一张 <img src="/account/logout"> 或一次
                       顶层导航点掉登录态。原生提交（data-enhance="false"）后由服务端 302 回看板。 *@
                    <form method="post" action="/account/logout" data-enhance="false" class="dt-logout-form">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit"
                                   StartIcon="@Icons.Material.Filled.Logout">退出</MudButton>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_open" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
               ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="dt-main">
        <AuthorizeView>
            <Authorized>
                <LineAlarmBar />
            </Authorized>
        </AuthorizeView>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _open = true;
    private bool _isDarkMode;
    private string _siteName = "DataTrace";
    private string? _logoUrl;

    /// <summary>只在预渲染阶段有值；交互渲染时拿不到，那也没关系——那时主题已经定了。</summary>
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        var snap = Branding.GetSnapshot();
        _siteName = snap.EffectiveSiteName;
        _logoUrl = snap.ResolvedLogoUrl;

        // 主题偏好存在 Cookie 里，服务端首帧就能定调色板。
        // 原来只读 localStorage、要等 OnAfterRender 才翻成暗色，暗色用户每次进页面都先闪一帧白底。
        _isDarkMode = string.Equals(
            HttpContext?.Request.Cookies[ThemeCookieName], "dark", StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _isDarkMode = await Js.InvokeAsync<bool>("dtTheme.get");
            StateHasChanged();
        }
        catch (JSException)
        {
            // Theme preference is optional; keep the light theme if browser storage is unavailable.
        }
    }

    private void Toggle() => _open = !_open;

    /// <summary>与 wwwroot/js/theme.js 的 storageKey / cookie 名保持一致。</summary>
    private const string ThemeCookieName = "dt-theme-mode";

    private async Task ToggleThemeAsync()
    {
        _isDarkMode = !_isDarkMode;
        try
        {
            await Js.InvokeVoidAsync("dtTheme.set", _isDarkMode);
        }
        catch (JSException)
        {
            // The Mud theme still changes for this circuit if persistence is unavailable.
        }
    }

    private static string RoleLabel(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole(AppRoles.Administrator)) return "管理员";
        if (user.IsInRole(AppRoles.Engineer)) return "工程师";
        if (user.IsInRole(AppRoles.Operator)) return "操作员";
        if (user.IsInRole(AppRoles.Viewer)) return "访客";
        return "未分配角色";
    }
}

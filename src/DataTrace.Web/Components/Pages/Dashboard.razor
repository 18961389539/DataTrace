    protected override async Task OnInitializedAsync()
    {
        try
        {
            var snap = await Config.GetSnapshotAsync();
            _configVersion = snap.Version;
            RefreshCurveConfiguration(snap);
            _collectEnabled = snap.Settings.CollectEnabled;
            _productionSimWarning = Branding.EnvironmentName.Equals("Production", StringComparison.OrdinalIgnoreCase)
                && snap.Settings.SimulatorAutoRun;

            try
            {
                var auth = await AuthState.GetAuthenticationStateAsync();
                _isAdmin = auth.User?.IsInRole("Administrator") == true;
                _canManageRecipes = _isAdmin || auth.User?.IsInRole("Engineer") == true;
                var bak = BackupService.GetStatus();
                _backupStale = bak.IsStaleOrFailed(TimeSpan.FromHours(SystemDefaults.BackupStaleHours));
            }
            catch
            {
                _backupStale = false;
            }
        }
        catch
        {
            // 配置读不出来不能静默：采集开关、仿真提示、备份陈旧提示都会停在默认值，
            // 用户会把「默认值」当成「真实状态」。说出来，他才知道该刷新重试。
            _configNote = "系统配置读取失败，页面上的采集开关与仿真提示可能不是最新状态。请刷新页面重试。";
        }

        Refresh();
        await RefreshSpoolAsync();
        EvaluateStale();
        Status.Changed += OnChanged;
        // 5 秒一跳：这一跳只做"轻活"（比版本号 + 推进卡片上的相对时间），
        // 时钟与节拍芯片各自有 1 秒计时器，不受这里影响。
        _uiTimer = new Timer(_ => _ = InvokeAsync(OnUiTickAsync), null, UiTickMs, UiTickMs);
        await RefreshShiftAsync(force: true);
        await RefreshWorkOrdersAsync(force: true);
    }

        protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Default false (collapsed) when unset — matches dtRecentOpen.get
        try
        {
            _recentOpenPref = await Js.InvokeAsync<bool>("dtRecentOpen.get");
            StateHasChanged();
        }
        catch
        {
            // JS not ready: keep recent records collapsed.
        }

        // 概览/详细沿用上次选择；读不到就停在概览。
        try
        {
            _fullDetailMode = await Js.InvokeAsync<bool>("dtDashboardView.get");
            StateHasChanged();
        }
        catch
        {
            // JS not ready: keep overview mode.
        }
    }
    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        // 这里只碰内存里的运行时快照。配置快照（GetSnapshotAsync 要拉整条
        // 工站→点位/曲线/序列/判据 与 型号→限值 的关联链）挪到下面的定时跳里按版本号比对，
        // 否则采集侧每秒推好几次事件，这条重查询就跟着跑好几次。
        Refresh();
        await RefreshSpoolAsync();
        await RefreshShiftAsync(force: false);
        EvaluateStale();
        StateHasChanged();
    });

    private async Task OnUiTickAsync()
    {
        EvaluateStale();
        await RefreshSpoolAsync();
        try
        {
            var ver = await Config.GetVersionAsync();
            if (ver != _configVersion)
            {
                _configVersion = ver;
                await RefreshConfigAlertsAsync();
                await RefreshShiftAsync(force: true);
            }
            else if ((DateTime.Now - _shiftFetchedAt).TotalSeconds >= ShiftCacheSeconds)
            {
                await RefreshShiftAsync(force: false);
            }
        }
        catch
        {
            // ignore tick errors
        }

        await RefreshWorkOrdersAsync(force: false);

        // 这一跳还得重画：卡片上的「30 秒前」只能靠它推进 —— hub 只在状态真的变了时才推事件，
        // 停机（或采集关闭）之后就没有事件了，不重画的话那些相对时间会一直冻在最后一次采集上。
        StateHasChanged();
    }

    /// <summary>
    /// 工单档案不随配置版本变化，也不推 hub；按 30 秒缓存自行轮询。
    /// 读取失败时保留上一次结果，只在卡片脚注说明。
    /// </summary>
    private async Task RefreshWorkOrdersAsync(bool force)
    {
        if (!force && (DateTime.Now - _workOrderFetchedAt).TotalSeconds < WorkOrderCacheSeconds)
        {
            return;
        }

        try
        {
            var orders = await Config.GetWorkOrdersAsync();
            _currentWorkOrder = orders.FirstOrDefault(order => order.IsCurrent);
            _currentProduced = null;
            _currentOk = null;
            _currentNg = null;
            if (_currentWorkOrder is { CurrentSince: { } since })
            {
                try
                {
                    // 轻量估算：从设为当前起、按工单型号统计走出末站的件数，不绑定会话。
                    var progress = await Reports.GetPieceYieldAsync(
                        since, DateTime.Now, null, _currentWorkOrder.Recipe?.Code);
                    _currentProduced = progress.ByShift.Sum(row => row.Total);
                    _currentOk = progress.ByShift.Sum(row => row.Ok);
                    _currentNg = progress.ByShift.Sum(row => row.Ng);
                }
                catch
                {
                    // 统计失败不影响工单卡其它信息；下一轮再试。
                    _currentProduced = null;
                    _currentOk = null;
                    _currentNg = null;
                }
            }

            _workOrderLoadFailed = false;
            _workOrderFetchedAt = DateTime.Now;
        }
        catch
        {
            _workOrderLoadFailed = true;
        }
    }

    private static string WorkOrderModel(WorkOrder order)
    {
        if (!string.IsNullOrWhiteSpace(order.Model))
        {
            return order.Model!;
        }

        return string.IsNullOrWhiteSpace(order.Recipe?.Model) ? "—" : order.Recipe!.Model!;
    }

    /// <summary>当前工单的完成/剩余估算；没有起点或统计失败时只提示从下次设为当前起算。</summary>
    private string? WorkOrderProgressText
    {
        get
        {
            if (_currentWorkOrder is not { } order)
            {
                return null;
            }

            if (order.CurrentSince is null || _currentProduced is not int produced
                || _currentOk is not int ok || _currentNg is not int ng)
            {
                return "完成数从下次设为当前起统计";
            }

            var split = $"已完成 {produced} 件（OK {ok} · NG {ng}）";
            if (order.PlannedQuantity is not int planned)
            {
                return $"{split} · 未设计划数量";
            }

            var remaining = planned - produced;
            return remaining >= 0
                ? $"{split} · 剩余 {remaining} 件"
                : $"{split} · 超产 {-remaining} 件";
        }
    }

    /// <summary>当前工单型号与当前型号不一致时返回给现场看的一句提示；一致时返回 null。</summary>
    private string? WorkOrderModelMismatchText
    {
        get
        {
            if (_currentWorkOrder is not { Recipe: { } recipe })
            {
                return null;
            }

            if (string.IsNullOrEmpty(Status.ActiveRecipeCode))
            {
                return "未设置当前型号，新采集按点位默认限值判定";
            }

            return string.Equals(recipe.Code, Status.ActiveRecipeCode, StringComparison.OrdinalIgnoreCase)
                ? null
                : $"当前型号不一致（当前 {Status.ActiveRecipeCode}），新采集仍按当前型号判定";
        }
    }

    /// <summary>柱状图按工站顺序排列；只画有 NG 的工站，没有时给一句“本班没有 NG”。</summary>
    private void BuildStationNgChart(IReadOnlyList<Station>? stations)
    {
        var order = new Dictionary<int, int>();
        if (stations is not null)
        {
            foreach (var station in stations.Where(item => item.Enabled))
            {
                order[station.Id] = station.Sequence;
            }
        }

        var points = _stationJudgements.Where(item => item.Ng > 0)
            .OrderBy(item => order.TryGetValue(item.StationId, out var sequence) ? sequence : int.MaxValue)
            .ThenBy(item => item.StationCode, StringComparer.Ordinal)
            .ToList();

        _ngTotal = points.Sum(item => item.Ng);
        _ngBars = points;
        _ngMax = points.Count == 0 ? 0 : points.Max(item => item.Ng);
        _ngSummary = points.Count == 0
            ? "本班没有 NG"
            : string.Join(" · ", points.Select(item => $"{item.StationCode} {item.Ng} 件"));
    }


@page "/"
@attribute [Authorize]
@using DataTrace.Application.Backup
@using DataTrace.Application.Configuration
@using DataTrace.Application.Realtime
@using DataTrace.Application.Reporting
@using DataTrace.Domain.Constants
@using DataTrace.Domain.Enums
@implements IDisposable
@inject IRuntimeStatusHub Status
@inject IConfigRepository Config
@inject CustomerBrandingStore Branding
@inject IDatabaseBackupService BackupService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IReportService Reports
@inject IJSRuntime Js

<PageHeader Title="实时看板" HelpRoute="/">
    <ChildContent>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_stations.Count 台工站</MudChip>
        <LiveCadenceChip LastBeat="LastBeat" />

        @if (CanManageRecipes)
        {
            <MudChip T="string" Size="Size.Small" Color="@(string.IsNullOrEmpty(Status.ActiveRecipeCode) ? Color.Default : Color.Primary)"
                     Variant="Variant.Filled" OnClick="GoRecipes" Style="cursor:pointer">
                @ActiveRecipeLabel
            </MudChip>
        }
        else
        {
            <MudChip T="string" Size="Size.Small" Color="@(string.IsNullOrEmpty(Status.ActiveRecipeCode) ? Color.Default : Color.Primary)"
                     Variant="Variant.Filled">
                @ActiveRecipeLabel
            </MudChip>
        }

    </ChildContent>
    <Actions>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mr-2"
                   StartIcon="@(_shopFloor ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)"
                   OnClick="ToggleShopFloorAsync">
            @(_shopFloor ? "退出大屏" : "大屏模式")
        </MudButton>
        <MudText Typo="Typo.caption" Class="@(_dataStale ? "dt-clock-stale" : "dt-muted")"
                 aria-label="@(_dataStale ? "本地时钟不代表数据仍在更新" : null)">
            PLC @_plcs.Count(p => p.Connected)/@_plcs.Count
            · 采集中 @_stations.Count(s => s.State == StationRuntimeState.Busy)
            · <LiveClock />
        </MudText>
        <InfoHint Topic="HelpTexts.StaleData" />
    </Actions>
</PageHeader>

@* KPI 独立成条：跟页头的状态芯片平铺在一起时它们权重相同，扫一眼分不出主次。
   今日件数的口径（Asia/Shanghai）与三态判定的说明跟着各自的 ⓘ 走。 *@
<div class="dt-kpi-bar">
    <div class="dt-kpi">
        <span class="dt-kpi-label">今日采集<InfoHint Topic="HelpTexts.TodayScope" /></span>
        <span class="dt-kpi-value">@_shiftTotal</span>
        <span class="dt-kpi-hint">OK @_shiftOk · 未判定 @_shiftNone</span>
    </div>
    <div class="dt-kpi">
        <span class="dt-kpi-label">直通率<InfoHint Topic="HelpTexts.YieldRate" /></span>
        <span class="dt-kpi-value">@_shiftYieldText</span>
    </div>
    <div class="dt-kpi">
        <span class="dt-kpi-label">今日 NG<InfoHint Topic="HelpTexts.JudgementThreeState" /></span>
        <span class="dt-kpi-value dt-kpi-value-alert">@_shiftNg</span>
    </div>
    <div class="dt-kpi">
        <span class="dt-kpi-label">平均节拍</span>
        <span class="dt-kpi-value">@AvgCadenceText</span>
    </div>
</div>

@if (_shopFloor)
{
    <div class="dt-shopfloor-exit">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.FullscreenExit"
                   OnClick="ToggleShopFloorAsync">退出大屏</MudButton>
    </div>
}


@if (_dataStale)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Filled">
        连接中断或数据已停止更新，显示可能过期（采集心跳超过 @SystemDefaults.StaleHeartbeatSeconds 秒未刷新）。
    </MudAlert>
}

@if (_backupStale && _isAdmin)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        数据库备份异常或超过 48 小时未成功，请到「系统设置」查看并立即备份。
    </MudAlert>
}

@if (_productionSimWarning)
{
    @* 开着仿真在 Production 是允许的（现场可以自己决定），所以这里只陈述事实、不再要求关闭。 *@
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        当前开着「启动后自动跑仿真」：看板与采集记录来自内置模拟器，不代表真实产线。可在「PLC 仿真」页关闭。
    </MudAlert>
}
@if (!_collectEnabled)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        「启用采集」当前是关闭的：PLC 不再被扫描，看板数值与「最近采集」都不会再变化。需要恢复请到「系统设置」打开。
    </MudAlert>
}

@foreach (var plc in _plcs.Where(p => !p.Connected || !string.IsNullOrEmpty(p.LastError)))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        @plc.Name 断开@(string.IsNullOrEmpty(plc.LastError) ? "" : $"：{plc.LastError}")
    </MudAlert>
}

@if (_stations.Count == 0)
{
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h6" Class="mb-2">还没有可监控的工站</MudText>
        <MudText Typo="Typo.body2" Class="dt-muted mb-4">
            先到「PLC 连接」新增一台 PLC（也可先用内置模拟器），再到「工站配置」创建工站并配好触发地址、点位与曲线，
            看板就会实时显示每台工站的节拍与最近一次判定。
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/config/plc">
                去配置 PLC
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Science" Href="/simulate">
                用模拟器跑一遍
            </MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    <MudGrid>
        @foreach (var station in _orderedStations)
        {
            <MudItem xs="12" md="6" lg="4">
                <StationCard Station="station" />
            </MudItem>
        }
    </MudGrid>
}


<MudExpansionPanels Class="mt-5 dt-recent-panels" Elevation="1" Dense="true">
    <MudExpansionPanel Class="dt-recent-panel"
                       Expanded="@RecentPanelExpanded"
                       ExpandedChanged="OnRecentExpandedChangedAsync"
                       Disabled="_shopFloor"
                       HideIcon="_shopFloor">
        <TitleContent>
            <div class="dt-recent-title">
                <MudText Typo="Typo.subtitle1" Class="mb-0">最近采集 · @_recentPreview.Count 条</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           EndIcon="@Icons.Material.Filled.ChevronRight" Href="/query"
                           Class="dt-recent-more"
                           @onclick:stopPropagation="true">
                    更多 → 数据查询
                </MudButton>
            </div>
        </TitleContent>
        <ChildContent>
            <MudTable Items="_recentPreview" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                      FixedHeader="true" Height="360px">

                <HeaderContent>
                    <MudTh Class="dt-nowrap">完成时间</MudTh>
                    <MudTh>工站</MudTh>
                    <MudTh>托盘码</MudTh>
                    <MudTh>流水号</MudTh>
                    <MudTh>型号</MudTh>
                    <MudTh>判定</MudTh>
                    <MudTh Class="dt-num">耗时</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="完成时间" Class="dt-nowrap">
                        @* 格子里只放时分秒，完整时间戳（含日期与毫秒）用 tooltip：
                           平板没有 hover，原生 title 等于把诊断要用的精度藏起来。 *@
                        <MudTooltip Text="@context.CompleteTime.ToString("yyyy-MM-dd HH:mm:ss.fff")">
                            <span>@context.CompleteTime.ToString("HH:mm:ss")</span>
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="工站">@context.StationCode</MudTd>
                    <MudTd DataLabel="托盘码">@context.PalletCode</MudTd>
                    <MudTd DataLabel="流水号">@context.SerialNo</MudTd>
                    <MudTd DataLabel="型号">@RecipeLabel(context.RecipeCode)</MudTd>
                    <MudTd DataLabel="判定">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(context.Judgement == Judgement.Ng ? Color.Error : context.Judgement == Judgement.Ok ? Color.Success : Color.Default)">
                            @DisplayLabels.JudgementText(context.Judgement)
                        </MudChip>
                        @if (!string.IsNullOrEmpty(context.Error))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">@context.Error</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="耗时" Class="dt-num dt-nowrap">@context.DurationMs ms</MudTd>
                    <MudTd DataLabel="操作">
                        <MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ChevronRight"
                                   Href="@($"/query/{context.MonthKey}/{context.RecordId}")">明细</MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="dt-muted py-3">
                        还没有采集记录。可在「PLC 仿真」页触发一条走线，快速验证采集链路是否通畅。
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private const int ShiftCacheSeconds = 15;
    /// <summary>页面级刷新节拍（毫秒）。</summary>
    private const int UiTickMs = 5000;
    private const string ShopFloorKey = "dt-shopfloor";

    private bool _productionSimWarning;
    private bool _backupStale;
    private bool _isAdmin;
    private bool _canManageRecipes;
    private bool _shopFloor;
    /// <summary>User preference for recent-collect panel (localStorage dtRecentOpen). Forced closed while shop-floor.</summary>
    private bool _recentOpenPref;
    private bool _dataStale;

    private IReadOnlyList<PlcRuntimeStatus> _plcs = [];
    private IReadOnlyList<StationRuntimeStatus> _stations = [];
    /// <summary>渲染用的工站顺序：异常在前，同级按工艺顺序（见 <see cref="SeverityRank"/>）。</summary>
    private IReadOnlyList<StationRuntimeStatus> _orderedStations = [];
    private IReadOnlyList<CollectFeedItem> _recent = [];
    private IReadOnlyList<CollectFeedItem> _recentPreview = [];
    private bool _collectEnabled = true;

    private int _shiftTotal;
    private int _shiftOk;
    private int _shiftNg;
    private int _shiftNone;
    private string _shiftYieldText = "—";
    private DateTime _shiftFetchedUtc = DateTime.MinValue;
    private bool _shiftBusy;
    private int _configVersion = -1;
    private Timer? _uiTimer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var snap = await Config.GetSnapshotAsync();
            _configVersion = snap.Version;
            _collectEnabled = snap.Settings.CollectEnabled;
            _productionSimWarning = Branding.EnvironmentName.Equals("Production", StringComparison.OrdinalIgnoreCase)
                && snap.Settings.SimulatorAutoRun;

            try
            {
                var auth = await AuthState.GetAuthenticationStateAsync();
                _isAdmin = auth.User?.IsInRole("Administrator") == true;
                _canManageRecipes = _isAdmin || auth.User?.IsInRole("Engineer") == true;
                var bak = BackupService.GetStatus();
                _backupStale = bak.IsStaleOrFailed(TimeSpan.FromHours(SystemDefaults.BackupStaleHours));
            }
            catch
            {
                _backupStale = false;
            }
        }
        catch
        {
            // best-effort
        }

        Refresh();
        EvaluateStale();
        Status.Changed += OnChanged;
        // 5 秒一跳：这一跳只做"轻活"（比版本号 + 推进卡片上的相对时间），
        // 时钟与节拍芯片各自有 1 秒计时器，不受这里影响。
        _uiTimer = new Timer(_ => _ = InvokeAsync(OnUiTickAsync), null, UiTickMs, UiTickMs);
        await RefreshShiftAsync(force: true);
    }

        protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var on = await Js.InvokeAsync<bool>("dtShopFloor.get");
            if (on != _shopFloor)
            {
                _shopFloor = on;
                await Js.InvokeVoidAsync("dtShopFloor.set", _shopFloor);
            }

            // Default false (collapsed) when unset — matches dtRecentOpen.get
            _recentOpenPref = await Js.InvokeAsync<bool>("dtRecentOpen.get");
            StateHasChanged();
        }
        catch
        {
            // JS not ready: keep defaults (shop-floor off, recent collapsed)
        }
    }
    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        // 这里只碰内存里的运行时快照。配置快照（GetSnapshotAsync 要拉整条
        // 工站→点位/曲线/序列/判据 与 型号→限值 的关联链）挪到下面的定时跳里按版本号比对，
        // 否则采集侧每秒推好几次事件，这条重查询就跟着跑好几次。
        Refresh();
        await RefreshShiftAsync(force: false);
        EvaluateStale();
        StateHasChanged();
    });

    private async Task OnUiTickAsync()
    {
        EvaluateStale();
        try
        {
            var ver = await Config.GetVersionAsync();
            if (ver != _configVersion)
            {
                _configVersion = ver;
                await RefreshConfigAlertsAsync();
                await RefreshShiftAsync(force: true);
            }
            else if ((DateTime.UtcNow - _shiftFetchedUtc).TotalSeconds >= ShiftCacheSeconds)
            {
                await RefreshShiftAsync(force: false);
            }
        }
        catch
        {
            // ignore tick errors
        }

        // 这一跳还得重画：卡片上的「30 秒前」只能靠它推进 —— hub 只在状态真的变了时才推事件，
        // 停机（或采集关闭）之后就没有事件了，不重画的话那些相对时间会一直冻在最后一次采集上。
        StateHasChanged();
    }

    private void EvaluateStale()
    {
        // 采集关闭时用专用告警，不叠「数据过期」。
        if (!_collectEnabled)
        {
            _dataStale = false;
            return;
        }

        var age = DateTime.UtcNow - Status.LastCollectorUtc;
        _dataStale = age.TotalSeconds > SystemDefaults.StaleHeartbeatSeconds;
    }

    private async Task RefreshConfigAlertsAsync()
    {
        try
        {
            var snap = await Config.GetSnapshotAsync();
            _configVersion = snap.Version;
            _collectEnabled = snap.Settings.CollectEnabled;
            _productionSimWarning = Branding.EnvironmentName.Equals("Production", StringComparison.OrdinalIgnoreCase)
                && snap.Settings.SimulatorAutoRun;
        }
        catch
        {
            // 配置读不出来就不下结论
        }
    }

    private async Task RefreshShiftAsync(bool force)
    {
        if (_shiftBusy) return;
        if (!force && (DateTime.UtcNow - _shiftFetchedUtc).TotalSeconds < ShiftCacheSeconds) return;

        _shiftBusy = true;
        try
        {
            var day = ShanghaiClock.Today;
            var report = await Reports.GetThroughputAsync(day, day.AddDays(1).AddTicks(-1), null);
            var rows = report.ByDay;
            var today = rows.FirstOrDefault(r => r.Day.Date == day) ?? rows.FirstOrDefault();
            if (today is null)
            {
                _shiftTotal = _shiftOk = _shiftNg = _shiftNone = 0;
                _shiftYieldText = "—";
            }
            else
            {
                _shiftTotal = today.Total;
                _shiftOk = today.Ok;
                _shiftNg = today.Ng;
                _shiftNone = today.None;
                _shiftYieldText = today.Ok + today.Ng == 0 ? "—" : today.FirstPassYield.ToString("P1");
            }

            _shiftFetchedUtc = DateTime.UtcNow;
        }
        catch
        {
            // 报表失败时保留上次数字
        }
        finally
        {
            _shiftBusy = false;
        }
    }

    private void Refresh()
    {
        _plcs = Status.Plcs;
        _stations = Status.Stations;
        // 排序在这里做一次，而不是写在 foreach 里：定时跳每 5 秒重画一次，
        // 内联排序就会跟着每 5 秒重排一遍。
        _orderedStations = _stations.OrderBy(SeverityRank).ThenBy(s => s.Sequence).ToList();
        _recent = Status.Recent;
        // 看板只展示最近十余条，完整历史去「数据查询」，避免表格占满整屏。
        _recentPreview = _recent.Take(12).ToList();
    }

    private DateTime? LastBeat => _stations.Select(s => s.LastCompleteTime).Max();

    /// <summary>平均节拍：各工站最近一次采集耗时的均值；一台都没采过时给「—」。</summary>
    private string AvgCadenceText => DurationFormat.Average(_stations.Select(s => s.LastDurationMs));

    /// <summary>
    /// 工站严重度：故障 → NG → 采集中 → 空闲 → 停用。看板上最该被看见的工位排在最前，
    /// 否则一台 NG 可能落在最后一屏，大屏上等于没有报警。
    /// </summary>
    private static int SeverityRank(StationRuntimeStatus station)
    {
        // 停用先判：停用工位的 LastJudgement 还留着最后一次判定，
        // 晚了它就会顶着上一次的 NG 挤到最前面，反而误导。
        if (station.State == StationRuntimeState.Disabled) return 4;
        if (station.State == StationRuntimeState.Fault) return 0;
        if (station.State == StationRuntimeState.Busy) return 2;
        return station.LastJudgement == Judgement.Ng ? 1 : 3;
    }

    private bool CanManageRecipes => _canManageRecipes;

    private string ActiveRecipeLabel =>
        string.IsNullOrEmpty(Status.ActiveRecipeCode)
            ? "未选择型号·按点位默认限值"
            : $"当前型号 {Status.ActiveRecipeCode}" + (string.IsNullOrEmpty(Status.ActiveRecipeName) ? "" : $"（{Status.ActiveRecipeName}）");

    private static string RecipeLabel(string? code)
        => string.IsNullOrEmpty(code) ? "未选型号" : code;

    private void GoRecipes() => Nav.NavigateTo("/config/recipes");

    /// <summary>Effective expand state: always collapsed in shop-floor; otherwise user preference.</summary>
    private bool RecentPanelExpanded => !_shopFloor && _recentOpenPref;

    private async Task OnRecentExpandedChangedAsync(bool open)
    {
        if (_shopFloor)
        {
            return;
        }

        _recentOpenPref = open;
        try
        {
            await Js.InvokeVoidAsync("dtRecentOpen.set", open);
        }
        catch
        {
            // preference write best-effort
        }
    }

    private async Task ToggleShopFloorAsync()
    {
        _shopFloor = !_shopFloor;
        try
        {
            await Js.InvokeVoidAsync("dtShopFloor.set", _shopFloor);
        }
        catch
        {
            // 无 JS 时仍切换本地标记；CSS 依赖 body class，失败则仅按钮文案变化
        }
    }

    public void Dispose()
    {
        Status.Changed -= OnChanged;
        _uiTimer?.Dispose();
    }
}

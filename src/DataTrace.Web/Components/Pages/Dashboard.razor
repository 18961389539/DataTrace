    private enum StationFilter { All, Attention, Busy, Idle, Disabled }

    private IReadOnlyList<StationRuntimeStatus> VisibleStations
    {
        get
        {
            IReadOnlyList<StationRuntimeStatus> stations = ShopFloor || _selectedFilter == StationFilter.All
                ? _orderedStations
                : _orderedStations.Where(station => MatchesFilter(station, _selectedFilter)).ToList();
            var query = _stationSearch.Trim();
            if (query.Length > 0)
            {
                stations = stations.Where(station =>
                    station.StationCode.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || station.StationName.Contains(query, StringComparison.OrdinalIgnoreCase)).ToList();
            }

            // 默认按工艺顺序。异常置顶只在「全部」下把故障 / 最近 NG / 点位异常排到前面，组内仍按顺序。
            if (_pinAbnormal && (ShopFloor || _selectedFilter == StationFilter.All))
            {
                stations = stations
                    .OrderBy(station => IsAttention(station) ? 0 : 1)
                    .ThenBy(station => station.Sequence)
                    .ThenBy(station => station.StationId)
                    .ToList();
            }

            return stations;
        }
    }

    private string StationEmptyText => string.IsNullOrWhiteSpace(_stationSearch)
        ? $"当前没有{FilterLabel(_selectedFilter)}的工站"
        : $"没有找到“{_stationSearch.Trim()}”对应的工站{(_selectedFilter == StationFilter.All ? "" : $"（当前筛选：{FilterLabel(_selectedFilter)}）")}";

    private void OnStationSearchChanged(string value) => _stationSearch = value;

    private void ClearStationFilters()
    {
        _stationSearch = "";
        _selectedFilter = StationFilter.All;
    }

    private int FilterCount(StationFilter filter) => filter switch
    {
        StationFilter.All => _stations.Count,
        StationFilter.Attention => _orderedStations.Count(IsAttention),
        _ => _orderedStations.Count(station => MatchesFilter(station, filter))
    };

    private static bool MatchesFilter(StationRuntimeStatus station, StationFilter filter)
        => filter switch
        {
            StationFilter.Attention => IsAttention(station),
            StationFilter.Busy => station.State == StationRuntimeState.Busy,
            StationFilter.Idle => station.State == StationRuntimeState.Idle,
            StationFilter.Disabled => station.State == StationRuntimeState.Disabled,
            _ => true
        };

    private static bool IsAttention(StationRuntimeStatus station)
        => station.State == StationRuntimeState.Fault
           || station.LastJudgement == Judgement.Ng
           || station.LastTags.Any(tag => tag.OutOfLimit || tag.Warning || IsNoData(tag));

    private static bool IsNoData(StationLiveTag tag)
        => tag.NumericValue is null && string.IsNullOrWhiteSpace(tag.TextValue);

    private Task RetryShiftAsync() => RefreshShiftAsync(force: true);

    private static string FilterLabel(StationFilter filter) => filter switch
    {
        StationFilter.Attention => "需关注",
        StationFilter.Busy => "采集中",
        StationFilter.Idle => "空闲",
        StationFilter.Disabled => "停用",
        _ => "全部"
    };


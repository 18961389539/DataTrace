@page "/"
@attribute [Authorize]
@using DataTrace.Application.Alarms
@using DataTrace.Application.Backup
@using DataTrace.Application.Configuration
@using DataTrace.Application.Realtime
@using DataTrace.Application.Reporting
@using DataTrace.Application.Runtime
@using DataTrace.Domain
@using DataTrace.Domain.Constants
@using DataTrace.Domain.Enums
@implements IDisposable
@inject IRuntimeStatusHub Status
@inject IConfigRepository Config
@inject CustomerBrandingStore Branding
@inject IDatabaseBackupService BackupService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IReportService Reports
@inject ISpoolStore Spool
@inject IJSRuntime Js
@inject IDialogService DialogService

<PageHeader Title="实时看板" HelpRoute="/" Busy="@_shiftBusy">
    <ChildContent>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_stations.Count 台工站</MudChip>
        @if (_productionSimWarning)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                     Icon="@Icons.Material.Filled.Science" OnClick="ToggleSimulationDetails"
                     aria-expanded="@_showSimulationDetails" aria-controls="dt-simulation-details"
                     aria-label="@(_showSimulationDetails ? "收起模拟数据说明" : "查看模拟数据说明")">
                模拟数据
            </MudChip>
        }
        <LiveCadenceChip LastBeat="LastBeat" FreshnessText="@FreshnessText"
                         FreshnessColor="@FreshnessColor" FreshnessIcon="@FreshnessIcon" />

        @if (CanManageRecipes)
        {
            <MudChip T="string" Size="Size.Small" Color="@(string.IsNullOrEmpty(Status.ActiveRecipeCode) ? Color.Default : Color.Primary)"
                     Variant="Variant.Filled" OnClick="GoRecipes" Style="cursor:pointer">
                @ActiveRecipeLabel
            </MudChip>
        }
        else
        {
            <MudChip T="string" Size="Size.Small" Color="@(string.IsNullOrEmpty(Status.ActiveRecipeCode) ? Color.Default : Color.Primary)"
                     Variant="Variant.Filled">
                @ActiveRecipeLabel
            </MudChip>
        }

    </ChildContent>
    <Actions>
        <MudText Typo="Typo.caption" Class="@(_dataStale ? "dt-clock-stale" : "dt-muted")"
                 aria-label="@(_dataStale ? "本地时钟不代表数据仍在更新" : null)">
            PLC @_plcs.Count(p => p.Connected)/@_plcs.Count
            · 采集中 @_stations.Count(s => s.State == StationRuntimeState.Busy)
            · <LiveClock />
        </MudText>
        <InfoHint Topic="HelpTexts.StaleData" />
    </Actions>
</PageHeader>

@if (_configNote is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        @_configNote
    </MudAlert>
}

@if (_productionSimWarning && _showSimulationDetails)
{
    <div id="dt-simulation-details">
        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined"
                  Class="dt-simulation-detail mb-3">
            <div class="dt-simulation-detail-content">
                <MudText Typo="Typo.body2" Class="dt-simulation-detail-text">
                    当前已开启「启动后自动跑仿真」。看板与采集记录来自内置模拟器，不代表真实产线。
                </MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                           EndIcon="@Icons.Material.Filled.ChevronRight" Href="/simulate">
                    前往 PLC 仿真
                </MudButton>
            </div>
        </MudAlert>
    </div>
}

@* KPI 独立成条：跟页头的状态芯片平铺在一起时它们权重相同，扫一眼分不出主次。
   本班 OK 的口径与三态判定的说明跟着各自的 ⓘ 走。 *@
<div class="dt-kpi-bar">
    <div class="dt-kpi-card">
        <div class="dt-kpi-main">
            <span class="dt-kpi-label">本班OK<InfoHint Topic="HelpTexts.TodayScope" /></span>
            @if (_shiftHasSuccess)
            {
                <span class="dt-kpi-value">@_shiftOk <span class="dt-kpi-unit">件</span></span>
            }
            else
            {
                <span class="dt-kpi-value">不可用</span>
            }
        </div>
        <span class="dt-kpi-hint dt-kpi-hint-wide">@(_shiftHasSuccess ? $"{_shiftWindowText} · 总数 {_shiftTotal} 件 · 未判定 {_shiftNone}" : "统计暂不可用")</span>
        @if (_shiftHasSuccess)
        {
            <span class="dt-kpi-hint dt-kpi-hint-wide">@_shiftStopText <InfoHint Topic="HelpTexts.ShiftShortfall" /></span>
        }
        <span class="dt-kpi-updated">统计更新于 @(_shiftHasSuccess ? _shiftFetchedAt.ToString("HH:mm") : "暂无成功记录")</span>
    </div>
    <div class="dt-kpi-card">
        <div class="dt-kpi-main">
            <span class="dt-kpi-label">直通率<InfoHint Topic="HelpTexts.YieldRate" /></span>
            @if (_shiftHasSuccess)
            {
                <span class="dt-kpi-value">@_shiftYieldText</span>
                @* 百分比旁边给实际件数，说明统计样本基数。 *@
                <span class="dt-kpi-sub">OK @_shiftOk · NG @_shiftNg</span>
            }
            else
            {
                <span class="dt-kpi-value">不可用</span>
            }
        </div>
        @if (_shiftHasSuccess)
        {
            <span class="dt-kpi-hint dt-kpi-hint-wide">@_shiftDragText</span>
            <span class="dt-kpi-hint dt-kpi-hint-wide">@_shiftNgSourceText <InfoHint Topic="HelpTexts.NgSource" /></span>
            @if (!string.IsNullOrEmpty(_shiftSideText))
            {
                <span class="dt-kpi-hint dt-kpi-hint-wide">@_shiftSideText</span>
            }
            @if (!string.IsNullOrEmpty(_shiftFirstNgText))
            {
                <span class="dt-kpi-hint dt-kpi-hint-wide">@_shiftFirstNgText <InfoHint Topic="HelpTexts.FirstNgStation" /></span>
            }
            @if (!string.IsNullOrEmpty(_shiftClearanceText))
            {
                <span class="dt-kpi-hint dt-kpi-hint-wide">@_shiftClearanceText <InfoHint Topic="HelpTexts.SpecClearance" /></span>
            }
        }
        else
        {
            <span class="dt-kpi-hint dt-kpi-hint-wide">统计暂不可用</span>
        }
        <span class="dt-kpi-updated">统计更新于 @(_shiftHasSuccess ? _shiftFetchedAt.ToString("HH:mm") : "暂无成功记录")</span>
    </div>
    <div class="dt-kpi-card">
        <div class="dt-kpi-main">
            <span class="dt-kpi-label">当前工单<InfoHint Topic="HelpTexts.WorkOrderScope" /></span>
            @if (_workOrderLoadFailed && _workOrderFetchedAt == DateTime.MinValue)
            {
                <span class="dt-kpi-value">—</span>
            }
            else if (_currentWorkOrder is { } current)
            {
                <span class="dt-kpi-value">@current.Code</span>
            }
            else
            {
                <span class="dt-kpi-value">无</span>
            }
        </div>
        @if (_currentWorkOrder is { } currentWorkOrder)
        {
            <span class="dt-kpi-hint dt-kpi-hint-wide">
                @WorkOrderModel(currentWorkOrder)
                · @(currentWorkOrder.Recipe?.Name ?? "未指定型号")
                · 计划 @(currentWorkOrder.PlannedQuantity?.ToString() ?? "—") 件
            </span>
            @if (WorkOrderModelMismatchText is { } mismatchText)
            {
                <span class="dt-kpi-hint dt-kpi-hint-wide">注意：@mismatchText</span>
            }
            @if (WorkOrderProgressText is { } progressText)
            {
                <span class="dt-kpi-hint dt-kpi-hint-wide">@progressText <InfoHint Topic="HelpTexts.WorkOrderProgress" /></span>
            }
        }
        else
        {
            <span class="dt-kpi-hint dt-kpi-hint-wide">
                @(_workOrderLoadFailed ? "工单档案读取失败，稍后自动重试" : "未指定当前工单（在工单管理里点「设为当前」）")
            </span>
        }
        <span class="dt-kpi-updated">
            @(_workOrderLoadFailed
                ? (_workOrderFetchedAt == DateTime.MinValue ? "工单读取失败" : $"工单读取失败，上次 {_workOrderFetchedAt:HH:mm}")
                : (_workOrderFetchedAt == DateTime.MinValue ? "暂无工单数据" : $"工单更新于 {_workOrderFetchedAt:HH:mm}"))
        </span>
    </div>
    <div class="dt-kpi-card dt-kpi-card-chart">
        <div class="dt-kpi-main">
            <span class="dt-kpi-label">本班 NG<InfoHint Topic="HelpTexts.StationNg" /></span>
            @if (_stationNgUnavailable)
            {
                <span class="dt-kpi-value">—</span>
            }
            else
            {
                <span class="dt-kpi-value dt-kpi-value-alert">@_ngTotal</span>
            }
        </div>
        @if (!_stationNgUnavailable && _ngBars.Count > 0)
        {
            <div class="dt-kpi-chart dt-ng-chart" role="img" aria-label="@($"按工站 NG 数量：{_ngSummary}")">
                @foreach (var bar in _ngBars)
                {
                    <div class="dt-ng-bar">
                        <span class="dt-ng-bar-value">@bar.Ng</span>
                        <div class="dt-ng-bar-track">
                            <div class="dt-ng-bar-fill" style="@($"height:{NgBarHeight(bar.Ng)}px")"></div>
                        </div>
                        <span class="dt-ng-bar-label">@bar.StationCode</span>
                    </div>
                }
            </div>
        }
        <span class="dt-kpi-hint dt-kpi-hint-wide">@(_stationNgUnavailable ? "统计暂不可用" : _ngSummary)</span>
    </div>
</div>
@if (_shiftError)
{
    <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="dt-kpi-error mb-3"
              role="status" aria-live="polite">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
            <span>@(_shiftHasSuccess ? $"统计更新失败，以下为 {_shiftFetchedAt:HH:mm} 的结果。" : "统计更新失败，统计暂不可用。")</span>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                       Disabled="@_shiftBusy" OnClick="RetryShiftAsync">
                @(_shiftBusy ? "正在重试" : "重试统计")
            </MudButton>
        </MudStack>
    </MudAlert>
}
else
{
    <div class="dt-kpi-refresh">
        <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@_shiftBusy" OnClick="RetryShiftAsync">
            @(_shiftBusy ? "正在更新统计" : "刷新统计")
        </MudButton>
    </div>
}

@if (_dataStale)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Filled">
        连接中断或数据已停止更新，显示可能过期（采集心跳超过 @SystemDefaults.StaleHeartbeatSeconds 秒未刷新）。
    </MudAlert>
}

@if (!_collectEnabled)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        「启用采集」当前是关闭的：PLC 不再被扫描，看板数值与「最近采集」都不会再变化。需要恢复请到「系统设置」打开。
    </MudAlert>
}

@if (_spoolCount > 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        有 @_spoolCount 件采集记录写库失败，正在补传。@( _spoolOldest is DateTime spoolOldest ? $"最早一笔 {spoolOldest:HH:mm:ss}。" : "")
        超过 @SystemDefaults.SpoolBacklogWarnMinutes 分钟仍未入库时，所有页面会响铃，直到有人接手。
    </MudAlert>
}

@foreach (var plc in _plcs.Where(p => !p.Connected || !string.IsNullOrEmpty(p.LastError)))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        @plc.Name 断开@(string.IsNullOrEmpty(plc.LastError) ? "" : $"：{plc.LastError}")
    </MudAlert>
}

@if (SecondaryAlertCount > 0)
{
    <MudExpansionPanels Class="mb-3 dt-dashboard-alerts" Dense="true" Elevation="0">
        <MudExpansionPanel Text="@($"其他运行提醒 · {SecondaryAlertCount}")">
            @if (_inProcessNote is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" Variant="Variant.Outlined">
                    @_inProcessNote
                </MudAlert>
            }
            @if (_backupStale && _isAdmin)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" Variant="Variant.Outlined">
                    数据库备份异常或超过 48 小时未成功，请到「系统设置」查看并立即备份。
                </MudAlert>
            }
            @if (_openSessions.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" Variant="Variant.Outlined">
                    @foreach (var session in _openSessions)
                    {
                        <div>托盘 @session.PalletCode（@(string.IsNullOrWhiteSpace(session.SerialNo) ? "无序列号" : session.SerialNo)）已在制 @session.OpenMinutes 分钟，停在 @session.StationCode，还没走到末站。</div>
                    }
                </MudAlert>
            }
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@if (_stations.Count == 0)
{
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h6" Class="mb-2">还没有可监控的工站</MudText>
        <MudText Typo="Typo.body2" Class="dt-muted mb-4">
            先到「PLC 连接」新增一台 PLC（也可先用内置模拟器），再到「工站配置」创建工站并配好触发地址、点位与曲线，
            看板就会实时显示每台工站的节拍与最近一次判定。
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/config/plc">
                去配置 PLC
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Science" Href="/simulate">
                用模拟器跑一遍
            </MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    var visibleStations = VisibleStations;
    <section aria-label="工站概况">
        <div class="dt-station-toolbar">
            <div class="dt-station-toolbar-heading">
                <h2>工站</h2>
                <span class="dt-station-toolbar-count">显示 @visibleStations.Count / @_stations.Count 台</span>
            </div>
            <div class="dt-station-toolbar-controls">
                @if (!ShopFloor)
                {
                    <MudTextField T="string" Value="_stationSearch" ValueChanged="OnStationSearchChanged"
                                  Label="查找工站" Placeholder="编号或名称" Immediate="true" Clearable="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" Class="dt-station-search"
                                  aria-label="按工站编号或名称查找" />
                    <div class="dt-station-filter-scroll">
                        <div class="dt-station-filters" role="group" aria-label="筛选工站状态">
                            @foreach (var filter in StationFilters)
                            {
                                <button type="button" class="dt-station-filter @(filter == StationFilter.Attention && FilterCount(filter) > 0 ? "dt-station-filter-alert" : null)"
                                        aria-pressed="@(filter == _selectedFilter ? "true" : "false")"
                                        @onclick="() => _selectedFilter = filter">
                                    @FilterLabel(filter) <span class="dt-station-filter-count">@FilterCount(filter)</span>
                                </button>
                            }
                        </div>
                    </div>
                }
                <div class="dt-station-view-mode" role="group" aria-label="工站显示方式">
                    <button type="button" class="dt-station-filter @(!_fullDetailMode ? "active" : null)"
                            aria-pressed="@(!_fullDetailMode ? "true" : "false")" @onclick="() => SetFullDetailModeAsync(false)">概览</button>
                    <button type="button" class="dt-station-filter @(_fullDetailMode ? "active" : null)"
                            aria-pressed="@(_fullDetailMode ? "true" : "false")" @onclick="() => SetFullDetailModeAsync(true)">详细监控</button>
                </div>
                <div class="dt-station-view-mode" role="group" aria-label="工站排序">
                    <button type="button" class="dt-station-filter"
                            aria-pressed="@(_pinAbnormal ? "true" : "false")"
                            @onclick="() => _pinAbnormal = !_pinAbnormal">异常置顶</button>
                </div>
            </div>
            <p class="dt-station-filter-note">需关注按工站故障、最近 NG 与点位异常统计工站，点它只看这些工站。异常置顶只在「全部」里把它们排到前面，关闭时仍按工艺顺序。过程报警数量在页面顶部报警栏单独显示。</p>
        </div>
        @if (visibleStations.Count == 0)
        {
            <div class="dt-station-empty" role="status">
                @StationEmptyText
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearStationFilters">清除搜索与筛选</MudButton>
            </div>
        }
        else
        {
            <MudGrid Class="dt-station-grid">
                @foreach (var station in visibleStations)
                {
                    <MudItem xs="12" md="@StationColumnMd" lg="@StationColumnLg">
                        <StationCard @key="station.StationId" Station="station" ShiftCounts="@StationShiftCounts(station.StationId)"
                                     ConfiguredCurves="@_configuredCurves.GetValueOrDefault(station.StationId)"
                                     Compact="@(!_fullDetailMode)"
                                     OnOpenDetails="@(() => OpenStationDetailsAsync(station))" />
                    </MudItem>
                }
            </MudGrid>
        }
    </section>
}

<MudExpansionPanels Class="mt-5 dt-recent-panels" Elevation="1" Dense="true">
    <MudExpansionPanel Class="dt-recent-panel"
                       Expanded="@RecentPanelExpanded"
                       ExpandedChanged="OnRecentExpandedChangedAsync"
                       Disabled="ShopFloor"
                       HideIcon="ShopFloor">
        <TitleContent>
            <div class="dt-recent-title">
                <MudText Typo="Typo.subtitle1" Class="mb-0">最近采集 · @_recentPreview.Count 条</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           EndIcon="@Icons.Material.Filled.ChevronRight" Href="/query"
                           Class="dt-recent-more"
                           @onclick:stopPropagation="true">
                    更多 → 数据查询
                </MudButton>
            </div>
        </TitleContent>
        <ChildContent>
            <MudTable Items="_recentPreview" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                      FixedHeader="true" Height="360px">

                <HeaderContent>
                    <MudTh Class="dt-nowrap">完成时间</MudTh>
                    <MudTh>工站</MudTh>
                    <MudTh>托盘码</MudTh>
                    <MudTh>流水号</MudTh>
                    <MudTh>型号</MudTh>
                    <MudTh>判定</MudTh>
                    <MudTh Class="dt-num">耗时</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="完成时间" Class="dt-nowrap">
                        @* 格子里只放时分秒，完整时间戳（含日期与毫秒）用 tooltip：
                           平板没有 hover，原生 title 等于把诊断要用的精度藏起来。 *@
                        <MudTooltip Text="@context.CompleteTime.ToString("yyyy-MM-dd HH:mm:ss.fff")">
                            <span>@context.CompleteTime.ToString("HH:mm:ss")</span>
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="工站">@context.StationCode</MudTd>
                    <MudTd DataLabel="托盘码">@context.PalletCode</MudTd>
                    <MudTd DataLabel="流水号">@context.SerialNo</MudTd>
                    <MudTd DataLabel="型号">@RecipeLabel(context.RecipeCode)</MudTd>
                    <MudTd DataLabel="判定">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(context.Judgement == Judgement.Ng ? Color.Error : context.Judgement == Judgement.Ok ? Color.Success : Color.Default)">
                            @DisplayLabels.JudgementText(context.Judgement)
                        </MudChip>
                        @if (!string.IsNullOrEmpty(context.Error))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">@context.Error</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="耗时" Class="dt-num dt-nowrap">@context.DurationMs ms</MudTd>
                    <MudTd DataLabel="操作">
                        <MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ChevronRight"
                                   Href="@($"/query/{context.MonthKey}/{context.RecordId}")">明细</MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="dt-muted pt-3">
                        还没有采集记录。可在「PLC 仿真」页触发一条走线，快速验证采集链路是否通畅。
                    </MudText>
                    @* 与上面工站空态一样给按钮：文案已经指了路，但同一页里
                       一个能给按钮、一个只能读字，看着像两套做法。 *@
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Science" Href="/simulate" Class="mb-3">
                        去 PLC 仿真
                    </MudButton>
                </NoRecordsContent>
            </MudTable>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private const int ShiftCacheSeconds = 15;
    /// <summary>页面级刷新节拍（毫秒）。</summary>
    private const int UiTickMs = 5000;

    /// <summary>
    /// 车间大屏开关由 MainLayout 统一持有（顶栏按钮在每页可达），这里只消费状态：
    /// 大屏时禁止展开「最近采集」，因为它只是巡线摘要，会挤掉工站卡片的版面。
    /// </summary>
    [CascadingParameter(Name = "ShopFloor")] private bool ShopFloor { get; set; }

    private bool _productionSimWarning;
    private bool _showSimulationDetails;
    private bool _backupStale;
    private bool _isAdmin;
    private bool _canManageRecipes;
    /// <summary>User preference for recent-collect panel (localStorage dtRecentOpen). Forced closed while shop-floor.</summary>
    private bool _recentOpenPref;
    private bool _dataStale;
    private bool _collectorHasBeat;
    private string _collectorAgeText = "等待采集心跳";

    private IReadOnlyList<PlcRuntimeStatus> _plcs = [];
    private IReadOnlyList<StationRuntimeStatus> _stations = [];
    /// <summary>工站顺序固定按产线工艺顺序，运行状态变化不会移动卡片。</summary>
    private IReadOnlyList<StationRuntimeStatus> _orderedStations = [];

    private Dictionary<int, IReadOnlyList<StationLiveCurve>> _configuredCurves = [];

    private async Task OpenStationDetailsAsync(StationRuntimeStatus station)
    {
        var parameters = new DialogParameters<StationDetailDialog>
        {
            { dialog => dialog.Station, station }
        };

    private void EvaluateStale()
    {
        // 采集关闭时用专用告警，不叠「数据过期」。
        if (!_collectEnabled)
        {
            _dataStale = false;
            return;
        }

        var collectorBeat = Status.LastCollectorAt;
        _collectorHasBeat = collectorBeat != DateTime.MinValue;
        if (!_collectorHasBeat)
        {
            _dataStale = true;
            _collectorAgeText = "等待采集心跳";
            return;
        }

        var age = DateTime.Now - collectorBeat;
        _dataStale = age.TotalSeconds > SystemDefaults.StaleHeartbeatSeconds;
        _collectorAgeText = age.TotalSeconds < 0
            ? "刚刚"
            : age.TotalSeconds < 5
                ? "刚刚"
                : age.TotalSeconds < 60
                    ? $"{(int)age.TotalSeconds} 秒前"
                    : age.TotalMinutes < 60
                        ? $"{(int)age.TotalMinutes} 分前"
                        : $"{(int)age.TotalHours} 小时前";
    }


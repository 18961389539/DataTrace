@page "/"
@attribute [Authorize]
@using DataTrace.Application.Alarms
@using DataTrace.Application.Backup
@using DataTrace.Application.Configuration
@using DataTrace.Application.Realtime
@using DataTrace.Application.Reporting
@using DataTrace.Application.Runtime
@using DataTrace.Domain
@using DataTrace.Domain.Constants
@using DataTrace.Domain.Enums
@implements IDisposable
@inject IRuntimeStatusHub Status
@inject IConfigRepository Config
@inject CustomerBrandingStore Branding
@inject IDatabaseBackupService BackupService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IReportService Reports
@inject ISpoolStore Spool
@inject IJSRuntime Js

<PageHeader Title="实时看板" HelpRoute="/">
    <ChildContent>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_stations.Count 台工站</MudChip>
        @if (_productionSimWarning)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                     Icon="@Icons.Material.Filled.Science" OnClick="ToggleSimulationDetails"
                     aria-expanded="@_showSimulationDetails" aria-controls="dt-simulation-details"
                     aria-label="@(_showSimulationDetails ? "收起模拟数据说明" : "查看模拟数据说明")">
                模拟数据
            </MudChip>
        }
        <LiveCadenceChip LastBeat="LastBeat" FreshnessText="@FreshnessText"
                         FreshnessColor="@FreshnessColor" FreshnessIcon="@FreshnessIcon" />

        @if (CanManageRecipes)
        {
            <MudChip T="string" Size="Size.Small" Color="@(string.IsNullOrEmpty(Status.ActiveRecipeCode) ? Color.Default : Color.Primary)"
                     Variant="Variant.Filled" OnClick="GoRecipes" Style="cursor:pointer">
                @ActiveRecipeLabel
            </MudChip>
        }
        else
        {
            <MudChip T="string" Size="Size.Small" Color="@(string.IsNullOrEmpty(Status.ActiveRecipeCode) ? Color.Default : Color.Primary)"
                     Variant="Variant.Filled">
                @ActiveRecipeLabel
            </MudChip>
        }

    </ChildContent>
    <Actions>
        <MudText Typo="Typo.caption" Class="@(_dataStale ? "dt-clock-stale" : "dt-muted")"
                 aria-label="@(_dataStale ? "本地时钟不代表数据仍在更新" : null)">
            PLC @_plcs.Count(p => p.Connected)/@_plcs.Count
            · 采集中 @_stations.Count(s => s.State == StationRuntimeState.Busy)
            · <LiveClock />
        </MudText>
        <InfoHint Topic="HelpTexts.StaleData" />
    </Actions>
</PageHeader>

@if (_inProcessNote is not null)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        @_inProcessNote
    </MudAlert>
}

@if (_productionSimWarning && _showSimulationDetails)
{
    <div id="dt-simulation-details">
        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined"
                  Class="dt-simulation-detail mb-3">
            <div class="dt-simulation-detail-content">
                <MudText Typo="Typo.body2" Class="dt-simulation-detail-text">
                    当前已开启「启动后自动跑仿真」。看板与采集记录来自内置模拟器，不代表真实产线。
                </MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                           EndIcon="@Icons.Material.Filled.ChevronRight" Href="/simulate">
                    前往 PLC 仿真
                </MudButton>
            </div>
        </MudAlert>
    </div>
}

@* KPI 独立成条：跟页头的状态芯片平铺在一起时它们权重相同，扫一眼分不出主次。
   本班完成的口径与三态判定的说明跟着各自的 ⓘ 走。 *@
<div class="dt-kpi-bar">
    <div class="dt-kpi-card">
        <div class="dt-kpi-main">
            <span class="dt-kpi-label">本班完成<InfoHint Topic="HelpTexts.TodayScope" /></span>
            <span class="dt-kpi-value">@_shiftTotal <span class="dt-kpi-unit">件</span></span>
        </div>
        <span class="dt-kpi-hint">@_shiftWindowText · OK @_shiftOk · 未判定 @_shiftNone</span>
        <span class="dt-kpi-hint dt-kpi-hint-wide">@_shiftStopText <InfoHint Topic="HelpTexts.ShiftShortfall" /></span>
    </div>
    <div class="dt-kpi-card">
        <div class="dt-kpi-main">
            <span class="dt-kpi-label">直通率<InfoHint Topic="HelpTexts.YieldRate" /></span>
            <span class="dt-kpi-value">@_shiftYieldText</span>
            @* 百分比旁边给实际件数：只有一个百分比，看不出它是拿 3 件还是 3000 件算出来的。 *@
            <span class="dt-kpi-sub">OK @_shiftOk · NG @_shiftNg</span>
        </div>
        <span class="dt-kpi-hint">@_shiftDragText</span>
        @if (!string.IsNullOrEmpty(_shiftSideText))
        {
            <span class="dt-kpi-hint">@_shiftSideText</span>
        }
        @if (!string.IsNullOrEmpty(_shiftFirstNgText))
        {
            <span class="dt-kpi-hint">@_shiftFirstNgText <InfoHint Topic="HelpTexts.FirstNgStation" /></span>
        }
        @if (!string.IsNullOrEmpty(_shiftClearanceText))
        {
            <span class="dt-kpi-hint dt-kpi-hint-wide">@_shiftClearanceText <InfoHint Topic="HelpTexts.SpecClearance" /></span>
        }
    </div>
    <div class="dt-kpi-card">
        <div class="dt-kpi-main">
            <span class="dt-kpi-label">本班 NG<InfoHint Topic="HelpTexts.JudgementThreeState" /></span>
            <span class="dt-kpi-value dt-kpi-value-alert">@_shiftNg</span>
        </div>
        <span class="dt-kpi-hint dt-kpi-hint-wide">@_shiftNgSourceText <InfoHint Topic="HelpTexts.NgSource" /></span>
    </div>
    <div class="dt-kpi-card">
        <div class="dt-kpi-main">
            <span class="dt-kpi-label">当前间隔<InfoHint Topic="HelpTexts.PieceGap" /></span>
            <span class="dt-kpi-value">@PaceText</span>
        </div>
        <span class="dt-kpi-hint">@PaceHint</span>
    </div>
</div>

@if (_dataStale)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Filled">
        连接中断或数据已停止更新，显示可能过期（采集心跳超过 @SystemDefaults.StaleHeartbeatSeconds 秒未刷新）。
    </MudAlert>
}

@if (_backupStale && _isAdmin)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        数据库备份异常或超过 48 小时未成功，请到「系统设置」查看并立即备份。
    </MudAlert>
}

@if (!_collectEnabled)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        「启用采集」当前是关闭的：PLC 不再被扫描，看板数值与「最近采集」都不会再变化。需要恢复请到「系统设置」打开。
    </MudAlert>
}

@if (_spoolCount > 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        有 @_spoolCount 件采集记录写库失败，正在补传。@( _spoolOldest is DateTime spoolOldest ? $"最早一笔 {spoolOldest:HH:mm:ss}。" : "")
        超过 @SystemDefaults.SpoolBacklogWarnMinutes 分钟仍未入库时，所有页面会响铃，直到有人接手。
    </MudAlert>
}

@if (_openSessions.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        @foreach (var session in _openSessions)
        {
            <div>托盘 @session.PalletCode（@(string.IsNullOrWhiteSpace(session.SerialNo) ? "无序列号" : session.SerialNo)）已在制 @session.OpenMinutes 分钟，停在 @session.StationCode，还没走到末站。</div>
        }
    </MudAlert>
}

@foreach (var plc in _plcs.Where(p => !p.Connected || !string.IsNullOrEmpty(p.LastError)))
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        @plc.Name 断开@(string.IsNullOrEmpty(plc.LastError) ? "" : $"：{plc.LastError}")
    </MudAlert>
}

@if (_stations.Count == 0)
{
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h6" Class="mb-2">还没有可监控的工站</MudText>
        <MudText Typo="Typo.body2" Class="dt-muted mb-4">
            先到「PLC 连接」新增一台 PLC（也可先用内置模拟器），再到「工站配置」创建工站并配好触发地址、点位与曲线，
            看板就会实时显示每台工站的节拍与最近一次判定。
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/config/plc">
                去配置 PLC
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Science" Href="/simulate">
                用模拟器跑一遍
            </MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    <MudGrid Class="dt-station-grid">
        @foreach (var station in _orderedStations)
        {
            <MudItem xs="12" md="6" lg="4">
                <StationCard Station="station" />
            </MudItem>
        }
    </MudGrid>
}


<MudExpansionPanels Class="mt-5 dt-recent-panels" Elevation="1" Dense="true">
    <MudExpansionPanel Class="dt-recent-panel"
                       Expanded="@RecentPanelExpanded"
                       ExpandedChanged="OnRecentExpandedChangedAsync"
                       Disabled="ShopFloor"
                       HideIcon="ShopFloor">
        <TitleContent>
            <div class="dt-recent-title">
                <MudText Typo="Typo.subtitle1" Class="mb-0">最近采集 · @_recentPreview.Count 条</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           EndIcon="@Icons.Material.Filled.ChevronRight" Href="/query"
                           Class="dt-recent-more"
                           @onclick:stopPropagation="true">
                    更多 → 数据查询
                </MudButton>
            </div>
        </TitleContent>
        <ChildContent>
            <MudTable Items="_recentPreview" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                      FixedHeader="true" Height="360px">

                <HeaderContent>
                    <MudTh Class="dt-nowrap">完成时间</MudTh>
                    <MudTh>工站</MudTh>
                    <MudTh>托盘码</MudTh>
                    <MudTh>流水号</MudTh>
                    <MudTh>型号</MudTh>
                    <MudTh>判定</MudTh>
                    <MudTh Class="dt-num">耗时</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="完成时间" Class="dt-nowrap">
                        @* 格子里只放时分秒，完整时间戳（含日期与毫秒）用 tooltip：
                           平板没有 hover，原生 title 等于把诊断要用的精度藏起来。 *@
                        <MudTooltip Text="@context.CompleteTime.ToString("yyyy-MM-dd HH:mm:ss.fff")">
                            <span>@context.CompleteTime.ToString("HH:mm:ss")</span>
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="工站">@context.StationCode</MudTd>
                    <MudTd DataLabel="托盘码">@context.PalletCode</MudTd>
                    <MudTd DataLabel="流水号">@context.SerialNo</MudTd>
                    <MudTd DataLabel="型号">@RecipeLabel(context.RecipeCode)</MudTd>
                    <MudTd DataLabel="判定">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(context.Judgement == Judgement.Ng ? Color.Error : context.Judgement == Judgement.Ok ? Color.Success : Color.Default)">
                            @DisplayLabels.JudgementText(context.Judgement)
                        </MudChip>
                        @if (!string.IsNullOrEmpty(context.Error))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">@context.Error</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="耗时" Class="dt-num dt-nowrap">@context.DurationMs ms</MudTd>
                    <MudTd DataLabel="操作">
                        <MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ChevronRight"
                                   Href="@($"/query/{context.MonthKey}/{context.RecordId}")">明细</MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="dt-muted pt-3">
                        还没有采集记录。可在「PLC 仿真」页触发一条走线，快速验证采集链路是否通畅。
                    </MudText>
                    @* 与上面工站空态一样给按钮：文案已经指了路，但同一页里
                       一个能给按钮、一个只能读字，看着像两套做法。 *@
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Science" Href="/simulate" Class="mb-3">
                        去 PLC 仿真
                    </MudButton>
                </NoRecordsContent>
            </MudTable>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private const int ShiftCacheSeconds = 15;
    /// <summary>页面级刷新节拍（毫秒）。</summary>
    private const int UiTickMs = 5000;

    /// <summary>
    /// 车间大屏开关由 MainLayout 统一持有（顶栏按钮在每页可达），这里只消费状态：
    /// 大屏时禁止展开「最近采集」，因为它只是巡线摘要，会挤掉工站卡片的版面。
    /// </summary>
    [CascadingParameter(Name = "ShopFloor")] private bool ShopFloor { get; set; }

    private bool _productionSimWarning;
    private bool _showSimulationDetails;
    private bool _backupStale;
    private bool _isAdmin;
    private bool _canManageRecipes;
    /// <summary>User preference for recent-collect panel (localStorage dtRecentOpen). Forced closed while shop-floor.</summary>
    private bool _recentOpenPref;
    private bool _dataStale;
    private bool _collectorHasBeat;
    private string _collectorAgeText = "等待采集心跳";

    private IReadOnlyList<PlcRuntimeStatus> _plcs = [];
    private IReadOnlyList<StationRuntimeStatus> _stations = [];
    /// <summary>渲染用的工站顺序：异常在前，同级按工艺顺序（见 <see cref="SeverityRank"/>）。</summary>
    private IReadOnlyList<StationRuntimeStatus> _orderedStations = [];
    private IReadOnlyList<CollectFeedItem> _recent = [];
    private IReadOnlyList<CollectFeedItem> _recentPreview = [];
    private bool _collectEnabled = true;
    private int _spoolCount;
    private DateTime? _spoolOldest;
    private IReadOnlyList<OpenSessionNotice> _openSessions = [];
    private string? _inProcessNote;
    private string _shiftWindowText = ShiftWindow.Containing(DateTime.Now, SystemDefaults.ShiftStartHour, SystemDefaults.ShiftLengthHours).Label;
    private string _shiftDragText = "";
    private string _shiftSideText = "";
    private string _shiftFirstNgText = "";
    private string _shiftClearanceText = "";
    private string _shiftNgSourceText = "";
    private string _shiftStopText = "";
    private DateTime _shiftWindowStart;

    private int _shiftTotal;
    private int _shiftOk;
    private int _shiftNg;
    private int _shiftQualityNg;
    private int _shiftCollectNg;
    private int _shiftNone;
    private string _shiftYieldText = "—";
    private DateTime _shiftFetchedAt = DateTime.MinValue;
    private bool _shiftBusy;
    private int _configVersion = -1;
    private Timer? _uiTimer;

    private void ToggleSimulationDetails() => _showSimulationDetails = !_showSimulationDetails;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var snap = await Config.GetSnapshotAsync();
            _configVersion = snap.Version;
            _collectEnabled = snap.Settings.CollectEnabled;
            _productionSimWarning = Branding.EnvironmentName.Equals("Production", StringComparison.OrdinalIgnoreCase)
                && snap.Settings.SimulatorAutoRun;

            try
            {
                var auth = await AuthState.GetAuthenticationStateAsync();
                _isAdmin = auth.User?.IsInRole("Administrator") == true;
                _canManageRecipes = _isAdmin || auth.User?.IsInRole("Engineer") == true;
                var bak = BackupService.GetStatus();
                _backupStale = bak.IsStaleOrFailed(TimeSpan.FromHours(SystemDefaults.BackupStaleHours));
            }
            catch
            {
                _backupStale = false;
            }
        }
        catch
        {
            // best-effort
        }

        Refresh();
        await RefreshSpoolAsync();
        EvaluateStale();
        Status.Changed += OnChanged;
        // 5 秒一跳：这一跳只做"轻活"（比版本号 + 推进卡片上的相对时间），
        // 时钟与节拍芯片各自有 1 秒计时器，不受这里影响。
        _uiTimer = new Timer(_ => _ = InvokeAsync(OnUiTickAsync), null, UiTickMs, UiTickMs);
        await RefreshShiftAsync(force: true);
    }

        protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Default false (collapsed) when unset — matches dtRecentOpen.get
        try
        {
            _recentOpenPref = await Js.InvokeAsync<bool>("dtRecentOpen.get");
            StateHasChanged();
        }
        catch
        {
            // JS not ready: keep defaults (recent collapsed)
        }
    }
    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        // 这里只碰内存里的运行时快照。配置快照（GetSnapshotAsync 要拉整条
        // 工站→点位/曲线/序列/判据 与 型号→限值 的关联链）挪到下面的定时跳里按版本号比对，
        // 否则采集侧每秒推好几次事件，这条重查询就跟着跑好几次。
        Refresh();
        await RefreshSpoolAsync();
        await RefreshShiftAsync(force: false);
        EvaluateStale();
        StateHasChanged();
    });

    private async Task OnUiTickAsync()
    {
        EvaluateStale();
        await RefreshSpoolAsync();
        try
        {
            var ver = await Config.GetVersionAsync();
            if (ver != _configVersion)
            {
                _configVersion = ver;
                await RefreshConfigAlertsAsync();
                await RefreshShiftAsync(force: true);
            }
            else if ((DateTime.Now - _shiftFetchedAt).TotalSeconds >= ShiftCacheSeconds)
            {
                await RefreshShiftAsync(force: false);
            }
        }
        catch
        {
            // ignore tick errors
        }

        // 这一跳还得重画：卡片上的「30 秒前」只能靠它推进 —— hub 只在状态真的变了时才推事件，
        // 停机（或采集关闭）之后就没有事件了，不重画的话那些相对时间会一直冻在最后一次采集上。
        StateHasChanged();
    }

    private async Task RefreshSpoolAsync()
    {
        try
        {
            var spool = await Spool.DescribeAsync();
            _spoolCount = spool.Count;
            _spoolOldest = spool.OldestAt;
        }
        catch
        {
            // 目录暂时读不到时保留上次数字，下一跳再试。
        }
    }

    private void EvaluateStale()
    {
        // 采集关闭时用专用告警，不叠「数据过期」。
        if (!_collectEnabled)
        {
            _dataStale = false;
            return;
        }

        var collectorBeat = Status.LastCollectorAt;
        _collectorHasBeat = collectorBeat != DateTime.MinValue;
        if (!_collectorHasBeat)
        {
            _dataStale = true;
            _collectorAgeText = "等待采集心跳";
            return;
        }

        var age = DateTime.Now - collectorBeat;
        _dataStale = age.TotalSeconds > SystemDefaults.StaleHeartbeatSeconds;
        _collectorAgeText = age.TotalSeconds < 0
            ? "刚刚"
            : age.TotalSeconds < 5
                ? "刚刚"
                : age.TotalSeconds < 60
                    ? $"{(int)age.TotalSeconds} 秒前"
                    : age.TotalMinutes < 60
                        ? $"{(int)age.TotalMinutes} 分前"
                        : $"{(int)age.TotalHours} 小时前";
    }

    private async Task RefreshConfigAlertsAsync()
    {
        try
        {
            var snap = await Config.GetSnapshotAsync();
            _configVersion = snap.Version;
            _collectEnabled = snap.Settings.CollectEnabled;
            _productionSimWarning = Branding.EnvironmentName.Equals("Production", StringComparison.OrdinalIgnoreCase)
                && snap.Settings.SimulatorAutoRun;
        }
        catch
        {
            // 配置读不出来就不下结论
        }
    }

    private async Task RefreshShiftAsync(bool force)
    {
        if (_shiftBusy) return;

        AppConfigurationSnapshot? snap = null;
        try
        {
            snap = await Config.GetSnapshotAsync();
        }
        catch
        {
            // 班次读不出来就用上次的窗口
        }

        var startHour = snap?.Settings.ShiftStartHour ?? SystemDefaults.ShiftStartHour;
        var lengthHours = snap?.Settings.ShiftLengthHours ?? SystemDefaults.ShiftLengthHours;
        var window = ShiftWindow.Containing(DateTime.Now, startHour, lengthHours);
        if (!force && window.Start == _shiftWindowStart && (DateTime.Now - _shiftFetchedAt).TotalSeconds < ShiftCacheSeconds) return;

        _shiftBusy = true;
        try
        {
            var yieldTask = Reports.GetPieceYieldAsync(window.Start, window.End.AddTicks(-1), null);
            var stopTask = Reports.GetShiftStopsAsync(window.Start, window.End.AddTicks(-1));
            await Task.WhenAll(yieldTask, stopTask);
            var report = await yieldTask;
            var stops = await stopTask;
            _shiftTotal = report.ByShift.Sum(row => row.Total);
            _shiftOk = report.ByShift.Sum(row => row.Ok);
            _shiftNg = report.ByShift.Sum(row => row.Ng);
            _shiftQualityNg = report.ByShift.Sum(row => row.QualityNg);
            _shiftCollectNg = report.ByShift.Sum(row => row.CollectNg);
            _shiftNone = report.ByShift.Sum(row => row.None);
            _shiftYieldText = _shiftOk + _shiftNg == 0 ? "—" : ((double)_shiftOk / (_shiftOk + _shiftNg)).ToString("P1");
            _shiftNgSourceText = PieceYieldRules.NgSourceText(_shiftQualityNg, _shiftCollectNg);
            _shiftDragText = _shiftTotal == 0
                ? "本班还没有走完的件"
                : _shiftOk + _shiftNg == 0
                    ? "走完的件都还没有判定"
                    : report.Drag?.Text
                      ?? (_shiftCollectNg > 0 ? "没有点位超差，不合格来自没采成" : "本班没有不合格件");
            _shiftSideText = report.Drag?.SideText ?? "";
            _shiftFirstNgText = report.FirstNg?.Text ?? "";
            _shiftClearanceText = report.Clearance?.Text ?? "";
            _shiftStopText = stops.ByShift.FirstOrDefault(row => row.ShiftStart == window.Start)?.Detail
                ?? "本班各站没有明显停顿";
            _shiftWindowText = window.Label;
            _shiftWindowStart = window.Start;
            _shiftFetchedAt = DateTime.Now;
        }
        catch
        {
            // 报表失败时保留上次数字
        }
        finally
        {
            _shiftBusy = false;
        }
    }

    private void Refresh()
    {
        _plcs = Status.Plcs;
        _stations = Status.Stations;
        // 排序在这里做一次，而不是写在 foreach 里：定时跳每 5 秒重画一次，
        // 内联排序就会跟着每 5 秒重排一遍。
        _orderedStations = _stations.OrderBy(SeverityRank).ThenBy(s => s.Sequence).ToList();
        _recent = Status.Recent;
        _openSessions = Status.OpenSessions;
        _inProcessNote = InProcessRecipes.Note(Status.ActiveRecipeCode, Status.InProcessRecipes ?? []);
        // 看板只展示最近十余条，完整历史去「数据查询」，避免表格占满整屏。
        _recentPreview = _recent.Take(12).ToList();
    }

    private DateTime? LastBeat => _stations.Select(s => s.LastCompleteTime).Max();

    private Color FreshnessColor => !_collectEnabled
        ? Color.Warning
        : _dataStale ? Color.Error : Color.Success;

    private string FreshnessIcon => !_collectEnabled
        ? Icons.Material.Filled.Pause
        : _dataStale ? Icons.Material.Filled.Warning : Icons.Material.Filled.CheckCircle;

    private string FreshnessText => !_collectEnabled
        ? "采集已暂停"
        : !_collectorHasBeat
            ? "等待采集心跳"
            : _dataStale
            ? $"心跳超时 · {_collectorAgeText}"
            : $"心跳正常 · {_collectorAgeText}";

    /// <summary>当前间隔：同一工站相邻两件的完成间隔里，最长的那一站。还没有两件时给「—」。</summary>
    private StationPaceRules.Pace? CurrentPace => StationPaceRules.Slowest(
        _stations.Select(station => new StationPaceRules.Sample(
            station.StationCode,
            station.Sequence,
            station.State != StationRuntimeState.Disabled,
            station.LastPieceGap)));

    private string PaceText => CurrentPace?.Text ?? "—";

    private string PaceHint => CurrentPace?.Hint ?? "还没有相邻的两件";

    /// <summary>
    /// 工站严重度：故障 → NG → 采集中 → 空闲 → 停用。看板上最该被看见的工位排在最前，
    /// 否则一台 NG 可能落在最后一屏，大屏上等于没有报警。
    /// </summary>
    private static int SeverityRank(StationRuntimeStatus station)
    {
        // 停用先判：停用工位的 LastJudgement 还留着最后一次判定，
        // 晚了它就会顶着上一次的 NG 挤到最前面，反而误导。
        if (station.State == StationRuntimeState.Disabled) return 4;
        if (station.State == StationRuntimeState.Fault) return 0;
        if (station.State == StationRuntimeState.Busy) return 2;
        return station.LastJudgement == Judgement.Ng ? 1 : 3;
    }

    private bool CanManageRecipes => _canManageRecipes;

    private string ActiveRecipeLabel
    {
        get
        {
            var next = InProcessRecipes.Display(Status.ActiveRecipeCode);
            if (!string.IsNullOrEmpty(Status.ActiveRecipeName))
            {
                next = $"{Status.ActiveRecipeCode}（{Status.ActiveRecipeName}）";
            }

            return _inProcessNote is null
                ? (string.IsNullOrEmpty(Status.ActiveRecipeCode) ? "未选择型号·按点位默认限值" : $"当前型号 {next}")
                : $"下一件起 {next}";
        }
    }

    private static string RecipeLabel(string? code)
        => string.IsNullOrEmpty(code) ? "未选型号" : code;

    private void GoRecipes() => Nav.NavigateTo("/config/recipes");

    /// <summary>Effective expand state: always collapsed in shop-floor; otherwise user preference.</summary>
    private bool RecentPanelExpanded => !ShopFloor && _recentOpenPref;

    private async Task OnRecentExpandedChangedAsync(bool open)
    {
        if (ShopFloor)
        {
            return;
        }

        _recentOpenPref = open;
        try
        {
            await Js.InvokeVoidAsync("dtRecentOpen.set", open);
        }
        catch
        {
            // preference write best-effort
        }
    }

    public void Dispose()
    {
        Status.Changed -= OnChanged;
        _uiTimer?.Dispose();
    }
}

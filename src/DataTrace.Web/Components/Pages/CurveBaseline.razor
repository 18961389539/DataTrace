@page "/curve-baseline"
@attribute [Authorize]
@implements IAsyncDisposable
@using System.Globalization
@using DataTrace.Application.Configuration
@using DataTrace.Application.Evaluation
@using DataTrace.Application.Reporting
@using DataTrace.Domain.Entities
@using DataTrace.Domain.Enums
@using DataTrace.Domain.Evaluation
@inject ICurveTemplateService TemplateService
@inject IConfigRepository Config
@inject ICurveBaselineCache BaselineCache
@inject DtToast Toast

<PageHeader Title="波形基线" Description="用较早的 OK 波形建基线，最近样本独立评估" HelpRoute="curve-baseline">
    <ChildContent>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">
            @(_recipeCode == "" ? "未选型号（默认限值）" : $"型号 {_recipeCode}")
        </MudChip>
        <MudTooltip Text="采集流水线用它给每条新波形打分（只记录，不参与判定）">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                     Color="@OnlineCacheColor">
                在线基线 @CacheText()
            </MudChip>
        </MudTooltip>
        <InfoHint Topic="HelpTexts.OnlineBaseline" />
    </ChildContent>
</PageHeader>

<MudPaper Class="dt-filter-card dt-baseline-filter-card mb-3">
    <div class="dt-baseline-range">
        <DateRangeFilter @bind-From="_from" @bind-To="_to" OnRangeChanged="Load" />
    </div>

    <div class="dt-baseline-selectors">
        <div class="dt-baseline-select">
            <MudSelect T="int?" Value="_stationId" ValueChanged="OnStationChanged" Label="工站">
                @foreach (var s in _stations)
                {
                    <MudSelectItem T="int?" Value="@s.Id">@s.Code @s.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="dt-baseline-select">
            <MudSelect T="int" Value="_curveId" ValueChanged="OnCurveChanged" Label="曲线">
                @foreach (var c in _curves)
                {
                    <MudSelectItem T="int" Value="@c.Id">@c.Code @c.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="dt-baseline-select">
            <MudTooltip Text="主序列按优先 Y 角色选择">
                <MudSelect T="string" Value="_seriesName" ValueChanged="OnSeriesChanged" Label="序列">
                <MudSelectItem T="string" Value="@PrimarySeries">（主序列）</MudSelectItem>
                @foreach (var name in _seriesNames)
                {
                    <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
                }
                </MudSelect>
            </MudTooltip>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Load" Disabled="_loading"
                   StartIcon="@Icons.Material.Filled.Refresh" Class="dt-baseline-run">
            @(_loading ? "分析中…" : "刷新分析")
        </MudButton>
    </div>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}

@if (_report is null)
{
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.body2" Class="dt-muted">
            @if (_loading)
            {
                <span>正在分析当前筛选条件…</span>
            }
            else if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <span>分析未完成：@_loadError</span>
            }
            else if (_curveId == 0)
            {
                <span>当前工站没有可分析的曲线。</span>
            }
            else
            {
                <span>当前条件暂无基线报告。</span>
            }
        </MudText>
    </MudPaper>
}
else
{
    <MudGrid>
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h6">@_report.CurveCode @_report.CurveName · @_report.SeriesName</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@TemplateColor(_report.Template.IsReliable)">
                        @(_report.Template.IsReliable ? "基线可用" : "基线不可用")
                    </MudChip>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Class="dt-muted">
                        @(string.IsNullOrEmpty(_report.Unit) ? "" : $"单位 {_report.Unit} 　")
                        取到 @_report.TotalSampleCount 条样本 · 本型号 NG @_report.NgCount 条 ·
                        未判定 @_report.UnjudgedCount 条
                    </MudText>
                </MudStack>

                @if (!string.IsNullOrEmpty(_report.EmptyReason))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@_report.EmptyReason</MudAlert>
                }

                <div class="dt-baseline-summary-strip">
                    <span class="dt-baseline-summary-item">
                        <span>基线样本</span><strong>@_report.BaselineSampleCount</strong>
                    </span>
                    <span class="dt-baseline-summary-item">
                        <span>参与维度</span>
                        <strong>@_report.Template.ScorableDimensionCount / @_report.Template.Dimensions.Count</strong>
                    </span>
                    <span class="dt-baseline-summary-item">
                        <span>近期评分</span>
                        <strong>@_report.Recent.Count</strong>
                        <InfoHint Topic="HelpTexts.BaselineSampleCounts" />
                    </span>
                    <span class="dt-baseline-summary-item @(_report.AbnormalCount > 0 ? "dt-baseline-summary-error" : "")">
                        <span>异常</span><strong>@_report.AbnormalCount</strong>
                    </span>
                    <span class="dt-baseline-summary-item @(_report.SuspiciousCount > 0 ? "dt-baseline-summary-warning" : "")">
                        <span>可疑</span><strong>@_report.SuspiciousCount</strong>
                    </span>
                    <span class="dt-baseline-summary-item @(_report.MismatchedRecipeCount > 0 ? "dt-baseline-summary-warning" : "")">
                        <span>型号不匹配</span>
                        <strong>@_report.MismatchedRecipeCount</strong>
                        <InfoHint Topic="HelpTexts.RecipeMismatch" />
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(_report.Template.Note))
                {
                    <MudText Typo="Typo.caption" Class="dt-muted mb-2">@_report.Template.Note</MudText>
                }

                <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">基线维度 · 中位数与正常范围</MudText>
                <MudTable Items="_report.Template.Dimensions" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                          Class="dt-baseline-dimensions">
                    <HeaderContent>
                        <MudTh>维度</MudTh>
                        <MudTh>基线</MudTh>
                        <MudTh>正常范围（±3σ）</MudTh>
                        <MudTh>状态</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="维度">@CurveFeatureDimensions.Label(context.Dimension)</MudTd>
                        <MudTd DataLabel="基线">@Num(context.Center)</MudTd>
                        <MudTd DataLabel="正常范围（±3σ）">@(context.IsConstant ? "—" : $"{Num(context.LowerBound)} ~ {Num(context.UpperBound)}")</MudTd>
                        <MudTd DataLabel="状态">
                            @if (context.IsConstant)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">恒定</MudChip>
                            }
                            else if (context.IsScorable)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success">参与</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">不参与</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                @if (_report.Template.Dimensions.Count > 0)
                {
                    <MudExpansionPanels Elevation="0" Class="dt-baseline-dimension-details">
                        <MudExpansionPanel Text="展开离散度、历史范围与离群样本">
                            <MudTable Items="_report.Template.Dimensions" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                                <HeaderContent>
                                    <MudTh>维度</MudTh>
                                    <MudTh>离散度 σ</MudTh>
                                    <MudTh>历史范围</MudTh>
                                    <MudTh>离群样本</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="维度">@CurveFeatureDimensions.Label(context.Dimension)</MudTd>
                                    <MudTd DataLabel="离散度 σ">@(context.IsConstant ? "—" : Num(context.Sigma))</MudTd>
                                    <MudTd DataLabel="历史范围">@Num(context.Min) ~ @Num(context.Max)</MudTd>
                                    <MudTd DataLabel="离群样本">@(context.OutlierCount > 0 ? context.OutlierCount.ToString() : "—")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">最近 @_report.Recent.Count 条波形的偏离</MudText>
                @if (_report.Recent.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="dt-muted py-3">该区间内没有可打分的样本。</MudText>
                }
                else
                {
                    <MudTable T="CurveTemplateScore" Items="_report.Recent" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                              @bind-SelectedItem="_selected" MultiSelection="false">
                        <HeaderContent>
                            <MudTh>时间</MudTh>
                            <MudTh>托盘码</MudTh>
                            <MudTh>判定</MudTh>
                            <MudTh>综合偏离（RMS z） <InfoHint Topic="HelpTexts.DeviationThresholds" /></MudTh>
                            <MudTh>最大偏离</MudTh>
                            <MudTh>偏离维度</MudTh>
                            <MudTh>结论</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="时间">@context.Time.ToString("MM-dd HH:mm:ss")</MudTd>
                            <MudTd DataLabel="托盘码">@context.PalletCode</MudTd>
                            <MudTd DataLabel="判定">
                                @if (context.ActualJudgement == Judgement.Ng)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error">NG</MudChip>
                                }
                                else if (context.ActualJudgement == Judgement.Ok)
                                {
                                    <MudText Typo="Typo.caption" Class="dt-text-success">OK</MudText>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">未判定</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="综合偏离（RMS z）">@Num(context.RmsZ, "0.00")</MudTd>
                            <MudTd DataLabel="最大偏离">@Num(context.MaxAbsZ, "0.00") σ</MudTd>
                            <MudTd DataLabel="偏离维度">
                                @if (context.WorstDimension is { } worst)
                                {
                                    @CurveFeatureDimensions.Label(worst)
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="dt-muted">—</MudText>
                                }
                                @if (context.ConstantBreachCount > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                             Class="ml-1">恒定维变化 @context.ConstantBreachCount</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="结论">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@VerdictColor(context.Verdict)">
                                    @VerdictLabel(context.Verdict)
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    @if (_selected is not null)
                    {
                        <MudDivider Class="my-3" />
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudText Typo="Typo.subtitle2">
                                @_selected.PalletCode 的偏离明细
                            </MudText>
                            <MudText Typo="Typo.caption" Class="dt-muted">
                                参与比对 @_selected.ScoredDimensionCount 个维度，仅列出偏离 ≥ @CurveTemplateMatcher.SuspiciousZ.ToString("0.#")σ 的项
                            </MudText>
                        </MudStack>
                        @if (_selected.Deviations.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="dt-muted">所有维度都在基线范围内。</MudText>
                        }
                        else
                        {
                            <MudTable Items="_selected.Deviations" Dense="true" Breakpoint="Breakpoint.Sm">
                                <HeaderContent>
                                    <MudTh>维度</MudTh>
                                    <MudTh>实测值</MudTh>
                                    <MudTh>基线</MudTh>
                                    <MudTh>离散度 σ</MudTh>
                                    <MudTh>偏离倍数</MudTh>
                                    <MudTh>类型</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="维度">@CurveFeatureDimensions.Label(context.Dimension)</MudTd>
                                    <MudTd DataLabel="实测值">@Num(context.Value)</MudTd>
                                    <MudTd DataLabel="基线">@Num(context.BaselineCenter)</MudTd>
                                    <MudTd DataLabel="离散度 σ">@(context.IsConstantBreach ? "0（恒定）" : Num(context.BaselineSigma))</MudTd>
                                    <MudTd DataLabel="偏离倍数">
                                        @if (context.ZScore is { } z)
                                        {
                                            <span style="@(Math.Abs(z) >= CurveTemplateMatcher.AbnormalMaxZ ? "color:var(--mud-palette-error);font-weight:600" : "")">
                                                @z.ToString("+0.00;-0.00", CultureInfo.InvariantCulture) σ
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--mud-palette-warning)">历史上从未变化</span>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="类型">@(context.IsConstantBreach ? "恒定维被打破" : "超出范围")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    }
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h6">影子模式对照</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">
                        偏离分不影响判定
                    </MudChip>
                </MudStack>
                <MudText Typo="Typo.caption" Class="dt-muted">
                    把「偏离分判为异常」与「实际判废」交叉。
                    决定这个算法能不能从"只记录"升级成"预警"的是<b>误报</b>这一格 ——
                    产线上天天乱响的报警会让人把整个面板关掉，那时再准也没用。
                </MudText>

                @if (_report.Shadow.Checked == 0)
                {
                    <MudText Typo="Typo.body2" Class="dt-muted mt-3">
                        没有可用于影子统计的 OK/NG 判定样本（未判定记录不计入；基线不可用时也不会下结论）。
                    </MudText>
                }
                else
                {
                    <MudGrid Class="dt-nums mt-3 mb-2">
                        <MudItem xs="6" sm="4" md="2">
                            <div class="dt-metric"><div class="dt-metric-label">已比对</div><div class="dt-metric-value">@_report.Shadow.Checked</div></div>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <div class="dt-metric">
                                <div class="dt-metric-label">检出</div>
                                <div class="dt-metric-value" style="@(_report.Shadow.TruePositive > 0 ? "color:var(--mud-palette-success)" : "")">@_report.Shadow.TruePositive</div>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <div class="dt-metric">
                                <div class="dt-metric-label">误报</div>
                                <div class="dt-metric-value" style="@(_report.Shadow.FalsePositive > 0 ? "color:var(--mud-palette-warning)" : "")">@_report.Shadow.FalsePositive</div>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <div class="dt-metric">
                                <div class="dt-metric-label">漏报</div>
                                <div class="dt-metric-value" style="@(_report.Shadow.FalseNegative > 0 ? "color:var(--mud-palette-error)" : "")">@_report.Shadow.FalseNegative</div>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <div class="dt-metric"><div class="dt-metric-label">一致正常</div><div class="dt-metric-value">@_report.Shadow.TrueNegative</div></div>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="2">
                            <div class="dt-metric"><div class="dt-metric-label">误报率 FPR</div><div class="dt-metric-value">@Ratio(_report.Shadow.FalsePositiveRate)</div></div>
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.caption" Class="dt-muted">
                        准确率（报警中真有问题）@Ratio(_report.Shadow.Precision) ·
                        召回率（不良中被抓到）@Ratio(_report.Shadow.Recall) ·
                        全样本误报占比 @Ratio(_report.Shadow.FalseAlertShare)
                        （FPR = 误报 / 实际合格；检出 = 偏离异常且判废；误报 = 偏离异常但合格；漏报 = 偏离正常但判废）
                    </MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    /// <summary>序列下拉里"主序列"那一项的值：留空即由服务层落到 Y 优先序列。</summary>
    /// <summary>不能取空串：MudSelect 把 "" 当作"未选择"，会把标签和选项文字叠在一起画。</summary>
    private const string PrimarySeries = "@primary";

    private IReadOnlyList<Station> _stations = [];
    private IReadOnlyList<CurveDefinition> _curves = [];
    private IReadOnlyList<string> _seriesNames = [];

    private int? _stationId;
    private int _curveId;
    private string _seriesName = PrimarySeries;
    /// <summary>
    /// 默认区间起点，与「近 7 天」预设取齐。字段初始化和查询兜底共用这一处 ——
    /// 之前是两个各写一遍的 -6，改默认区间时很容易只改到其中一个。
    /// 用计算属性而不是静态字段，免得服务长跑后停在启动那天。
    /// </summary>
    private static DateTime DefaultFrom => DateTime.Today.AddDays(-6);

    private DateTime? _from = DefaultFrom;
    private DateTime? _to = DateTime.Today;

    private CurveBaselineReport? _report;
    private CurveTemplateScore? _selected;
    private string _recipeCode = "";
    private bool _loading;
    private bool _loadPending;
    private string? _loadError;
    private readonly CancellationTokenSource _cacheStatusLifetime = new();
    private Task? _cacheStatusTask;

    protected override async Task OnInitializedAsync()
    {
        _cacheStatusTask = RefreshCacheStatusAsync(_cacheStatusLifetime.Token);
        var snapshot = await Config.GetSnapshotAsync();
        _stations = snapshot.Stations;
        _recipeCode = snapshot.ActiveRecipe?.Code ?? "";

        if (_stations.Count > 0)
        {
            _stationId = _stations[0].Id;
            RefreshCurves();
        }

        await Load();
    }

    private async Task RefreshCacheStatusAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cacheStatusLifetime.CancelAsync();
        if (_cacheStatusTask is not null)
        {
            await _cacheStatusTask;
        }

        _cacheStatusLifetime.Dispose();
    }

    private void RefreshCurves()
    {
        _curves = _stations.FirstOrDefault(s => s.Id == _stationId)?.Curves.ToList() ?? [];
        if (_curves.All(c => c.Id != _curveId))
        {
            _curveId = _curves.Count > 0 ? _curves[0].Id : 0;
        }

        RefreshSeries();
    }

    private void RefreshSeries()
    {
        _seriesNames = _curves.FirstOrDefault(c => c.Id == _curveId)?.Series
            .Select(s => s.Name)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .ToList() ?? [];

        if (_seriesName != PrimarySeries && !_seriesNames.Contains(_seriesName))
        {
            _seriesName = PrimarySeries;
        }
    }

    private async Task OnStationChanged(int? stationId)
    {
        _stationId = stationId;
        RefreshCurves();
        await Load();
    }

    private async Task OnCurveChanged(int curveId)
    {
        _curveId = curveId;
        RefreshSeries();
        await Load();
    }

    private async Task OnSeriesChanged(string seriesName)
    {
        _seriesName = seriesName ?? PrimarySeries;
        await Load();
    }

    private async Task Load()
    {
        if (_loading)
        {
            _loadPending = true;
            _report = null;
            _selected = null;
            _loadError = null;
            return;
        }

        _loading = true;
        _report = null;
        _selected = null;
        _loadError = null;
        try
        {
            do
            {
                _loadPending = false;

                if (DateRangeFilter.IsReversed(_from, _to))
                {
                    _loadError = DateRangeFilter.ReversedRangeMessage;
                    Toast.Add(DateRangeFilter.ReversedRangeMessage, Severity.Warning);
                    _report = null;
                    break;
                }

                if (_curveId == 0)
                {
                    _report = null;
                    break;
                }

                var curveId = _curveId;
                var seriesName = _seriesName == PrimarySeries ? null : _seriesName;
                var from = DateRangeFilter.StartOf(_from, DefaultFrom);
                var to = DateRangeFilter.EndOfInclusive(_to);
                try
                {
                    var report = await TemplateService.GetBaselineAsync(curveId, seriesName, from, to);

                    // 筛选条件在请求过程中变化时，丢弃旧条件结果，直接按最新条件重查。
                    if (_loadPending)
                    {
                        continue;
                    }

                    _report = report;
                    _selected = null;
                    _loadError = null;
                }
                catch (Exception ex)
                {
                    if (!_loadPending)
                    {
                        _report = null;
                        _selected = null;
                        _loadError = ex.Message;
                        Toast.Add($"波形基线分析失败：{ex.Message}", Severity.Error);
                    }
                }
            }
            while (_loadPending);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string VerdictLabel(CurveTemplateVerdict verdict) => verdict switch
    {
        CurveTemplateVerdict.Normal => "正常",
        CurveTemplateVerdict.Suspicious => "可疑",
        CurveTemplateVerdict.Abnormal => "异常",
        _ => "基线不可用"
    };

    private static Color VerdictColor(CurveTemplateVerdict verdict) => verdict switch
    {
        CurveTemplateVerdict.Normal => Color.Success,
        CurveTemplateVerdict.Suspicious => Color.Warning,
        CurveTemplateVerdict.Abnormal => Color.Error,
        _ => Color.Default
    };

    private static Color TemplateColor(bool reliable) => reliable ? Color.Success : Color.Warning;

    private static string Num(double value, string format = "0.####")
        => value.ToString(format, CultureInfo.InvariantCulture);

    private static string Num(double? value, string format = "0.####")
        => value is { } v ? Num(v, format) : "—";

    private static string Ratio(double? value)
        => value is { } v ? v.ToString("P0", CultureInfo.InvariantCulture) : "—";

    private Color OnlineCacheColor
    {
        get
        {
            var snapshot = BaselineCache.Current;
            if (snapshot is null)
            {
                return Color.Default;
            }

            return snapshot.IsFresh(DateTime.Now)
                   && string.Equals(snapshot.RecipeCode, _recipeCode, StringComparison.Ordinal)
                ? Color.Success
                : Color.Warning;
        }
    }

    /// <summary>明确区分尚未建立、有效、过期及型号不匹配的在线缓存。</summary>
    private string CacheText()
    {
        var snapshot = BaselineCache.Current;
        if (snapshot is null)
        {
            return "尚未建立";
        }

        var cachedRecipe = string.IsNullOrEmpty(snapshot.RecipeCode) ? "未选型号" : snapshot.RecipeCode;
        var recipeMatches = string.Equals(snapshot.RecipeCode, _recipeCode, StringComparison.Ordinal);
        if (!recipeMatches)
        {
            var expired = snapshot.IsFresh(DateTime.Now) ? "" : " · 已过期";
            return $"型号切换中{expired} · 缓存为 {cachedRecipe} · {snapshot.RefreshedAt:HH:mm:ss}";
        }

        if (!snapshot.IsFresh(DateTime.Now))
        {
            return $"已过期 · 刷新于 {snapshot.RefreshedAt:HH:mm:ss}";
        }

        return $"{snapshot.Count} 条序列 · {snapshot.RefreshedAt:HH:mm:ss}";
    }
}

@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@using DataTrace.Web.Services
@inject CustomerBrandingStore Branding

<PageTitle>登录 · @_siteName</PageTitle>

<div class="login-page">
    @* 一张有边界、有层次的卡：登录页面对的是第一次到现场的人，
       全白的散装表单看不出这是个正经系统。顶部细条是唯一一处品牌色，
       不配客户 Logo 时用采集波形作标记，免得页面顶部整块空着。 *@
    <section class="login-card">
        <div class="login-brand">
            @if (!string.IsNullOrEmpty(_logoUrl))
            {
                <img src="@_logoUrl" alt="" class="dt-brand-logo dt-brand-logo-login" />
            }
            else
            {
                <span class="login-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 12h4l2.5-6 3.5 13 3-9 2 2h5" />
                    </svg>
                </span>
            }
        </div>
        <h1 class="login-title">登录 @_siteName</h1>
        <p class="login-hint">产线数据采集与追溯。请使用工程师分配的账号登录。</p>
        <p class="login-hint login-security">首次部署请立即到「用户」页修改默认密码（如 admin / Admin@123），勿把出厂口令留在现场。</p>
        <form method="post" action="/account/login" data-enhance="false" data-enhance-nav="false">
            @* 这里不放 <AntiforgeryToken />：本页在 Routes 的 InteractiveServer 下渲染，令牌组件靠
               AntiforgeryStateProvider 取令牌，交互渲染阶段取不到；端点也没在用令牌
               （Program.cs 的 MapPost 上显式 DisableAntiforgery —— 处理器读了表单，不禁用就会 400）。
               登录的跨站防护由 Origin/Referer 校验承担（SameSitePost），别再把防伪令牌写回来当已生效的防线。 *@
            @* 回跳目标原样带回表单：Cookie 认证的挑战与 RedirectToLogin 都把它放在查询串上，
               这里是唯一一处能把它续到 POST 里的地方。端点只接受站内路径。 *@
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <label class="login-label" for="dt-user">用户名</label>
            <input class="login-input" id="dt-user" name="UserName" autocomplete="username" autofocus />
            <label class="login-label" for="dt-pass">密码</label>
            @* 显隐开关不走 Blazor 事件：登录发生在 SignalR 接手之前，按钮必须在 circuit 起来前就能用，
               而且首次交互渲染会重建这段表单节点。事件委托写在 js/datatrace.js 里，状态只落在 aria-pressed 上。 *@
            <div class="login-pass" data-dt-pass>
                <input class="login-input" id="dt-pass" name="Password" type="password" autocomplete="current-password" />
                <button type="button" class="login-pass-toggle" data-dt-pass-toggle
                        aria-label="显示密码" aria-pressed="false">
                    <svg class="dt-eye dt-eye-show" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                        <path d="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5c-1.7-4.4-6-7.5-11-7.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                    </svg>
                    <svg class="dt-eye dt-eye-hide" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                        <path d="M12 6.5c2.8 0 5.3 1.6 6.6 4-.6 1.2-1.5 2.2-2.6 2.9l1.4 1.4a11.9 11.9 0 0 0 3.6-4.3C19.3 6.1 15 3 10 3c-1.5 0-2.9.3-4.2.8l1.7 1.7c.8-.2 1.6-.3 2.5-.3zM3.7 2.9 2.3 4.3l3 3A12 12 0 0 0 1 11.5C2.7 15.9 7 19 12 19c1.7 0 3.3-.4 4.7-1l3.3 3.3 1.4-1.4L3.7 2.9zM12 16.5a5 5 0 0 1-4.2-7.6l1.6 1.6a3 3 0 0 0 4.1 4.1l1.6 1.6c-.9.5-2 .7-3.1.7z" />
                    </svg>
                </button>
            </div>
            @* 记住我：勾上才发持久 Cookie（关掉浏览器再打开仍认这个会话），不勾是会话 Cookie。
               公共终端上"上一个人勾了"等于下一个人直接用他的账号，所以默认不勾，
               并在 title 里把两种场景说清楚——工控机前的人不会去看帮助页。 *@
            <label class="login-remember"
                   title="在专用终端上勾选：关掉浏览器再打开无需重新登录；公共终端请勿勾选。">
                <input type="checkbox" name="RememberMe" value="true" checked="@_rememberMe" />
                <span>记住我</span>
            </label>
            <button type="submit" class="login-btn">登录</button>
            @if (ErrorText is { } message)
            {
                <p class="login-error" role="alert">@message</p>
            }
        </form>
    </section>
    @* 卡片下一句收尾：登录之后有什么、数据在哪跑，是第一次使用时最想知道的两件事。 *@
    <p class="login-foot">采集与判定在服务端后台持续运行，登录后可查看实时看板与追溯数据。</p>
</div>

@code {
    private string _siteName = "DataTrace";
    private string? _logoUrl;

    protected override void OnInitialized()
    {
        var snap = Branding.GetSnapshot();
        _siteName = snap.EffectiveSiteName;
        _logoUrl = snap.ResolvedLogoUrl;
    }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    /// <summary>挑战地址带上来的目标页；登录后回这一页，而不是把人都扔到看板。</summary>
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? ReturnUrl { get; set; }

    /// <summary>
    /// 登录失败回跳时带回来的"记住我"勾选状态（服务端拼在 ReturnUrl.AfterSignInFailed 里）。
    /// 与 ReturnUrl 一样，名字只在这三个地方出现：表单、端点、本页，改一处要一起改。
    /// </summary>
    [SupplyParameterFromQuery(Name = "remember")]
    public string? Remember { get; set; }

    private bool _rememberMe => Remember == "1";

    /// <summary>
    /// 按错误码给说法。被锁定时若仍说"用户名或密码错误"，操作员会一直重试，
    /// 每失败一次锁定时间就往后推一次，永远等不到解锁。
    /// </summary>
    private string? ErrorText => Error switch
    {
        null or "" => null,
        // 全限定：本页有个同名属性 ReturnUrl，裸写会解析到那个 string 上。
        DataTrace.Web.Services.ReturnUrl.LockedError => "账号因连续登录失败已被临时锁定，请稍后再试或联系管理员解除。",
        DataTrace.Web.Services.ReturnUrl.CrossSiteError => "登录请求来源异常，已拒绝。请回到本站登录页重新登录。",
        _ => "用户名或密码错误。"
    };
}
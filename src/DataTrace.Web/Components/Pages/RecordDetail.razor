@page "/query/{MonthKey}/{RecordId:long}"
@attribute [Authorize]
@using System.Globalization
@using System.Text
@using DataTrace.Application.Configuration
@using DataTrace.Application.Runtime
@using DataTrace.Domain.Constants
@using DataTrace.Domain.Entities
@using DataTrace.Domain.Evaluation
@using Microsoft.AspNetCore.Components.Authorization
@inject IRuntimeStore Store
@inject ICurveFileStore Curves
@inject ICollectArchiveStore Archives
@inject IAuditLogger Audit
@inject AuthenticationStateProvider Auth
@inject DtToast Toast
@inject IJSRuntime Js
@inject NavigationManager Nav

@if (!_loaded)
{
    <PageHeader Title="记录明细" HelpRoute="record">
        <Actions>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@BackUrl">返回查询</MudButton>
        </Actions>
    </PageHeader>
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px" />
}
else if (_loadError is { } loadError)
{
    <PageHeader Title="记录明细" HelpRoute="record">
        <Actions>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@BackUrl">返回查询</MudButton>
        </Actions>
    </PageHeader>
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        <div class="d-flex align-center flex-wrap gap-2">
            <span>@loadError</span>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RetryLoadAsync">重试</MudButton>
        </div>
    </MudAlert>
}
else if (_record is null)
{
    <PageHeader Title="记录明细" HelpRoute="record">
        <Actions>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@BackUrl">返回查询</MudButton>
        </Actions>
    </PageHeader>
    <MudAlert Severity="Severity.Warning">
        记录不存在或已按保留策略清理（月库 @MonthKey，记录 @RecordId）。请返回查询页重新选择条件。
    </MudAlert>
}
else
{
    <PageHeader Title="@_record.StationCode" HelpRoute="record">
        <ChildContent>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                     Color="@(_record.Judgement == Judgement.Ng ? Color.Error : _record.Judgement == Judgement.Ok ? Color.Success : Color.Default)">
                @DisplayLabels.JudgementTextLong(_record.Judgement)
            </MudChip>
            @if (!string.IsNullOrWhiteSpace(_record.RecipeCode))
            {
                @* 限值随型号切换而变，判定依据必须能回溯。 *@
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">型号 @_record.RecipeCode</MudChip>
            }
        </ChildContent>
        <Actions>
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@BackUrl">返回查询</MudButton>
            <MudTooltip Text="@(_navigationError ?? "按原列表顺序查看上一条")">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ChevronLeft"
                           Disabled="@(_previousUrl is null)" Href="@_previousUrl">上一条</MudButton>
            </MudTooltip>
            <MudTooltip Text="@(_navigationError ?? "按原列表顺序查看下一条")">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.ChevronRight"
                           Disabled="@(_nextUrl is null)" Href="@_nextUrl">下一条</MudButton>
            </MudTooltip>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.History"
                       Href="@PalletHistoryUrl()">同托盘近 30 天</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print"
                       Class="dt-print-hide" OnClick="PrintAsync">打印</MudButton>
            @if (_canCreateQualityIncident)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.ReportProblem" Href="@QualityIncidentUrl()">
                    创建质量异常
                </MudButton>
            }
            @if (_canExport)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="Export" Disabled="_exporting"
                           StartIcon="@(_exporting ? Icons.Material.Filled.Sync : Icons.Material.Filled.FileDownload)">
                    @(_exporting ? "导出中…" : "导出本记录")
                </MudButton>
            }
        </Actions>
    </PageHeader>

    @if (_navigationError is { } navigationError)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@navigationError</MudAlert>
    }

    <MudPaper Class="pa-4">
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Class="dt-muted">托盘码</MudText>
                <MudText Typo="Typo.subtitle1">@_record.PalletCode</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Class="dt-muted">流水号</MudText>
                <MudText Typo="Typo.subtitle1">@_record.SerialNo</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Class="dt-muted">触发时间</MudText>
                <MudText Typo="Typo.subtitle1">@_record.TriggerTime.ToString("yyyy-MM-dd HH:mm:ss.fff")</MudText>
                <MudText Typo="Typo.caption" Class="dt-muted">
                    耗时 @_record.DurationMs ms · 完成 @_record.CompleteTime.ToString("HH:mm:ss.fff")
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Class="dt-muted">结果码</MudText>
                <MudText Typo="Typo.subtitle1">@_record.ResultCode · @ResultCodes.Describe(_record.ResultCode)</MudText>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_record.ErrorMessage))
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_record.ErrorMessage</MudAlert>
        }
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_record.ArchivePath))
    {
        <MudPaper Class="pa-3 mt-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap">
                <MudText Typo="Typo.subtitle1">原始数据文件</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">JSON</MudChip>
                <MudText Typo="Typo.caption" Class="dt-muted">
                    @_record.ArchivePath · @FileSizeText(_record.ArchiveFileSize)
                </MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ToggleArchive" Disabled="_archiveLoading"
                           StartIcon="@(_archiveLoading ? Icons.Material.Filled.Sync : Icons.Material.Filled.Visibility)">
                    @(_archiveText is null ? "查看原始内容" : "收起内容")
                </MudButton>
                @if (_canExport)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="DownloadArchive" Disabled="_archiveLoading"
                               StartIcon="@Icons.Material.Filled.FileDownload">下载 JSON</MudButton>
                }
            </MudStack>
            @* 原始文件由设备每件覆写，这里是采集当时读到的那一份 —— 判定吃的就是它的内容。 *@
            <MudText Typo="Typo.caption" Class="dt-muted">
                设备每件覆写同一个 JSON 文件，此处是按采集时间与托盘码归的档；点位值就是从这个文件里读的。
            </MudText>
            @if (_archiveError is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">@_archiveError</MudText>
            }
            @if (_archiveText is not null)
            {
                <MudPaper Class="dt-archive-preview pa-2 mt-2" Elevation="0">
                    <pre>@_archiveText</pre>
                </MudPaper>
            }
        </MudPaper>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4 mb-1">
        <MudText Typo="Typo.h6">点位</MudText>
        @if (_outOfLimitCount > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">
                @_outOfLimitCount 项超限
            </MudChip>
        }
        @if (_warningCount > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                @_warningCount 项预警
            </MudChip>
        }
        <MudText Typo="Typo.caption" Class="dt-muted">
            共 @_record.TagValues.Count 项 · 限值取判定那一刻生效的配置（含型号覆盖），不随后续改动重算<InfoHint Topic="HelpTexts.LimitColumns" />
        </MudText>
    </MudStack>
    <MudTable Items="_tagRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>点位</MudTh>
            <MudTh>数值</MudTh>
            <MudTh>规格限</MudTh>
            <MudTh>预警限</MudTh>
            <MudTh>判定 <InfoHint Topic="HelpTexts.OverTolerance" /></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="点位">@context.TagName</MudTd>
            <MudTd DataLabel="数值" Class="dt-nowrap">
                @if (context.IsOutOfLimit)
                {
                    <strong class="dt-text-error">@DisplayWithUnit(context)</strong>
                }
                else if (context.IsWarning)
                {
                    <strong class="dt-text-warning">@DisplayWithUnit(context)</strong>
                }
                else
                {
                    @DisplayWithUnit(context)
                }
                @if (OverageText(context) is { } overage)
                {
                    <MudText Typo="Typo.caption" Class="dt-text-error ml-1">@overage</MudText>
                }
            </MudTd>
            <MudTd DataLabel="规格限" Class="dt-num dt-nowrap">@DisplayLimitRange(context)</MudTd>
            <MudTd DataLabel="预警限" Class="dt-num dt-nowrap">@DisplayLimitRange(context, warning: true)</MudTd>
            <MudTd DataLabel="判定">
                @if (context.IsOutOfLimit)
                {
                    <MudTooltip Arrow="true" RootClass="dt-help-popover">
                        <ChildContent>
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small"
                                     Color="Color.Error" aria-label="超出规格限" />
                        </ChildContent>
                        <TooltipContent>
                            <HelpContent Topic="HelpTexts.LimitThreeTiers" />
                        </TooltipContent>
                    </MudTooltip>
                    <MudText Typo="Typo.caption" Class="dt-text-error ml-1">超差</MudText>
                }
                else if (context.IsWarning)
                {
                    <MudTooltip Arrow="true" RootClass="dt-help-popover">
                        <ChildContent>
                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small"
                                     Color="Color.Warning" aria-label="落在预警带" />
                        </ChildContent>
                        <TooltipContent>
                            <HelpContent Topic="HelpTexts.LimitThreeTiers" />
                        </TooltipContent>
                    </MudTooltip>
                    <MudText Typo="Typo.caption" Class="dt-text-warning ml-1">预警</MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption">@TagJudgementText(context)</MudText>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="dt-muted py-3">该记录没有点位数据。</MudText>
        </NoRecordsContent>
    </MudTable>

    @if (_record.Curves.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mt-4 mb-1">曲线</MudText>
        @foreach (var curve in _record.Curves)
        {
            <MudPaper Class="pa-3 mt-2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap mb-2">
                    <MudText Typo="Typo.subtitle1">@curve.CurveName</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@curve.CurveCode</MudChip>
                    <MudText Typo="Typo.caption" Class="dt-muted">
                        @curve.PointCount 点 · @FileSizeText(curve.FileSize)<InfoHint Topic="HelpTexts.CurvePointCount" />
                    </MudText>
                    <MudSpacer />
                    @if (PayloadFor(curve.Id) is null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">@(_curveErrors.GetValueOrDefault(curve.Id, "曲线文件缺失"))</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="dt-muted">悬停读取数值</MudText>
                    }
                </MudStack>
                @if (curve.Features.Count > 0)
                {
                    <MudStack Row="true" Spacing="2" Class="flex-wrap mb-2">
                        @foreach (var feature in curve.Features.OrderBy(f => f.Role))
                        {
                            <MudTooltip Arrow="true" RootClass="dt-help-popover">
                                <ChildContent>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                             Color="@DeviationColor(feature)">
                                        @feature.SeriesName @DeviationText(feature)
                                    </MudChip>
                                </ChildContent>
                                <TooltipContent>
                                    <HelpContent Topic="HelpTexts.DeviationThresholds" Extra="@DeviationTitle(feature)" />
                                </TooltipContent>
                            </MudTooltip>
                        }
                        <MudText Typo="Typo.caption" Class="dt-muted align-self-center">
                            波形偏离 · 影子模式，不参与判定
                        </MudText>
                    </MudStack>
                }
                <CurveChart Payload="PayloadFor(curve.Id)" AuditKey="@CurveAuditKey(curve.CurveCode)" />
            </MudPaper>
        }
    }
}

@code {
    [Parameter] public string MonthKey { get; set; } = "";
    [Parameter] public long RecordId { get; set; }

    private async Task PrintAsync()
    {
        try
        {
            if (!await Js.InvokeAsync<bool>("dtPrint"))
            {
                Toast.Add("浏览器没有打开打印对话框，请用 Ctrl+P 重试", Severity.Warning);
            }
        }
        catch (JSException)
        {
            Toast.Add("打印不可用，请用 Ctrl+P 重试", Severity.Warning);
        }
    }

    /// <summary>查询页带过来的列表地址，返回时不再把用户筛选过的条件丢掉。</summary>
    [SupplyParameterFromQuery(Name = "back")]
    public string? BackQuery { get; set; }

    [SupplyParameterFromQuery(Name = "position")]
    public int? PositionQuery { get; set; }

    private string BackUrl => RecordListNavigation.IsListUrl(BackQuery) ? BackQuery! : "query";
    private string? _previousUrl;
    private string? _nextUrl;
    private string? _navigationError;

    private CollectRecord? _record;
    private bool _loaded;
    private string? _loadError;
    private bool _canExport;
    private bool _canCreateQualityIncident;
    private readonly Dictionary<long, CurvePayload> _curvePayloads = [];
    /// <summary>读不出来的曲线：曲线 Id → 界面提示。损坏与缺失的说明不同。</summary>
    private readonly Dictionary<long, string> _curveErrors = [];
    private List<TagValue> _tagRows = [];
    private int _outOfLimitCount;
    private int _warningCount;
    /// <summary>归档原文：默认收着，点了才读 —— 明细页大多数查看并不需要这份原始 JSON。</summary>
    private string? _archiveText;
    private string? _archiveError;
    private bool _archiveLoading;

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _canExport = auth.User.IsInRole(AppRoles.Administrator) || auth.User.IsInRole(AppRoles.Engineer);
        _canCreateQualityIncident = auth.User.IsInRole(AppRoles.Administrator)
                        || auth.User.IsInRole(AppRoles.Engineer)
                        || auth.User.IsInRole(AppRoles.Operator);
    }

    protected override async Task OnParametersSetAsync()
    {
        _loaded = false;
        _loadError = null;
        _previousUrl = null;
        _nextUrl = null;
        _navigationError = null;
        _curvePayloads.Clear();
        _curveErrors.Clear();
        _archiveText = null;
        _archiveError = null;
        try
        {
            _record = await Store.GetRecordAsync(MonthKey, RecordId);
        }
        catch (Exception ex)
        {
            _record = null;
            _tagRows = [];
            _outOfLimitCount = 0;
            _warningCount = 0;
            _loadError = $"记录读取失败：{ex.Message}";
            _loaded = true;
            return;
        }

        if (_record is null)
        {
            _tagRows = [];
            _outOfLimitCount = 0;
            _warningCount = 0;
            _loaded = true;
            return;
        }

        // 红区排最前，其次是黄区，方便一眼看到该看的。
        _tagRows = _record.TagValues
            .OrderByDescending(v => v.IsOutOfLimit)
            .ThenByDescending(v => v.IsWarning)
            .ThenBy(v => v.TagName, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _outOfLimitCount = _tagRows.Count(v => v.IsOutOfLimit);
        _warningCount = _tagRows.Count(v => v.IsWarning);

        foreach (var curve in _record.Curves)
        {
            try
            {
                // Crc32 是后加的列，历史行是 0：那种行没有校验值，只能不校验。
                _curvePayloads[curve.Id] = await Curves.ReadAsync(
                    curve.RelativePath,
                    curve.Crc32 == 0 ? null : curve.Crc32);
            }
            catch (InvalidDataException)
            {
                // 损坏与缺失要分开说：都报"缺失"的话，现场会去查备份而不是查磁盘或权限。
                _curveErrors[curve.Id] = "曲线文件损坏（内容与入库校验值不一致）";
            }
            catch
            {
                // 其余（文件缺失、权限、半截文件）一律按读不到处理，不阻断其余内容展示。
                _curveErrors[curve.Id] = "曲线文件缺失或无法读取";
            }
        }

        await LoadNavigationAsync();
        _loaded = true;
    }

    private async Task LoadNavigationAsync()
    {
        if (PositionQuery is not { } position || position < 0 || position >= int.MaxValue - 2
            || !RecordListNavigation.IsListUrl(BackQuery)) return;
        try
        {
            var skip = Math.Max(0, position - 1);
            var result = await Store.QueryAsync(RecordListNavigation.ReadRequest(BackUrl, skip, 3));
            var current = position - skip;
            if (result.Items.Count <= current || result.Items[current].MonthKey != MonthKey
                || result.Items[current].Record.Id != RecordId)
            {
                _navigationError = "列表已变化，请返回查询刷新后继续浏览";
                return;
            }
            if (current > 0)
                _previousUrl = RecordListNavigation.DetailUrl(result.Items[current - 1], BackUrl, position - 1);
            if (current + 1 < result.Items.Count)
                _nextUrl = RecordListNavigation.DetailUrl(result.Items[current + 1], BackUrl, position + 1);
        }
        catch (Exception)
        {
            _navigationError = "相邻记录加载失败，请返回查询重试";
        }
    }

    private Task RetryLoadAsync() => OnParametersSetAsync();

    private CurvePayload? PayloadFor(long curveId)
        => _curvePayloads.TryGetValue(curveId, out var payload) ? payload : null;

    /// <summary>曲线导出的审计键：定位到"哪条记录的哪条曲线"，与明细页导出同一套约定。</summary>
    private string CurveAuditKey(string curveCode) => $"{MonthKey}/{RecordId}/{curveCode}";

    private string PalletHistoryUrl()
    {
        var pallet = _record?.PalletCode ?? "";
        return $"/query?pallet={Uri.EscapeDataString(pallet)}&days=30";
    }

    private string QualityIncidentUrl()
        => $"/quality/incidents/new?month={Uri.EscapeDataString(MonthKey)}&recordId={RecordId}";

    private static string Display(TagValue value)
        => value.TextValue ?? value.NumericValue?.ToString("0.####", CultureInfo.InvariantCulture) ?? "-";

    private static string UnitLabel(string? unit)
        => string.IsNullOrWhiteSpace(unit) ? "单位未知" : unit;

    private static string DisplayWithUnit(TagValue value)
        => $"{Display(value)} {UnitLabel(value.UnitSnapshot)}";

    private static string DisplayLimitRange(TagValue value, bool warning = false)
    {
        var lower = warning ? value.WarningLowerLimit : value.LowerLimit;
        var upper = warning ? value.WarningUpperLimit : value.UpperLimit;
        var range = DisplayLabels.LimitRange(lower, upper);
        return lower is null && upper is null ? range : $"{range} {UnitLabel(value.UnitSnapshot)}";
    }

    private static string TagJudgementText(TagValue value)
    {
        if (value.LowerLimit is not null || value.UpperLimit is not null)
        {
            return value.NumericValue is null ? "缺数据" : "正常";
        }

        return "未配置判定";
    }

    /// <summary>导出里留空而不是写 0：下游表格把 0 当成真实限值就会算出错误的合格率。</summary>
    private static string CsvNum(double? value)
        => value?.ToString("0.###", CultureInfo.InvariantCulture) ?? "";

    /// <summary>
    /// 判废时说清"差多少"。只知道超限而不知道离限值多远，现场就没法判断是传感器飘了还是工艺真偏了。
    /// 取不到数值（必填点位取空）时留空，那种情况的说明在结果码里。
    /// </summary>
    private static string? OverageText(TagValue value)
    {
        if (!value.IsOutOfLimit || value.NumericValue is not { } numeric)
        {
            return null;
        }

        if (value.UpperLimit is { } upper && numeric > upper)
        {
            return $"超上限 +{(numeric - upper).ToString("0.###", CultureInfo.InvariantCulture)}";
        }

        if (value.LowerLimit is { } lower && numeric < lower)
        {
            return $"超下限 -{(lower - numeric).ToString("0.###", CultureInfo.InvariantCulture)}";
        }

        return null;
    }

    private static string FileSizeText(long bytes)
        => bytes < 1024
            ? $"{bytes} B"
            : bytes < 1024 * 1024
                ? $"{bytes / 1024.0:0.#} KB"
                : $"{bytes / 1024.0 / 1024:0.##} MB";

    /// <summary>影子模式的偏离结论配色；未比对（没有可用基线）用灰色，不要显得像出了问题。</summary>
    private static Color DeviationColor(CurveFeature feature) => feature.DeviationVerdict switch
    {
        CurveTemplateVerdict.Normal => Color.Success,
        CurveTemplateVerdict.Suspicious => Color.Warning,
        CurveTemplateVerdict.Abnormal => Color.Error,
        _ => Color.Default
    };

    private static string DeviationText(CurveFeature feature)
        => feature.DeviationRmsZ is { } rms
            ? $"{rms.ToString("0.00", CultureInfo.InvariantCulture)}σ"
            : "未比对";

    private static string DeviationTitle(CurveFeature feature)
    {
        if (feature.DeviationVerdict is not { } verdict)
        {
            return "该序列没有可用基线（样本不足或型号与当前不一致），未做比对";
        }

        var label = verdict switch
        {
            CurveTemplateVerdict.Normal => "与基线一致",
            CurveTemplateVerdict.Suspicious => "轻度偏离",
            CurveTemplateVerdict.Abnormal => "显著偏离",
            _ => "基线不可用"
        };

        var worst = feature.DeviationWorstDimension is { } dimension
            ? $"，最大偏离维度：{CurveFeatureDimensions.Label(dimension)}"
            : "";

        return $"基线由 {feature.BaselineSampleCount} 条合格样本建立，综合偏离 " +
               $"{feature.DeviationRmsZ?.ToString("0.00", CultureInfo.InvariantCulture) ?? "—"}σ，{label}{worst}（仅记录，不参与判定）";
    }

    private bool _exporting;

    private async Task ToggleArchive()
    {
        if (_record is null || _archiveLoading)
        {
            return;
        }

        if (_archiveText is not null)
        {
            _archiveText = null;
            return;
        }

        _archiveLoading = true;
        _archiveError = null;
        var bytes = await ReadArchiveAsync();
        _archiveLoading = false;
        if (bytes is null)
        {
            return;
        }

        // 按 UTF-8 解码后原样显示：设备写下的字节才是证据，页面不做任何格式化改写。
        _archiveText = Encoding.UTF8.GetString(bytes);
    }

    private async Task DownloadArchive()
    {
        if (_record is null || _archiveLoading)
        {
            return;
        }

        if (!_canExport)
        {
            Toast.Add("当前角色无权导出原始数据（需要管理员或工程师）", Severity.Warning);
            return;
        }

        _archiveLoading = true;
        _archiveError = null;
        var bytes = await ReadArchiveAsync();
        _archiveLoading = false;
        if (bytes is null)
        {
            return;
        }

        var name = $"datatrace_{_record.SerialNo}_source_{DateTime.Now:yyyyMMdd_HHmmss}.json";
        try
        {
            await Js.InvokeVoidAsync("dtDownload", name, Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            // JS 互操失败（连接断了、浏览器拦下下载）抛出去会断掉整条 circuit。
            Toast.Add($"下载失败：{ex.Message}", Severity.Error);
            return;
        }

        // 文件已经下载完了：审计写库失败不能报成"下载失败"，与导出 CSV 同一套口径。
        try
        {
            var user = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
            await Audit.WriteAsync(user, "Export", "CollectArchive", $"{MonthKey}/{_record.Id}", null, _record.ArchivePath);
            Toast.Add("已下载原始数据文件", Severity.Success);
        }
        catch (Exception ex)
        {
            Toast.Add($"已下载原始数据文件，但审计记录写入失败：{ex.Message}", Severity.Warning);
        }
    }

    /// <summary>读归档字节；读不出来时把原因写进 <see cref="_archiveError"/> 并返回 null。</summary>
    /// <remarks>
    /// Crc32 是随归档一起落库的，为 0 表示历史行没有校验值，只能不校验。
    /// 损坏与缺失分开说：都报"缺失"的话，现场会去查备份而不是查磁盘或权限。
    /// </remarks>
    private async Task<byte[]?> ReadArchiveAsync()
    {
        if (_record is null)
        {
            return null;
        }

        try
        {
            return await Archives.ReadAsync(
                _record.ArchivePath,
                _record.ArchiveCrc32 == 0 ? null : _record.ArchiveCrc32);
        }
        catch (InvalidDataException)
        {
            _archiveError = "归档文件损坏（内容与入库校验值不一致）";
            return null;
        }
        catch
        {
            _archiveError = "归档文件缺失或无法读取";
            return null;
        }
    }

    private async Task Export()
    {
        if (_record is null || _exporting)
        {
            return;
        }

        if (!_canExport)
        {
            Toast.Add("当前角色无权导出记录（需要管理员或工程师）", Severity.Warning);
            return;
        }

        _exporting = true;
        var rows = new List<string[]>
        {
            new[]
            {
                "记录信息", _record.SerialNo, _record.PalletCode, _record.StationCode,
                _record.TriggerTime.ToString("yyyy-MM-dd HH:mm:ss"), DisplayLabels.JudgementTextLong(_record.Judgement),
                ResultCodes.Describe(_record.ResultCode),
                string.IsNullOrWhiteSpace(_record.RecipeCode) ? "(默认限值)" : _record.RecipeCode,
                ""
            },
            Array.Empty<string>()
        };

        // 归档路径随导出一起带出去：只导表格的人在别处看不到"原始文件在哪"，
        // 事后要复核设备写了什么就得有这一行。
        if (!string.IsNullOrWhiteSpace(_record.ArchivePath))
        {
            rows.Add(new[] { "原始数据文件", _record.ArchivePath, FileSizeText(_record.ArchiveFileSize), "", "", "", "", "", "" });
            rows.Add(new string[9]);
        }

        rows.Add(new[] { "点位名称", "数值", "单位", "判定", "规格下限", "规格上限", "预警下限", "预警上限", "" });

        @* 导出顺序跟屏显一致（超差→预警→其余按名称）：对照着看时两份东西行序不同最容易错。 *@
        foreach (var value in _tagRows)
        {
            // 超规格与预警分开写：导出给质量看时，"判废"和"黄区提示"不能混为一谈。
            // 限值留空表示"这条记录没记下来"（早于本版本），不要写 0 让下游当成真实限值。
            // 末列留空：整份 CSV 固定 9 列，少一列时 Excel 会把后面的曲线段拼错位。
            rows.Add(new[]
            {
                value.TagName, Display(value), UnitLabel(value.UnitSnapshot),
                value.IsOutOfLimit ? "超限" : value.IsWarning ? "预警" : "",
                CsvNum(value.LowerLimit), CsvNum(value.UpperLimit),
                CsvNum(value.WarningLowerLimit), CsvNum(value.WarningUpperLimit),
                ""
            });
        }

        // 分区空行与曲线段都补满 9 列：列数参差时 Excel 会把两段内容拼错位。
        rows.Add(new string[9]);
        rows.Add(new[] { "曲线编码", "曲线名称", "点数", "文件路径", "", "", "", "", "" });
        foreach (var curve in _record.Curves)
        {
            rows.Add(new[]
            {
                curve.CurveCode, curve.CurveName,
                curve.PointCount.ToString(CultureInfo.InvariantCulture), curve.RelativePath,
                "", "", "", "", ""
            });
        }

        try
        {
            var csv = CsvExporter.Build(new[] { "项目", "A", "B", "C", "D", "E", "F", "G", "H" }, rows);
            await Js.InvokeVoidAsync("dtDownload", CsvExporter.FileName($"datatrace_{_record.SerialNo}"),
                CsvExporter.ToBase64(csv));
        }
        catch (Exception ex)
        {
            // JS 互操失败（连接断了、浏览器拦下下载）抛出去会断掉整条 circuit，页面直接卡死。
            Toast.Add($"导出失败：{ex.Message}", Severity.Error);
            return;
        }
        finally
        {
            _exporting = false;
        }

        // 文件已经下载完了：审计写库失败不能报成"导出失败"，现场会以为没导出去而重导。
        try
        {
            var auth = await Auth.GetAuthenticationStateAsync();
            var user = auth.User.Identity?.Name ?? "";
            var key = $"{MonthKey}/{_record.Id}";
            var summary =
                $"serial={_record.SerialNo};pallet={_record.PalletCode};station={_record.StationCode};" +
                $"recipe={_record.RecipeCode};tags={_tagRows.Count};curves={_record.Curves.Count}";
            await Audit.WriteAsync(user, "Export", "Record", key, null, summary);
            Toast.Add("已导出本记录明细", Severity.Success);
        }
        catch (Exception ex)
        {
            Toast.Add($"已导出本记录明细，但审计记录写入失败：{ex.Message}", Severity.Warning);
        }
    }
}

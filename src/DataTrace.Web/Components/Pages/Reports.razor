@page "/reports"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using DataTrace.Application.Configuration
@using DataTrace.Application.Reporting
@using DataTrace.Domain.Constants
@using DataTrace.Domain.Evaluation
@using Microsoft.AspNetCore.Components.Authorization
@inject IReportService ReportService
@inject ISpcService SpcService
@inject IConfigRepository Config
@inject IRuntimeStore Store
@using DataTrace.Application.Runtime
@inject IAuditLogger Audit
@inject AuthenticationStateProvider Auth
@inject DtToast Toast
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageHeader Title="报表" HelpRoute="reports">
    <Actions>
        <MudText Typo="Typo.caption" Class="dt-muted">@DateRangeFilter.Format(_from, _to) 　共 @_fpy.Sum(x => x.Total) 条记录</MudText>
    </Actions>
</PageHeader>

<MudPaper Class="dt-filter-card mb-3">
    @* 统计要动几组查询，期间下面的图表还是上一轮的值；没有这根进度条就是"看着有数、其实是旧的"。 *@
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
    }
    <form @onsubmit="OnSubmit" @onsubmit:preventDefault="true">
        <DateRangeFilter @bind-From="_from" @bind-To="_to" OnRangeChanged="Load" />

        <MudGrid Class="dt-filters">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudSelect T="int?" Value="_stationId" ValueChanged="OnStationChanged" Label="工站" Clearable="true"
                           Disabled="_loading" HelperText="不选表示全部工站">
                    @foreach (var s in _stations)
                    {
                        <MudSelectItem T="int?" Value="@s.Id">@s.Code @s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

                        <MudItem xs="12" sm="6" md="4" lg="3">
                <MudSelect T="RecipeFilterValue" Value="@ToOptionValue(_recipeFilter)" ValueChanged="OnRecipeFilterChanged"
                           Label="产品型号" Dense="true" Disabled="_loading" HelperText="作用于整份报表">
                    <MudSelectItem T="RecipeFilterValue" Value="@RecipeFilterValue.All">全部型号</MudSelectItem>
                    <MudSelectItem T="RecipeFilterValue" Value="@RecipeFilterValue.NoRecipe">未选型号</MudSelectItem>
                    @foreach (var opt in _recipeOptions)
                    {
                        <MudSelectItem T="RecipeFilterValue" Value="@ToOptionValue(opt.Code)">@opt.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
        <MudStack Row="true" Spacing="2" Class="mt-1 mb-2 flex-wrap">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh" Disabled="_loading">
                @(_loading ? "统计中…" : "刷新报表")
            </MudButton>
            @if (_canExport)
            {
                <MudButton Variant="Variant.Outlined" OnClick="ExportTrend" Disabled="_exporting || _trend.Count == 0"
                           StartIcon="@(_exporting ? Icons.Material.Filled.Sync : Icons.Material.Filled.FileDownload)">
                    @(_exporting ? "导出中…" : "导出趋势")
                </MudButton>
            }
        </MudStack>
    </form>
</MudPaper>

@if (_trendTruncated)
{
    @* 少算了就得说出来：不说的话图上那个偏窄的时间轴会被当成"区间内就这些点"。 *@
    <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mb-3">
        该点位在所选区间内的采样点超过单次上限，参数趋势与过程能力只统计<b>最近 @SystemDefaults.TrendSampleLimit 点</b>。
        需要更早的数据请缩小区间。
    </MudAlert>
}

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-3"
         AlwaysShowScrollButtons="true">
    <MudTabPanel Text="直通率">
        <MudGrid>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 dt-fill">
            <MudText Typo="Typo.h6" Class="mb-2">直通率</MudText>
            <MudTable Items="_fpy" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Loading="_loading">
                <HeaderContent>
                    <MudTh>日期</MudTh>
                    <MudTh Class="dt-num">总数</MudTh>
                    <MudTh Class="dt-num">OK</MudTh>
                    <MudTh Class="dt-num">NG</MudTh>
                    <MudTh Class="dt-num">未判定</MudTh>
<MudTh Class="dt-num">直通率 <InfoHint Topic="HelpTexts.YieldRate" /></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="日期">@context.Day.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="总数" Class="dt-num">@context.Total</MudTd>
                    <MudTd DataLabel="OK" Class="dt-num">@context.Ok</MudTd>
                    <MudTd DataLabel="NG" Class="dt-num">
                        @if (context.Ng > 0)
                        {
                            <strong class="dt-text-error">@context.Ng</strong>
                        }
                        else
                        {
                            @context.Ng
                        }
                    </MudTd>
                                        <MudTd DataLabel="未判定" Class="dt-num">@context.None</MudTd>
<MudTd DataLabel="直通率" Class="dt-num">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@YieldColor(context.FirstPassYield)">
                            @context.FirstPassYield.ToString("P1")
                        </MudChip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="dt-muted py-3">所选区间没有生产记录。</MudText>
                </NoRecordsContent>
            </MudTable>
            @if (_fpy.Count > 0)
            {
                <MudText Typo="Typo.caption" Class="dt-muted mt-2">
                    区间合计：@_fpy.Sum(x => x.Total) 条，OK @_fpy.Sum(x => x.Ok) 条，
                    平均直通率 @AverageYield().ToString("P1")<InfoHint Topic="HelpTexts.AverageYield" />
                </MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-4 dt-fill mt-3">
            <MudText Typo="Typo.h6" Class="mb-2">按产品型号 <InfoHint Topic="HelpTexts.RecipeScope" /></MudText>
            <MudTable Items="_byRecipe" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Loading="_loading">
                <HeaderContent>
                    <MudTh>型号</MudTh>
                    <MudTh Class="dt-num">产量</MudTh>
                    <MudTh Class="dt-num">OK</MudTh>
                    <MudTh Class="dt-num">NG</MudTh>
                    <MudTh Class="dt-num">未判定</MudTh>
                    <MudTh Class="dt-num">直通率</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="型号">@FormatRecipeRow(context.RecipeCode)</MudTd>
                    <MudTd DataLabel="产量" Class="dt-num">@context.Total</MudTd>
                    <MudTd DataLabel="OK" Class="dt-num">@context.Ok</MudTd>
                    <MudTd DataLabel="NG" Class="dt-num">@context.Ng</MudTd>
                    <MudTd DataLabel="未判定" Class="dt-num">@context.Pending</MudTd>
                    <MudTd DataLabel="直通率" Class="dt-num">@((context.PassRate * 100).ToString("0.0"))%</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="dt-muted">所选范围内没有记录。</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 dt-fill">
            <MudText Typo="Typo.h6" Class="mb-2">不良 Top N <InfoHint Topic="HelpTexts.IssueShare" /></MudText>
            <IssueTopTable Items="_defects.Items" Loading="_loading" Share="DefectShare"
                           EmptyText="区间内没有不良记录，工站状态良好。" />
            @if (_defects.Items.Count > 0)
            {
                @* 分母是区间内全部超限次数，不是榜内合计：榜内合计永远 100%，
                   那样就看不出"榜外还有一大截"，也就不会去查第 11 个点位。 *@
                <MudText Typo="Typo.caption" Class="dt-muted mt-2">
                    区间共 @_defects.Total 次超规格，下表列出前 @_defects.Items.Count 项；占比以全部次数为分母。
                </MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h6">预警 Top N <InfoHint Topic="HelpTexts.LimitThreeTiers" /></MudText>
                <MudSpacer />
                <MudText Typo="Typo.caption" Class="dt-muted">
                    落在黄区、尚未判废。这里先热起来，说明趋势正在往限值漂。
                </MudText>
            </MudStack>
            <IssueTopTable Items="_warnings.Items" Loading="_loading" Share="WarningShare"
                           EmptyText="区间内没有任何点位进入预警带。若这里长期为空，也可能说明预警限还没配。" />
            @if (_warnings.Items.Count > 0)
            {
                <MudText Typo="Typo.caption" Class="dt-muted mt-2">
                    区间共 @_warnings.Total 次进入预警带，下表列出前 @_warnings.Items.Count 项；占比以全部次数为分母。
                </MudText>
            }
        </MudPaper>
    </MudItem>
        </MudGrid>
    </MudTabPanel>
    <MudTabPanel Text="参数趋势">
<MudPaper Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap mb-2">
                <MudText Typo="Typo.h6">参数趋势</MudText>
                <MudSpacer />
                <MudSelect T="int" Value="_tagId" ValueChanged="OnTagChanged" Dense="true" Label="点位"
                           Disabled="_loading" Style="min-width:240px">
                    @foreach (var tag in _tags)
                    {
                        <MudSelectItem T="int" Value="@tag.Id">@TagOptionLabel(tag)</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            @if (_tags.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="dt-muted py-3">当前工站没有可画趋势的数值点位。</MudText>
            }
            else if (_loadFailed || _trendFailed)
            {
                @* 失败时结果已被清空，这里若沿用"没有采集数据"，现场会照着"点位没数据"去查传感器。 *@
                <MudText Typo="Typo.body2" Class="dt-text-error py-3">统计失败，本页结果已清空。请重试；若持续失败请检查月库是否被占用。</MudText>
            }
            else if (_trendLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-3" />
            }
            else if (_trend.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="dt-muted py-3">所选区间内该点位没有采集数据。</MudText>
            }
            else
            {
                <MudStack Row="true" Spacing="3" Class="mb-2 flex-wrap">
                    <MudText Typo="Typo.caption" Class="dt-muted dt-kpi">采样点 @_trend.Count<InfoHint Topic="HelpTexts.TrendSampleLimit" /></MudText>
                    <MudText Typo="Typo.caption" Class="dt-muted dt-kpi">均值 @_trendAverage</MudText>
                    <MudText Typo="Typo.caption" Class="dt-muted dt-kpi">最小 @_trendMin</MudText>
                    <MudText Typo="Typo.caption" Class="dt-muted dt-kpi">最大 @_trendMax</MudText>
                    <MudText Typo="Typo.caption" Class="dt-muted">@_trendRangeText</MudText>
                </MudStack>
                <LineChart Series="_trendSeries" Height="280" SeriesAxisName="时间"
                           XStartText="@_trendFromText" XEndText="@_trendToText"
                           ShowPoints="_trend.Count <= 120" />
            }
        </MudPaper>
    </MudTabPanel>
    <MudTabPanel Text="过程能力">
        @* 与「参数趋势」共用上方筛选里的工站，以及本页选中的点位（见趋势页签）。 *@
<MudPaper Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap mb-2">
                <MudText Typo="Typo.h6">过程能力</MudText>
                <MudSelect T="int" Value="_tagId" ValueChanged="OnTagChanged" Dense="true" Label="点位"
                           Disabled="_loading" Style="min-width:220px" Class="ml-2">
                    @foreach (var tag in _tags)
                    {
                        <MudSelectItem T="int" Value="@tag.Id">@TagOptionLabel(tag)</MudSelectItem>
                    }
                </MudSelect>
                @if (_spc is not null)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@VerdictColor(_spc.Verdict)">
                        @VerdictLabel(_spc.Verdict)
                    </MudChip>
                    <MudText Typo="Typo.caption" Class="dt-muted">
                        @_spc.TagName · 与「参数趋势」页签同一点位
                    </MudText>
                }
                <MudSpacer />
                <MudText Typo="Typo.caption" Class="dt-muted">I-MR 单值移动极差控制图</MudText>
            </MudStack>

            @if (_loadFailed || _trendFailed)
            {
                <MudText Typo="Typo.body2" Class="dt-text-error py-3">统计失败，本页结果已清空。请重试；若持续失败请检查月库是否被占用。</MudText>
            }
            else if (_trendLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-3" />
            }
            else if (_spc is null)
            {
                <MudText Typo="Typo.body2" Class="dt-muted py-3">请先在「参数趋势」页签选择一个数值点位，再回到这里查看过程能力。</MudText>
            }
            else
            {
                @if (_spc.SpecChangedInWindow)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                        区间内规格限变更 @(_spc.Segments.Count - 1) 次，已按变更点分段计算：
                        跨两套规格限算出来的 Cpk 没有意义，而且改限值常与换刀、调机同时发生，
                        那个台阶会把移动极差抬高、控制限跟着失真。
                    </MudAlert>
                    <MudTable Items="_spc.Segments" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="mb-1">
                        <HeaderContent>
                            <MudTh>段</MudTh>
                            <MudTh>时间范围</MudTh>
                            <MudTh>规格限</MudTh>
                            <MudTh>点数</MudTh>
                            <MudTh>Cp</MudTh>
                            <MudTh>Cpk</MudTh>
                            <MudTh>Ppk</MudTh>
                            <MudTh>结论</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="段">@context.Number</MudTd>
                            <MudTd DataLabel="时间范围">@SegmentRangeText(context)</MudTd>
                            <MudTd DataLabel="规格限">@LimitPair(context.LowerLimit, context.UpperLimit)@(context.LimitsFromConfig ? " *" : "")</MudTd>
                            <MudTd DataLabel="点数">@context.Count</MudTd>
                            <MudTd DataLabel="Cp">@SpcCalculator.Format(context.Summary.Cp)</MudTd>
                            <MudTd DataLabel="Cpk">@SpcCalculator.Format(context.Summary.Cpk)</MudTd>
                            <MudTd DataLabel="Ppk">@SpcCalculator.Format(context.Summary.Ppk)</MudTd>
                            <MudTd DataLabel="结论">@VerdictLabel(context.Summary.Verdict)</MudTd>
                        </RowTemplate>
                    </MudTable>
                    @if (_spc.Segments.Any(s => s.LimitsFromConfig))
                    {
                        <MudText Typo="Typo.caption" Class="dt-muted mb-2">
                            带 * 的段没有落库规格限（那批数据早于"限值随记录落库"），按当前配置估计。<InfoHint Topic="HelpTexts.SegmentAsterisk" />
                        </MudText>
                    }
                }

                @for (var index = 0; index < _spc.Segments.Count; index++)
                {
                    var segment = _spc.Segments[index];
                    @if (_spc.SpecChangedInWindow)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">
                            段 @segment.Number · @SegmentRangeText(segment) · 规格限 @LimitPair(segment.LowerLimit, segment.UpperLimit) @_spc.Unit
                        </MudText>
                    }

                    @if (!string.IsNullOrEmpty(segment.Summary.Note))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                            @segment.Summary.Note
                        </MudAlert>
                    }

                    <MudGrid Class="mb-2">
                        <MudItem xs="6" sm="4" md="3" lg="2">
                            <div class="dt-metric">
                                <div class="dt-metric-label">样本数</div>
                                <div class="dt-metric-value">@segment.Summary.Count</div>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" lg="2">
                            <div class="dt-metric">
                                <div class="dt-metric-label">均值</div>
                                <div class="dt-metric-value">@SpcCalculator.Format(segment.Summary.Mean, "0.###")</div>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" lg="2">
                            <div class="dt-metric">
                                <div class="dt-metric-label">Cp</div>
                                <div class="dt-metric-value">@SpcCalculator.Format(segment.Summary.Cp)</div>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" lg="2">
                            <div class="dt-metric">
                                <div class="dt-metric-label">Cpk（组内）<InfoHint Topic="HelpTexts.Capability" /></div>
                                <div class="dt-metric-value">@SpcCalculator.Format(segment.Summary.Cpk)</div>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" lg="2">
                            <div class="dt-metric">
                                <div class="dt-metric-label">Ppk（总体）</div>
                                <div class="dt-metric-value">@SpcCalculator.Format(segment.Summary.Ppk)</div>
                            </div>
                        </MudItem>
                        <MudItem xs="6" sm="4" md="3" lg="2">
                            <div class="dt-metric">
                                <div class="dt-metric-label">σ 组内</div>
                                <div class="dt-metric-value">@SpcCalculator.Format(segment.Summary.WithinStdDev, "0.####")</div>
                            </div>
                        </MudItem>
                    </MudGrid>

                    <MudText Typo="Typo.caption" Class="dt-muted dt-kpi mb-3">
                        规格限 @LimitPair(segment.LowerLimit, segment.UpperLimit) @_spc.Unit
                        @if (segment.LimitsFromConfig)
                        {
                            <span class="dt-text-warning">（未落库，按当前配置估计）</span>
                        }
                        · 目标值 @(_spc.TargetValue?.ToString("0.###") ?? "未配置")
                        · 实测范围 @SpcCalculator.Format(segment.Summary.Min, "0.###") ~ @SpcCalculator.Format(segment.Summary.Max, "0.###")
                        · σ 总体 @SpcCalculator.Format(segment.Summary.OverallStdDev, "0.####")
                        · 控制限 @SpcCalculator.Format(segment.Summary.LowerControlLimit, "0.###") ~ @SpcCalculator.Format(segment.Summary.UpperControlLimit, "0.###")
                        @if (segment.Summary.MeanOffsetInSigma is { } offset)
                        {
                            <text> · 均值偏离基准 @SpcCalculator.Format(offset, "+0.00;-0.00;0.00") σ</text>
                        }
                    </MudText>

                    @if (segment.Count > 0)
                    {
                        <LineChart Series="@_spcCharts[index]" Height="260" SeriesAxisName="采样点"
                                   XStartText="@ShortTime(segment.StartTime)" XEndText="@ShortTime(segment.EndTime)"
                                   ShowPoints="@(segment.Count <= 120)" />
                    }
                }

                @if (_spc.Violations.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="dt-muted mt-3">当前区间内没有触发任何判异准则。</MudText>
                }
                else
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">判异 @_spc.Violations.Count 条</MudText>
                    <MudTable Items="_spc.Violations" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            @if (_spc.SpecChangedInWindow)
                            {
                                <MudTh>段</MudTh>
                            }
                            <MudTh>规则</MudTh>
                            <MudTh>说明</MudTh>
                            <MudTh>采样点</MudTh>
                            <MudTh>时间</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @if (_spc.SpecChangedInWindow)
                            {
                                <MudTd DataLabel="段">@_spc.SegmentNumberOf(context.StartIndex)</MudTd>
                            }
                            <MudTd DataLabel="规则">@RuleLabel(context.Rule)</MudTd>
                            <MudTd DataLabel="说明">@context.Description</MudTd>
                            <MudTd DataLabel="采样点">@(context.StartIndex + 1) ~ @(context.EndIndex + 1)</MudTd>
                            <MudTd DataLabel="时间">@TimeText(context.StartIndex) ~ @TimeText(context.EndIndex)</MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudText Typo="Typo.caption" Class="dt-muted mt-2">
                        已实现 Nelson 规则 1–5：超 3σ、同侧连续 9 点、连续 6 点趋势、连续 14 点振荡、连续 3 点中 2 点超 2σ。
                        其余三条（4/5 点超 1σ、15 点在 1σ 内、8 点在 1σ 外）误报偏多，暂未启用。
                        分段之后规则只在段内连续判定，不会跨过规格限变更点。
                    </MudText>
                }
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    // 默认区间与「近 7 天」预设取齐（含今天共 7 天），否则进页面时没有一个预设是选中态。
    // 当前页签刻意不做受控绑定：MudTabs 的 ActivePanelIndex 是受控参数，用户点页签不会回写，
    // 一旦页面因刷新统计而重渲染，就会把页签弹回第一个 —— 看过程能力时点刷新最容易被弹走。
    private DateTime? _from = DateTime.Today.AddDays(-6);
    private DateTime? _to = DateTime.Today;
    private int? _stationId;
    private int _tagId;
    private IReadOnlyList<Station> _stations = [];
    private List<TagDefinition> _tags = [];
    private IReadOnlyList<DailyThroughput> _fpy = [];
    private IReadOnlyList<RecipeThroughput> _byRecipe = [];
    /// <summary>型号筛选：null/缺省=全部型号；<c>""</c>=未选型号；其它为精确匹配。作用于整份报表。</summary>
    private string? _recipeFilter;
private IssueTopReport _defects = new();
    private IssueTopReport _warnings = new();
    private ProcessCapabilityReport? _spc;

    /// <summary>与 _spc.Segments 一一对应的控制图序列：分段之后每段各画一张图。</summary>
    private IReadOnlyList<IReadOnlyList<LineSeries>> _spcCharts = [];
    private IReadOnlyList<TrendPoint> _trend = [];
    private IReadOnlyList<LineSeries> _trendSeries = [];
    private string _trendAverage = "-";
    private string _trendMin = "-";
    private string _trendMax = "-";
    private string _trendRangeText = "";
    private string _trendFromText = "";
    private string _trendToText = "";
    private bool _loading;
    private bool _loadPending;
    private bool _canExport;

    /// <summary>
    /// 上一轮统计失败了。趋势与过程能力在失败后与"区间内没有采样数据"长得一样，
    /// 不说清楚的话现场会照着"这个点位没数据"去查传感器。
    /// </summary>
    private bool _loadFailed;

    /// <summary>
    /// 趋势与过程能力单次最多统计的采样点数（值见 Domain 的 SystemDefaults，界面文案与它同源）：
    /// 区间取很大时（例如整年）不加限制会把百万级点位拉进内存，而且一张图最多也就画 600 个点、
    /// Cpk 也不该跨太久远的历史。截断时界面会明确说明只统计了最近 N 点，不会悄悄少算。
    /// </summary>
    private bool _trendTruncated;

    /// <summary>支持 /reports?from=…&amp;to=…&amp;station=…&amp;recipe=…&amp;tag=… 直达。</summary>
    [SupplyParameterFromQuery(Name = "from")]
    public string? FromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public string? ToQuery { get; set; }

    [SupplyParameterFromQuery(Name = "station")]
    public int? StationQuery { get; set; }

    /// <summary>型号筛选：<c>recipe=CODE</c> 精确匹配编码，<c>norecipe=1</c> 表示「未选型号」。</summary>
    [SupplyParameterFromQuery(Name = "recipe")]
    public string? RecipeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "norecipe")]
    public int? NoRecipeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "tag")]
    public int? TagQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _canExport = auth.User.IsInRole(AppRoles.Administrator) || auth.User.IsInRole(AppRoles.Engineer);

        ApplyQueryParameters();
        // 工站列表与型号列表都取自同一份配置快照：它按版本号在本电路内缓存，
        // 分头调 GetStationsAsync / GetRecipesAsync 等于把同一批表读两遍、后面 SpcService 再读第三遍。
        var snapshot = await Config.GetSnapshotAsync();
        _stations = snapshot.Stations;
        _knownRecipes = snapshot.Recipes;
        RefreshTags();
        ApplyTagQuery();
        await Load();

        // 首屏（直通率那一屏）已经取完：趋势与过程能力放到它后面去取，进入页面不用干等。
        StartTrendLoadInBackground();
    }

    /// <summary>
    /// 深链接：/reports?from=…&amp;to=…&amp;station=…&amp;recipe=…&amp;tag=… 直达。
    /// 与查询页同一套约定，刷新和转发链接都还在同一批条件上。
    /// </summary>
    private void ApplyQueryParameters()
    {
        if (DateTime.TryParse(FromQuery, out var from))
        {
            _from = from.Date;
        }

        if (DateTime.TryParse(ToQuery, out var to))
        {
            _to = to.Date;
        }

        if (StationQuery is { } station && station > 0)
        {
            _stationId = station;
        }

        if (NoRecipeQuery == 1)
        {
            _recipeFilter = "";
        }
        else if (!string.IsNullOrWhiteSpace(RecipeQuery))
        {
            _recipeFilter = RecipeQuery.Trim();
        }
    }

    /// <summary>点位的默认值是"筛选后第一个数值点位"，只有显式给了 tag 才覆盖。</summary>
    private void ApplyTagQuery()
    {
        if (TagQuery is { } tag && tag > 0 && _tags.Any(t => t.Id == tag))
        {
            _tagId = tag;
        }
    }

    private async Task OnSubmit() => await Load();

    /// <summary>
    /// 同一工站内名称唯一。跨工站一起列时加上工站名，否则三个「工站温度」分不出来。
    /// </summary>
    private string TagOptionLabel(TagDefinition tag)
    {
        if (_tags.Select(t => t.StationId).Distinct().Count() <= 1)
        {
            return tag.Name;
        }

        var station = _stations.FirstOrDefault(s => s.Id == tag.StationId);
        var stationLabel = station is null
            ? ""
            : string.IsNullOrWhiteSpace(station.Name) ? station.Code : station.Name;
        return string.IsNullOrWhiteSpace(stationLabel) ? tag.Name : $"{stationLabel} · {tag.Name}";
    }

    private void RefreshTags()
    {
        _tags = _stations
            .Where(s => _stationId is null || s.Id == _stationId)
            .SelectMany(s => s.Tags)
            .Where(t => t.DataType != PlcDataType.String)
            .OrderBy(t => _stations.First(s => s.Id == t.StationId).Sequence)
            .ThenBy(t => t.Name)
            .ToList();
        if (_tags.All(t => t.Id != _tagId))
        {
            _tagId = _tags.Count > 0 ? _tags[0].Id : 0;
        }
    }
private async Task OnStationChanged(int? stationId)
    {
        _stationId = stationId;
        RefreshTags();
        await Load();
    }

    private async Task OnTagChanged(int tagId)
    {
        _tagId = tagId;
        await Load();
    }


    /// <summary>下拉选项：编码 + 显示文案（文案同时是取值的 ToString，见 <see cref="RecipeFilterValue"/>）。</summary>
    private sealed record RecipeFilterOption(string Code, string Label);

    private IReadOnlyList<RecipeFilterOption> _recipeOptions = [];
    private Dictionary<string, string> _recipeNames = new(StringComparer.Ordinal);

    /// <summary>配置里的型号（含历史编码），用于把旧码归一到当前编码。</summary>
    private IReadOnlyList<Recipe> _knownRecipes = [];
    private DateTime? _recipeOptionsFrom;
    private DateTime? _recipeOptionsTo;

    /// <summary>
    /// 筛选状态 → 下拉取值：null=全部、""=未选型号、其它=编码。
    /// 文案与选项里显示的必须是同一个（都走 <see cref="FormatRecipeOption"/>），
    /// 否则预渲染那一帧画出来的文案会和交互后不一致。
    /// </summary>
    private RecipeFilterValue ToOptionValue(string? recipe)
        => recipe switch
        {
            null => RecipeFilterValue.All,
            "" => RecipeFilterValue.NoRecipe,
            var code => new RecipeFilterValue(code, FormatRecipeOption(code))
        };

    /// <summary>发给统计服务的型号参数：null=不限、空串=未选型号、其它=精确匹配。</summary>
    private string? ToRecipeQueryArg()
        => _recipeFilter is { Length: > 0 } code ? code.Trim() : _recipeFilter;

    private async Task OnRecipeFilterChanged(RecipeFilterValue? value)
    {
        _recipeFilter = value?.Recipe;
        await Load();
    }

    /// <summary>
    /// 选项只在时间区间变化时重建：刷新、切工站、换点位、改型号都复用它，
    /// 否则每次刷新都要重扫一遍区间内的型号编码。
    /// </summary>
    private async Task RefreshRecipeOptionsAsync()
    {
        var from = _from ?? DateTime.Today;
        var to = _to ?? DateTime.Today;
        if (_recipeOptionsFrom == from && _recipeOptionsTo == to)
        {
            return;
        }

        // 区间内出现过的编码（含空）+ 配置里已知型号，避免改码后旧码消失
        var fromRecords = await Store.ListRecipeCodesAsync(from, to);
        var known = _knownRecipes;
        _recipeNames = known
            .GroupBy(r => r.Code, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.First().Name ?? "", StringComparer.Ordinal);

        var codes = new HashSet<string>(StringComparer.Ordinal);
        foreach (var c in fromRecords)
        {
            if (!string.IsNullOrEmpty(c))
                codes.Add(c);
        }
        foreach (var r in known)
        {
            if (!string.IsNullOrEmpty(r.Code))
                codes.Add(r.Code);
        }

        // 当前筛选项若不在集合里也保留（例如刚改码后仍想看旧码）
        if (_recipeFilter is { Length: > 0 } current && !codes.Contains(current))
        {
            codes.Add(current);
        }

        _recipeOptions = codes
            .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
            .Select(c => new RecipeFilterOption(c, FormatRecipeOption(c)))
            .ToList();
        _recipeOptionsFrom = from;
        _recipeOptionsTo = to;
    }

    private string FormatRecipeOption(string code)
    {
        if (_recipeNames.TryGetValue(code, out var name) && !string.IsNullOrWhiteSpace(name))
            return $"{code} · {name}";
        return $"旧编码 {code}";
    }

    private string FormatRecipeRow(string? code)
        => string.IsNullOrEmpty(code) ? "未选型号" : FormatRecipeOption(code);

    /// <summary>
    /// 把改过编码的型号留下的历史编码并回当前编码，再按型号汇总。
    /// </summary>
    /// <remarks>
    /// 改码后区间内会留下新旧两个编码的记录，按字面分组会让同一个型号在表里裂成两行
    /// （旧码那行没有名称，显示成"旧编码 xxx"），而曲线基线是把旧码算作本型号的
    /// （见 <see cref="CurveRecipeScope"/>）—— 两处必须给同一个答案。
    /// </remarks>
    private IReadOnlyList<RecipeThroughput> MergeByRecipe(IReadOnlyList<RecipeThroughput> rows)
        => rows
            .GroupBy(r => CurveRecipeScope.CanonicalCode(r.RecipeCode, _knownRecipes), StringComparer.Ordinal)
            .Select(g => new RecipeThroughput
            {
                RecipeCode = g.Key,
                Total = g.Sum(x => x.Total),
                Ok = g.Sum(x => x.Ok),
                Ng = g.Sum(x => x.Ng),
                Pending = g.Sum(x => x.Pending)
            })
            // 与统计服务同一套排序：未选型号排最后。
            .OrderBy(x => string.IsNullOrEmpty(x.RecipeCode) ? "~" : x.RecipeCode, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private async Task Load()
    {
        if (DateRangeFilter.IsReversed(_from, _to))
        {
            Toast.Add(DateRangeFilter.ReversedRangeMessage, Severity.Warning);
            return;
        }

        // 加载中直接丢弃请求不行：日期控件在加载中没禁用，"先改开始日期、再改结束日期"
        // 会丢掉后者，界面停在旧区间上却显示新日期。把请求记下来，本轮结束立刻按最新条件重跑。
        if (_loading)
        {
            _loadPending = true;
            return;
        }

        _loading = true;
        try
        {
            do
            {
                _loadPending = false;

                var from = DateRangeFilter.StartOf(_from);
                var to = DateRangeFilter.EndOfInclusive(_to);
                // 型号筛选作用于整份报表：口径一致才不会"选了 A100 却看到全部型号的不良"。
                var recipeArg = ToRecipeQueryArg();

                // 下面 4 组查询彼此没有依赖，可以并行：
                // ReportService / RuntimeStore 是无状态的运行时取数 —— 每次调用都用
                // RuntimeDbFactory.Open 新建自己的 RuntimeDbContext（RuntimeStore.cs:42/138/258），
                // 工厂里共享的 _ensured/_gate 也已加锁（RuntimeDbFactory.cs:60-96）；
                // 配置读（配方选项）走 ConfigRepository 的临时 context，各查各的，
                // 不再共用电路里那个 scoped DbContext，所以也能并进来。
                // 工站与型号一样是整份报表的筛选条件：不良/预警不跟着收窄，
                // 选了 ST010 却看到全线的不良榜，现场就会去错工站找原因。
                var recipeOptionsTask = RefreshRecipeOptionsAsync();
                var throughputTask = ReportService.GetThroughputAsync(from, to, _stationId, recipeArg);
                var defectsTask = ReportService.GetDefectTopAsync(from, to, _stationId, recipeCode: recipeArg);
                var warningsTask = ReportService.GetWarningTopAsync(from, to, _stationId, recipeCode: recipeArg);

                // 任一失败，WhenAll 一并抛出 → 走下面的 catch 统一 ClearResults，
                // 与串行时"一次失败整体失败"的语义一致。
                await Task.WhenAll(recipeOptionsTask, throughputTask, defectsTask, warningsTask);

                // 数据全部到手之后，再按原顺序串行做派生计算：MergeByRecipe 依赖
                // RefreshRecipeOptionsAsync 填好的 _knownRecipes，提前执行只会拿到旧值。
                var throughput = await throughputTask;
                _fpy = throughput.ByDay;
                _byRecipe = MergeByRecipe(throughput.ByRecipe);
                _defects = await defectsTask;
                _warnings = await warningsTask;

                // 趋势与过程能力属于另外两个页签，进入本页时用户看的是「直通率」：
                // 那条 2 万点的窄投影（实测 ~170 ms）不该挡在首屏前面，首屏之后再由
                // StartTrendLoadInBackground 补上；这里只在已经取过时跟着条件重取一遍。
                if (_trendLoaded)
                {
                    await LoadTrendAsync();
                }

                _loadFailed = false;
            }
            while (_loadPending);
        }
        catch (Exception ex)
        {
            // 失败时把上一轮结果清掉：进度条一消失还留着旧数字，就是"看着有数、其实是旧的"。
            // Query 页失败时本来就会清 _items/_total，两页不该不一致。
            ClearResults();
            _loadFailed = true;
            Toast.Add($"统计失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            SyncUrl();
        }
    }

    /// <summary>
    /// 把当前条件写回地址栏（默认值不写，保持 /reports 干净）。
    /// 这样刷新和转发链接都还在同一批结果上，不用重新选一遍。
    /// </summary>
    private void SyncUrl()
    {
        var target = CurrentUrl();
        if (Nav.ToBaseRelativePath(Nav.Uri) == target)
        {
            return;
        }

        Nav.NavigateTo(target, replace: true);
    }

    private string CurrentUrl()
    {
        var parts = new List<string>();

        // 默认区间是"近 7 天"，与 DateRangeFilter 的预设取齐，等于默认值就不写进地址。
        var defaultFrom = DateTime.Today.AddDays(-6);
        if (_from is { } from && from.Date != defaultFrom)
        {
            parts.Add($"from={from:yyyy-MM-dd}");
        }

        if (_to is { } to && to.Date != DateTime.Today)
        {
            parts.Add($"to={to:yyyy-MM-dd}");
        }

        if (_stationId is { } station)
        {
            parts.Add($"station={station}");
        }

        if (_recipeFilter is { Length: > 0 } recipe)
        {
            parts.Add($"recipe={Uri.EscapeDataString(recipe.Trim())}");
        }
        else if (_recipeFilter is not null)
        {
            // 未选型号：独立参数，别和真实编码挤同一个 recipe。
            parts.Add("norecipe=1");
        }

        // 点位默认是"筛选后第一个"，等于默认值就不写。
        if (_tagId != 0 && (_tags.Count == 0 || _tagId != _tags[0].Id))
        {
            parts.Add($"tag={_tagId}");
        }

        return parts.Count == 0 ? "reports" : $"reports?{string.Join("&", parts)}";
    }

    private void ClearResults()
    {
        _fpy = [];
        // 这张表也要清：它同样会"进度条一消失还留着旧数字"。
        _byRecipe = [];
        _defects = new();
        _warnings = new();
        ClearTrend();
    }

    /// <summary>
    /// 趋势那一轮已经取过（进入页面时首屏不等它，之后再改条件就跟着一起重取）。
    /// </summary>
    private bool _trendLoaded;

    private bool _trendLoading;

    /// <summary>趋势那一轮的失败：只影响这两个页签，不能把「直通率」也标成失败。</summary>
    private bool _trendFailed;

    /// <summary>页面已销毁：后台那一轮趋势回来时不再碰组件（否则会撞上已释放的渲染器）。</summary>
    private bool _disposed;

    public void Dispose() => _disposed = true;

    private void ClearTrend()
    {
        _spc = null;
        _spcCharts = [];
        _trend = [];
        _trendTruncated = false;
        _trendSeries = [];
        _trendAverage = _trendMin = _trendMax = "-";
        _trendRangeText = _trendFromText = _trendToText = "";
        _trendLoaded = false;
        _trendFailed = false;
    }

    /// <summary>
    /// 首屏出来之后再去取趋势与过程能力（这两个页签不在首屏）。
    /// </summary>
    /// <remarks>
    /// 不 await：进入页面时用户看的是「直通率」，不该为另一屏的那条 2 万点窄投影（真实库上 ~170 ms）
    /// 干等。结果回来时自己重画一次；页面已销毁就直接丢掉，不再碰它。
    /// </remarks>
    private void StartTrendLoadInBackground()
    {
        _ = LoadTrendThenRenderAsync();
    }

    private async Task LoadTrendThenRenderAsync()
    {
        await LoadTrendAsync().ConfigureAwait(true);
        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    /// <summary>
    /// 取趋势样本，并把同一批样本交给过程能力分析（图上画哪些点，Cp/Cpk 就是按哪些点算的）。
    /// 单次上限 +1 是为了分辨"刚好到上限"和"被截断"，截断时要说明白。
    /// </summary>
    private async Task LoadTrendAsync()
    {
        var from = DateRangeFilter.StartOf(_from);
        var to = DateRangeFilter.EndOfInclusive(_to);
        var recipeArg = ToRecipeQueryArg();
        var tagId = _tagId;

        _trendLoading = true;
        try
        {
            var points = tagId != 0
                ? await ReportService.GetTrendAsync(from, to, tagId, recipeArg, SystemDefaults.TrendSampleLimit + 1)
                : [];
            _trendTruncated = points.Count > SystemDefaults.TrendSampleLimit;
            _trend = _trendTruncated ? points.TakeLast(SystemDefaults.TrendSampleLimit).ToList() : points;
            _trendSeries = BuildTrendSeries();
            RefreshTrendStats();

            // 过程能力与趋势是同一点位、同一区间、同一批 2 万点：拿趋势那批（它自带落库规格限）
            // 交给统计服务算，不再让它自己查一遍 —— 那是同一条窄投影跑两次。
            _spc = tagId != 0
                ? await SpcService.AnalyzeAsync(tagId, _trend, from, to, recipeArg)
                : null;
            _spcCharts = _spc?.Segments.Select(BuildSpcSeries).ToList() ?? [];

            _trendLoaded = true;
            _trendFailed = false;
        }
        catch (Exception ex)
        {
            // 与整页失败同一套说法：清掉再报，别让上一轮的图配着新条件的标题。
            ClearTrend();
            _trendFailed = true;
            Toast.Add($"统计失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _trendLoading = false;
        }
    }

    private IReadOnlyList<LineSeries> BuildTrendSeries()
    {
        if (_trend.Count == 0)
        {
            return [];
        }

        var name = _tags.FirstOrDefault(t => t.Id == _tagId)?.Name ?? "数值";
        return
        [
            new LineSeries
            {
                Name = name,
                Values = [.. _trend.Select(p => (float)p.Value)],
                Color = ChartColors.Primary
            }
        ];
    }

    /// <summary>趋势统计：均值/极值一次算好，模板里不再写 lambda。</summary>
    private void RefreshTrendStats()
    {
        if (_trend.Count == 0)
        {
            _trendAverage = _trendMin = _trendMax = "-";
            _trendRangeText = "";
            _trendFromText = "";
            _trendToText = "";
            return;
        }

        var values = _trend.Select(p => p.Value).ToList();
        _trendAverage = values.Average().ToString("0.###", CultureInfo.InvariantCulture);
        _trendMin = values.Min().ToString("0.###", CultureInfo.InvariantCulture);
        _trendMax = values.Max().ToString("0.###", CultureInfo.InvariantCulture);
        _trendRangeText = $"{_trend[0].Time:MM-dd HH:mm} ~ {_trend[^1].Time:MM-dd HH:mm}";
        _trendFromText = _trend[0].Time.ToString("MM-dd HH:mm");
        _trendToText = _trend[^1].Time.ToString("MM-dd HH:mm");
    }

    private double AverageYield()
    {
        var judged = _fpy.Sum(x => x.Ok + x.Ng);
        return judged == 0 ? 0 : (double)_fpy.Sum(x => x.Ok) / judged;
    }

    private double DefectShare(int count)
        => _defects.Total == 0 ? 0 : (double)count / _defects.Total;

    private double WarningShare(int count)
        => _warnings.Total == 0 ? 0 : (double)count / _warnings.Total;

    private static Color YieldColor(double yield) => yield switch
    {
        >= 0.99 => Color.Success,
        >= 0.95 => Color.Warning,
        _ => Color.Error
    };

    private bool _exporting;

    private async Task ExportTrend()
    {
        if (_exporting)
        {
            return;
        }

        if (!_canExport)
        {
            Toast.Add("当前角色无权导出报表数据（需要管理员或工程师）", Severity.Warning);
            return;
        }

        // 趋势样本按需取：用户可能一次都没点开那两个页签就直接导出。
        if (!_trendLoaded)
        {
            await LoadTrendAsync();
        }

        if (_trend.Count == 0)
        {
            // 取数失败时 LoadTrendAsync 已经报过原因，这里不再叠一条。
            if (!_trendFailed)
            {
                Toast.Add("当前条件下没有可导出的趋势点", Severity.Warning);
            }

            return;
        }

        _exporting = true;
        // 条数先定格：下载是异步的，中途点刷新会把 _trend 换掉，
        // 于是提示与审计里的条数跟真正导出去的那份对不上。
        var count = _trend.Count;
        try
        {
            var rows = _trend.Select(p => new[]
            {
                p.Time.ToString("yyyy-MM-dd HH:mm:ss"),
                p.Value.ToString("0.####", CultureInfo.InvariantCulture),
                p.PalletCode
            });
            var csv = CsvExporter.Build(["时间", "数值", "托盘码"], rows);
            await Js.InvokeVoidAsync("dtDownload", CsvExporter.FileName("datatrace_trend"), CsvExporter.ToBase64(csv));
        }
        catch (Exception ex)
        {
            // JS 互操失败（连接断了、浏览器拦下下载）抛出去会断掉整条 circuit，页面直接卡死。
            Toast.Add($"导出失败：{ex.Message}", Severity.Error);
            return;
        }
        finally
        {
            _exporting = false;
        }

        var message = $"已导出 {count} 个趋势点";

        // 文件已经下载完了：审计写库失败不能报成"导出失败"，现场会以为没导出去而重导。
        try
        {
            await WriteExportAuditAsync(count);
            Toast.Add(message, Severity.Success);
        }
        catch (Exception ex)
        {
            Toast.Add($"{message}，但审计记录写入失败：{ex.Message}", Severity.Warning);
        }
    }

    private async Task WriteExportAuditAsync(int count)
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        var user = auth.User.Identity?.Name ?? "";
        var recipe = _recipeFilter switch
        {
            null => "全部",
            "" => "未选型号",
            var code => code.Trim()
        };
        var tag = _tags.FirstOrDefault(t => t.Id == _tagId);
        // 键放"导的是哪个区间"，条件与条数放变更列：与查询页、明细页的写法一致。
        var key = $"{DateRangeFilter.StartOf(_from):yyyy-MM-dd}~{DateRangeFilter.StartOf(_to):yyyy-MM-dd}";
        var summary =
            $"station={_stationId?.ToString() ?? "全部"};tag={tag?.Name ?? _tagId.ToString()};" +
            $"recipe={recipe};points={count}";
        await Audit.WriteAsync(user, "Export", "Report", key, null, summary);
    }

    /// <summary>
    /// 一段的控制图：该段实测序列 + 该段自己的三条常量线（UCL / CL / LCL）。
    /// 常量序列参与量程计算，因此控制限一定落在可视范围内，不会被裁掉。
    /// </summary>
    private IReadOnlyList<LineSeries> BuildSpcSeries(ProcessCapabilitySegment segment)
    {
        if (_spc is null)
        {
            return [];
        }

        var values = _spc.Samples.Skip(segment.StartIndex).Take(segment.Count)
            .Select(p => (float)p.Value).ToArray();
        if (values.Length == 0)
        {
            return [];
        }

        var summary = segment.Summary;
        var name = $"实测 {_spc.TagName}{(_spc.SpecChangedInWindow ? $" 段 {segment.Number}" : "")}";

        return
        [
            new LineSeries
            {
                Name = name,
                Values = values,
                Color = ChartColors.Primary,
                Unit = _spc.Unit
            },
            ConstantSeries("UCL", summary.UpperControlLimit, values.Length, ChartColors.Alert),
            ConstantSeries("CL", summary.CenterLine, values.Length, ChartColors.Secondary),
            ConstantSeries("LCL", summary.LowerControlLimit, values.Length, ChartColors.Alert)
        ];
    }

    /// <summary>
    /// 控制限的常量线：两点就够 —— 它画出来就是一条水平线，X 轴靠首尾两点定位。
    /// 原来按样本数铺一条等长数组（最多两万个相同的值 × 3 条线 × 每段），
    /// 而折线图反正只会留下几百个点：白造数组，还白扫两万个数一遍。
    /// </summary>
    private static LineSeries ConstantSeries(string name, double value, int count, string color)
    {
        var v = (float)value;
        return count > 1
            ? new LineSeries { Name = name, Values = [v, v], XValues = [0f, count - 1], Color = color }
            : new LineSeries { Name = name, Values = [v], XValues = [0f], Color = color };
    }

    private string TimeText(int sampleIndex)
        => _spc?.TimeAt(sampleIndex) is { } time ? time.ToString("MM-dd HH:mm:ss") : "-";

    private static string ShortTime(DateTime time) => time.ToString("MM-dd HH:mm");

    private static string SegmentRangeText(ProcessCapabilitySegment segment)
        => $"{ShortTime(segment.StartTime)} ~ {ShortTime(segment.EndTime)}";

    private static string LimitPair(double? lower, double? upper)
    {
        if (lower is null && upper is null)
        {
            return "未配置";
        }

        return $"{lower?.ToString("0.###", CultureInfo.InvariantCulture) ?? "-"} ~ {upper?.ToString("0.###", CultureInfo.InvariantCulture) ?? "-"}";
    }

    private static string VerdictLabel(SpcVerdict verdict) => verdict switch
    {
        SpcVerdict.Capable => "过程能力达标 Cpk ≥ 1.33",
        SpcVerdict.Marginal => "过程能力勉强 1.00 ≤ Cpk < 1.33",
        SpcVerdict.Incapable => "过程能力不足 Cpk < 1.00",
        _ => "数据不足，不下结论"
    };

    private static Color VerdictColor(SpcVerdict verdict) => verdict switch
    {
        SpcVerdict.Capable => Color.Success,
        SpcVerdict.Marginal => Color.Warning,
        SpcVerdict.Incapable => Color.Error,
        _ => Color.Default
    };

    private static string RuleLabel(SpcRule rule) => rule switch
    {
        SpcRule.BeyondControlLimit => "规则 1 · 超 3σ",
        SpcRule.NineOnOneSide => "规则 2 · 同侧连续",
        SpcRule.SixMonotonic => "规则 3 · 持续趋势",
        SpcRule.FourteenAlternating => "规则 4 · 系统性振荡",
        SpcRule.TwoOfThreeBeyondTwoSigma => "规则 5 · 2/3 超 2σ",
        _ => rule.ToString()
    };
}

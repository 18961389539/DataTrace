@page "/alarms"
@attribute [Authorize]
@implements IDisposable
@using DataTrace.Application.Alarms
@using DataTrace.Application.Configuration
@using DataTrace.Domain.Constants
@using Microsoft.AspNetCore.Components.Authorization
@inject IAlarmIncidents Incidents
@inject ILineAlarmBoard Board
@inject AuthenticationStateProvider Auth
@inject DtToast Toast
@inject IConfigRepository Config

<PageHeader Title="报警" HelpRoute="alarms" Busy="@_refreshing" Description="还没人接手的会一直留在这里，并在所有页面顶部响铃。静音只关本机声音。" />

@if (_loadError is not null)
{
    @* 读取失败时整页换错误态：原来只换掉"待处理"那半屏，"最近结束"照常渲染，
       于是同屏出现「报警加载失败」和「还没有已经接手并解除的报警」，把故障读成了空数据。 *@
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
        <div class="d-flex align-center flex-wrap gap-2">
            <span>@_loadError</span>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="_refreshing" OnClick="@(() => Reload(pushBoard: false))">
                重试
            </MudButton>
        </div>
    </MudAlert>
}
else
{
<MudGrid Class="mb-3">
    <MudItem xs="12" sm="4">
        <MudSelect T="int?" @bind-Value="_stationFilter" @bind-Value:after="ResetPages" Label="报警工站" Clearable="true">
            <MudSelectItem T="int?" Value="@((int?)0)">全线／会话报警</MudSelectItem>
            @foreach (var station in StationOptions)
            {
                <MudSelectItem T="int?" Value="@((int?)station.Id)">@station.Label</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudSelect T="LineAlarmKind?" @bind-Value="_kindFilter" @bind-Value:after="ResetPages" Label="报警类型" Clearable="true">
            @foreach (var kind in Enum.GetValues<LineAlarmKind>())
            {
                <MudSelectItem T="LineAlarmKind?" Value="@((LineAlarmKind?)kind)">@KindText(kind)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4" Class="d-flex align-center flex-wrap gap-2">
        <MudCheckBox T="bool" @bind-Value="_mineOnly" @bind-Value:after="ResetPages" Label="我的已接手" />
        <MudButton StartIcon="@Icons.Material.Filled.FilterAltOff" Size="Size.Small" OnClick="ResetFilters">清空筛选</MudButton>
    </MudItem>
</MudGrid>
<section class="mb-3" aria-label="报警状态查询模式">
    <MudText Typo="Typo.subtitle2" Class="mb-1">按状态查看</MudText>
    <div role="group" aria-label="报警状态快捷筛选" class="d-flex flex-wrap gap-2">
        <MudButton Size="Size.Small" Variant="@ViewVariant(AlarmView.All)" Color="@ViewColor(AlarmView.All)"
                   aria-pressed="@ViewPressed(AlarmView.All)" OnClick="@(() => SetView(AlarmView.All))">
            全部
        </MudButton>
        <MudButton Size="Size.Small" Variant="@ViewVariant(AlarmView.Current)" Color="@ViewColor(AlarmView.Current)"
                   aria-pressed="@ViewPressed(AlarmView.Current)" OnClick="@(() => SetView(AlarmView.Current))">
            当前／仍在发生 (@CurrentCount)
        </MudButton>
        <MudButton Size="Size.Small" Variant="@ViewVariant(AlarmView.RecoveredUnowned)" Color="@ViewColor(AlarmView.RecoveredUnowned)"
                   aria-pressed="@ViewPressed(AlarmView.RecoveredUnowned)" OnClick="@(() => SetView(AlarmView.RecoveredUnowned))">
            已恢复待接手 (@RecoveredUnownedCount)
        </MudButton>
        <MudButton Size="Size.Small" Variant="@ViewVariant(AlarmView.AcknowledgedOrResolved)" Color="@ViewColor(AlarmView.AcknowledgedOrResolved)"
                   aria-pressed="@ViewPressed(AlarmView.AcknowledgedOrResolved)" OnClick="@(() => SetView(AlarmView.AcknowledgedOrResolved))">
            已接手／已解除 (@AcknowledgedOrResolvedCount)
        </MudButton>
    </div>
    <MudText Typo="Typo.caption" Class="dt-muted mt-1">
        @_viewDescription；工站、类型和“我的已接手”筛选会同步作用于计数与列表。最近已解除只查询最新 30 条。
    </MudText>
</section>
@if (VisibleAttentionCount == 0 && FilteredRecent.Count == 0 && _attention.Count + _recent.Count > 0)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">当前状态与筛选条件没有匹配的报警。</MudAlert>
}
else if (VisibleAttentionCount == 0 && FilteredRecent.Count == 0)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-3">
        当前查询范围内没有报警。
    </MudAlert>
}
else
{
    @if (NeedsOwner.Count > 0)
    {
        <MudText Typo="Typo.subtitle1" Class="mb-2">@NeedsOwnerTitle @NeedsOwner.Count</MudText>
        @if (!_canTake)
        {
            <MudText Typo="Typo.body2" Class="dt-muted mb-2">当前账号是访客，只能查看，不能接手。</MudText>
        }
        <MudTable Items="PagedNeedsOwner" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="mb-2">
            <HeaderContent>
                <MudTh>优先级</MudTh>
                <MudTh>发生时间</MudTh>
                <MudTh>持续时间</MudTh>
                <MudTh>类型</MudTh>
                <MudTh>内容</MudTh>
                <MudTh>状态</MudTh>
                <MudTh>接手</MudTh>
                <MudTh>定位</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="优先级">@PriorityText(context.Kind)</MudTd>
                <MudTd DataLabel="发生时间">@When(context.RaisedAt)</MudTd>
                <MudTd DataLabel="持续时间">@DurationText(context, _now)</MudTd>
                <MudTd DataLabel="类型">@KindText(context.Kind)</MudTd>
                <MudTd DataLabel="内容">@context.Message</MudTd>
                <MudTd DataLabel="状态">@StatusText(context)</MudTd>
                <MudTd DataLabel="接手">@OwnerText(context)</MudTd>
                <MudTd DataLabel="定位">
                    @{ var action = ActionFor(context); }
                    @if (action.Href is not null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ChevronRight"
                                   Href="@action.Href">@action.Label</MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="dt-muted">需要工程师或管理员</MudText>
                    }
                    @if (_canTake && context.Kind == LineAlarmKind.ConsecutiveNg)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.ReportProblem" Href="@CreateQualityIncidentUrl(context.Id)">
                            创建质量异常
                        </MudButton>
                    }
                </MudTd>
                <MudTd DataLabel="操作">
                    @if (_canTake)
                    {
                        @* 进度落在本行：一次只处理一条，行内能看清当前进度。 *@
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   Disabled="_working"
                                   StartIcon="@(_workingId == context.Id ? Icons.Material.Filled.Sync : null)"
                                   OnClick="@(() => Take(context))">
                            @(_workingId == context.Id ? "接手中…" : "接手")
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4 flex-wrap" Spacing="2">
            <MudPagination Count="@PageCount(NeedsOwner.Count)" Selected="@PageNumber(NeedsOwner.Count, _needsOwnerPage)"
                           SelectedChanged="SetNeedsOwnerPage" Disabled="false" aria-label="待接手报警分页" />
            <MudText Typo="Typo.caption" Class="dt-muted">
                待接手报警：第 @PageNumber(NeedsOwner.Count, _needsOwnerPage) / @PageCount(NeedsOwner.Count) 页，共 @NeedsOwner.Count 条，每页 @PageSize 条
            </MudText>
        </MudStack>
    }
    @if (AcknowledgedOpen.Count > 0)
    {
        <MudText Typo="Typo.subtitle1" Class="mb-2">@AcknowledgedOpenTitle @AcknowledgedOpen.Count</MudText>
        <MudTable Items="PagedAcknowledgedOpen" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="mb-2 dt-acknowledged-alarms">
            <HeaderContent>
                <MudTh>优先级</MudTh>
                <MudTh>发生时间</MudTh>
                <MudTh>持续时间</MudTh>
                <MudTh>类型</MudTh>
                <MudTh>内容</MudTh>
                <MudTh>状态</MudTh>
                <MudTh>接手人</MudTh>
                <MudTh>定位</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="优先级">@PriorityText(context.Kind)</MudTd>
                <MudTd DataLabel="发生时间">@When(context.RaisedAt)</MudTd>
                <MudTd DataLabel="持续时间">@DurationText(context, _now)</MudTd>
                <MudTd DataLabel="类型">@KindText(context.Kind)</MudTd>
                <MudTd DataLabel="内容">@context.Message</MudTd>
                <MudTd DataLabel="状态">@StatusText(context)</MudTd>
                <MudTd DataLabel="接手人">@OwnerText(context)</MudTd>
                <MudTd DataLabel="定位">
                    @{ var action = ActionFor(context); }
                    @if (action.Href is not null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ChevronRight"
                                   Href="@action.Href">@action.Label</MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="dt-muted">需要工程师或管理员</MudText>
                    }
                    @if (_canTake && context.Kind == LineAlarmKind.ConsecutiveNg)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.ReportProblem" Href="@CreateQualityIncidentUrl(context.Id)">
                            创建质量异常
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4 flex-wrap" Spacing="2">
            <MudPagination Count="@PageCount(AcknowledgedOpen.Count)" Selected="@PageNumber(AcknowledgedOpen.Count, _acknowledgedPage)"
                           SelectedChanged="SetAcknowledgedPage" Disabled="false" aria-label="已接手报警分页" />
            <MudText Typo="Typo.caption" Class="dt-muted">
                已接手未解除：第 @PageNumber(AcknowledgedOpen.Count, _acknowledgedPage) / @PageCount(AcknowledgedOpen.Count) 页，共 @AcknowledgedOpen.Count 条，每页 @PageSize 条
            </MudText>
        </MudStack>
    }
}

@if (ShowRecent)
{
    @* 历史归档与待办分开呈现，避免旧的已解除记录挤在当前报警之前。 *@
    <MudText Typo="Typo.subtitle1" Class="mb-2 dt-archived-title">最近已解除 @FilteredRecent.Count</MudText>
    @if (FilteredRecent.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="dt-muted">@(_recent.Count == 0 ? "还没有已经接手并解除的报警。" : "当前筛选没有最近已解除的报警。")</MudText>
    }
    else
    {
        <MudTable Items="PagedRecent" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="mb-2 dt-archived-table">
            <HeaderContent>
                <MudTh>优先级</MudTh>
                <MudTh>发生时间</MudTh>
                <MudTh>解除时间</MudTh>
                <MudTh>持续时间</MudTh>
                <MudTh>类型</MudTh>
                <MudTh>内容</MudTh>
                <MudTh>接手</MudTh>
                <MudTh>处置</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="优先级">@PriorityText(context.Kind)</MudTd>
                <MudTd DataLabel="发生时间">@When(context.RaisedAt)</MudTd>
                <MudTd DataLabel="解除时间">@When(context.ClearedAt)</MudTd>
                <MudTd DataLabel="持续时间">@DurationText(context, _now)</MudTd>
                <MudTd DataLabel="类型">@KindText(context.Kind)</MudTd>
                <MudTd DataLabel="内容">@context.Message</MudTd>
                <MudTd DataLabel="接手">@OwnerText(context)</MudTd>
                <MudTd DataLabel="处置">
                    @if (_canTake && context.Kind == LineAlarmKind.ConsecutiveNg)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.ReportProblem" Href="@CreateQualityIncidentUrl(context.Id)">
                            创建质量异常
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4 flex-wrap" Spacing="2">
            <MudPagination Count="@PageCount(FilteredRecent.Count)" Selected="@PageNumber(FilteredRecent.Count, _recentPage)"
                           SelectedChanged="SetRecentPage" Disabled="false" aria-label="最近已解除报警分页" />
            <MudText Typo="Typo.caption" Class="dt-muted">
                最近已解除：第 @PageNumber(FilteredRecent.Count, _recentPage) / @PageCount(FilteredRecent.Count) 页，共 @FilteredRecent.Count 条，每页 @PageSize 条
            </MudText>
        </MudStack>
    }
}
}

@code {
    private const int PageSize = 25;
    private enum AlarmView { All, Current, RecoveredUnowned, AcknowledgedOrResolved }

    private IReadOnlyList<AlarmIncidentDraft> _attention = [];
    private IReadOnlyList<AlarmIncidentDraft> _recent = [];
    private IReadOnlyList<Station> _stations = [];
    private int? _stationFilter;
    private LineAlarmKind? _kindFilter;
    private bool _mineOnly;
    private AlarmView _alarmView = AlarmView.All;
    private int _needsOwnerPage = 1;
    private int _acknowledgedPage = 1;
    private int _recentPage = 1;
    private string? _actor;
    private DateTime _now = DateTime.Now;
    private readonly CancellationTokenSource _durationCts = new();
    private IReadOnlyList<AlarmIncidentDraft> FilteredAttention => _attention.Where(Matches).ToList();
    private IReadOnlyList<AlarmIncidentDraft> FilteredRecent => ShowRecent
        ? SortByPriority(_recent.Where(Matches))
        : [];
    private IReadOnlyList<AlarmIncidentDraft> NeedsOwner => SortByPriority(FilteredAttention.Where(item =>
        item.NeedsOwner && (_alarmView switch
        {
            AlarmView.Current => item.StillActive,
            AlarmView.RecoveredUnowned => !item.StillActive,
            AlarmView.AcknowledgedOrResolved => false,
            _ => true
        })));
    private IReadOnlyList<AlarmIncidentDraft> AcknowledgedOpen => SortByPriority(FilteredAttention.Where(item =>
        !item.NeedsOwner
        && (_alarmView is AlarmView.All or AlarmView.Current or AlarmView.AcknowledgedOrResolved)
        && (_alarmView != AlarmView.Current || item.StillActive)));
    private IReadOnlyList<AlarmIncidentDraft> PagedNeedsOwner => PageItems(NeedsOwner, _needsOwnerPage);
    private IReadOnlyList<AlarmIncidentDraft> PagedAcknowledgedOpen => PageItems(AcknowledgedOpen, _acknowledgedPage);
    private IReadOnlyList<AlarmIncidentDraft> PagedRecent => PageItems(FilteredRecent, _recentPage);
    private int VisibleAttentionCount => NeedsOwner.Count + AcknowledgedOpen.Count;
    private bool ShowRecent => _alarmView is AlarmView.All or AlarmView.AcknowledgedOrResolved;
    private int CurrentCount => FilteredAttention.Count(item => item.StillActive);
    private int RecoveredUnownedCount => FilteredAttention.Count(item => !item.StillActive && item.NeedsOwner);
    private int AcknowledgedOrResolvedCount => FilteredAttention.Count(item => !item.NeedsOwner) + FilteredRecent.Count;
    private string NeedsOwnerTitle => _alarmView switch
    {
        AlarmView.Current => "当前报警，待接手",
        AlarmView.RecoveredUnowned => "已恢复，待接手",
        _ => "待接手"
    };
    private string AcknowledgedOpenTitle => _alarmView == AlarmView.Current
        ? "当前报警，已接手"
        : "已接手，尚未解除";
    private string _viewDescription => _alarmView switch
    {
        AlarmView.Current => "当前模式：只显示仍在发生的报警（包含已接手记录）",
        AlarmView.RecoveredUnowned => "当前模式：只显示条件已恢复、仍待接手的报警",
        AlarmView.AcknowledgedOrResolved => "当前模式：显示已接手未解除，以及最近 30 条已解除记录",
        _ => "当前模式：显示全部待处理记录，以及最近 30 条已解除记录"
    };
    private IEnumerable<(int Id, string Label)> StationOptions => _stations.Select(station => (station.Id, $"{station.Code} {station.Name}"))
        .Concat(_attention.Concat(_recent).Select(StationOf).Where(id => id > 0).Distinct()
            .Where(id => _stations.All(station => station.Id != id)).Select(id => (id, $"历史工站 #{id}")));

    private static int StationOf(AlarmIncidentDraft item)
    {
        if (item.Kind is not (LineAlarmKind.ConsecutiveNg or LineAlarmKind.ConsecutiveWarning or LineAlarmKind.ProcessDrift
            or LineAlarmKind.StationFault or LineAlarmKind.ConsecutiveProcess)) return 0;
        var parts = item.Key.Split(':');
        return parts.Length >= 2 && int.TryParse(parts[1], out var id) && id > 0 ? id : 0;
    }

    private bool Matches(AlarmIncidentDraft item)
        => (_stationFilter is null || StationOf(item) == _stationFilter)
           && (_kindFilter is null || item.Kind == _kindFilter)
           && (!_mineOnly || item.AcknowledgedAt is not null && !string.IsNullOrEmpty(_actor)
               && string.Equals(item.AcknowledgedBy, _actor, StringComparison.OrdinalIgnoreCase));

    private static IReadOnlyList<AlarmIncidentDraft> SortByPriority(IEnumerable<AlarmIncidentDraft> items)
        => items.OrderByDescending(item => PriorityRank(item.Kind))
            .ThenByDescending(item => item.RaisedAt)
            .ThenByDescending(item => item.Id)
            .ToList();

    private static int PriorityRank(LineAlarmKind kind) => kind switch
    {
        LineAlarmKind.HeartbeatStale or LineAlarmKind.StationFault or LineAlarmKind.DiskLow
            or LineAlarmKind.CollectionOverdue => 3,
        LineAlarmKind.ConsecutiveNg or LineAlarmKind.ConsecutiveProcess
            or LineAlarmKind.MesBacklog or LineAlarmKind.SpoolBacklog => 2,
        _ => 1
    };

    private static string PriorityText(LineAlarmKind kind) => PriorityRank(kind) switch
    {
        3 => "紧急",
        2 => "高",
        _ => "提示"
    };

    private Variant ViewVariant(AlarmView view) => _alarmView == view ? Variant.Filled : Variant.Outlined;
    private Color ViewColor(AlarmView view) => _alarmView == view ? Color.Primary : Color.Default;
    private string ViewPressed(AlarmView view) => _alarmView == view ? "true" : "false";

    private void SetView(AlarmView view)
    {
        _alarmView = view;
        ResetPages();
    }

    private void ResetFilters()
    {
        _stationFilter = null;
        _kindFilter = null;
        _mineOnly = false;
        ResetPages();
    }

    private void ResetPages()
    {
        _needsOwnerPage = 1;
        _acknowledgedPage = 1;
        _recentPage = 1;
    }

    private static int PageCount(int count) => Math.Max(1, (int)Math.Ceiling(count / (double)PageSize));

    private static int PageNumber(int count, int page) => Math.Clamp(page, 1, PageCount(count));

    private static IReadOnlyList<AlarmIncidentDraft> PageItems(IReadOnlyList<AlarmIncidentDraft> items, int page)
        => items.Skip((PageNumber(items.Count, page) - 1) * PageSize).Take(PageSize).ToList();

    private Task SetNeedsOwnerPage(int page) { _needsOwnerPage = PageNumber(NeedsOwner.Count, page); return Task.CompletedTask; }
    private Task SetAcknowledgedPage(int page) { _acknowledgedPage = PageNumber(AcknowledgedOpen.Count, page); return Task.CompletedTask; }
    private Task SetRecentPage(int page) { _recentPage = PageNumber(FilteredRecent.Count, page); return Task.CompletedTask; }

    private static string DurationText(AlarmIncidentDraft item, DateTime now)
    {
        var duration = (item.ClearedAt ?? now) - item.RaisedAt;
        if (duration < TimeSpan.Zero) duration = TimeSpan.Zero;
        return duration.TotalHours >= 1 ? $"{(long)duration.TotalHours} 小时 {duration.Minutes} 分"
            : $"{(int)duration.TotalMinutes} 分 {duration.Seconds} 秒";
    }

    private async Task UpdateDurationAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
            while (await timer.WaitForNextTickAsync(_durationCts.Token))
                await InvokeAsync(() => { _now = DateTime.Now; StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }
    private string? _loadError;
    private bool _canTake;
    private bool _canDiagnose;
    /// <summary>有任意一条在接手时为 true：其余行的按钮一起禁用，防止并发写同一条。</summary>
    private bool _working;
    /// <summary>正在接手的那一条：进度显示在它自己的按钮上，而不是整表一起灰。</summary>
    private long? _workingId;
    private bool _refreshing;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        _actor = user.Identity?.Name;
        try { _stations = (await Config.GetSnapshotAsync()).Stations; }
        catch (Exception) { _stations = []; }
        _canTake = user.IsInRole(AppRoles.Administrator)
                   || user.IsInRole(AppRoles.Engineer)
                   || user.IsInRole(AppRoles.Operator);
        _canDiagnose = user.IsInRole(AppRoles.Administrator) || user.IsInRole(AppRoles.Engineer);
        Board.Changed += OnChanged;
        await Reload(pushBoard: false);
        _ = UpdateDurationAsync();
    }

    private void OnChanged() => _ = InvokeAsync(() => Reload(pushBoard: false));

    private async Task Take(AlarmIncidentDraft item)
    {
        if (_working || !item.NeedsOwner)
        {
            return;
        }

        _working = true;
        _workingId = item.Id;
        try
        {
            var actor = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
            var result = await Incidents.AcknowledgeAsync(item.Id, actor);
            if (!result.Found)
            {
                Toast.Add("这条报警已经不在", Severity.Warning);
            }
            else if (result.AlreadyTaken)
            {
                Toast.Add($"已由 {result.TakenBy} 接手", Severity.Info);
            }
            else
            {
                Toast.Add("已接手", Severity.Success);
            }

            if (result.AuditError is { } auditError)
            {
                Toast.Add($"操作已完成，但审计记录失败：{auditError}", Severity.Warning);
            }

            await Reload(pushBoard: true);
        }
        catch (Exception ex)
        {
            Toast.Add($"接手失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _working = false;
            _workingId = null;
        }
    }

    private async Task Reload(bool pushBoard)
    {
        if (_refreshing)
        {
            return;
        }

        _refreshing = true;
        try
        {
            _attention = await Incidents.ListAttentionAsync();
            _recent = await Incidents.ListRecentClosedAsync(30);
            _loadError = null;
            if (pushBoard)
            {
                Board.Replace(new LineAlarmSnapshot(_attention.Where(item => item.NeedsOwner).Select(ToAlarm).ToList()));
            }
        }
        catch (Exception ex)
        {
            // 不清空上一次读到的数据：清空之后"最近结束"那半屏会渲染成「还没有已经接手并解除的报警」，
            // 与错误提示同屏自相矛盾，把一次读取故障说成了"确实没有报警"。错误面板已经盖住整页。
            _loadError = $"报警加载失败：{ex.Message}";
        }
        finally
        {
            _refreshing = false;
        }
    }

    private static LineAlarm ToAlarm(AlarmIncidentDraft item)
        => new(
            item.Key,
            item.Kind,
            item.StillActive ? item.Message : item.Message + "（已恢复，仍待接手）");

    private static string KindText(LineAlarmKind kind) => kind switch
    {
        LineAlarmKind.HeartbeatStale => "采集心跳",
        LineAlarmKind.MesBacklog => "MES 积压",
        LineAlarmKind.ConsecutiveNg => "连续不合格",
        LineAlarmKind.StationFault => "工站故障",
        LineAlarmKind.SpoolBacklog => "补传积压",
        LineAlarmKind.ConsecutiveProcess => "连续采集失败",
        LineAlarmKind.SessionSuperseded => "托盘被盖掉",
        LineAlarmKind.ConsecutiveWarning => "连续预警",
        LineAlarmKind.ProcessDrift => "过程漂移",
        LineAlarmKind.OpenSession => "在制超时",
        LineAlarmKind.DiskLow => "磁盘空间",
        _ => kind.ToString()
    };

    private static string StatusText(AlarmIncidentDraft item)
    {
        if (item.NeedsOwner)
        {
            return item.StillActive ? "待接手" : "已恢复，待接手";
        }

        return "已接手，尚未解除";
    }

    private static string OwnerText(AlarmIncidentDraft item)
        => item.AcknowledgedBy is null ? "—" : $"{item.AcknowledgedBy} {When(item.AcknowledgedAt)}";

    private (string Label, string? Href) ActionFor(AlarmIncidentDraft item)
    {
        var kind = item.Kind;
        if (!_canDiagnose && kind is not LineAlarmKind.ConsecutiveNg
            and not LineAlarmKind.ConsecutiveWarning and not LineAlarmKind.ProcessDrift)
        {
            return ("需授权", null);
        }

        var keyParts = item.Key.Split(':');
        var station = keyParts.Length >= 2 && int.TryParse(keyParts[1], out var stationId) && stationId > 0
            ? $"&station={stationId}" : "";
        var tag = keyParts.Length >= 3 && int.TryParse(keyParts[2], out var tagId) && tagId > 0
            ? $"&tag={tagId}" : "";
        var range = $"&from={item.RaisedAt.AddDays(-1):yyyy-MM-dd}&to={(item.ClearedAt ?? DateTime.Now):yyyy-MM-dd}";
        return kind switch
        {
            LineAlarmKind.MesBacklog => ("查看 MES 状态", "/config/settings"),
            LineAlarmKind.ConsecutiveNg => ("查看 NG 记录", "/query?judge=Ng" + station + range),
            LineAlarmKind.ConsecutiveWarning or LineAlarmKind.ProcessDrift => ("查看过程报表", "/reports?" + (station + tag + range).TrimStart('&')),
            LineAlarmKind.SessionSuperseded or LineAlarmKind.OpenSession => ("打开产品追溯",
                keyParts.Length == 2 && long.TryParse(keyParts[1], out var sessionId) && sessionId > 0
                    ? $"/query?view=trace&sessionId={sessionId}" : "/query?view=trace"),
            LineAlarmKind.StationFault or LineAlarmKind.ConsecutiveProcess => ("打开运行诊断", "/diagnostics" + (station.Length > 0 ? "?" + station.TrimStart('&') : "")),
            _ => ("打开运行诊断", "/diagnostics")
        };
    }

    private static string CreateQualityIncidentUrl(long alarmId)
        => $"/quality/incidents/new?alarmId={alarmId}";

    private static string When(DateTime? time)
        => time?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—";

    public void Dispose()
    {
        Board.Changed -= OnChanged;
        _durationCts.Cancel();
        _durationCts.Dispose();
    }
}

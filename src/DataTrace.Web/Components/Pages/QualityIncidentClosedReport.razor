@page "/quality/incidents/closed-report"
@attribute [Authorize]
@using DataTrace.Application.Configuration
@using DataTrace.Application.Quality
@using DataTrace.Domain.Constants
@using DataTrace.Domain.Enums
@using DataTrace.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject IQualityIncidentService Incidents
@inject IConfigRepository Config
@inject IAuditLogger Audit
@inject AuthenticationStateProvider Auth
@inject DtToast Toast
@inject IJSRuntime Js
@inject NavigationManager Nav

<PageHeader Title="结案报表" Description="已关闭质量异常单的原因分类、措施与复核汇总。" HelpRoute="quality/incidents">
    <ChildContent>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">共 @_total 张</MudChip>
    </ChildContent>
    <Actions>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/quality/incidents">返回处置台</MudButton>
        @if (_canExport)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload"
                       Disabled="@(_loading || _exporting || _total == 0)" OnClick="ExportAsync">
                @(_exporting ? "导出中…" : "导出结案 CSV")
            </MudButton>
        }
    </Actions>
</PageHeader>

<MudPaper Class="dt-filter-card mb-3" Elevation="0" Outlined="true">
    <MudGrid Class="dt-filters">
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_closedFrom" Label="结案起" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker @bind-Date="_closedTo" Label="结案止" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="int?" @bind-Value="_stationId" Label="工站" Clearable="true" Dense="true">
                @foreach (var station in _stations)
                {
                    <MudSelectItem T="int?" Value="@((int?)station.Id)">@station.Code @station.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField T="string" @bind-Value="_keyword" Label="单号或关键字" Clearable="true" Immediate="true"
                          OnKeyDown="OnSearchKeyDown" />
        </MudItem>
    </MudGrid>
    <MudStack Row="true" Spacing="2" Class="mt-2 flex-wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                   Disabled="_loading" OnClick="SearchAsync">查询</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt"
                   Disabled="_loading" OnClick="ResetAsync">重置</MudButton>
        <MudText Typo="Typo.caption" Class="dt-muted align-self-center">按结案时间筛选；汇总与列表同条件。</MudText>
    </MudStack>
</MudPaper>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
            <span>@_error</span>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">重试</MudButton>
        </MudStack>
    </MudAlert>
}
else
{
    <MudGrid Class="mb-3">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-3" Outlined="true">
                <MudText Typo="Typo.subtitle2">结案总数</MudText>
                <MudText Typo="Typo.h5">@_total</MudText>
                <MudText Typo="Typo.caption" Class="dt-muted">平均关闭时长 @AverageDurationText</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-3" Outlined="true">
                <MudText Typo="Typo.subtitle2" Class="mb-2">按等级</MudText>
                @if (_severityCounts.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="dt-muted">暂无</MudText>
                }
                else
                {
                    @foreach (var pair in _severityCounts.OrderByDescending(p => p.Value))
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudChip T="string" Size="Size.Small" Color="@SeverityColor(pair.Key)">@SeverityText(pair.Key)</MudChip>
                            <MudText>@pair.Value</MudText>
                        </MudStack>
                    }
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-3" Outlined="true">
                <MudText Typo="Typo.subtitle2" Class="mb-2">按原因分类</MudText>
                @if (_causeCounts.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="dt-muted">暂无</MudText>
                }
                else
                {
                    @foreach (var pair in _causeCounts.Take(8))
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                            <MudText Typo="Typo.body2">@pair.Key</MudText>
                            <MudText>@pair.Value</MudText>
                        </MudStack>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudTable Items="_items" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Loading="_loading"
              FixedHeader="true" Height="var(--dt-grid-height)" Class="dt-list-table">
        <HeaderContent>
            <MudTh>单号</MudTh>
            <MudTh>标题</MudTh>
            <MudTh>等级</MudTh>
            <MudTh>工站 / 型号</MudTh>
            <MudTh>源流水号</MudTh>
            <MudTh>原因分类</MudTh>
            <MudTh>结案时间</MudTh>
            <MudTh>时长(h)</MudTh>
            <MudTh>复核人</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="单号" Class="dt-nowrap">
                <MudLink Href="@($"/quality/incidents/{context.Id}")">@context.IncidentNumber</MudLink>
            </MudTd>
            <MudTd DataLabel="标题">@context.Title</MudTd>
            <MudTd DataLabel="等级">
                <MudChip T="string" Size="Size.Small" Color="@SeverityColor(context.Severity)">@SeverityText(context.Severity)</MudChip>
            </MudTd>
            <MudTd DataLabel="工站 / 型号">
                <span>@(string.IsNullOrWhiteSpace(context.StationCode) ? "全部工站" : context.StationCode)</span>
                @if (!string.IsNullOrWhiteSpace(context.RecipeCode))
                {
                    <MudText Typo="Typo.caption" Class="dt-muted">@context.RecipeCode</MudText>
                }
            </MudTd>
            <MudTd DataLabel="源流水号" Class="dt-nowrap">@(context.SourceSerialNo ?? "—")</MudTd>
            <MudTd DataLabel="原因分类">@(context.CauseCategory ?? "—")</MudTd>
            <MudTd DataLabel="结案时间" Class="dt-nowrap">@context.ClosedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd DataLabel="时长(h)" Class="dt-num">@context.DurationHours.ToString("0.##")</MudTd>
            <MudTd DataLabel="复核人">@context.ClosedBy</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="dt-muted py-3">当前条件下没有已关闭的异常单。</MudText>
        </NoRecordsContent>
    </MudTable>

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-2 flex-wrap gap-2">
        <MudText Typo="Typo.caption" Class="dt-muted">第 @_page / @PageCount 页 · 共 @_total 张</MudText>
        <MudPagination Count="PageCount" Selected="_page" SelectedChanged="OnPageChanged"
                       BoundaryCount="1" MiddleCount="2" Disabled="_loading" />
    </MudStack>
}

@code {
    private static readonly int PageSize = 50;
    private IReadOnlyList<QualityIncidentClosedReportItem> _items = [];
    private IReadOnlyList<DataTrace.Domain.Entities.Station> _stations = [];
    private IReadOnlyDictionary<string, int> _causeCounts = new Dictionary<string, int>();
    private IReadOnlyDictionary<QualityIncidentSeverity, int> _severityCounts = new Dictionary<QualityIncidentSeverity, int>();
    private DateTime? _closedFrom = DateTime.Today.AddDays(-30);
    private DateTime? _closedTo = DateTime.Today;
    private int? _stationId;
    private string? _keyword;
    private int _page = 1;
    private int _total;
    private bool _loading;
    private bool _exporting;
    private bool _canExport;
    private string? _error;
    private double _averageHours;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_total / (double)PageSize));
    private string AverageDurationText => _total == 0 ? "—" : $"{_averageHours:0.##} 小时";

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _canExport = auth.User.IsInRole(AppRoles.Administrator) || auth.User.IsInRole(AppRoles.Engineer);
        _stations = await Config.GetStationsAsync();
        await LoadAsync();
    }


    private async Task SearchAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task ResetAsync()
    {
        _closedFrom = DateTime.Today.AddDays(-30);
        _closedTo = DateTime.Today;
        _stationId = null;
        _keyword = null;
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = Math.Clamp(page, 1, PageCount);
        await LoadAsync();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task LoadAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        try
        {
            var result = await Incidents.ListClosedReportAsync(BuildQuery((_page - 1) * PageSize, PageSize));
            _items = result.Items;
            _total = result.Total;
            _causeCounts = result.CauseCategoryCounts;
            _severityCounts = result.SeverityCounts;
            _averageHours = result.AverageDurationHours;

            if (_page > PageCount)
            {
                _page = PageCount;
            }

            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"结案报表加载失败：{ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private QualityIncidentClosedReportQuery BuildQuery(int skip, int take) => new()
    {
        ClosedFrom = _closedFrom?.Date,
        ClosedTo = _closedTo?.Date.AddDays(1).AddTicks(-1),
        StationId = _stationId,
        Keyword = _keyword,
        Skip = skip,
        Take = take
    };

    private async Task ExportAsync()
    {
        if (_loading || _exporting || _total == 0)
        {
            return;
        }

        if (!_canExport)
        {
            Toast.Add("当前角色无权导出（需要管理员或工程师）", Severity.Warning);
            return;
        }

        _exporting = true;
        try
        {
            var items = new List<QualityIncidentClosedReportItem>();
            var skip = 0;
            const int take = 200;
            int total;
            do
            {
                var page = await Incidents.ListClosedReportAsync(BuildQuery(skip, take));
                items.AddRange(page.Items);
                total = page.Total;
                skip += page.Items.Count;
                if (page.Items.Count == 0)
                {
                    break;
                }
            } while (items.Count < total && items.Count < SystemDefaults.ExportRowLimit);

            if (items.Count == 0)
            {
                Toast.Add("没有可导出的结案记录", Severity.Warning);
                return;
            }

            var csv = CsvExporter.Build(
                [
                    "单号", "标题", "等级", "工站", "型号", "负责人", "创建人", "创建时间",
                    "结案时间", "复核人", "关闭时长小时", "原因分类", "处置措施", "验证结论",
                    "复核意见", "源流水号", "源托盘码", "证据数"
                ],
                items.Select(item => (IEnumerable<string?>)[
                    item.IncidentNumber,
                    item.Title,
                    SeverityText(item.Severity),
                    item.StationCode,
                    item.RecipeCode,
                    item.Owner,
                    item.CreatedBy,
                    item.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss"),
                    item.ClosedAt.ToString("yyyy-MM-dd HH:mm:ss"),
                    item.ClosedBy,
                    item.DurationHours.ToString("0.##"),
                    item.CauseCategory,
                    item.ActionTaken,
                    item.VerificationResult,
                    item.ReviewComment,
                    item.SourceSerialNo,
                    item.SourcePalletCode,
                    item.EvidenceCount.ToString()
                ]));

            await Js.InvokeVoidAsync(
                "dtDownload",
                CsvExporter.FileName("quality_closed_report"),
                CsvExporter.ToBase64(csv));

            var user = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
            var filters = $"from={_closedFrom:yyyy-MM-dd};to={_closedTo:yyyy-MM-dd};station={_stationId};q={_keyword}";
            await Audit.WriteAsync(user, "Export", "QualityIncidentClosedReport", filters, null,
                $"exported={items.Count};total={total}");
            Toast.Add($"已导出结案报表 {items.Count} 张", Severity.Success);
        }
        catch (Exception ex)
        {
            Toast.Add($"导出失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    private static string SeverityText(QualityIncidentSeverity severity) => severity switch
    {
        QualityIncidentSeverity.Low => "低",
        QualityIncidentSeverity.Medium => "中",
        QualityIncidentSeverity.High => "高",
        QualityIncidentSeverity.Critical => "紧急",
        _ => "未知"
    };

    private static Color SeverityColor(QualityIncidentSeverity severity) => severity switch
    {
        QualityIncidentSeverity.High or QualityIncidentSeverity.Critical => Color.Error,
        QualityIncidentSeverity.Medium => Color.Warning,
        _ => Color.Default
    };
}
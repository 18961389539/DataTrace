@page "/simulate"
@attribute [Authorize(Roles = "Administrator,Engineer")]
@implements IDisposable
@using DataTrace.Application.Configuration
@using DataTrace.Collector
@using DataTrace.Domain.Entities
@using DataTrace.Domain.Validation
@using DataTrace.Plc.Simulator
@inject IConfigRepository Config
@inject ILineSimulator Simulator
@inject SimulatorCatalog Simulators
@inject IDialogService DialogService
@inject DtToast Toast
@inject CustomerBrandingStore Branding
@inject IAuditLogger Audit
@inject AuthenticationStateProvider Auth

<PageHeader Title="PLC 仿真"
            Description="模拟 PLC 内存与产线节拍：自动生成托盘码、点位、位移压力曲线，按工站顺序触发并等待上位机回写 2–8。"
            HelpRoute="simulate">
    <ChildContent>
        @if (Dirty)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">有未保存的参数</MudChip>
        }
    </ChildContent>
</PageHeader>

<NavigationLock ConfirmExternalNavigation="@Dirty" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4">
            @if (ProductionLocksAutoRun)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mb-2">
                    Production 环境已锁定关闭「启动后自动跑仿真」（SimulatorAutoRun），避免现场误开仿真。
                    开发/演示环境仍可在本页切换。
                </MudAlert>
                <MudSwitch T="bool" Value="false" Disabled="true" Label="自动跑线（Production 已锁定关闭）" Color="Color.Primary" />
            }
            else
            {
                <MudSwitch T="bool" Value="_auto" ValueChanged="OnAutoChanged" Label="自动跑线" Color="Color.Primary" />
            }
            <MudNumericField @bind-Value="_interval" @bind-Value:after="() => _intervalError = null" Immediate="true"
                             Label="托盘间隔(ms)" Min="@SettingsLimits.MinSimulatorIntervalMs" Max="@SettingsLimits.MaxSimulatorIntervalMs"
                             Error="@(_intervalError is not null)" ErrorText="@_intervalError" />
            <InfoHint Topic="HelpTexts.SimPalletInterval" />
            <MudNumericField @bind-Value="_ng" @bind-Value:after="() => _ngError = null" Immediate="true"
                             Label="NG 比例(%)" Min="@SettingsLimits.MinSimulatorNgPercent" Max="@SettingsLimits.MaxSimulatorNgPercent"
                             Error="@(_ngError is not null)" ErrorText="@_ngError" />
            <InfoHint Topic="HelpTexts.SimNgPercent" />
            <MudNumericField @bind-Value="_pool" @bind-Value:after="() => _poolError = null" Immediate="true"
                             Label="托盘池数量(复用)" Min="@SettingsLimits.MinSimulatorPalletPool" Max="@SettingsLimits.MaxSimulatorPalletPool"
                             HelperText="自动跑线循环使用的托盘码个数；填 1 时每轮都是同一个码"
                             Error="@(_poolError is not null)" ErrorText="@_poolError" />
            <MudButton Class="mt-2" Variant="@(Dirty ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                       OnClick="SaveOptions" Disabled="_saving"
                       StartIcon="@(_saving ? Icons.Material.Filled.Sync : Icons.Material.Filled.Save)">
                @(_saving ? "保存中…" : Dirty ? "保存参数（有改动）" : "保存参数")
            </MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.subtitle1">状态</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@(_status.Running ? Color.Success : Color.Default)">
                    @(_status.Running ? "自动跑线中" : "已停止")
                </MudChip>
                <MudSpacer />
                <MudText Typo="Typo.caption" Class="dt-muted">
                    最近触发：@(_status.LastTriggerTime?.ToString("HH:mm:ss") ?? "-")
                </MudText>
            </MudStack>

            <MudGrid Spacing="2">
                <MudItem xs="6" sm="3">
                    <div class="dt-metric">
                        <div class="dt-metric-label">当前托盘</div>
                        <div class="dt-metric-value">@(_status.CurrentPallet ?? "-")</div>
                    </div>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <div class="dt-metric">
                        <div class="dt-metric-label">当前工站</div>
                        <div class="dt-metric-value">@(_status.CurrentStation ?? "-")</div>
                    </div>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <div class="dt-metric">
                        <div class="dt-metric-label">最近回写<InfoHint Topic="HelpTexts.SimLastWriteBack" /></div>
                        <div class="dt-metric-value">@(_status.LastResultCode is { } c ? ResultCodes.Describe(c) : "-")</div>
                    </div>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <div class="dt-metric">
                        <div class="dt-metric-label">累计托盘 / 工站</div>
                        <div class="dt-metric-value">@_status.CompletedPallets / @_status.CompletedStations</div>
                    </div>
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@_status.LastMessage</MudText>

            <MudDivider Class="my-3" />

            <MudTextField @bind-Value="_pallet" @bind-Value:after="ValidatePallet" Label="指定托盘码"
                          HelperText="走完整条线时用这个码，留空则不执行" Immediate="true"
                          Error="@(_palletError is not null)" ErrorText="@_palletError" />

            @if (_running || _triggering is not null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" />
                <MudText Typo="Typo.caption" Class="dt-muted">
                    @(_running ? $"正在走完 {_pallet} 的整条线（逐站触发并等待回写）…" : $"正在触发 {_triggering}…")
                </MudText>
            }

            <MudButton Class="ma-1 mt-2" Variant="Variant.Filled" Color="Color.Primary" OnClick="RunOne"
                       Disabled="_busy" StartIcon="@(_running ? Icons.Material.Filled.Sync : Icons.Material.Filled.PlayArrow)">
                @(_running ? "走线中…" : "走完一条线")
            </MudButton>
            <InfoHint Topic="HelpTexts.SimRunLine" />
            @foreach (var station in _stations)
            {
                <MudButton Class="ma-1 mt-2" Variant="Variant.Outlined" OnClick="@(() => Trigger(station))"
                           Disabled="@(_busy || _triggering == station.Code)"
                           StartIcon="@(_triggering == station.Code ? Icons.Material.Filled.Sync : Icons.Material.Filled.Bolt)">
                    触发 @station.Code
                </MudButton>
            }
            @if (_stations.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="dt-muted d-block mt-2">
                    还没有启用的工站，先到「工站配置」创建工站后再来仿真。
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="dt-muted d-block mt-2">
                    单站触发只把该站的触发寄存器置位；采集端下一轮扫描才会采集。
                    从非首站开始时，若该托盘还没有在制会话，采集端会按「跳站」记一条异常记录。
                </MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private bool ProductionLocksAutoRun =>
        Branding.EnvironmentName.Equals("Production", StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<Station> _stations = [];
    private Dictionary<int, PlcConnection> _plcs = new();
    private string _pallet = "P0001";
    private string? _palletError;

    /// <summary>
    /// 可编辑的仿真参数用可空 int 承接：输入框被清空或敲进非法字符时得到 null，
    /// 而不是被 MudNumericField 悄悄夹成下限（托盘池被夹成 1 会让每轮都用同一个托盘码）。
    /// </summary>
    private int? _interval;
    private int? _ng;
    private int? _pool;
    private int _loadedInterval;
    private int _loadedNg;
    private int _loadedPool;
    private string? _intervalError;
    private string? _ngError;
    private string? _poolError;
    private bool _auto;
    private bool _saving;
    private bool _running;
    private bool _disposed;
    private string? _triggering;
    private LineSimulatorStatus _status = new();

    /// <summary>参数改了但没点「保存参数」：提示 + 拦一下离开本页。</summary>
    private bool Dirty
        => _interval != _loadedInterval || _ng != _loadedNg || _pool != _loadedPool;

    /// <summary>三个动作共用同一条模拟产线，任一在跑时全部按钮都锁住，避免交错触发把状态机搅乱。</summary>
    private bool _busy => _saving || _running || _triggering is not null;

    protected override async Task OnInitializedAsync()
    {
        // 先订阅再 await。反过来写时，用户在加载那一下秒退，Dispose 会跑在 += 之前，
        // 单例模拟器上就留下一条永远不会被取消的订阅，之后每次推送都对已释放组件 InvokeAsync。
        Simulator.Changed += OnChanged;

        var snapshot = await Config.GetSnapshotAsync();
        _stations = snapshot.Stations.Where(s => s.Enabled).OrderBy(s => s.Sequence).ToList();
        _plcs = snapshot.PlcConnections.ToDictionary(x => x.Id);
        _auto = snapshot.Settings.SimulatorAutoRun || Simulator.Status.Running;
        if (ProductionLocksAutoRun)
        {
            _auto = false;
        }
        _interval = snapshot.Settings.SimulatorIntervalMs;
        _ng = snapshot.Settings.SimulatorNgPercent;
        _pool = snapshot.Settings.SimulatorPalletPool;
        _loadedInterval = snapshot.Settings.SimulatorIntervalMs;
        _loadedNg = snapshot.Settings.SimulatorNgPercent;
        _loadedPool = snapshot.Settings.SimulatorPalletPool;
        _status = Simulator.Status;
    }

    private void OnChanged()
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            _status = Simulator.Status;
            _auto = _status.Running;
            StateHasChanged();
        });
    }

    private async Task OnAutoChanged(bool value)
    {
        // 打开就会往运行时库里写仿真记录，关掉没有副作用，所以只在"打开"这个方向上拦一道。
        if (value)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "启动自动跑线",
                "启动后仿真器会按工站顺序持续产生记录并写入运行时库。" +
                "如果这台机器接的是真实 PLC，请先确认采集已停用。确定启动？",
                yesText: "启动", cancelText: "取消");
            if (confirmed != true)
            {
                return;
            }
        }

        _auto = value;
        Simulator.SetRunning(value);
        // 只落开关本身：三个参数各自由「保存参数」提交，避免开关把没点保存的改动顺手存下去（或反过来被参数校验挡住）。
        await PersistAsync(value ? "Enable" : "Disable", includeOptions: false);
    }

    private void ValidatePallet()
        => _palletError = string.IsNullOrWhiteSpace(_pallet) ? "托盘码不能为空"
            : _pallet.Trim().Length > 64 ? "托盘码最长 64 个字符"
            : null;

    /// <summary>
    /// 写审计日志。失败时单独提示一次，而不是吞掉 —— 仿真会往运行库写记录，
    /// "谁开的仿真器、什么时候改的参数"必须留得下痕。
    /// </summary>
    private async Task AuditSafe(string action, string key, string? oldValue, string? newValue)
    {
        try
        {
            var user = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
            await Audit.WriteAsync(user, action, "LineSimulator", key, oldValue, newValue);
        }
        catch (Exception ex)
        {
            Toast.Add($"审计记录失败：{ex.Message}", Severity.Warning);
        }
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (!Dirty)
        {
            return;
        }

        var ok = await DialogService.ShowMessageBox(
            "参数未保存",
            "仿真参数改过但还没点「保存参数」，离开本页将丢失这些改动。确定离开？",
            yesText: "离开", cancelText: "留下");
        if (ok != true)
        {
            context.PreventNavigation();
        }
    }

    private async Task SaveOptions()
    {
        if (!ValidateOptions())
        {
            return;
        }

        await PersistAsync("SaveOptions", includeOptions: true);
    }

    /// <summary>
    /// 落库仿真配置。<paramref name="includeOptions"/> 为 false 时只写"自动跑线"开关。
    /// </summary>
    private async Task PersistAsync(string auditAction, bool includeOptions)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        try
        {
            var settings = (await Config.GetSnapshotAsync()).Settings;
            var oldValues = SummarizeOptions(settings);
            settings.SimulatorAutoRun = ProductionLocksAutoRun ? false : _auto;
            if (includeOptions)
            {
                settings.SimulatorIntervalMs = _interval!.Value;
                settings.SimulatorNgPercent = _ng!.Value;
                settings.SimulatorPalletPool = _pool!.Value;
            }

            await Config.SaveSettingsAsync(settings);
            if (includeOptions)
            {
                _loadedInterval = settings.SimulatorIntervalMs;
                _loadedNg = settings.SimulatorNgPercent;
                _loadedPool = settings.SimulatorPalletPool;
            }

            await AuditSafe(auditAction, "simulator", oldValues, SummarizeOptions(settings));
            Toast.Add(
                includeOptions
                    ? "仿真参数已保存"
                    : settings.SimulatorAutoRun ? "自动跑线已开启" : "自动跑线已停止",
                Severity.Success);
        }
        catch (Exception ex)
        {
            // 配置库写入失败如果抛给 Blazor，整条 circuit 会断掉，现场只看到页面卡死。
            Toast.Add($"保存仿真参数失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string SummarizeOptions(SystemSettings s)
        => $"autoRun={s.SimulatorAutoRun}; interval={s.SimulatorIntervalMs}; ng={s.SimulatorNgPercent}; pool={s.SimulatorPalletPool}";

    /// <summary>
    /// 保存前校验三个参数：空值（输入框被清空/敲进非法字符）与越界都拦下来。
    /// </summary>
    /// <remarks>
    /// 不能任由输入框自己"夹到边界"：托盘间隔夹成 500ms 会让写库频率翻几倍、
    /// 托盘池夹成 1 会让每轮都是同一个托盘码，而提示却是"仿真参数已保存"。
    /// </remarks>
    private bool ValidateOptions()
    {
        _intervalError = _interval is not { } interval ? "托盘间隔不能为空"
            : SettingsLimits.SimulatorIntervalError(interval);
        _ngError = _ng is not { } ng ? "NG 比例不能为空"
            : SettingsLimits.SimulatorNgPercentError(ng);
        _poolError = _pool is not { } pool ? "托盘池数量不能为空"
            : SettingsLimits.SimulatorPalletPoolError(pool);

        var bad = new[] { _intervalError, _ngError, _poolError }.Count(x => x is not null);
        if (bad == 0)
        {
            return true;
        }

        Toast.Add($"{bad} 项填写有误，已标在对应输入框下（未保存）", Severity.Warning);
        return false;
    }

    private async Task RunOne()
    {
        if (_busy)
        {
            return;
        }

        ValidatePallet();
        if (_palletError is not null)
        {
            return;
        }

        _running = true;
        try
        {
            // 按真实结果提示：中途超时只走了半条线，不能报成"已走线"。
            var result = await Simulator.RunOnePalletAsync(_pallet.Trim());
            await AuditSafe("RunPallet", _pallet.Trim(), null,
                result.Completed ? "completed" : $"stopped; station={result.StoppedAtStation}");
            Toast.Add(result.Message, result.Completed ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            Toast.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _running = false;
        }
    }

    private async Task Trigger(Station station)
    {
        if (_busy)
        {
            return;
        }

        if (!_plcs.TryGetValue(station.PlcConnectionId, out var plc) || plc.Brand != PlcBrand.Simulator)
        {
            Toast.Add("该工站未绑定模拟 PLC", Severity.Warning);
            return;
        }

        // 非首站单点触发：采集端找不到在制会话时会把这条记成"跳站"异常，先说清楚再动手。
        if (!station.IsFirstStation)
        {
            var confirmed = await DialogService.ShowMessageBox(
                $"触发 {station.Code}",
                $"{station.Code} 不是首站。若托盘 {_pallet.Trim()} 当前没有在制会话，" +
                "采集端会把这条记录判为「未找到在制托盘会话（可能跳站）」并建一个异常会话。确定继续？",
                yesText: "继续触发", cancelText: "取消");
            if (confirmed != true)
            {
                return;
            }
        }

        _triggering = station.Code;
        try
        {
            var driver = Simulators.Get(plc.Id);
            if (!driver.IsConnected)
            {
                await driver.ConnectAsync();
            }

            SimulatorScenario.LoadStationCycle(driver, plc, station, _pallet.Trim());
            await AuditSafe("TriggerStation", $"{station.Code}/{_pallet.Trim()}", null, "triggered");
            Toast.Add($"已触发 {station.Code}", Severity.Success);
        }
        catch (Exception ex)
        {
            Toast.Add($"触发 {station.Code} 失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _triggering = null;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Simulator.Changed -= OnChanged;
    }
}

    private static readonly string[] AttentionOrder =
    [
        "diag-manual", "diag-spool", "diag-mes", "diag-health", "diag-loop", "diag-plc", "diag-latency"
    ];

    private bool SectionNeedsAttention(string sectionId) => sectionId switch
    {
        "diag-manual" => _manualReviewPending.Count > 0,
        "diag-spool" => _spoolCount > 0,
        "diag-mes" => (_mesOutbox?.PendingCount ?? 0) > 0,
        "diag-health" => UnhealthyCount > 0 || _healthError is not null,
        "diag-loop" => LoopStale || _loop.OverrunCount > 0,
        "diag-plc" => DisconnectedPlcCount > 0,
        "diag-latency" => HotLatencyCount > 0,
        _ => false
    };

    private async Task JumpNextAttentionAsync()
    {
        var current = _jumpTarget switch
        {
            "manual" => "diag-manual",
            "spool" => "diag-spool",
            "mes" => "diag-mes",
            "health" => "diag-health",
            "loop" => "diag-loop",
            "plc" => "diag-plc",
            "latency" => "diag-latency",
            _ => null
        };
        var start = current is null ? -1 : Array.IndexOf(AttentionOrder, current);
        for (var offset = 1; offset <= AttentionOrder.Length; offset++)
        {
            var idx = (start + offset + AttentionOrder.Length) % AttentionOrder.Length;
            var candidate = AttentionOrder[idx];
            if (SectionNeedsAttention(candidate))
            {
                await JumpAsync(candidate);
                return;
            }
        }
    }


@page "/diagnostics"
@attribute [Authorize(Roles = "Administrator,Engineer")]
@using System.Text
@using DataTrace.Application.Realtime
@using DataTrace.Application.Configuration
@using DataTrace.Application.Runtime
@using DataTrace.Application.Identity
@using DataTrace.Collector
@using DataTrace.Domain.Constants
@using DataTrace.Domain.Entities
@using DataTrace.Shared
@implements IAsyncDisposable
@inject ICollectorDiagnostics Diag
@inject IRuntimeStatusHub RuntimeStatus
@inject IHealthProbe Probe
@inject ISpoolStore Spool
@inject SpoolReplayRunner Runner
@inject IDialogService Dialogs
@inject DtToast Toast
@inject IJSRuntime Js
@inject IConfigRepository Config
@inject IConfigurationAuthorizer Authorizer
@inject AuthenticationStateProvider Auth
@inject IConfirmationRecoveryService ConfirmationRecovery

@* 这一页的职责是回答"为什么变慢了、为什么没采上"，不是"这一件为什么判 NG"。
   所以三块内容都只读、只活在内存里，不参与看板的实时推送 —— 观测手段不该反过来成为负担。 *@
<PageHeader Title="运行诊断" HelpRoute="diagnostics" Busy="@_busy"
            Description="看采集进程这一会儿在干什么：扫描慢在哪、PLC 在发什么、写库失败的件还堵在哪。数据只在内存里，重启即清空。">
    <ChildContent>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="@SummaryChipClass("health")"
                 Color="@(UnhealthyCount > 0 ? Color.Error : Color.Default)"
                 OnClick="@(() => JumpAsync("diag-health"))" title="跳到系统健康">
            健康异常 @UnhealthyCount
        </MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="@SummaryChipClass("loop")"
                 Color="@(LoopStale || _loop.OverrunCount > 0 ? Color.Error : Color.Default)"
                 OnClick="@(() => JumpAsync("diag-loop"))" title="跳到采集循环">
            @(LoopStale ? "循环停滞" : $"超时 {_loop.OverrunCount}")
        </MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="@SummaryChipClass("plc")"
                 Color="@(DisconnectedPlcCount > 0 ? Color.Error : Color.Default)"
                 OnClick="@(() => JumpAsync("diag-plc"))" title="跳到 PLC 通信">
            PLC 断连 @DisconnectedPlcCount
        </MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="@SummaryChipClass("spool")"
                 Color="@(_spoolCount > 0 ? Color.Warning : Color.Default)"
                 OnClick="@(() => JumpAsync("diag-spool"))" title="跳到补传队列">
            补传积压 @_spoolCount
        </MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="@SummaryChipClass("manual")"
                 Color="@(_manualReviewPending.Count > 0 ? Color.Warning : Color.Default)"
                 OnClick="@(() => JumpAsync("diag-manual"))" title="跳到人工核对">
            待核对 @_manualReviewPending.Count
        </MudChip>
        @if ((_mesOutbox?.PendingCount ?? 0) > 0)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="@SummaryChipClass("mes")"
                     Color="Color.Warning" OnClick="@(() => JumpAsync("diag-mes"))" title="跳到 MES 出站">
                MES @_mesOutbox!.PendingCount
            </MudChip>
        }
    </ChildContent>
    <Actions>
        <MudText Typo="Typo.caption" Class="dt-muted">@RefreshCaption</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Text"
                   StartIcon="@(_paused ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause)"
                   OnClick="TogglePauseAsync">@(_paused ? "继续刷新" : "暂停刷新")</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy"
                   OnClick="CopyDigestAsync">复制诊断摘要</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.History"
                   Href="/logs">审计日志</MudButton>
    </Actions>
</PageHeader>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
        <div class="d-flex align-center flex-wrap gap-2">
            <span>@_loadError</span>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="@(() => RefreshAsync(showBusy: true))">重试</MudButton>
        </div>
    </MudAlert>
}

@if (RuntimeStatus.CollectionReadiness is { Ready: false } readiness)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-3">
        <MudText Typo="Typo.subtitle2">采集启动核对未完成，当前扫描被阻止</MudText>
        <MudText Typo="Typo.body2">@(readiness.Reason ?? "请检查运行日志并完成数据核对。")</MudText>
        <MudText Typo="Typo.caption">最近检查 @readiness.CheckedAt.ToString("yyyy-MM-dd HH:mm:ss")；此阻塞会在诊断页刷新时更新。</MudText>
    </MudAlert>
}

@if (HasActionableItems)
{
    <div class="dt-diag-action-callout" role="status">
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">需要处置</MudChip>
        <MudText Typo="Typo.caption" Class="dt-muted">按优先级：核对 → 补传 → MES</MudText>
        @if (_manualReviewPending.Count > 0)
        {
            <span>待人工核对 @_manualReviewPending.Count</span>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                       OnClick="@(() => JumpAsync("diag-manual"))">去核对</MudButton>
        }
        @if (_spoolCount > 0)
        {
            <span>
                补传积压 @_spoolCount
                @if (_spoolOldest is { } oldest)
                {
                    <span class="dt-diag-action-callout-age">· 最早已等 @WaitText(AgeReference - oldest)</span>
                }
            </span>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="@(() => JumpAsync("diag-spool"))">去补传</MudButton>
        }
        @if ((_mesOutbox?.PendingCount ?? 0) > 0)
        {
            <span>MES 待推送 @_mesOutbox!.PendingCount</span>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => JumpAsync("diag-mes"))">查看</MudButton>
        }
    </div>
}
else if (_onlyIssues && _loadError is null)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="dt-diag-clean mb-3">
        当前没有需要处置的异常。关闭「只看异常」可查看全部观测数据。
    </MudAlert>
}

<div class="dt-diag-toolbar" aria-label="诊断导航与偏好">
    <div class="dt-diag-section-nav" role="navigation" aria-label="分区跳转">
        <MudButton Size="Size.Small" Variant="@NavVariant("health")" Color="@NavColor(UnhealthyCount > 0)" Class="@NavClass("health")"
                   OnClick="@(() => JumpAsync("diag-health"))">健康@(UnhealthyCount > 0 ? $" {UnhealthyCount}" : "")</MudButton>
        <MudButton Size="Size.Small" Variant="@NavVariant("loop")" Color="@NavColor(LoopStale || _loop.OverrunCount > 0)" Class="@NavClass("loop")"
                   OnClick="@(() => JumpAsync("diag-loop"))">循环@(LoopStale ? "!" : _loop.OverrunCount > 0 ? $" {_loop.OverrunCount}" : "")</MudButton>
        <MudButton Size="Size.Small" Variant="@NavVariant("plc")" Color="@NavColor(DisconnectedPlcCount > 0)" Class="@NavClass("plc")"
                   OnClick="@(() => JumpAsync("diag-plc"))">PLC@(DisconnectedPlcCount > 0 ? $" {DisconnectedPlcCount}" : "")</MudButton>
        <MudButton Size="Size.Small" Variant="@NavVariant("latency")" Color="@NavColor(HotLatencyCount > 0)" Class="@NavClass("latency")"
                   OnClick="@(() => JumpAsync("diag-latency"))">耗时@(HotLatencyCount > 0 ? $" {HotLatencyCount}" : "")</MudButton>
        <MudButton Size="Size.Small" Variant="@NavVariant("manual")" Color="@NavColor(_manualReviewPending.Count > 0)" Class="@NavClass("manual")"
                   OnClick="@(() => JumpAsync("diag-manual"))">核对@(_manualReviewPending.Count > 0 ? $" {_manualReviewPending.Count}" : "")</MudButton>
        <MudButton Size="Size.Small" Variant="@NavVariant("spool")" Color="@NavColor(_spoolCount > 0)" Class="@NavClass("spool")"
                   OnClick="@(() => JumpAsync("diag-spool"))">补传@(_spoolCount > 0 ? $" {_spoolCount}" : "")</MudButton>
        <MudButton Size="Size.Small" Variant="@NavVariant("mes")" Color="@NavColor((_mesOutbox?.PendingCount ?? 0) > 0)" Class="@NavClass("mes")"
                   OnClick="@(() => JumpAsync("diag-mes"))">MES@((_mesOutbox?.PendingCount ?? 0) > 0 ? $" {_mesOutbox!.PendingCount}" : "")</MudButton>
    </div>
    <MudCheckBox T="bool" @bind-Value="_onlyIssues" @bind-Value:after="PersistOnlyIssuesAsync" Label="只看异常" Dense="true" Color="Color.Primary" />
    <div class="dt-diag-ops">
        <MudText Typo="Typo.caption" Class="dt-muted">@RefreshCaption</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="dt-diag-ops-btn"
                   StartIcon="@Icons.Material.Filled.NextPlan"
                   Disabled="@(!HasJumpableAttention)"
                   title="跳到下一处需要关注的分区" aria-label="跳到下一处需要关注的分区"
                   OnClick="JumpNextAttentionAsync">下一项</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Class="dt-diag-ops-btn"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   title="立即刷新诊断数据" aria-label="立即刷新诊断数据"
                   OnClick="@(() => RefreshAsync(showBusy: true))">刷新</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Class="dt-diag-ops-btn"
                   StartIcon="@(_paused ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause)"
                   title="@(_paused ? "继续自动刷新" : "暂停自动刷新")"
                   aria-label="@(_paused ? "继续自动刷新" : "暂停自动刷新")"
                   OnClick="TogglePauseAsync">@(_paused ? "继续" : "暂停")</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Class="dt-diag-ops-btn"
                   StartIcon="@Icons.Material.Filled.ContentCopy"
                   title="复制诊断摘要到剪贴板" aria-label="复制诊断摘要到剪贴板"
                   OnClick="CopyDigestAsync">复制</MudButton>
    </div>
</div>

@if (_focusedStation is { } focused)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2 flex-wrap dt-diag-focus">
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">工站 @focused.Code @focused.Name</MudChip>
        <MudText Typo="Typo.caption" Class="dt-muted">已按工站过滤 PLC / 耗时 / 补传 / 核对</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/alarms?station={focused.Id}")">此站报警</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/config/stations">工站配置</MudButton>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Clear" Href="/diagnostics">清除工站筛选</MudButton>
    </MudStack>
}

<div class="dt-diag-group-label">观测</div>
@* 与 /healthz 同一份判据：这一页要回答"现在还能不能干活"，
   而其中一半（配置库、数据盘、磁盘余量、采集服务心跳）原本要另开一个标签页才看得到。 *@
@if (ShowHealthSection)
{
    <section id="diag-health" class="@HealthSectionClass" aria-label="系统健康">
        <div class="dt-diag-section-title">
            <MudText Typo="Typo.subtitle1" Class="mb-0">系统健康</MudText>
            @if (_health is { } healthHead)
            {
                <MudChip T="string" Size="Size.Small"
                         Color="@(_healthError is not null ? Color.Warning : healthHead.Status == "healthy" ? Color.Success : Color.Error)"
                         Variant="Variant.Filled">
                    @(_healthError is not null ? "检查失败 · 显示上次结果" : healthHead.Status == "healthy" ? "全部正常" : "有异常项")
                </MudChip>
                <MudText Typo="Typo.caption" Class="dt-muted">
                    与 /healthz 同一份判据 · 最近检查 @RelativeOrDash(_healthAt) · @HealthCadenceText · 版本 @healthHead.Version · 已运行 @UptimeText(healthHead.UptimeSeconds)
                </MudText>
            }
        </div>
        @if (_health is { } health)
        {
            <div class="dt-diag-health-grid">
                @foreach (var check in VisibleHealthChecks(health))
                {
                    <div class="dt-diag-health-item @(check.Healthy ? null : "dt-diag-health-item--bad")">
                        <span class="@(check.Healthy ? "dt-diag-health-ok" : "dt-diag-health-bad")">
                            @(check.Healthy ? "正常" : "异常")
                        </span>
                        <span>@HealthName(check.Name)</span>
                        @if (AdvancedHealthIdentifier(check) is { } identifier)
                        {
                            <span class="dt-muted">@identifier</span>
                        }
                        @if (HealthDetail(check) is { } detail)
                        {
                            <span class="dt-muted">@detail</span>
                        }
                        @if (!check.Healthy && HealthNextStep(check) is { } next)
                        {
                            <span class="dt-diag-health-actions">
                                @foreach (var link in next)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Href="@link.Href">@link.Label</MudButton>
                                }
                            </span>
                        }
                    </div>
                }
            </div>
            @if (_healthError is { } healthError)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">@healthError</MudText>
            }
        }
    </section>
}

<section id="diag-loop" class="@LoopSectionClass" aria-label="采集循环">
    <div class="dt-diag-section-title">
        <MudText Typo="Typo.subtitle1" Class="mb-0">
            采集循环 <InfoHint Topic="HelpTexts.CollectorLoop" />
        </MudText>
        @if (_loop.Ticks.Count > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="@(LoopStale ? Color.Error : Color.Default)"
                     Variant="@(LoopStale ? Variant.Filled : Variant.Outlined)">
                @(LoopStale ? "已停滞" : $"最近 {SinceText(SinceLastTick)}")
            </MudChip>
            @if (_loop.OverrunCount > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">超时 @_loop.OverrunCount</MudChip>
            }
        }
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/config/settings#sec-collect">采集设置</MudButton>
    </div>
@if (_loop.Ticks.Count == 0)
{
    <MudText Typo="Typo.body2" Class="dt-muted mb-2">
        还没有采集循环记录。采集关闭时不会有记录（这时上方「采集服务心跳」仍显示正常，那是服务在打点，不是在扫描）；刚启动则需要等下一轮扫描。
    </MudText>
}
else if (!_onlyIssues || LoopStale || _loop.OverrunCount > 0)
{
    <MudStack Row="true" Spacing="2" Class="mb-2 flex-wrap">
        @* 判活要放在第一位：循环一旦停住，Ticks 就不再更新，后面的平均 / 最长 / 超时数
           会一直停在最后一轮的样子，比"一切正常"还像正常。 *@
        <MudChip T="string" Size="Size.Small"
                 Color="@(LoopStale ? Color.Error : Color.Default)"
                 Variant="@(LoopStale ? Variant.Filled : Variant.Outlined)">
            最后扫描 @SinceText(SinceLastTick)
        </MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">近期 @_loop.Ticks.Count 轮</MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">平均 @_loop.AverageWorkMs ms</MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">最长 @_loop.MaxWorkMs ms</MudChip>
        <MudChip T="string" Size="Size.Small"
                 Color="@(_loop.OverrunCount > 0 ? Color.Warning : Color.Default)"
                 Variant="@(_loop.OverrunCount > 0 ? Variant.Filled : Variant.Outlined)">
            超时 @_loop.OverrunCount 轮
        </MudChip>
    </MudStack>
    @if (LoopStale)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-2">
            采集循环已停止推进：最后一轮是 @SinceText(SinceLastTick)。下面这些数字是它停下之前的旧记录，
            不代表现在还在采 —— @LoopStopAdvice
        </MudAlert>
    }
    @* 形状优先于平均：偶发 200 ms 的抖动在"平均 5 ms"里直接消失，在曲线上藏不住。 *@
    <div class="mb-3">
        <LineChart Series="LoopSeries" Height="200" ShowPoints="false"
                   SeriesAxisName="轮次" XStartText="@LoopStartText" XEndText="@LoopEndText"
                   EmptyText="还没有采集循环记录" />
    </div>
    <MudTable Items="_loop.Ticks" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
              FixedHeader="true" Height="320px" Class="dt-list-table">
        <HeaderContent>
            <MudTh>时间</MudTh>
            <MudTh Class="dt-num">总耗时</MudTh>
            <MudTh Class="dt-num">扫描</MudTh>
            <MudTh Class="dt-num">心跳</MudTh>
            <MudTh Class="dt-num">PLC</MudTh>
            <MudTh Class="dt-num">触发</MudTh>
            <MudTh Class="dt-num">冷却跳过</MudTh>
            <MudTh Class="dt-num">工站跳过</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="时间" title="@context.At.ToString("yyyy-MM-dd HH:mm:ss")">@SinceText(AgeReference - context.At)</MudTd>
            <MudTd DataLabel="总耗时" Class="dt-num dt-nowrap">
                <span class="@(context.Overran ? "dt-diag-overrun" : null)">@context.WorkMs ms</span>
                @if (context.Overran)
                {
                    <MudText Typo="Typo.caption" Class="dt-muted">超过设置的 @context.ConfiguredIntervalMs ms</MudText>
                }
            </MudTd>
            <MudTd DataLabel="扫描" Class="dt-num dt-nowrap">@context.ScanMs ms</MudTd>
            <MudTd DataLabel="心跳" Class="dt-num dt-nowrap">@context.HeartbeatMs ms</MudTd>
            <MudTd DataLabel="PLC" Class="dt-num">@context.PlcCount</MudTd>
            <MudTd DataLabel="触发" Class="dt-num">@context.TriggeredCount</MudTd>
            <MudTd DataLabel="冷却跳过" Class="dt-num">@context.CoolingDownPlcCount</MudTd>
            <MudTd DataLabel="工站跳过" Class="dt-num">@context.SkippedStationCount</MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <MudText Typo="Typo.body2" Class="dt-muted">采集循环正常（最后扫描 @SinceText(SinceLastTick)，无超时）。</MudText>
}
</section>

<section id="diag-plc" class="@PlcSectionClass" aria-label="PLC 通信">
    <div class="dt-diag-section-title">
        <MudText Typo="Typo.subtitle1" Class="mb-0">
            PLC 通信 <InfoHint Topic="HelpTexts.PlcTraffic" />
        </MudText>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@FocusedTraffic.Count 台</MudChip>
        @if (DisconnectedPlcCount > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">异常 @DisconnectedPlcCount</MudChip>
        }
        <MudCheckBox T="bool" @bind-Value="_expandHealthyPlc" @bind-Value:after="PersistExpandHealthyAsync"
                     Label="展开健康连接" Dense="true" Disabled="_onlyIssues" />
        <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(FocusedTraffic.Count == 0)"
                   OnClick="CollapseAllPlc">全部折叠</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(DisconnectedPlcCount == 0)"
                   OnClick="ExpandIssuePlc">展开异常</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/config/plc">PLC 配置</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/alarms">设备报警</MudButton>
    </div>
@if (FocusedTraffic.Count == 0)
{
    <MudText Typo="Typo.body2" Class="dt-muted">还没有 PLC 通信记录。没有启用的 PLC 连接时这里会是空的。</MudText>
}
else
{
    @* 累计与最近是两种口径，写在最前面：不标的话，"最长 6000 ms"会被当成刚才那一次，
       而它可能是几小时前的那一回。 *@
    <MudText Typo="Typo.caption" Class="dt-muted mb-1">
        标题里的请求数、失败数与最长耗时是采集服务启动以来的累计值（进程重启即清零）；
        展开后流水只留最近 @SystemDefaults.PlcTrafficCapacity 条，失败明细只留 @SystemDefaults.PlcTrafficFailureCapacity 条。
        @if (_onlyIssues)
        {
            <span>「只看异常」下默认展开异常 PLC，正常连接保持折叠。</span>
        }
    </MudText>
    <MudExpansionPanels Elevation="1" Dense="true">
        @foreach (var plc in FocusedTraffic)
        {
            var plcIssue = PlcHasIssue(plc);
            if (_onlyIssues && !plcIssue && _focusedStation is null)
            {
                continue;
            }
            <MudExpansionPanel Class="dt-diag-plc"
                               Expanded="@PlcExpanded(plc, plcIssue)"
                               ExpandedChanged="@(expanded => SetPlcExpanded(plc.PlcConnectionId, expanded))">
                <TitleContent>
                    <div class="dt-diag-plc-title">
                        <MudText Typo="Typo.subtitle2" Class="mb-0">@plc.Name</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">请求 @plc.TotalCount</MudChip>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(plc.FailureCount > 0 ? Color.Error : Color.Default)"
                                 Variant="@(plc.FailureCount > 0 ? Variant.Filled : Variant.Outlined)">
                            失败 @plc.FailureCount
                        </MudChip>
                        @* 断线时最快的判读：失败数只是累计值，看不出来已经断了多久。 *@
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(NeverSucceeded(plc) ? Color.Error : Color.Default)"
                                 Variant="@(NeverSucceeded(plc) ? Variant.Filled : Variant.Outlined)">
                            @SuccessSinceText(plc)
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">最近 @plc.LastDurationMs ms</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">最长 @plc.MaxDurationMs ms</MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (plc.Recent.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="dt-muted">这台 PLC 还没有发过请求。</MudText>
                    }
                    else
                    {
                        @* 失败另存的那一份排在最前：标题里的"失败 N"如果点进去看不到任何一条，
                           那个数字就成了死数 —— 高频请求下几十条流水只覆盖几秒。 *@
                        @if (HiddenFailures(plc) is { Count: > 0 } hidden)
                        {
                            @* 说明写明"最多留几条"：上面那个"失败 N"是累计值，这里列不出 N 条是正常的，
                               不写清楚的话，它看起来像一个对不上的数字。 *@
                            <MudText Typo="Typo.caption" Class="dt-muted mb-1">
                                另有 @hidden.Count 条失败已被流水挤掉；失败明细最多保留最近 @SystemDefaults.PlcTrafficFailureCapacity 条，更早的只计入上面的累计失败数：
                            </MudText>
                            <div class="dt-diag-failures">
                                @foreach (var failure in hidden)
                                {
                                    <div class="dt-diag-failure">
                                        <span title="@failure.At.ToString("yyyy-MM-dd HH:mm:ss.fff")">@SinceText(AgeReference - failure.At)</span>
                                        <span class="dt-diag-failure-addr">@failure.Address</span>
                                        <span class="dt-diag-failure-error">@failure.Error</span>
                                    </div>
                                }
                            </div>
                        }
                        <MudTable Items="plc.Recent" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                                  Class="dt-diag-traffic dt-list-table">
                            <HeaderContent>
                                <MudTh>时间</MudTh>
                                <MudTh>方向</MudTh>
                                <MudTh>地址</MudTh>
                                <MudTh Class="dt-num">字数</MudTh>
                                <MudTh Class="dt-num">耗时</MudTh>
                                <MudTh>结果</MudTh>
                                <MudTh>值</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="时间" title="@context.At.ToString("yyyy-MM-dd HH:mm:ss.fff")">@SinceText(AgeReference - context.At)</MudTd>
                                <MudTd DataLabel="方向">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="@(context.IsWrite ? Color.Info : Color.Default)">
                                        @(context.IsWrite ? "写" : "读")
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="地址" Class="dt-nowrap">@context.Address</MudTd>
                                <MudTd DataLabel="字数" Class="dt-num">@context.WordCount</MudTd>
                                <MudTd DataLabel="耗时" Class="dt-num dt-nowrap">
                                    <span class="@(context.DurationMs >= HotPlcDurationMs ? "dt-diag-duration--hot" : null)">@context.DurationMs ms</span>
                                </MudTd>
                                <MudTd DataLabel="结果">
                                    @if (context.Ok)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">成功</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" title="@context.Error">失败</MudChip>
                                        <MudText Typo="Typo.caption" Color="Color.Error">@context.Error</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="值" Class="dt-nowrap">@ValueText(context)</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
    @if (_onlyIssues && FocusedTraffic.All(plc => !PlcHasIssue(plc)) && _focusedStation is null)
    {
        <MudText Typo="Typo.body2" Class="dt-muted mt-2">当前没有异常 PLC 连接。</MudText>
    }
}
</section>
<section id="diag-latency" class="dt-diag-section dt-diag-section--observe" aria-label="站级采集耗时">
    <div class="dt-diag-section-title">
        <MudText Typo="Typo.subtitle1" Class="mb-0">
            站级采集耗时 <InfoHint Topic="HelpTexts.CollectorLoop" />
        </MudText>
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/">看板</MudButton>
        <MudText Typo="Typo.caption" Class="dt-muted">偏高阈值：P95 ≥ @HotLatencyP95Ms ms / P99 ≥ @HotLatencyP99Ms ms；PLC 单次 ≥ @HotPlcDurationMs ms</MudText>
    </div>
@if (FilteredLatencies.Count == 0)
{
    <MudText Typo="Typo.body2" Class="dt-muted mb-2">尚无近期端到端采集样本；分位数取最近 15 分钟、每站最多 512 个样本。</MudText>
}
else if (!_onlyIssues || FilteredLatencies.Any(IsHotLatency))
{
    <MudTable Items="@(_onlyIssues ? FilteredLatencies.Where(IsHotLatency).ToList() : FilteredLatencies)" Dense="true" Hover="true" Class="dt-list-table mb-2">
        <HeaderContent><MudTh>工站</MudTh><MudTh>样本</MudTh><MudTh>P95</MudTh><MudTh>P99</MudTh><MudTh>最后样本</MudTh></HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudLink Href="@($"/diagnostics?station={StationIdByCode(context.StationCode)}")">@context.StationCode</MudLink>
            </MudTd>
            <MudTd>@context.SampleCount</MudTd>
            <MudTd Class="@(IsHotLatency(context) ? "dt-diag-duration--hot" : null)">@context.P95Ms.ToString("F0") ms</MudTd>
            <MudTd Class="@(context.P99Ms >= HotLatencyP99Ms ? "dt-diag-duration--hot" : null)">@context.P99Ms.ToString("F0") ms</MudTd>
            <MudTd title="@context.LastSampleAt.ToString("yyyy-MM-dd HH:mm:ss")">@SinceText(AgeReference - context.LastSampleAt)</MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <MudText Typo="Typo.body2" Class="dt-muted">近期耗时均在阈值内。</MudText>
}

@if (FilteredActiveCollections.Count > 0)
{
    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">正在采集</MudText>
    <MudTable Items="FilteredActiveCollections" Dense="true" Hover="true" Class="dt-list-table mb-1">
        <HeaderContent>
            <MudTh>工站</MudTh>
            <MudTh>已持续</MudTh>
            <MudTh>状态</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.StationCode</MudTd>
            <MudTd>@WaitText(TimeSpan.FromMilliseconds(context.ElapsedMs))</MudTd>
            <MudTd>
                @if (_overdueCollections.Any(x => x.StationCode == context.StationCode))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">超限</MudChip>
                    <MudLink Href="/alarms" Class="ml-1">报警</MudLink>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">进行中</MudChip>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
    <MudAlert Severity="@(FilteredOverdueCollections.Count > 0 ? Severity.Error : Severity.Info)" Dense="true" Class="mb-1">
        正在采集：@string.Join("、", FilteredActiveCollections.Select(x => $"{x.StationCode} {WaitText(TimeSpan.FromMilliseconds(x.ElapsedMs))}"))。
        @(_collectionAgeLimitSeconds > 0 ? $"最长采集时间 {_collectionAgeLimitSeconds} 秒；超限 {string.Join("、", FilteredOverdueCollections.Select(x => x.StationCode))}。" : "最长采集时间未配置，超时告警已禁用。")
    </MudAlert>
}
</section>

<div class="dt-diag-group-label">处置</div>

<section id="diag-manual" class="@ManualSectionClass" aria-label="待人工核对的 PLC 回写">
    <div class="dt-diag-section-title">
        <MudText Typo="Typo.subtitle1" Class="mb-0">待人工核对的 PLC 回写</MudText>
        <MudChip T="string" Size="Size.Small"
                 Color="@(FilteredManualReview.Count > 0 ? Color.Warning : Color.Default)"
                 Variant="@(FilteredManualReview.Count > 0 ? Variant.Filled : Variant.Outlined)">
            @FilteredManualReview.Count 条
        </MudChip>
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/alarms">设备报警</MudButton>
    </div>
@if (_manualReviewError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-2">
        人工核对清单读取失败：@_manualReviewError
    </MudAlert>
}
@if (FilteredManualReview.Count == 0)
{
    @if (!_onlyIssues)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
            没有因设备事件身份不明而阻塞的回写。
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="dt-muted">没有待核对项。</MudText>
    }
}
else
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-2">
        这些留证会阻塞对应工站继续采集。请先现场核对设备和旧事件，再选择处置方式；本页不会自动清除未知事件。
    </MudAlert>
    <MudExpansionPanels MultiExpansion="true">
        @foreach (var pending in FilteredManualReview)
        {
            var form = ManualFormFor(pending);
            <MudExpansionPanel>
                <TitleContent>
                    <div class="d-flex flex-wrap gap-2 align-center">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">待人工核对</MudChip>
                        <MudText>@pending.StationCode · @pending.PalletCode · @pending.SerialNo</MudText>
                        <MudText Typo="Typo.caption" Class="dt-muted" title="@pending.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")">
                            @pending.MonthKey · 留证 @SinceText(AgeReference - pending.CreatedAt)
                        </MudText>
                        <MudLink Href="@($"/diagnostics?station={StationIdByCode(pending.StationCode)}")">只看此站</MudLink>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.body2">阻塞原因：@(pending.ManualReviewReason ?? "需要现场核对")</MudText>
                        <MudText Typo="Typo.caption" Class="dt-muted">
                            原目标：工站 @pending.StationCode / 地址 @(pending.TriggerAddress ?? "未留存") / 原结果码 @pending.ResultCode
                        </MudText>
                        <MudSelect T="PendingConfirmationResolutionMode" @bind-Value="form.Mode" Label="现场核对后的处置方式" Variant="Variant.Outlined">
                            <MudSelectItem T="PendingConfirmationResolutionMode" Value="PendingConfirmationResolutionMode.DeviceAlreadyAcknowledged">设备已自行确认（触发位已清）</MudSelectItem>
                            <MudSelectItem T="PendingConfirmationResolutionMode" Value="PendingConfirmationResolutionMode.SameEventConfirmed">仍是原事件（核对身份后重写原结果码）</MudSelectItem>
                        </MudSelect>
                        <MudTextField T="string" @bind-Value="form.Reason" Label="核对说明（必填）" Required="true" Immediate="true"
                                      HelperText="说明谁核对了什么，以及现场如何处置旧事件。" />
                        <MudTextField T="string" @bind-Value="form.DeviceStateEvidence" Label="设备状态证据（必填）" Required="true" Immediate="true"
                                      HelperText="记录实际观察到的触发位读值和事件身份依据；服务还会读取原 PLC 目标并验证状态。" />
                        <MudCheckBox T="bool" @bind-Value="form.PhysicalCheckConfirmed" Color="Color.Warning"
                                     Label="@ManualCheckText(form.Mode)" />
                        <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                   Disabled="@(_resolvingManualReview || string.IsNullOrWhiteSpace(form.Reason) || string.IsNullOrWhiteSpace(form.DeviceStateEvidence) || !form.PhysicalCheckConfirmed)"
                                   OnClick="@(() => ResolveManualReviewAsync(pending, form))">
                            @(_resolvingManualReview ? "正在核对设备…" : "核对设备并解除阻塞")
                        </MudButton>
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}
</section>

<section id="diag-spool" class="@SpoolSectionClass" aria-label="补传队列">
    <div class="dt-diag-section-title">
        <MudText Typo="Typo.subtitle1" Class="mb-0">
            补传队列 <InfoHint Topic="HelpTexts.SpoolQueue" />
        </MudText>
        <MudChip T="string" Size="Size.Small"
                 Color="@(_spoolCount > 0 ? Color.Warning : Color.Default)"
                 Variant="@(_spoolCount > 0 ? Variant.Filled : Variant.Outlined)">
            @_spoolCount 件
        </MudChip>
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/alarms">设备报警</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/query">数据查询</MudButton>
    </div>
@if (_spoolCount == 0)
{
    @if (!_onlyIssues)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
            补传队列是空的：没有写库失败等待补传的件。
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="dt-muted">补传队列是空的。</MudText>
    }
}
else
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-2">
        <div class="d-flex align-center flex-wrap gap-2">
            <span>
                @_spoolCount 件写库失败等待补传@(_spoolOldest is { } oldest ? $"，最早一笔 {oldest:MM-dd HH:mm:ss}（已等待 {WaitText(AgeReference - oldest)}；超过 {SystemDefaults.SpoolBacklogWarnMinutes} 分钟就会进报警页）" : "")。
            </span>
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@(_replayingAll ? Icons.Material.Filled.Sync : Icons.Material.Filled.CloudUpload)"
                       Disabled="_replayingAll || _workingFile is not null"
                       OnClick="ReplayAllAsync">
                @(_replayingAll ? $"补传中…已 {_replayDone} 条" : "整队补传")
            </MudButton>
            @* 大队列一次补几分钟：既要知道走到哪了，也要停得下来。 *@
            @if (_replayingAll)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="CancelReplayAll">取消</MudButton>
            }
        </div>
    </MudAlert>

    @if (_spoolTruncated)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-2">
            <div class="d-flex align-center flex-wrap gap-2">
                <span>队列有 @_spoolCount 条，超过 @SpoolDetailLimit 条就不再自动列明细 —— 读一遍要把每条缓存整块反序列化，这么多条不值得自动做。</span>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ListDetailOnceAsync">列出明细</MudButton>
            </div>
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.caption" Class="dt-muted mb-1">
            明细读取于 @(_entriesAt is { } readAt ? readAt.ToString("HH:mm:ss") : "—")：@DetailCadenceText。
        </MudText>
        <MudTable Items="FilteredSpoolEntries" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="dt-list-table">
            <HeaderContent>
                <MudTh>入队时间</MudTh>
                <MudTh>工站</MudTh>
                <MudTh>托盘码</MudTh>
                <MudTh>流水号</MudTh>
                <MudTh>月份</MudTh>
                <MudTh Class="dt-num">尝试</MudTh>
                <MudTh>上次失败</MudTh>
                <MudTh>操作</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="入队时间" Class="dt-nowrap" title="@context.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")">@SinceText(AgeReference - context.CreatedAt)</MudTd>
                <MudTd DataLabel="工站">
                    <MudLink Href="@($"/diagnostics?station={StationIdByCode(context.StationCode)}")">@context.StationCode</MudLink>
                </MudTd>
                <MudTd DataLabel="托盘码">@context.PalletCode</MudTd>
                <MudTd DataLabel="流水号">@context.SerialNo</MudTd>
                <MudTd DataLabel="月份">@context.MonthKey</MudTd>
                <MudTd DataLabel="尝试" Class="dt-num">
                    @context.Attempts
                    @if (context.LastAttemptAt is { } lastAt)
                    {
                        <MudText Typo="Typo.caption" Class="dt-muted" title="@lastAt.ToString("yyyy-MM-dd HH:mm:ss")">@SinceText(AgeReference - lastAt)</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="上次失败">
                    @if (string.IsNullOrEmpty(context.LastError))
                    {
                        <span>还没试过</span>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@context.LastError</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="操作">
                    <MudStack Row="true" Spacing="1">
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="_workingFile is not null || _replayingAll"
                                   StartIcon="@(_workingFile == context.FileName ? Icons.Material.Filled.Sync : null)"
                                   OnClick="@(() => ReplayOneAsync(context))">
                            @(_workingFile == context.FileName ? "补传中…" : "立即补传")
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                   Disabled="_workingFile is not null || _replayingAll"
                                   OnClick="@(() => DiscardAsync(context))">丢弃</MudButton>
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}
</section>

<section id="diag-mes" class="@MesSectionClass" aria-label="MES 出站">
    <div class="dt-diag-section-title">
        <MudText Typo="Typo.subtitle1" Class="mb-0">MES 出站</MudText>
        <MudChip T="string" Size="Size.Small"
                 Color="@((_mesOutbox?.PendingCount ?? 0) > 0 ? Color.Warning : Color.Success)"
                 Variant="Variant.Outlined">
            @(_mesOutbox is null ? "未读到" : _mesOutbox.PendingCount == 0 ? "队列空" : $"待推 {_mesOutbox.PendingCount}")
        </MudChip>
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/config/settings#sec-mes">MES 设置</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/alarms">设备报警</MudButton>
    </div>
@if (_mesOutbox is null)
{
    <MudText Typo="Typo.body2" Class="dt-muted">MES 出站状态尚未读到。</MudText>
}
else if (_mesOutbox.PendingCount == 0)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
        MES 待推送队列是空的。
        @if (_mesOutbox.LastAttemptAt is { } lastAttempt)
        {
            <span class="dt-muted">最近尝试 @SinceText(AgeReference - lastAttempt)
                @(_mesOutbox.LastAttemptSucceeded is true ? "· 成功" : _mesOutbox.LastAttemptSucceeded is false ? "· 失败" : "")</span>
        }
    </MudAlert>
}
else
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
        MES 待推送 @_mesOutbox.PendingCount 条@(_mesOutbox.OldestPendingAt is { } mesOldest ? $"，最老一条 {mesOldest:MM-dd HH:mm:ss}（已等待 {WaitText(AgeReference - mesOldest)}）" : "")。
        @if (_mesOutbox.LastAttemptAt is { } lastAttempt)
        {
            <span>最近尝试 @SinceText(AgeReference - lastAttempt)
                @(_mesOutbox.LastAttemptSucceeded is true ? "· 成功" : _mesOutbox.LastAttemptSucceeded is false ? "· 失败" : "")。</span>
        }
    </MudAlert>
}
</section>

@code {
    /// <summary>页面自己的刷新节拍。这一页是拉模式，不订阅任何推送。</summary>
    private const int DiagTickMs = 2000;

    /// <summary>超过这个条数就不再自动读每条缓存的内容。</summary>
    private const int SpoolDetailLimit = 200;

    /// <summary>诊断摘要里每台 PLC 带上的最新失败条数：够对方看出"最近在报什么错"即可。</summary>
    private const int DigestFailureLines = 3;

    /// <summary>PLC 单次通信耗时偏高阈值（ms）。</summary>
    private const int HotPlcDurationMs = 200;

    /// <summary>站级采集 P95 偏高阈值（ms）。</summary>
    private const int HotLatencyP95Ms = 500;

    /// <summary>站级采集 P99 偏高阈值（ms）。</summary>
    private const int HotLatencyP99Ms = 800;

    /// <summary>
    /// 补传明细（尝试次数、上次失败原因）的重读节拍。
    /// </summary>
    /// <remarks>
    /// 比页面的 2 秒刷新慢得多：读一遍明细要把队列里每条缓存和它的旁车都反序列化一次，
    /// 而"试了几次、上次为什么失败"本来就不是秒级变化的东西。件数与最早时间仍跟着主刷新走；
    /// 件数变了（有人补传成功、又堵进来新件）则立即重读，不用等这一拍。
    /// </remarks>
    private const int SpoolDetailTickMs = 10_000;

    /// <summary>人工核对留证读取节拍。该列表跨月库查询，不跟随两秒的诊断刷新频率。</summary>
    private const int ManualReviewRefreshMs = 10_000;

    /// <summary>
    /// 探活的复查节拍。
    /// </summary>
    /// <remarks>
    /// 刻意比页面的 2 秒刷新慢得多：探活要写探测文件、查配置库、读磁盘余量，
    /// 每两秒做一遍就成了"观测手段自己制造 IO"。而这几项（能不能写、还剩多少）
    /// 本来也不是秒级变化的东西。
    /// </remarks>
    private const int HealthTickMs = 15_000;

    private HealthReport? _health;
    private DateTime? _healthAt;
    private string? _healthError;
    private bool _showAdvancedHealthDetails;


    /// <summary>
    /// 采集循环的趋势线：每轮总耗时，对照当时的扫描间隔。
    /// </summary>
    /// <remarks>
    /// Ticks 是倒序（最新在前），折线要从左往右走时间，所以这里反转。
    /// 间隔画成第二条线而不是一条基准线，是因为间隔本身可能被改过 —— 每轮用它自己的值，
    /// 改过间隔的地方图上会看得见台阶。
    /// </remarks>
    private LineSeries[] LoopSeries => _loop.Ticks.Count == 0
        ? []
        :
        [
            new LineSeries
            {
                Name = "每轮耗时",
                Values = _loop.Ticks.Select(t => (float)t.WorkMs).Reverse().ToArray(),
                Color = ChartColors.Primary,
                Unit = "ms"
            },
            new LineSeries
            {
                Name = "扫描间隔",
                Values = _loop.Ticks.Select(t => (float)t.ConfiguredIntervalMs).Reverse().ToArray(),
                Color = ChartColors.Secondary,
                Unit = "ms"
            }
        ];

    /// <summary>折线首尾的时间标注。Ticks 倒序：末位是最早一轮，首位是最新一轮。</summary>
    private string LoopStartText => _loop.Ticks.Count == 0 ? "" : _loop.Ticks[^1].At.ToString("HH:mm:ss");

    private string LoopEndText => _loop.Ticks.Count == 0 ? "" : _loop.Ticks[0].At.ToString("HH:mm:ss");

    /// <summary>
    /// 算"距今多久"时用的当前时刻：刷新被挂起（暂停/后台）时取快照时刻。
    /// </summary>
    /// <remarks>
    /// 页面暂停后读数冻着，再用真实时钟去老化它们，就会把好着的循环说成"已停止推进" ——
    /// 停够一个判活窗口（≥5×扫描间隔、下限 2 秒）后随便点个按钮触发重画，假警报就出来了。
    /// </remarks>
    private DateTime AgeReference => AutoRefreshSuspended && _refreshedAt is { } snapshotAt ? snapshotAt : DateTime.Now;

    /// <summary>最后一轮采集采样距今（挂起时按快照时刻算）。Ticks 是倒序（最新在前）。</summary>
    private TimeSpan? SinceLastTick => _loop.Ticks.Count > 0 ? AgeReference - _loop.Ticks[0].At : null;

    /// <summary>页头右侧那行字：暂停/后台时说清读数停在哪一刻，运行时说明刷新节拍。</summary>
    private string RefreshCaption => _paused
        ? $"已暂停{(_refreshedAt is { } snapshotAt ? $" · 显示 {snapshotAt:HH:mm:ss} 的快照" : "")}"
        : _hidden
            ? $"{(_refreshedAt is { } lastAt ? $"{lastAt:HH:mm:ss} 更新 · " : "")}页面在后台，刷新已挂起（切回来即恢复）"
            : $"{(_refreshedAt is { } at ? $"{at:HH:mm:ss} 更新 · " : "")}每 {DiagTickMs / 1000} 秒自动刷新";

    /// <summary>健康块的复查说明：挂起时不再复查，别让分区说明与页头的状态打架。</summary>
    private string HealthCadenceText => AutoRefreshSuspended ? "复查已暂停" : $"每 {HealthTickMs / 1000} 秒复查";

    /// <summary>补传明细的刷新说明：挂起时自动重读停了，只在恢复或做动作之后更新。</summary>
    private string DetailCadenceText => AutoRefreshSuspended
        ? "自动刷新已暂停，这些读数不会自动更新"
        : $"件数每 {DiagTickMs / 1000} 秒更新，明细每 {SpoolDetailTickMs / 1000} 秒重读，件数变化时立即重读";

    /// <summary>
    /// 采集循环是不是已经停了。
    /// </summary>
    /// <remarks>
    /// 阈值取"配置间隔的 5 倍"（下限 2 秒）：单轮偶尔慢一下不算停，
    /// 但连续五轮都没出记录，那就不是"慢"而是"停了"。
    /// </remarks>
    private bool LoopStale => _loop.Ticks.Count > 0
        && SinceLastTick is { } gap
        && gap.TotalMilliseconds > Math.Max(_loop.Ticks[0].ConfiguredIntervalMs * 5, 2000);

    /// <summary>探活里"采集服务心跳"这一项的结论；报告里没有它（探活没读成）时为 null。</summary>
    private bool? ServiceHeartbeatHealthy
        => _health?.Checks.FirstOrDefault(check => check.Name == "collector")?.Healthy;

    /// <summary>
    /// "循环停了"往下该怎么查 —— 结合探活里那条"采集服务心跳"给出方向。
    /// </summary>
    /// <remarks>
    /// 两条判据不是一回事：心跳按 60 秒判，只表示采集服务的主循环还在打点 ——
    /// 采集被停用时它照样新鲜；这里的"停止推进"按 5×扫描间隔判（下限 2 秒），说的是扫描真的不再推进。
    /// 两边阈值差得远，同屏出现"心跳正常 + 已停止推进"是正常的，所以要把这层区别说出来。
    /// </remarks>
    private string LoopStopAdvice => ServiceHeartbeatHealthy switch
    {
        true => "采集服务心跳还是新鲜的，说明服务在跑、停的是扫描本身：先确认采集有没有被停用（设置页的采集开关），再看日志里是不是每轮都停在配置读取那一步。",
        false => "连采集服务心跳也停了，请确认采集服务是否仍在运行。",
        _ => "请确认采集服务是否仍在运行。"
    };

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        _showAdvancedHealthDetails = user.IsInRole(AppRoles.Administrator);
        await RefreshAsync(showBusy: true);
        _timer = new Timer(_ => _ = InvokeAsync(TickAsync), null, DiagTickMs, DiagTickMs);
    }

    protected override async Task OnParametersSetAsync()
    {
        _focusedStation = StationQuery is > 0
            ? (await Config.GetSnapshotAsync()).Stations.FirstOrDefault(station => station.Id == StationQuery)
            : null;
        _focusExpanded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _visibilityRef = DotNetObjectReference.Create(this);
        try
        {
            await Js.InvokeVoidAsync("dtVisibility.initialize", _visibilityRef);
        }
        catch (JSException)
        {
            // 浏览器多半还拿着旧版 datatrace.js（没有这个模块）。为省 2 秒轮询不该把整页电路搭进去：
            // 退化成"不挂起"、照常轮询即可；ref 仍由 DisposeAsync 统一收尾。
        }

        await LoadUiPrefsAsync();
        StateHasChanged();
    }

    /// <summary>
    /// 浏览器把页面切到后台/切回来。
    /// </summary>
    /// <remarks>
    /// 切走就挂起按秒的轮询：每个开着的标签页都在取数，没人看的时候不该继续占着服务端。
    /// 切回来立即取一轮；手动暂停着的页面保持暂停，别顺手把用户按下的暂停解掉。
    /// </remarks>
    [JSInvokable]
    public async Task OnVisibilityChanged(bool hidden)
    {
        _hidden = hidden;
        if (!hidden && !_paused)
        {
            await RefreshAsync();
        }

        StateHasChanged();
    }

    /// <summary>
    /// 定时跳：取一轮数，然后显式重画。
    /// </summary>
    /// <remarks>
    /// 定时器不是事件回调，框架不会替这一跳调 StateHasChanged。少了这一句，
    /// 字段每 2 秒都在更新，页面却一直停在打开时的样子 —— "自动刷新"就成了一句空话。
    /// </remarks>
    private async Task TickAsync()
    {
        // 暂停期间连重画一起停：页面冻成一份可以慢慢读（选文本、对照日志）的快照；
        // 切到后台则连取数都不做。
        if (AutoRefreshSuspended)
        {
            return;
        }

        await RefreshAsync();
        StateHasChanged();
    }

    /// <summary>自动刷新是否已被挂起：用户按了暂停，或浏览器把页面切到了后台。</summary>
    private bool AutoRefreshSuspended => _paused || _hidden;

    /// <summary>
    /// 暂停/继续自动刷新。
    /// </summary>
    /// <remarks>
    /// 暂停只停这一页的取数：补传、丢弃这些用户动作仍然即时生效 —— 它们是有人等着的操作，
    /// 不属于"自动刷新"。继续时立即补一轮，不然要干等一整拍，看着像点了没反应。
    /// </remarks>
    private async Task TogglePauseAsync()
    {
        _paused = !_paused;
        if (!_paused)
        {
            await RefreshAsync();
        }
    }

    /// <summary>
    /// 取一轮数。
    /// </summary>
    /// <param name="showBusy">
    /// 这次取数要不要点亮页头的忙碌指示。只为有人在等的取数点亮（首屏、重试、列出明细）：
    /// 定时轮询每 2 秒路过一次，次次点亮的话，进度圈与压淡的统计就成了常态噪声。
    /// </param>
    private async Task RefreshAsync(bool showBusy = false)
    {
        if (_refreshing)
        {
            // 正在取数：记一笔，让那一轮结束后立即再取一轮，而不是把这次请求丢掉 ——
            // 补传/丢弃之后的收尾刷新正好撞上 2 秒一跳的轮询时，页面会停在旧数据上。
            _refetchRequested = true;
            return;
        }

        _refreshing = true;
        _busy = showBusy;
        try
        {
            do
            {
                _refetchRequested = false;
                await RefreshOnceAsync();
            }
            while (_refetchRequested);
        }
        finally
        {
            _refreshing = false;
            _busy = false;
        }
    }

    /// <summary>一轮取数的实体：读数写进字段；读失败只留提示，保留上一次读到的内容。</summary>
    private async Task RefreshOnceAsync()
    {
        try
        {
            _loop = Diag.Loop;
            _traffic = Diag.PlcTraffic;
            _latencies = Diag.RecentStationLatencies;
            _activeCollections = Diag.ActiveCollections;
            _overdueCollections = Diag.OverdueCollections;
            _collectionAgeLimitSeconds = Diag.CollectionMaxAgeSeconds;
            if (_mesOutboxAt is null || DateTime.Now - _mesOutboxAt.Value >= TimeSpan.FromSeconds(10))
            {
                _mesOutbox = await Config.GetMesOutboxStatusAsync();
                _mesOutboxAt = DateTime.Now;
            }

            if (_manualReviewAt is null
                || (DateTime.Now - _manualReviewAt.Value).TotalMilliseconds >= ManualReviewRefreshMs)
            {
                try
                {
                    _manualReviewPending = await ConfirmationRecovery.ListPendingAsync();
                    _manualReviewAt = DateTime.Now;
                    _manualReviewError = null;
                    var activeKeys = _manualReviewPending.Select(ManualReviewKey).ToHashSet(StringComparer.Ordinal);
                    foreach (var staleKey in _manualReviewForms.Keys.Where(key => !activeKeys.Contains(key)).ToList())
                    {
                        _manualReviewForms.Remove(staleKey);
                    }
                }
                catch (Exception ex)
                {
                    _manualReviewError = ex.Message;
                }
            }

            // 探活按自己的节拍来（见 HealthTickMs），不跟着 2 秒的主刷新跑。
            if (_health is null || _healthAt is not { } checkedAt
                || (DateTime.Now - checkedAt).TotalMilliseconds >= HealthTickMs)
            {
                try
                {
                    _health = await Probe.CheckAsync();
                    _healthAt = DateTime.Now;
                    _healthError = null;
                }
                catch (Exception ex)
                {
                    // 探活自己出问题不该把整页拖红：保留上一份读数，只说明这次没读成。
                    _healthError = $"健康检查未能完成：{ex.Message}";
                }
            }

            var backlog = await Spool.DescribeAsync();
            _spoolCount = backlog.Count;
            _spoolOldest = backlog.OldestAt;

            // 空队列与超量队列都不去读内容：前者没得读，后者读一遍要把每条缓存
            // 反序列化一次，会把磁盘和 CPU 拖成诊断页自己的问题。
            // 其余情况还要过一道明细节拍（见 SpoolDetailTickMs）：件数没变就不跟着 2 秒一跳重读。
            if (backlog.Count == 0)
            {
                _entries = [];
                _entriesCount = 0;
                _entriesAt = null;
                _spoolTruncated = false;
            }
            else if (backlog.Count > SpoolDetailLimit && !_forceSpoolDetail)
            {
                _entries = [];
                // 明细缓存一并作废：队列缩回阈值以内时立即重读，而不是先空着等慢节拍。
                _entriesAt = null;
                _spoolTruncated = true;
            }
            else if (_forceSpoolDetail || DetailsDue(backlog.Count))
            {
                _entries = await Spool.ListEntriesAsync();
                _entriesCount = backlog.Count;
                _entriesAt = DateTime.Now;
                _spoolTruncated = false;
            }
            else
            {
                _spoolTruncated = false;
            }

            _forceSpoolDetail = false;
            _loadError = null;
            _refreshedAt = DateTime.Now;
        }
        catch (Exception ex)
        {
            // 与报警页同样的取舍：出错时保留上一次读到的内容，只加一条错误提示。
            // 清空之后"补传队列是空的"会和错误提示同屏出现，把一次读取故障说成"确实没有积压"。
            _loadError = $"诊断数据读取失败：{ex.Message}";
        }
    }

    /// <summary>超量时由用户显式要求列一次明细：只在这一次刷新里读，之后回到摘要。</summary>
    private async Task ListDetailOnceAsync()
    {
        _forceSpoolDetail = true;
        await RefreshAsync(showBusy: true);
    }

    /// <summary>明细该不该重读了：从没读过、件数变了、或距上次读过一会儿。</summary>
    private bool DetailsDue(int count)
        => _entriesAt is not { } at
           || count != _entriesCount
           || (DateTime.Now - at).TotalMilliseconds >= SpoolDetailTickMs;

    /// <summary>
    /// 把这一屏浓缩成一段能贴进工单/群的纯文本。
    /// </summary>
    /// <remarks>
    /// 现场排障的最后一公里是"把看到的东西带出去"：截图不能检索、也不能粘贴，
    /// 所以按页面三块各给一两行摘要，PLC 只带上最新几条失败 —— 够对方判断方向即可。
    /// 内容取当前内存里的读数，可能与页面差一个刷新节拍；这比让用户自己去拼更好。
    /// </remarks>
    private string BuildDigest()
    {
        var text = new StringBuilder();
        text.AppendLine("DataTrace 运行诊断摘要");
        text.AppendLine($"生成时间：{DateTime.Now:yyyy-MM-dd HH:mm:ss}");

        // 页面自己的状态先写：正在读失败、已暂停这些恰恰是最该跟读数一起带出去的信息。
        if (_loadError is not null)
        {
            text.AppendLine($"读取状态：{_loadError}");
        }

        if (_paused)
        {
            text.AppendLine($"页面状态：已暂停，读数为 {(_refreshedAt is { } snapshotAt ? snapshotAt.ToString("HH:mm:ss") : "—")} 的快照");
        }

        if (_health is { } health)
        {
            text.AppendLine($"系统健康：{health.Status} · 版本 {health.Version} · 已运行 {UptimeText(health.UptimeSeconds)}");
            foreach (var check in health.Checks)
            {
                var detail = HealthDetail(check);
                var identifier = AdvancedHealthIdentifier(check);
                text.AppendLine(
                    $"  {HealthName(check.Name)}：{(check.Healthy ? "正常" : "异常")}"
                    + (identifier is null ? "" : $" {identifier}")
                    + (detail is null ? "" : $" {detail}"));
            }
        }
        else
        {
            text.AppendLine("系统健康：这次没读到");
        }

        text.AppendLine(_loop.Ticks.Count == 0
            ? "采集循环：没有记录（采集关闭时不会有记录）"
            : $"采集循环：最后扫描 {SinceText(SinceLastTick)} · 近期 {_loop.Ticks.Count} 轮 · 平均 {_loop.AverageWorkMs} ms · 最长 {_loop.MaxWorkMs} ms · 超时 {_loop.OverrunCount} 轮");

        if (_traffic.Count == 0)
        {
            text.AppendLine("PLC 通信：没有记录");
        }

        foreach (var plc in _traffic)
        {
            text.AppendLine(
                $"PLC {plc.Name}：请求 {plc.TotalCount} · 失败 {plc.FailureCount} · 最近 {plc.LastDurationMs} ms · 最长 {plc.MaxDurationMs} ms · {SuccessSinceText(plc)}");

            // 带一条最新流水作对照：只给失败的话，读的人分不清"现在还通不通"。
            if (plc.Recent.Count > 0)
            {
                var latest = plc.Recent[0];
                text.AppendLine(
                    $"  最近一次：{latest.At:HH:mm:ss.fff} {(latest.IsWrite ? "写" : "读")} {latest.Address} {latest.DurationMs} ms {(latest.Ok ? "成功" : "失败")}");
            }

            foreach (var failure in plc.RecentFailures.Take(DigestFailureLines))
            {
                text.AppendLine($"  {failure.At:HH:mm:ss.fff} {failure.Address} {failure.Error}");
            }
        }

        if (_spoolCount == 0)
        {
            text.AppendLine("补传队列：空");
        }
        else
        {
            text.AppendLine($"补传队列：{_spoolCount} 件"
                + (_spoolTruncated ? $"（明细超过 {SpoolDetailLimit} 条，未自动读取）" : "")
                + (_spoolOldest is { } oldest
                    ? $"，最早一笔 {oldest:MM-dd HH:mm:ss}（已等待 {WaitText(AgeReference - oldest)}）"
                    : ""));

            // 明细里有失败原因就带上最近一条 —— 这是"为什么一直补不进去"的直接答案。
            if (_entries.LastOrDefault(entry => !string.IsNullOrEmpty(entry.LastError))?.LastError is { } lastError)
            {
                text.AppendLine($"  最近一条补传失败：{lastError}");
            }
        }

        text.AppendLine(_manualReviewPending.Count == 0
            ? "待人工核对：无"
            : $"待人工核对：{_manualReviewPending.Count} 条");
        foreach (var pending in _manualReviewPending.Take(5))
        {
            text.AppendLine($"  {pending.StationCode} {pending.SerialNo}：{pending.ManualReviewReason ?? "需要现场核对"}");
        }

        if (_mesOutbox is { } mes)
        {
            text.AppendLine(mes.PendingCount == 0
                ? "MES 出站：空"
                : $"MES 出站：待推送 {mes.PendingCount}"
                    + (mes.OldestPendingAt is { } mesOldest
                        ? $"，最早 {mesOldest:MM-dd HH:mm:ss}（已等待 {WaitText(AgeReference - mesOldest)}）"
                        : ""));
        }

        if (_activeCollections.Count > 0)
        {
            text.AppendLine("正在采集：" + string.Join("、", _activeCollections.Select(x => $"{x.StationCode} {WaitText(TimeSpan.FromMilliseconds(x.ElapsedMs))}")));
            if (_overdueCollections.Count > 0)
            {
                text.AppendLine("采集超限：" + string.Join("、", _overdueCollections.Select(x => x.StationCode)));
            }
        }

        if (_latencies.Count > 0)
        {
            var hot = _latencies.OrderByDescending(x => x.P95Ms).Take(3).ToList();
            text.AppendLine("耗时偏高：" + string.Join("、", hot.Select(x => $"{x.StationCode} P95 {x.P95Ms:F0} ms")));
        }

        if (_focusedStation is { } focused)
        {
            text.AppendLine($"工站筛选：{focused.Code} {focused.Name}");
        }

        text.AppendLine($"只看异常：{(_onlyIssues ? "开" : "关")}；展开健康连接：{(_expandHealthyPlc ? "开" : "关")}");

        return text.ToString();
    }

    private async Task CopyDigestAsync()
    {
        try
        {
            var copied = await Js.InvokeAsync<bool>("dtCopy", BuildDigest());
            // 与查询页同一取舍：浏览器拒绝剪贴板时不能照样报"已复制"。
            Toast.Add(copied ? "诊断摘要已复制" : "复制失败：浏览器不允许写入剪贴板，请手动选中复制",
                copied ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            Toast.Add($"复制失败：{ex.Message}", Severity.Error);
        }
    }

    private async Task ReplayAllAsync()
    {
        if (!await AuthorizeManualActionAsync())
        {
            return;
        }

        _replayingAll = true;
        _replayDone = 0;
        _replayCts = new CancellationTokenSource();
        var done = 0;
        var canceled = false;
        string? failure = null;
        try
        {
            done = await Runner.ReplayAllAsync(_replayCts.Token, NoteReplayProgress);
            canceled = _replayCts.IsCancellationRequested;
        }
        catch (OperationCanceledException)
        {
            canceled = true;
        }
        catch (Exception ex)
        {
            failure = ex.Message;
        }
        finally
        {
            _replayCts?.Dispose();
            _replayCts = null;
            _replayingAll = false;
            await RefreshAsync();
        }

        // 结果提示放在刷新之后：只有刷新过的件数才分得清"0 条"是没人可补、还是第一条就补不动。
        // 进度回调是异步贴回来的，可能还差最后一两条，所以取两者中大的那个。
        var succeeded = Math.Max(done, _replayDone);
        if (failure is not null)
        {
            Toast.Add($"整队补传失败：{failure}", Severity.Error);
        }
        else if (canceled)
        {
            Toast.Add($"已取消补传，本次成功 {succeeded} 条", Severity.Warning);
        }
        else if (succeeded > 0)
        {
            Toast.Add($"已补传 {succeeded} 条", Severity.Success);
        }
        else if (_spoolCount == 0)
        {
            Toast.Add("队列已经空了（多半刚被后台补传完）", Severity.Info);
        }
        else
        {
            Toast.Add("没有补传成功的记录，队列里最早那条仍然失败", Severity.Warning);
        }
    }

    /// <summary>
    /// 补传进度回调：按钮上的"已 N 条"。
    /// </summary>
    /// <remarks>
    /// 回调发生在执行器的循环里（线程不再是渲染调度线程），所以要经 InvokeAsync 回到调度线程上改状态、重画。
    /// </remarks>
    private void NoteReplayProgress(int done)
        => _ = InvokeAsync(() =>
        {
            _replayDone = done;
            StateHasChanged();
        });

    /// <summary>叫停整队补传：正在写的那一条让它写完，后面的不再动。</summary>
    private void CancelReplayAll() => _replayCts?.Cancel();

    private async Task ReplayOneAsync(SpoolEntry entry)
    {
        if (!await AuthorizeManualActionAsync())
        {
            return;
        }

        _workingFile = entry.FileName;
        try
        {
            var result = await Runner.ReplayOneAsync(entry.FileName);
            if (result.Ok)
            {
                Toast.Add($"{entry.SerialNo} 已补传入库", Severity.Success);
            }
            else
            {
                Toast.Add($"补传失败：{result.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Toast.Add($"补传失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _workingFile = null;
            await RefreshAsync();
        }
    }

    private async Task DiscardAsync(SpoolEntry entry)
    {
        var confirmed = await Dialogs.ConfirmDangerAsync(
            "丢弃这条缓存",
            $"{entry.SerialNo}（托盘 {entry.PalletCode}，工站 {entry.StationCode}）写库失败后一直没能补传。丢弃即删除本地缓存文件，这条采集记录不会进入数据库。",
            "我了解这条记录将无法恢复",
            yesText: "仍要丢弃");
        if (!confirmed)
        {
            return;
        }

        if (!await AuthorizeManualActionAsync())
        {
            return;
        }

        _workingFile = entry.FileName;
        try
        {
            await Spool.DeleteAsync(entry.FileName);
            Toast.Add($"{entry.SerialNo} 的缓存已丢弃", Severity.Info);
        }
        catch (Exception ex)
        {
            Toast.Add($"丢弃失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _workingFile = null;
            await RefreshAsync();
        }
    }

    private async Task<bool> AuthorizeManualActionAsync()
    {
        try
        {
            var actor = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
            await Authorizer.AuthorizeChangeAsync(actor);
            return true;
        }
        catch (Exception ex)
        {
            Toast.Add($"当前会话已无此操作权限：{ex.Message}", Severity.Error);
            return false;
        }
    }

    private async Task ResolveManualReviewAsync(PendingWriteBack pending, ManualReviewForm form)
    {
        if (string.IsNullOrWhiteSpace(form.Reason) || string.IsNullOrWhiteSpace(form.DeviceStateEvidence)
            || !form.PhysicalCheckConfirmed)
        {
            Toast.Add("请填写核对说明和设备状态证据，并确认已完成现场核对", Severity.Warning);
            return;
        }

        if (!await AuthorizeManualActionAsync())
        {
            return;
        }

        var actor = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name;
        if (string.IsNullOrWhiteSpace(actor))
        {
            Toast.Add("当前会话身份无效，拒绝解除", Severity.Error);
            return;
        }

        var modeDescription = form.Mode == PendingConfirmationResolutionMode.DeviceAlreadyAcknowledged
            ? "由设备自行完成确认；服务将读取原触发位，并要求读到非触发值。"
            : "现场已确认 PLC 上仍是这件原事件；服务将向冻结的原目标写入保存的结果码并读回校验。"
                + "这会向 PLC 写入数据。";
        var confirmed = await Dialogs.ConfirmDangerAsync(
            "解除人工核对阻塞",
            $"{pending.StationCode} / {pending.SerialNo}：{modeDescription}如果事件身份不确定或现场情况不符，请取消并继续保持阻塞。",
            "我已现场核对设备状态与事件身份",
            yesText: form.Mode == PendingConfirmationResolutionMode.SameEventConfirmed ? "写回并核验" : "确认设备已确认",
            cancelText: "继续阻塞");
        if (confirmed != true)
        {
            return;
        }

        _resolvingManualReview = true;
        try
        {
            var modeLabel = form.Mode == PendingConfirmationResolutionMode.DeviceAlreadyAcknowledged
                ? "设备已自行确认"
                : "现场确认仍是原事件并重写原结果码";
            var result = await ConfirmationRecovery.ResolveAsync(
                pending.MonthKey,
                pending.Id,
                actor,
                $"处置方式：{modeLabel}。{form.Reason.Trim()}",
                form.DeviceStateEvidence.Trim(),
                form.Mode);
            if (!result.Resolved)
            {
                Toast.Add(result.Error ?? "设备核对未通过，阻塞仍保留", Severity.Error);
            }
            else
            {
                Toast.Add("设备状态已验证，人工核对留证已解除；审计留证仍保留", Severity.Success);
                _manualReviewAt = null;
                await RefreshAsync(showBusy: true);
            }
        }
        catch (Exception ex)
        {
            Toast.Add($"人工核对失败，阻塞仍保留：{ex.Message}", Severity.Error);
        }
        finally
        {
            _resolvingManualReview = false;
        }
    }

    private ManualReviewForm ManualFormFor(PendingWriteBack pending)
    {
        var key = ManualReviewKey(pending);
        if (!_manualReviewForms.TryGetValue(key, out var form))
        {
            form = new ManualReviewForm();
            _manualReviewForms[key] = form;
        }

        return form;
    }

    private static string ManualReviewKey(PendingWriteBack pending) => $"{pending.MonthKey}:{pending.Id}";

    private static string ManualCheckText(PendingConfirmationResolutionMode mode)
        => mode == PendingConfirmationResolutionMode.DeviceAlreadyAcknowledged
            ? "我已现场处理旧事件，并确认触发位已清除；不确定时不会解除。"
            : "我已现场确认触发位对应的仍是该流水原事件，不是新件；允许服务回写保存的原结果码。";

    private sealed class ManualReviewForm
    {
        public PendingConfirmationResolutionMode Mode { get; set; } = PendingConfirmationResolutionMode.DeviceAlreadyAcknowledged;
        public string Reason { get; set; } = "";
        public string DeviceStateEvidence { get; set; } = "";
        public bool PhysicalCheckConfirmed { get; set; }
    }

    /// <summary>
    /// 已经被流水窗口挤掉的失败。
    /// </summary>
    /// <remarks>
    /// 两份列表会重叠，重叠多少取决于失败有多密：断线时 <c>Recent</c> 里本来就全是失败，
    /// 那一份没有额外信息；偶发故障时它才是唯一还留着证据的地方。
    /// 所以这里只取"早于流水最早一条"的，避免同一行看两遍。
    /// </remarks>
    private static IReadOnlyList<PlcExchangeView> HiddenFailures(PlcTrafficView plc)
        => plc.Recent.Count == 0
            ? plc.RecentFailures
            : plc.RecentFailures.Where(failure => failure.At < plc.Recent[^1].At).ToList();

    /// <summary>探活项的中文名。码名留给 /healthz 的机器判读，页面上说人话。</summary>
    /// <remarks>
    /// "collector" 写成"采集服务心跳"而不是"采集心跳"：它判的是服务主循环还活着（60 秒口径），
    /// 采集被停用时照样新鲜 —— 与"采集循环"那一块判的"扫描有没有在推进"是两件事。
    /// </remarks>
    private static string HealthName(string? name) => name switch
    {
        "config-db" => "配置库",
        "data-root" => "数据盘",
        "runtime-dir" => "运行目录",
        "disk-free" => "磁盘余量",
        "collector" => "采集服务心跳",
        "collection-readiness" => "启动核对",
        "collection-stations" => "工站运行",
        "collection-task-age" => "采集超时",
        _ => "其他健康检查"
    };

    /// <summary>未知探活码只向管理员显示，普通诊断界面使用通用中文名称。</summary>
    private string? AdvancedHealthIdentifier(HealthCheck check)
        => _showAdvancedHealthDetails && HealthName(check.Name) == "其他健康检查"
            ? $"内部标识：{check.Name}"
            : null;

    /// <summary>
    /// 健康项要显示的说明：换成 null 表示"没有可说的"。
    /// </summary>
    /// <remarks>
    /// 探活对成功项只回机器口令 ok（它刻意不回显安装路径），而页面上已经有"正常/异常"这一列 ——
    /// 再把 ok 当说明晾出来，既违背"码名留给 /healthz 判读"的自述，也是纯噪声。
    /// </remarks>
    private static string? HealthDetail(HealthCheck check)
        => string.Equals(check.Detail, "ok", StringComparison.OrdinalIgnoreCase) ? null : check.Detail;

    /// <summary>把"距今多久"写成现场能念出来的一句话。</summary>
    private static string SinceText(TimeSpan? gap)
        => gap is not { } value
            ? "—"
            : value.TotalSeconds < 1
                ? $"{value.TotalMilliseconds:0} 毫秒前"
                : value.TotalSeconds < 60
                    ? $"{(int)value.TotalSeconds} 秒前"
                    : value.TotalMinutes < 60
                        ? $"{(int)value.TotalMinutes} 分钟前"
                        : value.TotalHours < 24
                            ? $"{(int)value.TotalHours} 小时 {value.Minutes} 分前"
                            : $"{(int)value.TotalDays} 天前";

    /// <summary>
    /// "上次成功"那句话。
    /// </summary>
    /// <remarks>
    /// 从来没成功过要单独说：显示成"上次成功 0 秒前"或一个 0 时刻都会把"一直没通"讲成"刚刚还通着"。
    /// </remarks>
    private string SuccessSinceText(PlcTrafficView plc)
        => plc.LastSuccessAt is { } at
            ? $"上次成功 {SinceText(AgeReference - at)}"
            : plc.TotalCount == 0
                ? "还没有请求"
                : "从未成功";

    /// <summary>发过请求却一次都没成功：标题上出红的那个条件。</summary>
    private static bool NeverSucceeded(PlcTrafficView plc)
        => plc.TotalCount > 0 && plc.LastSuccessAt is null;

    /// <summary>把运行时长写成人话：从"几分钟"到"几天几小时"。</summary>
    private static string UptimeText(double seconds)
    {
        var span = TimeSpan.FromSeconds(seconds);
        return span.TotalDays >= 1
            ? $"{(int)span.TotalDays} 天 {span.Hours} 小时"
            : span.TotalHours >= 1
                ? $"{(int)span.TotalHours} 小时 {span.Minutes} 分"
                : span.TotalMinutes >= 1
                    ? $"{(int)span.TotalMinutes} 分钟"
                    : $"{Math.Max(1, (int)span.TotalSeconds)} 秒";
    }

    /// <summary>把"等了多久"写成人话。句子是"已等待 X"，所以不带"前"。</summary>
    private static string WaitText(TimeSpan span)
        => span.TotalMinutes < 1
            ? "不到 1 分钟"
            : span.TotalMinutes < 60
                ? $"{(int)span.TotalMinutes} 分钟"
                : span.TotalHours < 24
                    ? $"{(int)span.TotalHours} 小时 {span.Minutes} 分"
                    : $"{(int)span.TotalDays} 天 {span.Hours} 小时";

    private static string ValueText(PlcExchangeView exchange)
        => exchange.Values.Count == 0
            ? "—"
            : string.Join(' ', exchange.Values.Select(value => value.ToString())) +
              (exchange.WordCount > exchange.Values.Count ? " …" : "");

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();

        if (_visibilityRef is not { } visibilityRef)
        {
            return;
        }

        _visibilityRef = null;
        try
        {
            await Js.InvokeVoidAsync("dtVisibility.dispose", visibilityRef);
        }
        catch (JSDisconnectedException)
        {
            // 导航/关停时电路可能已经断了：拆不掉也无妨，JS 侧拿不到 ref 就不会再回调。
        }
        finally
        {
            visibilityRef.Dispose();
        }
    }
}

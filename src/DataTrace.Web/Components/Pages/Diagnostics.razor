    private static bool PlcHasIssue(PlcTrafficView plc)
        => plc.FailureCount > 0 || NeverSucceeded(plc);

    private bool PlcExpanded(PlcTrafficView plc, bool issue)
    {
        if (_plcExpanded.TryGetValue(plc.PlcConnectionId, out var explicitValue))
        {
            return explicitValue;
        }

        if (_focusedStation is not null && plc.PlcConnectionId == _focusedStation.PlcConnectionId)
        {
            return _focusExpanded;
        }

        // 异常连接默认展开；健康连接默认折叠，除非用户打开「展开健康连接」。
        return issue || _expandHealthyPlc;
    }

    private void SetPlcExpanded(int plcId, bool expanded)
    {
        _plcExpanded[plcId] = expanded;
        if (_focusedStation is not null && plcId == _focusedStation.PlcConnectionId)
        {
            _focusExpanded = expanded;
        }
    }

    private IEnumerable<HealthCheck> VisibleHealthChecks(HealthReport health)
    {
        if (!_onlyIssues)
        {
            return health.Checks;
        }

        var unhealthy = health.Checks.Where(check => !check.Healthy).ToList();
        // 全部正常时仍列出各项，避免页头「全部正常」却看不到检查清单。
        return unhealthy.Count > 0 ? unhealthy : health.Checks;
    }


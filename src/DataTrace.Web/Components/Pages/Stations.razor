@page "/config/stations"
@attribute [Authorize(Roles = "Administrator,Engineer")]
@using DataTrace.Application.Configuration
@using DataTrace.Domain.Entities
@using DataTrace.Domain.Enums
@using DataTrace.Domain.Validation
@using DataTrace.Plc.Addresses
@using DataTrace.Plc.Codec
@using DataTrace.Domain.Evaluation
@inject IConfigRepository Config
@inject IAuditLogger Audit
@inject AuthenticationStateProvider Auth
@inject DtToast Toast
@inject IDialogService DialogService
@inject IJsonFileDialog FileDialog

<PageHeader Title="工站配置" Description="先选工站，再按页签改握手、点位和曲线。改动保存后立即下发给采集器。" HelpRoute="config/stations" />

@if (_plcs.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
        还没有 PLC 连接，请先到「PLC 连接」页新增，再回来新增工站。
    </MudAlert>
}

<MudGrid>
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-3 station-pane">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.subtitle1">工站 @_stations.Count</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@(_busy ? Icons.Material.Filled.Sync : Icons.Material.Filled.Add)"
                           OnClick="AddDevice" Disabled="_busy">@(_busy ? "处理中…" : "新增")</MudButton>
            </MudStack>
            @if (_stations.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="dt-muted">暂无工站，点上方「新增」创建第一台。</MudText>
            }
            @foreach (var station in _stations)
            {
                var selected = station.Id == _current?.Id;
                <div class="@(selected ? "station-list-item active" : "station-list-item")" @onclick="() => Select(station)">
                    <MudStack Row="true" AlignItems="AlignItems.Start">
                        <div>
                            <MudText Typo="Typo.subtitle2">@station.Code</MudText>
                            <MudText Typo="Typo.body2">@station.Name</MudText>
                            <MudText Typo="Typo.caption">
                                @RoleLabel(station) · @PlcName(station.PlcConnectionId) · 点位 @station.Tags.Count · 曲线 @station.Curves.Count
                            </MudText>
                        </div>
                        <MudSpacer />
                        <span @onclick:stopPropagation="true">
                            <MudTooltip Text="删除工站">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                               aria-label="@($"删除工站 {station.Code}")"
                                               Disabled="_busy" OnClick="@(() => DeleteDevice(station))" />
                            </MudTooltip>
                        </span>
                    </MudStack>
                </div>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="9">
        @if (_current is null)
        {
            <MudPaper Class="pa-6 station-pane">
                <MudText>还没有工站。点工站列表上的「新增」创建第一台。</MudText>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="pa-4 station-pane">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">@_current.Code @_current.Name</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveStation" Disabled="_busy"
                               StartIcon="@(_busy ? Icons.Material.Filled.Sync : Icons.Material.Filled.Save)">
                        @(_busy ? "保存中…" : $"保存 {_current.Code}")
                    </MudButton>
                </MudStack>
                <MudGrid Class="mb-2">
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField @bind-Value="_current.Code" @bind-Value:after="ValidateStation" Label="编码"
                                      Immediate="true" Error="@(_codeError is not null)" ErrorText="@_codeError" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField @bind-Value="_current.Name" @bind-Value:after="ValidateStation" Label="工站名称"
                                      Immediate="true" Error="@(_nameError is not null)" ErrorText="@_nameError" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="int" @bind-Value="_current.PlcConnectionId" @bind-Value:after="ValidateStation" Label="所属 PLC"
                                   Error="@(_plcError is not null)" ErrorText="@_plcError">
                            @foreach (var plc in _plcs)
                            {
                                <MudSelectItem T="int" Value="plc.Id">@plc.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudNumericField @bind-Value="_current.Sequence" @bind-Value:after="ValidateStation" Label="产线顺序"
                                         Immediate="true" HelperText="决定前后站与跳站判定，必须互不相同"
                                         Error="@(_sequenceError is not null)" ErrorText="@_sequenceError" />
                    </MudItem>
                </MudGrid>
                @if (_lineWarnings.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mb-2">
                        <ul class="ma-0 pl-4">
                            @foreach (var warning in _lineWarnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </MudAlert>
                }
                <MudTabs Elevation="0" Rounded="true" PanelClass="pt-4" AlwaysShowScrollButtons="true" @bind-ActivePanelIndex="_tab">
                    <MudTabPanel Text="握手">
                        @* 平铺九宫格看不出"哪几个是一件事"：这里按 握手 / 托盘码 / 取值来源 / 线体角色
                           分成四段，每段一句说明，用户不用猜某个字段属于哪部分。 *@
                        <MudText Typo="Typo.subtitle2">握手（触发与回写）</MudText>
                        <MudText Typo="Typo.caption" Class="dt-muted mb-2">
                            工站靠同一个寄存器收发：PLC 把它写成触发值表示有料要采，采集端读完把结果码写回同一个寄存器。
                        </MudText>
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_current.TriggerAddress" @bind-Value:after="ValidateStation"
                                              Label="触发 / 回写地址" Immediate="true"
                                              HelperText="@AddressHelper"
                                              Error="@(_triggerError is not null)" ErrorText="@_triggerError" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudNumericField @bind-Value="_current.TriggerValue" @bind-Value:after="ValidateStation"
                                                 Label="触发值" Immediate="true" HelperText="约定为 1；2 起是回写码，不能用作触发值"
                                                 Error="@(_triggerValueError is not null)" ErrorText="@_triggerValueError" />
                                <InfoHint Topic="HelpTexts.TriggerValue" />
                            </MudItem>
                        </MudGrid>

                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.subtitle2">托盘码与产品位</MudText>
                        @* 这条边界必须写明：点位值改从文件读之后，用户容易以为整站都不读 PLC 了。 *@
                        <MudText Typo="Typo.caption" Class="dt-muted mb-2">
                            这两项始终从 PLC 读：托盘码用来认托盘，有料地址用来判断产品位上有没有件 ——
                            点位值从哪读（见「点位」页签）不影响它们。
                        </MudText>
                        <MudGrid>
                            @* 四列各 3/12：中文字段名在更窄的列里会被浮标标签省略号截掉
                               （实测 md=2 时「托盘码长度」需要 81px 而只有 74px）。 *@
                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="_current.PalletCodeAddress" @bind-Value:after="ValidateStation"
                                              Label="托盘码地址" Immediate="true"
                                              Error="@(_palletError is not null)" ErrorText="@_palletError" />
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudNumericField @bind-Value="_current.PalletCodeLength" @bind-Value:after="ValidateStation"
                                                 Label="托盘码长度" Immediate="true" Min="1" Max="@StationConfigLimits.MaxPalletCodeLength"
                                                 HelperText="字符数"
                                                 Error="@(_palletLengthError is not null)" ErrorText="@_palletLengthError" />
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudSelect T="PlcDataType" @bind-Value="_current.PalletCodeDataType" Label="托盘码类型"
                                           HelperText="字符串最常见；数值型会把寄存器值转成托盘码">
                                    <MudSelectItem T="PlcDataType" Value="PlcDataType.String">字符串</MudSelectItem>
                                    <MudSelectItem T="PlcDataType" Value="PlcDataType.Int32">Int32</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                @* 「可留空」交给 HelperText：放进标签会让它在窄列里被截断。 *@
                                <MudTextField @bind-Value="_occupiedAddress" @bind-Value:after="ValidateStation"
                                              Label="有料地址" Immediate="true"
                                              HelperText="留空 = 恒为有料"
                                              Error="@(_occupiedError is not null)" ErrorText="@_occupiedError" />
                            </MudItem>
                        </MudGrid>
                        <MudText Typo="Typo.caption" Class="dt-muted">
                            有料地址读到 0 时，该工位本轮按空位记录（不判定、不告警）。
                        </MudText>

                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.subtitle2">线体角色</MudText>
                        <MudText Typo="Typo.caption" Class="dt-muted mb-2">
                            首站开托盘会话、末站关会话并上报 MES；停用的工站不参与采集。
                        </MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Class="flex-wrap">
                            <MudSwitch @bind-Value="_current.IsFirstStation" @bind-Value:after="ValidateStation"
                                       Label="首站" Color="Color.Primary" />
                            <MudSwitch @bind-Value="_current.IsLastStation" @bind-Value:after="ValidateStation"
                                       Label="末站" Color="Color.Primary" />
                            <InfoHint Topic="HelpTexts.FirstLastStation" />
                            <MudSwitch @bind-Value="_current.Enabled" @bind-Value:after="ValidateStation"
                                       Label="启用" Color="Color.Primary" />
                            @if (_firstError is not null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@_firstError</MudText>
                            }
                            @if (_lastError is not null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@_lastError</MudText>
                            }
                        </MudStack>
                    </MudTabPanel>
                    <MudTabPanel Text="@($"点位（{_current.Tags.Count} 个）")">
                        @* 数据文件是"哪些点位从文件读"这件事的公共前提，所以跟点位放在同一页：
                           逐点位选来源在编辑对话框里，路径一个工站只有一个（一台设备写一个文件）。 *@
                        <MudGrid Class="mb-1">
                            <MudItem xs="12" md="7">
                                <div class="dt-path-field">
                                    <MudTextField @bind-Value="_current.DataFilePath" @bind-Value:after="ValidateStation"
                                                  Label="数据文件路径" Immediate="true"
                                                  HelperText="可手填，也可点右侧「选择」；点位都来自 PLC 时可留空"
                                                  Error="@(_dataPathError is not null)" ErrorText="@_dataPathError" />
                                    <button type="button" class="dt-path-pick" aria-label="选择数据文件"
                                            disabled="@_busy" @onclick="PickDataFile">
                                        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" />
                                        <span>选择</span>
                                    </button>
                                </div>
                                @if (_dataPathWarning is not null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Warning">@_dataPathWarning</MudText>
                                }
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <MudSelect T="DataFileFormat" @bind-Value="_current.DataFileFormat" @bind-Value:after="ValidateStation"
                                           Label="文件格式" HelperText="@FormatHelper" Disabled="_busy">
                                    <MudSelectItem T="DataFileFormat" Value="DataFileFormat.Json">JSON</MudSelectItem>
                                    <MudSelectItem T="DataFileFormat" Value="DataFileFormat.Csv">CSV</MudSelectItem>
                                </MudSelect>
                                <InfoHint Topic="HelpTexts.TagDataSource" />
                            </MudItem>
                        </MudGrid>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudText Typo="Typo.caption" Class="dt-muted">
                                @FileSourceSummary
                            </MudText>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddTag" Disabled="_busy">新增点位</MudButton>
                        </MudStack>
                        <MudTable Items="_current.Tags.OrderBy(t => t.Name).ToList()" Dense="true" Hover="true" Breakpoint="Breakpoint.Xs">
                            <HeaderContent>
                                @* 给列宽比例：不约束时中文表头会被挤成逐字竖排（曲线页签上实测过）。
                                   只留 5 列：类型并进「来源与地址」的小字里，否则窄容器（侧栏展开时约 560px）
                                   下操作列会被挤到表格外、需要横向滚动。 *@
                                <MudTh Class="dt-nowrap" Style="width:24%">名称</MudTh>
                                <MudTh Class="dt-nowrap" Style="width:26%">来源与地址</MudTh>
                                <MudTh Class="dt-nowrap" Style="width:22%">限值</MudTh>
                                <MudTh Class="dt-nowrap px-1" Style="width:12%">启用</MudTh>
                                <MudTh Class="dt-nowrap px-1"></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="名称">
                                    <MudText Typo="Typo.body2">@context.Name</MudText>
                                    @if (context.IsRequired)
                                    {
                                        <MudText Typo="Typo.caption" Class="dt-muted">必填</MudText>
                                    }
                                    @if (context.Source == TagDataSource.Plc
                                         && context.DataType == PlcDataType.String && context.Length <= 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Warning">字符串长度未设置，采集会读成空</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="来源与地址">
                                    <MudText Typo="Typo.caption" Class="dt-muted">
                                        @SourceLabel(context.Source) · @DataTypeLabel(context.Source, context.DataType)
                                        @if (context.Source == TagDataSource.Plc && context.DataType == PlcDataType.String)
                                        {
                                            <text> · 长 @context.Length</text>
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.body2">@context.Address</MudText>
                                </MudTd>
                                <MudTd DataLabel="限值">
                                    <MudText Typo="Typo.body2">@LimitSummary(context)</MudText>
                                    @if (WarningSummary(context) is { } warning)
                                    {
                                        <MudText Typo="Typo.caption" Class="dt-muted">@warning</MudText>
                                    }
                                </MudTd>
                                <MudTd DataLabel="启用" Class="px-1">
                                    @* 最常改的一个字段，列表里直接拨：为它开一次对话框不值得。 *@
                                    <MudSwitch T="bool" Value="context.Enabled" ValueChanged="@(value => ToggleTagEnabled(context, value))"
                                               Color="Color.Primary" Disabled="_busy"
                                               aria-label="@($"{(context.Enabled ? "停用" : "启用")}点位 {context.Name}")" />
                                </MudTd>
                                <MudTd Class="dt-nowrap px-1">
                                    @* 可访问名带上名称：每行都有「编辑 / 删除」，读屏与测试都难以分辨点的是哪一行。 *@
                                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Disabled="_busy"
                                               aria-label="@($"编辑点位 {context.Name}")"
                                               OnClick="@(() => EditTag(context))">编辑</MudButton><MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Disabled="_busy"
                                               aria-label="@($"删除点位 {context.Name}")"
                                               OnClick="@(() => DeleteTag(context))">删除</MudButton>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2" Class="dt-muted py-3">还没有点位，点右上「新增点位」添加（如压力、保压时间）。</MudText>
                            </NoRecordsContent>
                        </MudTable>
                        @if (FileSourceCount > 0 && _current.DataFileFormat == DataFileFormat.Csv)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mt-3">
                                有 @FileSourceCount 个点位取自 CSV：地址写表头列名。文件须为 UTF-8，第一行表头，下面只能有一行数据。
                                数字与数字串都收，<b>带单位的文本取不到值</b>。曲线仍按 PLC 地址读取。
                            </MudAlert>
                        }
                        else if (FileSourceCount > 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mt-3">
                                有 @FileSourceCount 个点位取自 JSON 文件：「地址」按文件里的字段名写（支持 <b>data.force</b> 这样的嵌套），
                                数字与数字串都收，<b>带单位的文本取不到值</b>；长度、倍率、偏移对这些点位不生效。曲线仍按 PLC 地址读取。
                            </MudAlert>
                        }
                        @if (_current.Tags.Any(t => t.Source == TagDataSource.Plc
                                                    && t.DataType == PlcDataType.String && t.Length <= 0))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mt-3">
                                有字符串点位的「长度」为 0：采集解码为空串，若勾选必填会直接判 NG。请点「编辑」补上长度（建议 16 或 32）。
                            </MudAlert>
                        }
                    </MudTabPanel>
                    <MudTabPanel Text="@($"曲线（{_current.Curves.Count} 条）")">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                            <MudText Typo="Typo.caption" Class="dt-muted">
                                列表只显示摘要；序列与地址在编辑对话框里改，波形判据单独配。
                            </MudText>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddCurve" Disabled="_busy">新增曲线</MudButton>
                        </MudStack>
                        <MudTable Items="_current.Curves.OrderBy(c => c.Code).ToList()" Dense="true" Hover="true" Breakpoint="Breakpoint.Xs">
                            <HeaderContent>
                                @* 列宽给比例：「序列 / 起始地址」内容最长，不约束的话它会把
                                   「波形判据」挤到几十像素，中文表头只能逐字竖排。 *@
                                <MudTh Class="dt-nowrap" Style="width:28%">编码 / 名称</MudTh>
                                <MudTh Class="dt-nowrap" Style="width:30%">序列 / 起始地址</MudTh>
                                <MudTh Class="dt-nowrap" Style="width:16%">波形判据</MudTh>
                                <MudTh Class="dt-nowrap" Style="width:12%">启用</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="编码 / 名称">
                                    <MudText Typo="Typo.body2">@context.Code</MudText>
                                    <MudText Typo="Typo.caption" Class="dt-muted">
                                        @context.Name · @context.PointCount 点
                                        @if (context.PositionIndex > 0)
                                        {
                                            <text> · @PositionLabel(context.PositionIndex)</text>
                                        }
                                    </MudText>
                                </MudTd>
                                <MudTd DataLabel="序列 / 起始地址">
                                    @* 两条序列各一行：并排成两列时，窄窗口下地址会被折成两行、反而更难对。 *@
                                    <MudText Typo="Typo.caption" Class="dt-nowrap">@SeriesSummary(context, SeriesRole.Y)</MudText>
                                    <MudText Typo="Typo.caption" Class="dt-nowrap dt-muted">@SeriesSummary(context, SeriesRole.X)</MudText>
                                </MudTd>
                                <MudTd DataLabel="波形判据">
                                    <MudText Typo="Typo.caption">@CriteriaSummary(context)</MudText>
                                </MudTd>
                                <MudTd DataLabel="启用">
                                    <MudSwitch T="bool" Value="context.Enabled" ValueChanged="@(value => ToggleCurveEnabled(context, value))"
                                               Color="Color.Primary" Disabled="_busy"
                                               aria-label="@($"{(context.Enabled ? "停用" : "启用")}曲线 {context.Code}")" />
                                </MudTd>
                                <MudTd Class="dt-nowrap">
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Disabled="_busy"
                                               aria-label="@($"编辑曲线 {context.Code}")"
                                               OnClick="@(() => EditCurve(context))">编辑</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Disabled="_busy"
                                               aria-label="@($"配置曲线 {context.Code} 的波形判据")"
                                               OnClick="@(() => EditCriteria(context))">波形判据</MudButton>
                                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Disabled="_busy"
                                               aria-label="@($"删除曲线 {context.Code}")"
                                               OnClick="@(() => DeleteCurve(context))">删除</MudButton>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2" Class="dt-muted py-3">还没有曲线，点右上「新增曲线」添加（如位移-压力曲线）。</MudText>
                            </NoRecordsContent>
                        </MudTable>
                        <MudText Typo="Typo.caption" Class="dt-muted mt-2">
                            「波形判据」对整段波形设阈值（峰值、面积、上升/保压段斜率…），能拦住「点位值在限内但波形异常」的漏检。
                        </MudText>
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    /// <summary>本工站里取自 JSON 文件的启用点位数量。为 0 表示整站都从 PLC 读。</summary>
    private int FileSourceCount => _current?.Tags.Count(t => t.Enabled && t.Source == TagDataSource.JsonFile) ?? 0;

    /// <summary>点位列表上方那句汇总：点出有几个点位走文件，用户不用逐行看「来源」列。</summary>
    private string FileSourceSummary => FileSourceCount == 0
        ? $"共 {_current?.Tags.Count ?? 0} 个点位，全部从 PLC 寄存器读。"
        : $"共 {_current?.Tags.Count ?? 0} 个点位，其中 {FileSourceCount} 个取自 {FileKind} 文件。";

    private string FileKind => _current?.DataFileFormat == DataFileFormat.Csv ? "CSV" : "JSON";

    private string FormatHelper => _current?.DataFileFormat == DataFileFormat.Csv
        ? "表头列名，只认一行数据"
        : "字段路径 a.b.c";

    private string SourceLabel(TagDataSource source)
        => source == TagDataSource.JsonFile ? $"{FileKind} 文件" : "PLC 寄存器";

    /// <summary>工站里是否有点位取自 JSON 文件（只看启用中的点位：停用的不参与采集）。</summary>
    private static bool HasFileSourceTag(Station station)
        => station.Tags.Any(t => t.Enabled && t.Source == TagDataSource.JsonFile);

    private static bool UsesNumericLimits(PlcDataType dataType) => dataType is not (PlcDataType.Bool or PlcDataType.String);
    private IReadOnlyList<Station> _stations = [];
    private IReadOnlyList<PlcConnection> _plcs = [];
    private Station? _current;
    private int _tab;
    private string _occupiedAddress = "";

    protected override async Task OnInitializedAsync()
    {
        await ReloadList();
        if (_stations.Count > 0)
        {
            await Select(_stations[0]);
        }
    }

    private int _depth;
    private bool _busy;

    private string? _codeError;
    private string? _nameError;
    private string? _plcError;
    private string? _sequenceError;
    private string? _triggerError;
    private string? _triggerValueError;
    private string? _palletError;
    private string? _palletLengthError;
    private string? _occupiedError;
    private string? _dataPathError;
    private string? _dataPathWarning;
    private string? _firstError;
    private string? _lastError;

    /// <summary>整条线的拓扑问题（缺首站/末站、顺序冲突），保存后重算，只提示不拦截保存。</summary>
    private IReadOnlyList<string> _lineWarnings = [];

    private PlcConnection? CurrentPlc => _plcs.FirstOrDefault(p => p.Id == _current?.PlcConnectionId);

    private static string PositionLabel(int positionIndex) => positionIndex == 0 ? "工站级" : "产品位";

    /// <summary>类型列的显示：文件源没有字宽这回事，只显示「数值 / 文本」。</summary>
    private static string DataTypeLabel(TagDataSource source, PlcDataType dataType)
        => source == TagDataSource.JsonFile
            ? (dataType == PlcDataType.String ? "文本" : "数值")
            : DisplayLabels.DataType(dataType);

    /// <summary>限值摘要：只放规格带（带上单位），细节留给编辑对话框。</summary>
    private static string LimitSummary(TagDefinition tag)
        => !UsesNumericLimits(tag.DataType) ? "—"
            : tag.LowerLimit is null && tag.UpperLimit is null ? "不判定"
            : $"{CompactRange(tag.LowerLimit, tag.UpperLimit)} {tag.Unit}".Trim();

    /// <summary>预警带摘要；没配预警限时不显示这一行，避免每行都挂一句"未配置"。</summary>
    private static string? WarningSummary(TagDefinition tag)
        => UsesNumericLimits(tag.DataType) && (tag.WarningLowerLimit is not null || tag.WarningUpperLimit is not null)
            ? $"预警 {CompactRange(tag.WarningLowerLimit, tag.WarningUpperLimit)}"
            : null;

    /// <summary>
    /// 单侧限值的紧凑写法：只配了一侧时写成 <c>≤ 18</c>，而不是并排表里那种 <c>— ~ 18</c>。
    /// 列表里每行都挂一个破折号只会让人以为"这侧配了 0"。
    /// </summary>
    private static string CompactRange(double? lower, double? upper)
        => lower is null && upper is null ? "—"
            : lower is null ? $"≤ {DisplayLabels.LimitNum(upper)}"
            : upper is null ? $"≥ {DisplayLabels.LimitNum(lower)}"
            : $"{DisplayLabels.LimitNum(lower)} ~ {DisplayLabels.LimitNum(upper)}";

    /// <summary>
    /// 配置库读写全走这里：SQLite 写失败（占用、磁盘满）如果直接抛给 Blazor，整条 circuit 会断掉，
    /// 现场只看到页面卡死且没有任何说明，因此统一转成可读的提示条。
    /// 嵌套调用（如保存后重读列表）不再重复报错，异常交给最外层提示一次。
    /// </summary>
    private async Task Guard(string what, Func<Task> action)
    {
        if (_depth > 0)
        {
            await action();
            return;
        }

        _depth++;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Toast.Add($"{what}失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _depth--;
        }
    }

    /// <summary>
    /// 改配置的动作用这层：写库期间锁住本页的提交按钮，连点不会重复下发，
    /// 也避免"上一个保存还没落库就改下一台工站"造成的互相覆盖。
    /// </summary>
    private async Task Run(string what, Func<Task> action)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await Guard(what, action);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// 用系统文件框点选 JSON。选中只填进输入框，仍要点工站的「保存」才写入配置。
    /// </summary>
    private async Task PickDataFile()
    {
        if (_current is null || _busy)
        {
            return;
        }

        string? path;
        try
        {
            path = await FileDialog.PickAsync(_current.DataFilePath, _current.DataFileFormat);
        }
        catch (InvalidOperationException ex)
        {
            Toast.Add(ex.Message, Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        _current.DataFilePath = path.Trim();
        ValidateStation();
    }

    /// <summary>字段级校验：错误直接标在输入框上，不等提交时才弹提示。</summary>
    private void ValidateStation()
    {
        if (_current is null)
        {
            return;
        }

        _codeError = string.IsNullOrWhiteSpace(_current.Code) ? "工站编码不能为空"
            : CodeTaken(_current.Code, _current.Id) ? $"工站编码 {_current.Code.Trim()} 已被占用"
            : null;
        _nameError = string.IsNullOrWhiteSpace(_current.Name) ? "工站名称不能为空" : null;
        _plcError = _plcs.Any(p => p.Id == _current.PlcConnectionId) ? null : "请选择所属 PLC";
        _triggerError = AddressError(_current.TriggerAddress, "触发 / 回写地址不能为空");
        _palletError = AddressError(_current.PalletCodeAddress, "托盘码地址不能为空");
        _occupiedError = string.IsNullOrWhiteSpace(_occupiedAddress)
            ? null
            : AddressError(_occupiedAddress, "有料地址不能为空");
        _triggerValueError = StationConfigLimits.TriggerValueError(_current.TriggerValue);
        _palletLengthError = StationConfigLimits.PalletCodeLengthError(_current.PalletCodeLength);
        _dataPathError = null;
        _dataPathWarning = null;
        // 路径只有"真有文件源点位"时才必须填：整站都从 PLC 读的工站不该被一条用不上的配置拦住。
        var path = _current.DataFilePath?.Trim() ?? "";
        if (HasFileSourceTag(_current))
        {
            _dataPathError = path.Length == 0 ? "有点位取自 JSON 文件，数据文件路径不能为空" : null;
            // 文件由设备写、每件覆写：路径上现在没有文件只提示不拦截，
            // 设备可能还没跑第一件，也可能通过另一条路径共享过来（映射盘/UNC）。
            _dataPathWarning = _dataPathError is null && !File.Exists(path)
                ? "这个路径上现在没有文件：采集时以设备写出的那一份为准，请确认设备与上位机看到的是同一个路径。"
                : null;
        }

        _sequenceError = SequenceError(_current);
        _firstError = DuplicateFlagError(_current, x => x.IsFirstStation, "首站");
        _lastError = DuplicateFlagError(_current, x => x.IsLastStation, "末站");
        _lineWarnings = LineWarnings(_current);
    }

    /// <summary>
    /// 产线顺序校验：顺序决定前后站与"跳站"判定的口径，重复或非正数都会让判定变得没有依据。
    /// </summary>
    private string? SequenceError(Station station)
    {
        if (!station.Enabled)
        {
            return null;
        }

        if (station.Sequence <= 0)
        {
            return "产线顺序必须大于 0";
        }

        var taken = _stations.FirstOrDefault(s => s.Id != station.Id && s.Enabled && s.Sequence == station.Sequence);
        return taken is null ? null : $"产线顺序 {station.Sequence} 已被工站 {taken.Code} 占用";
    }

    private string? DuplicateFlagError(Station station, Func<Station, bool> flag, string label)
    {
        if (!station.Enabled || !flag(station))
        {
            return null;
        }

        var other = _stations.FirstOrDefault(s => s.Id != station.Id && s.Enabled && flag(s));
        return other is null ? null : $"工站 {other.Code} 已是{label}；一条线只能有一个启用的{label}";
    }

    /// <summary>
    /// 整条线的拓扑提示：缺首站会让托盘没有会话、缺末站会让会话永不关闭、顺序重复会让跳站判定失去依据。
    /// </summary>
    /// <remarks>
    /// 只提示不拦截保存：维护期间临时停掉唯一的末站是正常操作，拦住它反而没法干活。
    /// </remarks>
    private IReadOnlyList<string> LineWarnings(Station station)
    {
        var warnings = new List<string>();
        var enabled = _stations.Where(s => s.Enabled).ToList();
        if (station.Enabled && enabled.All(s => s.Id != station.Id))
        {
            enabled.Add(station);
        }

        if (enabled.Count == 0)
        {
            return warnings;
        }

        if (enabled.All(s => !s.IsFirstStation))
        {
            warnings.Add("没有任何启用的首站：托盘不会建立会话，采集记录会按「未找到在制托盘会话（可能跳站）」处理。");
        }

        if (enabled.All(s => !s.IsLastStation))
        {
            warnings.Add("没有任何启用的末站：托盘会话永远不会关闭，在制托盘只会增不会减，MES 也不会收到上报。");
        }

        var duplicated = enabled
            .GroupBy(s => s.Sequence)
            .Where(g => g.Count() > 1)
            .Select(g => $"产线顺序 {g.Key} 被 {string.Join("、", g.Select(x => x.Code))} 共用");
        warnings.AddRange(duplicated);

        return warnings;
    }

    /// <summary>
    /// 地址字段校验：按所属 PLC 的品牌检查写法，并拒绝位地址。
    /// </summary>
    /// <remarks>
    /// 位地址（三菱 M100、西门子 DB1.DBX0.0、Modbus 线圈…）解析得出来但进不了读计划，
    /// 采集时会静默读回 0 —— 必须在保存前拦住，否则现场只会看到"值恒为 0"。
    /// </remarks>
    private string? AddressError(string? text, string emptyMessage)
    {
        var plc = CurrentPlc;
        if (plc is null)
        {
            // 还没选 PLC 时 _plcError 已经报了，这里不再叠加地址错。
            return null;
        }

        if (string.IsNullOrWhiteSpace(text))
        {
            return emptyMessage;
        }

        return PlcAddressValidator.TryValidate(plc.Brand, text, out _, out var error) ? null : error;
    }

    /// <summary>地址写法提示：跟着所属 PLC 的品牌走，免得照着别的品牌写。</summary>
    private string AddressHelper
    {
        get
        {
            return CurrentPlc?.Brand switch
            {
                PlcBrand.SiemensS7 => "西门子示例：DB1.DBW0、DB1.DBD4、MW10（不支持位地址）",
                PlcBrand.ModbusTcp => "Modbus 示例：40001 保持寄存器、30001 输入寄存器（不支持线圈/离散量）",
                PlcBrand.OmronFins => "欧姆龙示例：D100、CIO100、W0、H10（不支持位地址）",
                _ => "三菱示例：D100、W1A、ZR100（不支持 M/X/Y 等位地址）"
            };
        }
    }

    private bool CodeTaken(string code, int selfId) => _stations.Any(s => s.Id != selfId
        && string.Equals(s.Code?.Trim(), code.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool StationValid
    {
        get
        {
            ValidateStation();
            return _codeError is null && _nameError is null && _plcError is null
                   && _sequenceError is null && _triggerError is null && _triggerValueError is null
                   && _palletError is null && _palletLengthError is null && _occupiedError is null
                   && _dataPathError is null
                   && _firstError is null && _lastError is null;
        }
    }

    /// <summary>新增点位：表单在对话框里，页面只负责下发默认值与落库。</summary>
    private Task AddTag() => ShowTagDialog(
        new TagDefinition
        {
            StationId = _current?.Id ?? 0,
            DataType = PlcDataType.Float,
            Scale = 1,
            Offset = 0,
            IsRequired = true,
            PositionIndex = 1
        },
        isNew: true);

    /// <summary>编辑点位：传克隆体进对话框，取消时不会在跟踪上下文里留下脏实体。</summary>
    private Task EditTag(TagDefinition tag) => ShowTagDialog(CloneTag(tag), isNew: false);

    /// <summary>
    /// 点位编辑对话框：新增与编辑共用，页面不再常驻一大片表单。
    /// </summary>
    /// <remarks>
    /// 校验与归一都在对话框里做（它才看得见用户在改什么），这里只负责把结果落库与写审计；
    /// 参数带上所属 PLC 品牌与工站的数据文件路径：对话框据此校验地址，
    /// 并在用户选了 JSON 来源而工站还没配路径时直接拦下（比落库时报错更早一步）。
    /// </remarks>
    private async Task ShowTagDialog(TagDefinition tag, bool isNew)
    {
        if (_current is null || _busy)
        {
            return;
        }

        var station = _current;
        var parameters = new DialogParameters
        {
            ["Tag"] = tag,
            ["IsNew"] = isNew,
            ["Brand"] = CurrentPlc?.Brand,
            ["DataFilePath"] = station.DataFilePath ?? "",
            ["FileFormat"] = station.DataFileFormat,
            ["Siblings"] = station.Tags.ToList()
        };
        var dialog = await DialogService.ShowAsync<TagEditDialog>(
            isNew ? "新增点位" : $"编辑点位 · {tag.Name}",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not TagDefinition edited)
        {
            return;
        }

        await Run(isNew ? "添加点位" : "保存点位", async () =>
        {
            edited.StationId = station.Id;
            var oldTag = isNew ? null : station.Tags.FirstOrDefault(t => t.Id == edited.Id);
            var oldSnap = oldTag is null ? null
                : $"{oldTag.Address}; {oldTag.DataType}; limits={DisplayLabels.LimitRange(oldTag.LowerLimit, oldTag.UpperLimit)}";
            await Config.SaveTagAsync(edited);
            await AuditAsync(isNew ? "Create" : "Save", "TagDefinition", $"{station.Code}/{edited.Name}", oldSnap,
                $"source={edited.Source}; {edited.Address}; {edited.DataType}; limits={DisplayLabels.LimitRange(edited.LowerLimit, edited.UpperLimit)}");
            var tab = _tab;
            await Select(station);
            _tab = tab;
            Toast.Add(isNew ? $"点位 {edited.Name} 已添加" : $"点位 {edited.Name} 已保存", Severity.Success);
        });
    }

    /// <summary>
    /// 列表里直接改启用状态：这是最常改的一个字段，为它开对话框不值得。
    /// </summary>
    /// <remarks>
    /// 无论成败都重读一次工站：失败时开关必须退回库里的真实状态，
    /// 不能停在一个"看着像改了、其实没保存"的样子上。
    /// </remarks>
    private Task ToggleTagEnabled(TagDefinition tag, bool enabled) => Run("保存点位", async () =>
    {
        if (_current is null || tag.Enabled == enabled)
        {
            return;
        }

        var clone = CloneTag(tag);
        clone.Enabled = enabled;
        try
        {
            await Config.SaveTagAsync(clone);
            await AuditAsync("Save", "TagDefinition", $"{_current.Code}/{tag.Name}",
                $"enabled={tag.Enabled}", $"enabled={enabled}; {clone.Address}; {clone.DataType}");
            Toast.Add($"{tag.Name} 已{(enabled ? "启用" : "停用")}", Severity.Success);
        }
        finally
        {
            var station = _current;
            var tab = _tab;
            await Select(station);
            _tab = tab;
        }
    });

    /// <summary>
    /// 点位的克隆体，供对话框编辑与列表里直接改启用状态使用。
    /// </summary>
    /// <remarks>
    /// 漏抄任何一个字段都会静默改配置（例如漏了 Source，编辑一次就把来源重置回 PLC），
    /// 所以这里逐字段列全，新增字段时必须同步补上。
    /// </remarks>
    private static TagDefinition CloneTag(TagDefinition tag) => new()
    {
        Id = tag.Id,
        StationId = tag.StationId,
        Name = tag.Name,
        Address = tag.Address,
        DataType = tag.DataType,
        Source = tag.Source,
        Length = tag.Length,
        Scale = tag.Scale,
        Offset = tag.Offset,
        Unit = tag.Unit,
        LowerLimit = tag.LowerLimit,
        UpperLimit = tag.UpperLimit,
        WarningLowerLimit = tag.WarningLowerLimit,
        WarningUpperLimit = tag.WarningUpperLimit,
        TargetValue = tag.TargetValue,
        IsRequired = tag.IsRequired,
        PositionIndex = tag.PositionIndex,
        Enabled = tag.Enabled
    };

    /// <summary>
    /// 曲线编辑对话框：新增与编辑共用，页面不再常驻一大片表单。
    /// </summary>
    /// <remarks>
    /// 新建时按当前 PLC 品牌预填一套合法地址（对话框负责），已有曲线一律载入库里的现值。
    /// </remarks>
    private async Task ShowCurveDialog(CurveDefinition curve, bool isNew)
    {
        if (_current is null || _busy)
        {
            return;
        }

        var station = _current;
        var parameters = new DialogParameters
        {
            ["Curve"] = curve,
            ["IsNew"] = isNew,
            ["Brand"] = CurrentPlc?.Brand,
            ["Siblings"] = station.Curves.ToList()
        };
        var dialog = await DialogService.ShowAsync<CurveEditDialog>(
            isNew ? "新增曲线" : $"编辑曲线 · {curve.Code}",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not CurveDefinition edited)
        {
            return;
        }

        await Run(isNew ? "添加曲线" : "保存曲线", async () =>
        {

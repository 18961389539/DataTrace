            var code = edited.Code;
            var summary = $"points={edited.PointCount}; " +
                          $"y={SeriesAddress(edited, SeriesRole.Y)}; x={SeriesAddress(edited, SeriesRole.X)}; " +
                          $"enabled={edited.Enabled}";

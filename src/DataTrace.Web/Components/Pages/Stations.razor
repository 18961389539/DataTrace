    /// <summary>
    /// 列表里直接改启用状态（与点位页签同一套做法）。
    /// </summary>
    /// <remarks>
    /// 无论成败都重读一次工站：失败时开关必须退回库里的真实状态，
    /// 不能停在一个"看着像改了、其实没保存"的样子上。
    /// 传的是克隆体，且必须带上两条序列 —— 仓储按角色整体替换 Series。
    /// </remarks>
    private Task ToggleCurveEnabled(CurveDefinition curve, bool enabled) => Run("保存曲线", async () =>
    {
        if (_current is null || curve.Enabled == enabled)
        {
            return;
        }

        var clone = CloneCurve(curve);
        clone.Enabled = enabled;
        try
        {
            await Config.SaveCurveAsync(clone);
            await AuditAsync("Save", "CurveDefinition", $"{_current.Code}/{curve.Code}",
                $"enabled={curve.Enabled}", $"enabled={enabled}; {clone.Code}");
            Toast.Add($"曲线 {curve.Code} 已{(enabled ? "启用" : "停用")}", Severity.Success);
        }
        finally
        {
            var station = _current;
            var tab = _tab;
            await Select(station);
            _tab = tab;
        }
    });

    private static CurveDefinition CloneCurve(CurveDefinition curve) => new()
    {
        Id = curve.Id,
        StationId = curve.StationId,
        Code = curve.Code,
        Name = curve.Name,
        PointCount = curve.PointCount,
        PositionIndex = curve.PositionIndex,
        Enabled = curve.Enabled,
        // Series 必须一起带上：仓储按角色整体替换，缺了它这次保存会把地址连同序列一起清掉。
        Series = curve.Series.Select(s => new CurveSeries
        {
            Id = s.Id,
            CurveDefinitionId = s.CurveDefinitionId,
            Name = s.Name,
            Role = s.Role,
            StartAddress = s.StartAddress,
            DataType = s.DataType,
            StrideWords = s.StrideWords,
            Scale = s.Scale,
            Offset = s.Offset,
            Unit = s.Unit
        }).ToList()
    };

    private static string SeriesAddress(CurveDefinition curve, SeriesRole role)
        => curve.Series.FirstOrDefault(s => s.Role == role)?.StartAddress ?? "-";

    /// <summary>序列摘要：「Y 压力 kN · D3000」；缺了某个角色也说清楚，别让空字符串看着像"没配地址"。</summary>
    private static string SeriesSummary(CurveDefinition curve, SeriesRole role)
    {
        var series = curve.Series.FirstOrDefault(s => s.Role == role);
        return series is null
            ? $"{role}：未配置"
            : $"{role} {series.Name} {series.Unit} · {series.StartAddress}".Replace("  ", " ");
    }

    /// <summary>
    /// 判据摘要：条数 + 其中启用了几条。
    /// </summary>
    /// <remarks>
    /// 只写条数会骗人：全部停用的判据一条都不参与判定，与"没配判据"在采集端是同一个行为。
    /// </remarks>
    private static string CriteriaSummary(CurveDefinition curve)
    {
        var total = curve.Criteria.Count;
        if (total == 0)
        {
            return "未配置";
        }

        var enabled = curve.Criteria.Count(c => c.Enabled);
        return enabled == total ? $"{total} 条" : $"{total} 条 · 启用 {enabled}";
    }

    private Task ReloadList() => Guard("加载工站配置", async () =>
    {
        _plcs = await Config.GetPlcConnectionsAsync();
        _stations = await Config.GetStationsAsync();
    });

    private string PlcName(int id) => _plcs.FirstOrDefault(p => p.Id == id)?.Name ?? "-";

    private static string RoleLabel(Station station)
    {
        if (station.IsFirstStation) return "首站";
        if (station.IsLastStation) return "末站";
        return "中间站";
    }

    private static string YStart(CurveDefinition curve)
        => curve.Series.FirstOrDefault(s => s.Role == SeriesRole.Y)?.StartAddress ?? "-";

    private static string XStart(CurveDefinition curve)
        => curve.Series.FirstOrDefault(s => s.Role == SeriesRole.X)?.StartAddress ?? "-";

    private Task Select(Station? station)
    {
        if (station is null)
        {
            return Task.CompletedTask;
        }

        ClearErrors();
        var id = station.Id;
        return Guard("读取工站", async () =>
        {
            _current = await Config.GetStationAsync(id);
            // 历史配置里可能已经存着采集读不到的地址（例如按别的品牌写的、或是位地址）。
            // 进页面就算一遍，别让用户非要去动一下那个输入框才看到红字。
            _occupiedAddress = _current?.Positions.FirstOrDefault()?.OccupiedAddress ?? "";
            ValidateStation();
        });
    }

    /// <summary>换工站或重新加载后，上一台的校验残留必须清掉，否则会错标在新工站上。</summary>
    private void ClearErrors()
    {
        _codeError = _nameError = _plcError = _sequenceError = null;
        _triggerError = _triggerValueError = _palletError = _palletLengthError = _occupiedError = null;
        _dataPathError = _dataPathWarning = null;
        _firstError = _lastError = null;
    }

    private Task AddDevice() => Run("新增工站", async () =>
    {
        var plc = _plcs.FirstOrDefault(p => p.Enabled) ?? _plcs.FirstOrDefault();
        if (plc is null)
        {
            Toast.Add("请先在 PLC 连接里添加一台 PLC", Severity.Warning);
            return;
        }

        // 顺序按 10 递增，编码与顺序都要避开已占用的值：
        // 现场有手工改过编码的库时，ST{seq} 可能与别的工站撞码。
        var seq = _stations.Count == 0 ? 10 : _stations.Max(s => s.Sequence) + 10;
        while (_stations.Any(s => s.Sequence == seq || CodeTaken($"ST{seq:000}", 0)))
        {
            seq += 10;
        }

        // 默认地址跟品牌走：演示线的握手区是 D1000 起、每站 200（D1000/D1200/D1400…），
        // 这样既与内置演示数据一致，也不会撞上曲线默认用的 D2000。
        var baseAddr = PlcAddressDefaults.HandshakeBase + Math.Max(0, seq / 10 - 1) * 200;
        var station = new Station
        {
            PlcConnectionId = plc.Id,
            Code = $"ST{seq:000}",
            Name = $"工站{seq}",
            Sequence = seq,
            TriggerAddress = PlcAddressDefaults.Word(plc.Brand, baseAddr),
            TriggerValue = 1,
            PalletCodeAddress = PlcAddressDefaults.Word(plc.Brand, baseAddr + 10),
            PalletCodeLength = 16,
            PositionCount = 1,
            Enabled = true
        };
        await Config.SaveStationAsync(station);
        await AuditAsync("Create", "Station", station.Code, null, $"{station.Name}; plc={station.PlcConnectionId}; seq={station.Sequence}");
        await ReloadList();
        await Select(station);
        _tab = 0;
        Toast.Add("已新增工站", Severity.Success);
    });

    private Task DeleteDevice(Station station) => Run("删除工站", async () =>
    {
        var tags = station.Tags.Count;
        var curves = station.Curves.Count;
        var extra = tags + curves > 0 ? $"，同时删除 {tags} 个点位、{curves} 条曲线定义" : "";
        var confirmed = await DialogService.ShowMessageBox(
            "删除工站",
            $"确定删除工站「{station.Code} {station.Name}」？{extra}。已采集的历史记录不受影响，但操作不可恢复。",
            yesText: "删除", cancelText: "取消");
        if (confirmed != true)
        {
            return;
        }

        await Config.DeleteStationAsync(station.Id);
        await AuditAsync("Delete", "Station", station.Code, $"{station.Name}; tags={tags}; curves={curves}", null);
        if (_current?.Id == station.Id)
        {
            _current = null;
        }

        await ReloadList();
        if (_current is null && _stations.Count > 0)
        {
            await Select(_stations[0]);
        }

        Toast.Add($"已删除 {station.Code}", Severity.Success);
    });

    private Task SaveStation() => Run("保存工站", async () =>
    {
        if (_current is null) return;
        if (!StationValid)
        {
            // 「触发 / 回写地址」和「托盘码地址」都在握手页签里，报错时把那页切出来，
            // 否则用户看不到红字长在哪，只觉得按钮点了没反应。
            if (_triggerError is not null || _palletError is not null)
            {
                _tab = 0;
            }
            else if (_dataPathError is not null)
            {
                _tab = 1;
            }

            return;
        }

        _current.Code = _current.Code.Trim();
        _current.Name = _current.Name.Trim();
        // 路径原样交给采集侧用：这里只去掉手滑留下的首尾空格（UNC 与映射盘都可能有尾随空格）。
        _current.DataFilePath = (_current.DataFilePath ?? "").Trim();
        // 历史库里可能没有产品位行：这里补一条，否则用户刚填的有料地址会被静默丢掉。
        var position = _current.Positions.FirstOrDefault(p => p.Index == 1) ?? _current.Positions.FirstOrDefault();
        if (position is null)
        {
            position = new ProductPositionDefinition { Index = 1, Name = "产品" };
            _current.Positions.Add(position);
        }

        position.OccupiedAddress = string.IsNullOrWhiteSpace(_occupiedAddress) ? null : _occupiedAddress.Trim();

        var before = _stations.FirstOrDefault(s => s.Id == _current.Id);
        var oldSnap = before is null ? null
            : $"{before.Name}; plc={before.PlcConnectionId}; trigger={before.TriggerAddress}; enabled={before.Enabled}";
        await Config.SaveStationAsync(_current);
        await AuditAsync("Save", "Station", _current.Code, oldSnap,
            $"{_current.Name}; plc={_current.PlcConnectionId}; trigger={_current.TriggerAddress}; " +
            $"dataFile={_current.DataFilePath}; format={_current.DataFileFormat}; " +
            $"occupied={position?.OccupiedAddress ?? "-"}; enabled={_current.Enabled}");
        Toast.Add($"{_current.Code} 已保存并下发采集器", Severity.Success);
        var id = _current.Id;
        var tab = _tab;
        await ReloadList();
        await Select(_stations.First(s => s.Id == id));
        _tab = tab;
    });

    private Task DeleteTag(TagDefinition tag) => Run("删除点位", async () =>
    {
        if (_current is null) return;
        var confirmed = await DialogService.ShowMessageBox(
            "删除点位",
            $"确定删除点位「{tag.Name}」？删除后采集时不再读取该地址。",
            yesText: "删除", cancelText: "取消");
        if (confirmed != true)
        {
            return;
        }

        await Config.DeleteTagAsync(tag.Id);
        await AuditAsync("Delete", "TagDefinition", $"{_current.Code}/{tag.Name}", tag.Address, null);
        var tab = _tab;
        await Select(_current);
        _tab = tab;
        Toast.Add($"点位 {tag.Name} 已删除", Severity.Success);
    });

    /// <summary>新增曲线：地址与序列在对话框里填，页面只负责下发品牌与落库。</summary>
    private Task AddCurve() => ShowCurveDialog(
        new CurveDefinition { StationId = _current?.Id ?? 0, PointCount = 50, PositionIndex = 1, Enabled = true },
        isNew: true);

    /// <summary>编辑曲线：传克隆体（含序列）进对话框，取消时不会在跟踪上下文里留下脏实体。</summary>
    private Task EditCurve(CurveDefinition curve) => ShowCurveDialog(CloneCurve(curve), isNew: false);

    /// <summary>
    /// 波形判据编辑。对话框返回的是克隆集合，这里整体交给仓储做按主键增量同步。
    /// 打开对话框这段时间不算"正在保存"，否则用户编辑判据的几分钟里整页按钮都是灰的。
    /// </summary>
    private async Task EditCriteria(CurveDefinition curve)
    {
        var station = _current;
        if (station is null || _busy)
        {
            return;
        }

        var parameters = new DialogParameters { ["Curve"] = curve };
        var dialog = await DialogService.ShowAsync<CurveCriterionDialog>($"波形判据 · {curve.Code}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not IReadOnlyList<CurveCriterion> criteria)
        {
            return;
        }

        await Run("保存波形判据", async () =>
        {
            // 不写 curve.Criteria：它是被跟踪实体的导航集合，替换它会和 EF 的导航修正
            // 互相打架（同一行会在集合里留下两份）。仓储按主键同步，随后重读即可。
            var beforeCount = curve.Criteria?.Count ?? 0;
            await Config.SaveCurveCriteriaAsync(curve.Id, criteria);
            await AuditAsync("Save", "CurveCriterion", $"{station.Code}/{curve.Code}",
                $"count={beforeCount}", $"count={criteria.Count}");
            var tab = _tab;
            await Select(station);
            _tab = tab;
            Toast.Add(
                criteria.Count == 0
                    ? $"曲线 {curve.Code} 已关闭波形判定"
                    : $"曲线 {curve.Code} 已保存 {criteria.Count} 条波形判据并下发采集器",
                Severity.Success);
        });
    }

    private Task DeleteCurve(CurveDefinition curve) => Run("删除曲线", async () =>
    {
        if (_current is null) return;
        var confirmed = await DialogService.ShowMessageBox(
            "删除曲线定义",
            $"确定删除曲线「{curve.Code} {curve.Name}」？历史曲线文件不会被删除，" +
            "但这条曲线的波形基线会随之失效（重建需要重新累积样本）。",
            yesText: "删除", cancelText: "取消");
        if (confirmed != true)
        {
            return;
        }

        await Config.DeleteCurveAsync(curve.Id);
        await AuditAsync("Delete", "CurveDefinition", $"{_current.Code}/{curve.Code}", curve.Name, null);
        var tab = _tab;
        await Select(_current);
        _tab = tab;
        Toast.Add($"曲线 {curve.Code} 已删除", Severity.Success);
    });

    /// <summary>
    /// 写审计日志。失败时单独提示一次，而不是吞掉或者把已成功的保存说成失败。
    /// </summary>
    /// <remarks>
    /// 配置已经落库并下发了，这时候告诉用户"保存失败"会让人反复保存；
    /// 完全不说又会让"谁改了什么"出现空洞，所以两者分开讲。
    /// </remarks>
    private async Task AuditAsync(string action, string entityType, string key, string? oldValue, string? newValue)
    {
        try
        {
            var user = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
            await Audit.WriteAsync(user, action, entityType, key, oldValue, newValue);
        }
        catch (Exception ex)
        {
            Toast.Add($"操作已完成，但审计记录失败：{ex.Message}", Severity.Warning);
        }
    }
}


@page "/config/settings"
@attribute [Authorize(Roles = "Administrator,Engineer")]
@using DataTrace.Application.Backup
@using DataTrace.Application.Configuration
@using DataTrace.Collector
@using DataTrace.Web.Services
@inject IConfigRepository Config
@inject ILineSimulator Simulator
@inject DtToast Toast
@inject IDialogService DialogService
@inject CustomerBrandingStore Branding
@inject IDatabaseBackupService BackupService

<PageHeader Title="系统设置">
    <ChildContent>
        @if (Dirty)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">未保存</MudChip>
        }
    </ChildContent>
    <Actions>
        <MudText Typo="Typo.caption" Class="dt-muted">改动要点「保存」才会下发，采集器下一轮轮询采用新参数</MudText>
    </Actions>
</PageHeader>

@if (_loading)
{
    <MudSkeleton Class="mb-3" />
    <MudSkeleton Class="mb-3" SkeletonType="SkeletonType.Rectangle" Height="280px" />
}
else if (_settings is null)
{
    <MudAlert Severity="Severity.Error" Dense="true">系统设置读取失败，请刷新页面重试。</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-3">
        <MudText Typo="Typo.subtitle1" Class="mb-2">部署身份（配得开）</MudText>
        <MudText Typo="Typo.caption" Class="dt-muted mb-3">
            一客户一套部署。厂名/Logo 写入安装目录 customer.json；端口与数据目录由安装脚本写入 appsettings.Production.json。
            多产线请使用多个安装目录（或未来 SiteId），本页不建多站点库表。
        </MudText>
        <MudStack Row="true" Spacing="4" Class="flex-wrap mb-3">
            <div class="dt-metric">
                <div class="dt-metric-label">客户标识</div>
                <div class="dt-metric-value">@(_identity.CustomerId is { Length: > 0 } ? _identity.CustomerId : "—")</div>
            </div>
            <div class="dt-metric">
                <div class="dt-metric-label">运行环境</div>
                <div class="dt-metric-value">@_envName</div>
            </div>
            <div class="dt-metric">
                <div class="dt-metric-label">数据目录</div>
                <div class="dt-metric-value" style="font-size:.85rem;word-break:break-all">@_dataRoot</div>
            </div>
            <div class="dt-metric">
                <div class="dt-metric-label">监听地址</div>
                <div class="dt-metric-value" style="font-size:.85rem">@(_bindUrl ?? "—")</div>
            </div>
        
            <div class="dt-metric">
                <div class="dt-metric-label">应用版本</div>
                <div class="dt-metric-value">@_appVersion</div>
            </div></MudStack>
        <AuthorizeView Roles="Administrator">
            <Authorized>
                <MudGrid>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_editSiteName" Label="厂名 / 站点显示名" Immediate="true"
                                      HelperText="顶栏、登录页、浏览器标题；保存到 customer.json" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="_editLogoPath" Label="Logo 文件名" Immediate="true"
                                      Placeholder="logo.png"
                                      HelperText="放在安装目录 branding\ 下，例如 logo.png → /branding/logo.png" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" Class="d-flex align-center">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SaveBranding" Disabled="_savingBrand"
                                   StartIcon="@Icons.Material.Filled.Badge">
                            @(_savingBrand ? "保存中…" : "保存品牌")
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </Authorized>
            <NotAuthorized>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">厂名/Logo 仅管理员可改；当前为只读展示。</MudAlert>
            </NotAuthorized>
        </AuthorizeView>
    </MudPaper>

    @if (_softCapWarning is { Length: > 0 })
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Variant="Variant.Outlined">
            @_softCapWarning
        </MudAlert>
    }

    @if (_productionSimWarning)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Outlined">
            Production 环境下数据库仍开启「启动后自动跑仿真」（SimulatorAutoRun=true）。客户现场请保持关闭；应用下次启动会强制写回 false。
        </MudAlert>
    }

    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        <b>默认密码：</b>首次部署请到「用户」页修改 admin / engineer 等出厂口令。应用不会强制改密以免把管理员锁在门外。
    </MudAlert>

    <MudPaper Class="pa-4 mb-3">
        <MudText Typo="Typo.subtitle1" Class="mb-3">采集</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudNumericField @bind-Value="_settings.ScanIntervalMs" Label="扫描周期(ms)" Min="20" Max="5000"
                                 Step="10" HelperText="采集器轮询 PLC 的间隔；改小更快，但会增加 PLC 负载" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudNumericField @bind-Value="_settings.WriteRetryCount" Label="写回重试次数" Min="0" Max="10"
                                 HelperText="0 表示只写一次；NG 回写失败会导致 PLC 收不到结果" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudNumericField @bind-Value="_settings.RetentionYears" Label="保留年数" Min="1" Max="30"
                                 HelperText="按整月删除更早的月库与曲线文件" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                <MudSwitch T="bool" Value="_settings.CollectEnabled" ValueChanged="ToggleCollect" Disabled="_saving"
                           Label="启用采集" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
            <MudText Typo="Typo.subtitle1">模拟产线</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" Size="Size.Small" Href="/simulate"
                       EndIcon="@Icons.Material.Filled.ChevronRight">去 PLC 仿真页修改</MudButton>
        </MudStack>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Variant="Variant.Text">
            客户 Production 安装默认关闭「启动后自动跑仿真」（见 customer.json / appsettings.Production.json 的 SimulatorAutoRun）。
            开发演示环境仍可默认开启。现场勿误开仿真。开关改动请在「PLC 仿真」页操作并保存。
        </MudAlert>
        @* 只读展示：可编辑入口仅在「PLC 仿真」页，避免两处同时写互相覆盖。 *@
        <MudStack Row="true" Spacing="4" Class="flex-wrap">
            <div class="dt-metric">
                <div class="dt-metric-label">启动后自动跑仿真</div>
                <div class="dt-metric-value">@(_settings.SimulatorAutoRun ? "开" : "关")</div>
            </div>
            <div class="dt-metric">
                <div class="dt-metric-label">托盘间隔</div>
                <div class="dt-metric-value">@_settings.SimulatorIntervalMs ms</div>
            </div>
            <div class="dt-metric">
                <div class="dt-metric-label">NG 比例</div>
                <div class="dt-metric-value">@_settings.SimulatorNgPercent %</div>
            </div>
            <div class="dt-metric">
                <div class="dt-metric-label">托盘池数量</div>
                <div class="dt-metric-value">@_settings.SimulatorPalletPool</div>
            </div>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 mb-3">
        <MudText Typo="Typo.subtitle1" Class="mb-3">MES 推送</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
                <MudSwitch @bind-Value="_settings.MesEnabled" Label="启用 MES HTTP 推送" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="6" md="6">
                <MudTextField @bind-Value="_settings.MesEndpoint" Label="MES 地址" Placeholder="http://mes.local/api/collect"
                              Immediate="true" HelperText="启用推送时必须填写 http(s) 地址" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudNumericField @bind-Value="_settings.MesTimeoutSeconds" Label="MES 超时(秒)" Min="1" Max="300" />
            </MudItem>
        </MudGrid>
    </MudPaper>


    <MudPaper Class="pa-4 mb-3">
        <MudText Typo="Typo.subtitle1" Class="mb-2">数据库备份</MudText>
        <MudText Typo="Typo.caption" Class="dt-muted mb-3">
            定时在线备份 config.db 与 runtime 月库（SQLite Backup API，不停机）。默认每天本地 @_backupStatus?.DailyTime，保留 @_backupStatus?.RetentionDays 天 / 最多 @_backupStatus?.MaxBackups 套。
            记录清理默认关闭（当前：@(_backupStatus?.RecordRetentionEnabled == true ? $"已启用，保留 {_backupStatus.RecordKeepDays} 天" : "关闭")）。
        </MudText>

        @if (_backupStatus is null)
        {
            <MudSkeleton Width="60%" />
        }
        else
        {
            @if (!_backupStatus.Enabled)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Outlined">
                    自动备份已关闭（Backup:Enabled=false）。生产环境建议保持开启，并定期把备份目录拷到其它磁盘/NAS。
                </MudAlert>
            }
            else if (_backupStatus.IsStaleOrFailed(TimeSpan.FromHours(48)))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Outlined">
                    @if (_backupStatus.LastSucceeded == false)
                    {
                        <text>最近一次备份失败：@(_backupStatus.LastError ?? "未知错误")。请检查磁盘空间与日志后点击「立即备份」。</text>
                    }
                    else
                    {
                        <text>超过 48 小时没有成功备份（或尚无成功记录）。请立即备份，并确认定时任务已启用。</text>
                    }
                </MudAlert>
            }

            <MudStack Row="true" Spacing="4" Class="flex-wrap mb-3">
                <div class="dt-metric">
                    <div class="dt-metric-label">上次成功</div>
                    <div class="dt-metric-value" style="font-size:.9rem">
                        @(_backupStatus.LastSuccessAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "尚无")
                    </div>
                </div>
                <div class="dt-metric">
                    <div class="dt-metric-label">上次大小</div>
                    <div class="dt-metric-value" style="font-size:.9rem">@FormatBytes(_backupStatus.LastBackupBytes)</div>
                </div>
                <div class="dt-metric">
                    <div class="dt-metric-label">下次计划</div>
                    <div class="dt-metric-value" style="font-size:.9rem">
                        @(_backupStatus.NextScheduledAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
                    </div>
                </div>
                <div class="dt-metric">
                    <div class="dt-metric-label">备份目录</div>
                    <div class="dt-metric-value" style="font-size:.8rem;word-break:break-all">@_backupStatus.BackupDirectory</div>
                </div>
            </MudStack>

            <AuthorizeView Roles="Administrator">
                <Authorized>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunBackupNow"
                               Disabled="_backingUp" StartIcon="@Icons.Material.Filled.Backup">
                        @(_backingUp ? "备份中…" : "立即备份")
                    </MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudText Typo="Typo.caption" Class="dt-muted">仅管理员可手动触发备份。</MudText>
                </NotAuthorized>
            </AuthorizeView>
        }
    </MudPaper>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_saving"
                   StartIcon="@Icons.Material.Filled.Save">
            @(_saving ? "保存中…" : "保存")
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Reload" Disabled="_saving" StartIcon="@Icons.Material.Filled.RestartAlt">
            放弃修改并重载
        </MudButton>
    </MudStack>
}

@code {
    private SystemSettings? _settings;
    private string _savedKey = "";
    private bool _loading = true;
    private bool _saving;
    private bool _savingBrand;
    private string _editSiteName = "";
    private string? _editLogoPath;
    private DataTrace.Web.Options.CustomerOptions _identity = new();
    private string _envName = "";
    private string _dataRoot = "";
    private string? _bindUrl;
    private string _appVersion = "";
    private string? _softCapWarning;
    private bool _productionSimWarning;
    private BackupStatusSnapshot? _backupStatus;
    private bool _backingUp;

    /// <summary>页面上的值与最近一次读/写的值不一致。没有这个提示，切走页面就会静默丢掉改动。</summary>
    private bool Dirty => _settings is not null && Key(_settings) != _savedKey;

    private static string Key(SystemSettings s) => string.Join('|',
        s.ScanIntervalMs, s.WriteRetryCount, s.RetentionYears, s.CollectEnabled,
        s.MesEnabled, s.MesEndpoint, s.MesTimeoutSeconds);

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        RefreshBackupStatus();
    }

    private async Task Reload()
    {
        _loading = true;
        try
        {
            _identity = Branding.GetSnapshot();
            _editSiteName = _identity.EffectiveSiteName;
            _editLogoPath = _identity.LogoPath;
            _envName = Branding.EnvironmentName;
            _dataRoot = Branding.ResolvedDataRoot;
            _bindUrl = Branding.BindUrl;
            _appVersion = Branding.AppVersion;

            _softCapWarning = null;
            try
            {
                var snap = await Config.GetSnapshotAsync();
                var maxSt = _identity.MaxStations;
                var maxPlc = _identity.MaxPlcs;
                if (maxSt is int msCap && snap.Stations.Count > msCap)
                {
                    _softCapWarning = $"工站数量 {snap.Stations.Count} 已超过客户约定上限 MaxStations={msCap}（仅提示，不阻断配置）。";
                }
                else if (maxPlc is int mpCap && snap.PlcConnections.Count > mpCap)
                {
                    _softCapWarning = $"PLC 连接数 {snap.PlcConnections.Count} 已超过客户约定上限 MaxPlcs={mpCap}（仅提示，不阻断配置）。";
                }
            }
            catch
            {
                // soft cap is best-effort; ignore load errors here
            }

            _settings = (await Config.GetSnapshotAsync()).Settings;
            _productionSimWarning = Branding.EnvironmentName.Equals("Production", StringComparison.OrdinalIgnoreCase)
                && _settings.SimulatorAutoRun;
            _savedKey = _settings is null ? "" : Key(_settings);
        }
        catch (Exception ex)
        {
            _settings = null;
            Toast.Add($"读取系统设置失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveBranding()
    {
        if (_savingBrand) return;
        _savingBrand = true;
        try
        {
            Branding.SaveBranding(_editSiteName, _editLogoPath);
            _identity = Branding.GetSnapshot();
            Toast.Add("品牌已保存到 customer.json（刷新页面后顶栏/登录页生效）", Severity.Success);
        }
        catch (Exception ex)
        {
            Toast.Add($"保存品牌失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _savingBrand = false;
        }
    }

    /// <summary>关掉采集会让整线停止读数，属于影响生产的操作，必须二次确认。</summary>
    private async Task ToggleCollect(bool enable)
    {
        if (_settings is null)
        {
            return;
        }

        if (enable)
        {
            _settings.CollectEnabled = true;
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            "停用采集",
            "停用后采集器不再读取任何工站，实时看板与查询都不会再有新数据。" +
            "这一步只改页面上的开关，要点「保存」才真正下发。确定停用？",
            yesText: "停用采集", cancelText: "取消");
        if (confirmed == true)
        {
            _settings.CollectEnabled = false;
        }
    }

    private async Task Save()
    {
        if (_settings is null || _saving)
        {
            return;
        }

        if (_settings.MesEnabled && !IsHttpUrl(_settings.MesEndpoint))
        {
            Toast.Add("已启用 MES 推送，但地址不是合法的 http(s) 地址", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            // 只把本页拥有的字段搬到刚读出来的快照上。整对象写回会踩两个坑：
            // 一是把「产品型号」页在这页打开之后改的 ActiveRecipeId 覆盖掉，
            // 二是把「PLC 仿真」页改过的仿真参数按本页加载时的旧值写回去。
            var target = (await Config.GetSnapshotAsync()).Settings;
            target.ScanIntervalMs = _settings.ScanIntervalMs;
            target.WriteRetryCount = _settings.WriteRetryCount;
            target.RetentionYears = _settings.RetentionYears;
            target.CollectEnabled = _settings.CollectEnabled;
            target.MesEnabled = _settings.MesEnabled;
            target.MesEndpoint = _settings.MesEndpoint;
            target.MesTimeoutSeconds = _settings.MesTimeoutSeconds;

            await Config.SaveSettingsAsync(target);
            _settings = target;
            _savedKey = Key(target);
            Simulator.SetRunning(target.SimulatorAutoRun);
            Toast.Add("已保存并下发采集器", Severity.Success);
        }
        catch (Exception ex)
        {
            Toast.Add($"保存失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static bool IsHttpUrl(string? url)
        => Uri.TryCreate(url, UriKind.Absolute, out var uri)
           && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    private void RefreshBackupStatus()
    {
        try
        {
            _backupStatus = BackupService.GetStatus();
        }
        catch
        {
            _backupStatus = null;
        }
    }

    private async Task RunBackupNow()
    {
        if (_backingUp)
        {
            return;
        }

        _backingUp = true;
        try
        {
            var result = await BackupService.RunBackupAsync();
            RefreshBackupStatus();
            if (result.Success)
            {
                Toast.Add($"备份完成：{result.BackupPath}", Severity.Success);
            }
            else
            {
                Toast.Add($"备份失败：{result.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Toast.Add($"备份异常：{ex.Message}", Severity.Error);
            RefreshBackupStatus();
        }
        finally
        {
            _backingUp = false;
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0)
        {
            return "—";
        }

        string[] units = ["B", "KB", "MB", "GB"];
        double v = bytes;
        var i = 0;
        while (v >= 1024 && i < units.Length - 1)
        {
            v /= 1024;
            i++;
        }

        return $"{v:0.##} {units[i]}";
    }

}

    private async Task Save()
    {
        if (_settings is null || _saving) return;

        ValidateUrlFields();
        if (SettingsEditRules.UrlError(_edit) is { } urlError)
        {
            Toast.Add(urlError, Severity.Warning);
            await ScrollTo(_mesEndpointError is not null ? "sec-mes" : "sec-alarm");
            return;
        }

        if (!ValidateEditFields())
        {
            if (FirstInvalidSection is { } section)
            {
                await ScrollTo(section);
            }

            return;
        }

        var needSettings = SettingsDirty;
        var needBrand = BrandingDirty;
        if (!needSettings && !needBrand)
        {
            Toast.Add("没有需要保存的更改", Severity.Info);
            return;
        }

        // 保留年数是破坏性的：改小之后每 6 小时的清理任务就会把更近的历史删掉，且不可恢复。
        if (needSettings && _edit.RetentionYears != _loaded.RetentionYears && !await ConfirmRetentionChange())
        {
            return;
        }
        if (needSettings && _edit.AuditRetentionYears != _loaded.AuditRetentionYears
            && !await ConfirmAuditRetentionChange())
        {
            return;
        }

        _saving = true;
        string? settingsErr = null;
        string? brandErr = null;
        var settingsSaved = false;
        var brandSaved = false;
        var settingsBlocked = false;

        try
        {
            if (needSettings)
            {
                try
                {
                    var user = (await AuthState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
                    var saved = await SettingsSave.SaveAsync(_edit, _loaded, user, _canEditBrand);
                    if (saved.ValidationMessage is { } invalid)
                    {
                        Toast.Add(invalid, Severity.Warning);
                        settingsBlocked = true;
                    }
                    else if (saved.Failure is { } failure)
                    {
                        settingsErr = failure;
                    }
                    else if (saved.Saved is { } snapshot)
                    {
                        var shown = _settings.Clone();
                        shown.ScanIntervalMs = snapshot.ScanIntervalMs;
                        shown.WriteRetryCount = snapshot.WriteRetryCount;
                        shown.WriteRetryDelayMs = snapshot.WriteRetryDelayMs;
                        shown.RetentionYears = snapshot.RetentionYears;
                        shown.AuditRetentionYears = snapshot.AuditRetentionYears;
                        shown.MesTimeoutSeconds = snapshot.MesTimeoutSeconds;
                        shown.ShiftStartHour = snapshot.ShiftStartHour;
                        shown.ShiftLengthHours = snapshot.ShiftLengthHours;
                        shown.CollectEnabled = snapshot.CollectEnabled;
                        shown.MesEnabled = snapshot.MesEnabled;
                        shown.MesEndpoint = snapshot.MesEndpoint;
                        shown.AlarmWebhookUrl = snapshot.AlarmWebhookUrl;
                        shown.SimulatorAutoRun = snapshot.SimulatorAutoRun;
                        shown.SimulatorIntervalMs = snapshot.SimulatorIntervalMs;
                        shown.SimulatorNgPercent = snapshot.SimulatorNgPercent;
                        shown.SimulatorPalletPool = snapshot.SimulatorPalletPool;
                        _settings = shown;
                        _edit = SettingsEdit.From(shown);
                        _loaded = _edit.Clone();
                        Simulator.SetRunning(shown.SimulatorAutoRun);
                        settingsSaved = true;
                    }
                }
                catch (Exception ex)
                {
                    settingsErr = ex.Message;
                }
            }

            if (!settingsBlocked && needBrand)
            {
                try
                {
                    var oldBrand = $"site={_savedSiteName}; logo={_savedLogoPath}";
                    Branding.SaveBranding(_editSiteName, _editLogoPath);
                    _identity = Branding.GetSnapshot();
                    _savedSiteName = _identity.EffectiveSiteName;
                    _savedLogoPath = _identity.LogoPath;
                    _editSiteName = _savedSiteName;
                    _editLogoPath = _savedLogoPath;
                    await AuditSafe(
                        "Save",
                        "Branding",
                        "customer.json",
                        oldBrand,
                        $"site={_savedSiteName}; logo={_savedLogoPath}");
                    brandSaved = true;
                }
                catch (Exception ex)
                {
                    brandErr = ex.Message;
                }
            }
        }
        finally
        {
            _saving = false;
        }

        if (settingsBlocked)
        {
            return;
        }

        // 保存成功但 Logo 文件不在：顶栏会是一片空白，用户很难想到是文件名写错了。
        // 放在成功提示之后，免得被"已写入 customer.json"盖住。
        if (settingsSaved)
        {
            await RefreshMesOutboxStatusAsync();
            await LoadRevisionHistoryAsync(reset: true);
        }

        if (settingsErr is null && brandErr is null)
        {
            var bits = new List<string>();
            if (settingsSaved) bits.Add("配置已保存并下发采集端");
            if (brandSaved) bits.Add("品牌已写入 customer.json");
            Toast.Add(bits.Count > 0 ? string.Join("；", bits) : "已保存", Severity.Success);
        }
        else if (settingsSaved && brandErr is not null)
        {
            Toast.Add($"配置已保存，品牌保存失败：{brandErr}", Severity.Warning);
        }
        else if (brandSaved && settingsErr is not null)
        {
            Toast.Add($"品牌已保存，配置保存失败：{settingsErr}", Severity.Warning);
        }
        else if (settingsErr is not null && brandErr is not null)
        {
            Toast.Add($"配置保存失败：{settingsErr}；品牌保存失败：{brandErr}", Severity.Error);
        }
        else if (settingsErr is not null)
        {
            Toast.Add($"配置保存失败：{settingsErr}", Severity.Error);
        }
        else
        {
            Toast.Add($"品牌保存失败：{brandErr}", Severity.Error);
        }

        // 放在成功提示之后：文件名写错时顶栏是一片空白，用户很难想到是文件名的问题。
        if (brandSaved && Branding.LogoFileWarning(_savedLogoPath) is { } logoWarning)
        {
            Toast.Add(logoWarning, Severity.Warning);
        }
    }

    /// <summary>
    /// 数值字段的保存前校验：空值（输入框被清空或敲进非法字符）与越界都拦下来。
    /// </summary>
    /// <remarks>
    /// 不能任由输入框自己"夹到边界"：清空"保留年数"会得到 1，6 小时后历史整月库就被删了；
    /// 清空"扫描间隔"会得到 20ms，采集端会以十倍频率轮询 PLC。两种都显示成"保存成功"。
    /// </remarks>
    private bool ValidateEditFields()
    {
        _scanError = _edit.ScanIntervalMs is not { } scan ? "扫描间隔不能为空"
            : SettingsLimits.ScanIntervalError(scan);
        _retryError = _edit.WriteRetryCount is not { } retry ? "写回重试次数不能为空"
            : SettingsLimits.WriteRetryCountError(retry);
        _retryDelayError = _edit.WriteRetryDelayMs is not { } delay ? "写回重试间隔不能为空"
            : SettingsLimits.WriteRetryDelayError(delay);
        _retentionError = _edit.RetentionYears is not { } years ? "保留年数不能为空"
            : SettingsLimits.RetentionYearsError(years);
        _auditRetentionError = _edit.AuditRetentionYears is not { } auditYears ? "审计保留年数不能为空"
            : SettingsLimits.AuditRetentionYearsError(auditYears);
        _mesTimeoutError = _edit.MesTimeoutSeconds is not { } timeout ? "MES 超时不能为空"
            : SettingsLimits.MesTimeoutError(timeout);
        _shiftStartError = _edit.ShiftStartHour is not { } shiftStart ? "班次起点不能为空"
            : SettingsLimits.ShiftStartHourError(shiftStart);
        _shiftLengthError = _edit.ShiftLengthHours is not { } shiftLength ? "班次时长不能为空"
            : SettingsLimits.ShiftLengthHoursError(shiftLength);

        var bad = new[] { _scanError, _retryError, _retryDelayError, _retentionError, _auditRetentionError, _mesTimeoutError, _shiftStartError, _shiftLengthError }
            .Count(x => x is not null);
        if (bad == 0)
        {
            return true;
        }

        Toast.Add($"{bad} 项填写有误，已在对应输入框标出（未保存）", Severity.Warning);
        return false;
    }

    private void ValidateUrlFields()
    {
        _mesEndpointError = SettingsEditRules.MesEndpointError(_edit);
        _alarmWebhookUrlError = SettingsEditRules.AlarmWebhookUrlError(_edit);
    }

    private string? FirstInvalidSection
        => _scanError is not null || _retryError is not null || _retryDelayError is not null
           || _shiftStartError is not null || _shiftLengthError is not null
            ? "sec-collect"
            : _retentionError is not null || _auditRetentionError is not null
                ? "sec-data"
                : _mesTimeoutError is not null ? "sec-mes" : null;

    /// <summary>改小保留年数前的确认：把"会删到哪个月"说清楚，避免事后才发现历史没了。</summary>
    private async Task<bool> ConfirmRetentionChange()
    {
        var years = _edit.RetentionYears!.Value;
        var newestDeleted = SettingsLimits.NewestDeletedMonth(DateTime.Today, years);
        var confirmed = await DialogService.ConfirmDangerAsync(
            "确认保留年数",
            $"保留年数 {_loaded.RetentionYears?.ToString() ?? "默认"} → {years} 年。\n\n"
            + $"清理任务（约每 {SystemDefaults.RetentionCheckHours} 小时一次）会删除 {newestDeleted:yyyy-MM} 及更早月份的整月记录库与曲线文件，"
            + "删除后不可恢复（配置库里的审计日志不受影响）。",
            acknowledge: $"我了解将删除 {newestDeleted:yyyy-MM} 及更早月份的整月记录库与曲线文件，且无法恢复",
            yesText: "确认修改", cancelText: "取消");
        return confirmed == true;
    }

    private async Task<bool> ConfirmAuditRetentionChange()
    {
        var years = _edit.AuditRetentionYears!.Value;
        var newestArchivedMonth = years == 0
            ? (DateTime?)null
            : new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddYears(-years).AddMonths(-1);
        var effect = years == 0
            ? "停止后续自动归档和清理；已生成的归档不删除。"
            : $"后台约每 {SystemDefaults.RetentionCheckHours} 小时处理一次：先将 {newestArchivedMonth:yyyy-MM} 及更早的整月审计记录归档为 gzip CSV，并校验 SHA-256，再删除在线记录。归档失败时保留数据库原记录。";
        var confirmed = await DialogService.ConfirmDangerAsync(
            "确认审计日志保留策略",
            $"审计日志保留年数 {_loaded.AuditRetentionYears?.ToString() ?? "0"} → {years} 年。\n\n{effect}\n\n"
            + "此设置独立于运行数据保留；审计归档位于 audit-archive 目录。请确认已配置该目录的备份和访问权限。",
            acknowledge: "我了解该策略会影响审计记录的归档与清理",
            yesText: "确认修改", cancelText: "取消");
        return confirmed == true;
    }


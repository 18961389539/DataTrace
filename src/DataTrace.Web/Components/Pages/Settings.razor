@page "/config/settings"
@attribute [Authorize(Roles = "Administrator,Engineer")]
@using DataTrace.Application.Backup
@using DataTrace.Application.Configuration
@using DataTrace.Collector
@using DataTrace.Web.Services
@using DataTrace.Domain.Entities
@using DataTrace.Domain.Validation
@using DataTrace.Web.Options
@inject IConfigRepository Config
@inject ILineSimulator Simulator
@inject DtToast Toast
@inject IDialogService DialogService
@inject CustomerBrandingStore Branding
@inject IDatabaseBackupService BackupService
@inject IAuditLogger Audit
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState

<PageHeader Title="系统设置" HelpRoute="config/settings">
    <ChildContent>
        @if (Dirty)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">有未保存的更改</MudChip>
        }
    </ChildContent>
    <Actions>
        <MudText Typo="Typo.caption" Class="dt-muted">改动要点「保存」才会下发；采集端下一轮查询周期起用新参数</MudText>
        <InfoHint Topic="HelpTexts.SaveToDispatch" />
    </Actions>
</PageHeader>

<NavigationLock ConfirmExternalNavigation="@Dirty" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

@if (_loading)
{
    <MudSkeleton Class="mb-3" />
    <MudSkeleton Class="mb-3" SkeletonType="SkeletonType.Rectangle" Height="280px" />
}
else if (_settings is null)
{
    <MudAlert Severity="Severity.Error" Dense="true">系统配置读取失败，请刷新页面重试。</MudAlert>
}
else
{
    <div class="dt-settings-page">
        <div class="dt-settings-health">
            <div class="dt-settings-health-card">
                <div class="dt-settings-health-label">数据库备份</div>
                <div class="dt-settings-health-value">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@BackupChipColor">@BackupChipText</MudChip>
                </div>
                <div class="dt-settings-health-detail">@BackupDetail</div>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="pa-0 mt-1"
                           OnClick="@(() => ScrollTo("sec-data"))">查看备份区</MudButton>
            </div>
            <div class="dt-settings-health-card">
                <div class="dt-settings-health-label">仿真自动跑线</div>
                <div class="dt-settings-health-value">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@SimChipColor">@SimChipText</MudChip>
                </div>
                <div class="dt-settings-health-detail">@SimDetail</div>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="pa-0 mt-1"
                           Href="/simulate">去 PLC 仿真页</MudButton>
            </div>
            <div class="dt-settings-health-card">
                <div class="dt-settings-health-label">授权上限</div>
                <div class="dt-settings-health-value">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(_softCapWarning is { Length: > 0 } ? Color.Warning : Color.Success)">
                        @(_softCapWarning is { Length: > 0 } ? "需关注" : "未超限")
                    </MudChip>
                </div>
                <div class="dt-settings-health-detail">
                    @if (_softCapWarning is { Length: > 0 })
                    {
                        @_softCapWarning
                    }
                    else
                    {
                        <text>MaxStations / MaxPlcs 客户约定上限未超出</text>
                    }
                </div>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="pa-0 mt-1"
                           OnClick="@(() => ScrollTo("sec-basic"))">查看基本信息</MudButton>
            </div>
            <div class="dt-settings-health-card">
                <div class="dt-settings-health-label">默认口令</div>
                <div class="dt-settings-health-value">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">需关注</MudChip>
                </div>
                <div class="dt-settings-health-detail">请确认已修改 admin / engineer 等出厂口令（应用不强制检测）</div>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="pa-0 mt-1"
                           Href="/users">去用户页</MudButton>
            </div>
        </div>

        <div class="dt-settings-nav-mobile">
            @foreach (var item in NavItems)
            {
                <MudChip T="string" Size="Size.Small"
                         Variant="@(_activeSection == item.Id ? Variant.Filled : Variant.Outlined)"
                         Color="Color.Primary"
                         OnClick="@(() => ScrollTo(item.Id))">@item.Label</MudChip>
            }
        </div>

        <div class="dt-settings-layout">
            <nav class="dt-settings-nav" aria-label="设置分区">
                @foreach (var item in NavItems)
                {
                    <button type="button"
                            class="dt-settings-nav-btn @(_activeSection == item.Id ? "active" : null)"
                            @onclick="@(() => ScrollTo(item.Id))">@item.Label</button>
                }
            </nav>

            <div>
                <MudPaper Class="pa-4 mb-3 dt-settings-section" id="sec-basic" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-1">基本信息</MudText>
                    <MudText Typo="Typo.caption" Class="dt-muted mb-3">
                        一客户一套部署。厂名/Logo 写入安装目录 customer.json；端口、数据目录可由安装脚本写入 appsettings.Production.json。
                    </MudText>
                    <MudStack Row="true" Spacing="3" Class="flex-wrap mb-3">
                        <div class="dt-metric">
                            <div class="dt-metric-label">客户标识 <span class="dt-src-badge ro">客户配置·只读</span><InfoHint Topic="HelpTexts.ConfigSource" /></div>
                            <div class="dt-metric-value">@(_identity.CustomerId is { Length: > 0 } ? _identity.CustomerId : "—")</div>
                        </div>
                        <div class="dt-metric">
                            <div class="dt-metric-label">运行环境 <span class="dt-src-badge rt">运行时</span></div>
                            <div class="dt-metric-value">@_envName</div>
                        </div>
                        <div class="dt-metric" style="min-width:220px;max-width:360px;flex:1">
                            <div class="dt-metric-label">
                                数据目录 <span class="dt-src-badge rt">运行时</span>
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Class="pa-0 ml-1"
                                               title="复制路径" aria-label="复制数据目录路径"
                                               OnClick="@(() => CopyPath(_dataRoot))" />
                            </div>
                            <div class="dt-metric-value dt-path-trunc" title="@_dataRoot">@_dataRoot</div>
                        </div>
                        <div class="dt-metric">
                            <div class="dt-metric-label">监听地址 <span class="dt-src-badge ro">客户配置·只读</span></div>
                            <div class="dt-metric-value" style="font-size:.9rem">@(_bindUrl ?? "—")</div>
                        </div>
                    </MudStack>

                    @if (_canEditBrand)
                    {
                        <div class="dt-settings-row">
                            <div>
                                <div class="dt-settings-row-name">厂名 / 站点显示名</div>
                                <div class="dt-settings-row-hint">显示在登录页与顶栏标题</div>
                            </div>
                            <MudTextField @bind-Value="_editSiteName" Immediate="true" Margin="Margin.Dense"
                                          Variant="Variant.Outlined" aria-label="厂名 / 站点显示名" />
                            <span class="dt-src-badge edit">可在此修改·customer.json</span>
                        </div>
                        <div class="dt-settings-row">
                            <div>
                                <div class="dt-settings-row-name">Logo 文件名</div>
                                <div class="dt-settings-row-hint">放在安装目录 branding\ 下，例如 logo.png</div>
                            </div>
                            <MudTextField @bind-Value="_editLogoPath" Immediate="true" Margin="Margin.Dense"
                                          Variant="Variant.Outlined" Placeholder="logo.png" aria-label="Logo 文件名" />
                            <span class="dt-src-badge edit">可在此修改·customer.json</span>
                        </div>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">厂名/Logo 仅管理员可改，当前为只读展示。</MudAlert>
                        <MudStack Row="true" Spacing="4" Class="flex-wrap mt-2">
                            <div class="dt-metric">
                                <div class="dt-metric-label">厂名 / 站点显示名</div>
                                <div class="dt-metric-value" style="font-size:1rem">@_identity.EffectiveSiteName</div>
                            </div>
                            <div class="dt-metric">
                                <div class="dt-metric-label">Logo 文件名</div>
                                <div class="dt-metric-value" style="font-size:1rem">@(_identity.LogoPath ?? "—")</div>
                            </div>
                        </MudStack>
                    }
                </MudPaper>

                <MudPaper Class="pa-4 mb-3 dt-settings-section" id="sec-collect" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-1">采集与仿真</MudText>
                    <MudText Typo="Typo.caption" Class="dt-muted mb-3">
                        下列采集参数保存后下发采集端。停用采集见「安全」危险操作区。
                    </MudText>

                    <div class="dt-settings-row">
                        <div>
                            <div class="dt-settings-row-name">扫描间隔(ms)<InfoHint Topic="HelpTexts.ScanInterval" /></div>
                            <div class="dt-settings-row-hint">采集端查询 PLC 的间隔；越小越快，也越加重 PLC 通讯</div>
                        </div>
                        <MudNumericField @bind-Value="_edit.ScanIntervalMs" @bind-Value:after="() => _scanError = null"
                                         Min="@SettingsLimits.MinScanIntervalMs" Max="@SettingsLimits.MaxScanIntervalMs" Step="10"
                                         Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true"
                                         Error="@(_scanError is not null)" ErrorText="@_scanError"
                                         aria-label="扫描间隔(ms)" />
                        <span class="dt-src-badge edit">可在此修改·配置库</span>
                    </div>
                    <div class="dt-settings-row">
                        <div>
                            <div class="dt-settings-row-name">写回重试次数 <InfoHint Topic="HelpTexts.WriteRetry" /></div>
                            <div class="dt-settings-row-hint">总尝试次数：0 与 1 都只写一次；NG 位写失败会导致 PLC 侧不更新</div>
                        </div>
                        <MudNumericField @bind-Value="_edit.WriteRetryCount" @bind-Value:after="() => _retryError = null"
                                         Min="@SettingsLimits.MinWriteRetryCount" Max="@SettingsLimits.MaxWriteRetryCount"
                                         Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true"
                                         Error="@(_retryError is not null)" ErrorText="@_retryError"
                                         aria-label="写回重试次数" />
                        <span class="dt-src-badge edit">可在此修改·配置库</span>
                    </div>
                    <div class="dt-settings-row">
                        <div>
                            <div class="dt-settings-row-name">写回重试间隔(ms)</div>
                            <div class="dt-settings-row-hint">每次写回失败后等待多久再试；配得太大，一次写失败就把该工站的采集周期拖长</div>
                        </div>
                        <MudNumericField @bind-Value="_edit.WriteRetryDelayMs" @bind-Value:after="() => _retryDelayError = null"
                                         Min="@SettingsLimits.MinWriteRetryDelayMs" Max="@SettingsLimits.MaxWriteRetryDelayMs" Step="10"
                                         Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true"
                                         Error="@(_retryDelayError is not null)" ErrorText="@_retryDelayError"
                                         aria-label="写回重试间隔(ms)" />
                        <span class="dt-src-badge edit">可在此修改·配置库</span>
                    </div>

                    <MudDivider Class="my-3" />

                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudText Typo="Typo.subtitle2">仿真参数</MudText>
                        <MudSpacer />
                        <MudButton Variant="Variant.Text" Size="Size.Small" Href="/simulate"
                                   EndIcon="@Icons.Material.Filled.ChevronRight">去 PLC 仿真页修改</MudButton>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="dt-muted mb-3">
                        客户 Production 安装默认关闭「启动后自动跑仿真」（customer.json / appsettings.Production.json 的 SimulatorAutoRun）。
                        本页只读展示；可编辑在「PLC 仿真」页，保存时会同步写回配置库。
                    </MudText>
                    <MudStack Row="true" Spacing="3" Class="flex-wrap dt-settings-readonly pa-3 rounded">
                        <div class="dt-metric">
                            <div class="dt-metric-label">启动后自动跑仿真 <span class="dt-src-badge ro">客户配置·只读</span></div>
                            <div class="dt-metric-value">@(_settings.SimulatorAutoRun ? "开" : "关")</div>
                        </div>
                        <div class="dt-metric">
                            <div class="dt-metric-label">托盘间隔 <span class="dt-src-badge rt">运行时</span></div>
                            <div class="dt-metric-value">@_settings.SimulatorIntervalMs ms</div>
                        </div>
                        <div class="dt-metric">
                            <div class="dt-metric-label">NG 比例 <span class="dt-src-badge rt">运行时</span></div>
                            <div class="dt-metric-value">@_settings.SimulatorNgPercent %</div>
                        </div>
                        <div class="dt-metric">
                            <div class="dt-metric-label">托盘池数量 <span class="dt-src-badge rt">运行时</span></div>
                            <div class="dt-metric-value">@_settings.SimulatorPalletPool</div>
                        </div>
                    </MudStack>
                    @if (_productionSimWarning)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2" Style="color:var(--mud-palette-warning)">
                            当前开着「启动后自动跑仿真」：采集记录来自内置模拟器，不代表真实产线。可在「PLC 仿真」页切换。
                        </MudText>
                    }
                </MudPaper>

                <MudPaper Class="pa-4 mb-3 dt-settings-section" id="sec-data" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-1">数据与备份</MudText>
                    <MudText Typo="Typo.caption" Class="dt-muted mb-3">
                        定时在线备份 config.db 与 runtime 月库（SQLite Backup API，不停服）；默认每天本地 @(_backupStatus?.DailyTime ?? "02:30")，
                        保留 @(_backupStatus?.RetentionDays ?? 30) 天 / 最多 @(_backupStatus?.MaxBackups ?? 60) 套。曲线文件本身不进备份包。
                    </MudText>

                    <div class="dt-settings-row">
                        <div>
                            <div class="dt-settings-row-name">保留年数<InfoHint Topic="HelpTexts.Retention" /></div>
                            <div class="dt-settings-row-hint">仅清理超过年限的运行时整月记录库和曲线文件（RetentionHostedService，约每 @SystemDefaults.RetentionCheckHours 小时检查一次）。配置库中的审计日志（AuditLogs）不受此项影响，不会被按年数自动清除。</div>
                        </div>
                        <MudNumericField @bind-Value="_edit.RetentionYears" @bind-Value:after="() => _retentionError = null"
                                         Min="@SettingsLimits.MinRetentionYears" Max="@SettingsLimits.MaxRetentionYears"
                                         Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true"
                                         Error="@(_retentionError is not null)" ErrorText="@_retentionError"
                                         aria-label="保留年数" />
                        <span class="dt-src-badge edit">可在此修改·配置库</span>
                    </div>
                    <div class="dt-settings-row">
                        <div>
                            <div class="dt-settings-row-name">备份保留</div>
                            <div class="dt-settings-row-hint">备份套数保留策略，与「保留年数」互不替代</div>
                        </div>
                        <MudText Typo="Typo.body2">
                            @(_backupStatus?.RetentionDays ?? 30) 天 / 最多 @(_backupStatus?.MaxBackups ?? 60) 份
                        </MudText>
                        <span class="dt-src-badge ro">客户配置·只读</span>
                    </div>

                    @if (_backupStatusError is { } backupError)
                    {
                        <MudText Typo="Typo.caption" Class="mt-3" Style="color:var(--mud-palette-error)">
                            备份状态读取失败：@backupError
                        </MudText>
                    }
                    else if (_backupStatus is null)
                    {
                        <MudSkeleton Width="60%" Class="mt-3" />
                    }
                    else
                    {
                        @if (!_backupStatus.Enabled)
                        {
                            <MudText Typo="Typo.caption" Class="mb-2" Style="color:var(--mud-palette-error)">
                                自动备份已关闭（Backup:Enabled=false）。请在配置中重新打开，并把备份目录放到独立磁盘/NAS。完整说明见本区上方文案。
                            </MudText>
                        }
                        else if (_backupStatus.IsStaleOrFailed(TimeSpan.FromHours(SystemDefaults.BackupStaleHours)))
                        {
                            <MudText Typo="Typo.caption" Class="mb-2" Style="color:var(--mud-palette-error)">
                                @if (_backupStatus.LastSucceeded == false)
                                {
                                    <text>最近一次备份失败：@(_backupStatus.LastError ?? "未知错误")。请检查磁盘空间与日志后点「立即备份」。</text>
                                }
                                else
                                {
                                    <text>超过 @SystemDefaults.BackupStaleHours 小时没有成功备份（或尚无成功记录）。请确认定时任务与配置后点「立即备份」。</text>
                                }
                            </MudText>
                        }

                        <MudStack Row="true" Spacing="3" Class="flex-wrap my-3">
                            <div class="dt-metric">
                                <div class="dt-metric-label">上次成功 <span class="dt-src-badge rt">运行时</span></div>
                                <div class="dt-metric-value" style="font-size:.9rem">
                                    @(_backupStatus.LastSuccessAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "尚无")
                                </div>
                            </div>
                            <div class="dt-metric">
                                <div class="dt-metric-label">上次大小 <span class="dt-src-badge rt">运行时</span></div>
                                <div class="dt-metric-value" style="font-size:.9rem">@FormatBytes(_backupStatus.LastBackupBytes)</div>
                            </div>
                            <div class="dt-metric">
                                <div class="dt-metric-label">下次计划 <span class="dt-src-badge rt">运行时</span></div>
                                <div class="dt-metric-value" style="font-size:.9rem">
                                    @(_backupStatus.NextScheduledAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
                                </div>
                            </div>
                            <div class="dt-metric" style="min-width:220px;max-width:360px;flex:1">
                                <div class="dt-metric-label">
                                    备份目录 <span class="dt-src-badge ro">客户配置·只读</span>
                                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Class="pa-0 ml-1"
                                                   title="复制路径" aria-label="复制备份目录路径"
                                                   OnClick="@(() => CopyPath(_backupStatus.BackupDirectory))" />
                                </div>
                                <div class="dt-metric-value dt-path-trunc" title="@_backupStatus.BackupDirectory">@_backupStatus.BackupDirectory</div>
                            </div>
                        </MudStack>

                        <AuthorizeView Roles="Administrator">
                            <Authorized>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunBackupNow"
                                           Disabled="_backingUp" StartIcon="@Icons.Material.Filled.Backup">
                                    @(_backingUp ? "备份中…" : "立即备份")
                                </MudButton>
                            </Authorized>
                            <NotAuthorized>
                                <MudText Typo="Typo.caption" Class="dt-muted">仅管理员可手动触发备份。</MudText>
                            </NotAuthorized>
                        </AuthorizeView>
                    }
                </MudPaper>

                <MudPaper Class="pa-4 mb-3 dt-settings-section" id="sec-mes" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-3">MES 对接</MudText>
                    <div class="dt-settings-row">
                        <div>
                            <div class="dt-settings-row-name">启用 MES HTTP 推送</div>
                        </div>
                        <MudSwitch @bind-Value="_edit.MesEnabled" Color="Color.Primary"
                                   Label="@(_edit.MesEnabled ? "已启用" : "已关闭")" />
                        <span class="dt-src-badge edit">可在此修改·配置库</span>
                    </div>
                    <div class="dt-settings-row">
                        <div>
                            <div class="dt-settings-row-name">MES 地址</div>
                            <div class="dt-settings-row-hint">启用推送时必须填写合法 http(s) 地址</div>
                        </div>
                        <MudTextField @bind-Value="_edit.MesEndpoint" Immediate="true" Margin="Margin.Dense"
                                      Variant="Variant.Outlined" Placeholder="http://mes.local/api/collect"
                                      aria-label="MES 地址" />
                        <span class="dt-src-badge edit">可在此修改·配置库</span>
                    </div>
                    <div class="dt-settings-row">
                        <div>
                            <div class="dt-settings-row-name">MES 超时(秒)</div>
                        </div>
                        <MudNumericField @bind-Value="_edit.MesTimeoutSeconds" @bind-Value:after="() => _mesTimeoutError = null"
                                         Min="@SettingsLimits.MinMesTimeoutSeconds" Max="@SettingsLimits.MaxMesTimeoutSeconds"
                                         Margin="Margin.Dense" Variant="Variant.Outlined" Immediate="true"
                                         Error="@(_mesTimeoutError is not null)" ErrorText="@_mesTimeoutError"
                                         aria-label="MES 超时(秒)" />
                        <span class="dt-src-badge edit">可在此修改·配置库</span>
                    </div>

                    @* 只有开关和地址时，"配了但推不出去"现场是看不出来的：这里把积压与最近一次结果摆出来。 *@
                    @if (!_edit.MesEnabled)
                    {
                        <MudText Typo="Typo.caption" Class="dt-muted mt-2">推送已关闭，记录不会进入推送队列。</MudText>
                    }
                    else if (_mesStatus is null)
                    {
                        <MudText Typo="Typo.caption" Class="dt-muted mt-2">推送状态读取失败，暂无法显示积压情况。</MudText>
                    }
                    else
                    {
                        <MudStack Row="true" Spacing="3" Class="flex-wrap dt-settings-readonly pa-3 rounded mt-1">
                            <div class="dt-metric">
                                <div class="dt-metric-label">待推送 <span class="dt-src-badge rt">运行时</span><InfoHint Topic="HelpTexts.MesOutbox" /></div>
                                <div class="dt-metric-value">@_mesStatus.PendingCount</div>
                            </div>
                            <div class="dt-metric">
                                <div class="dt-metric-label">最久未推送</div>
                                <div class="dt-metric-value" style="font-size:.9rem">
                                    @(_mesStatus.OldestPendingAt?.ToString("MM-dd HH:mm") ?? "—")
                                </div>
                            </div>
                            <div class="dt-metric">
                                <div class="dt-metric-label">最近成功</div>
                                <div class="dt-metric-value" style="font-size:.9rem">
                                    @(_mesStatus.LastSuccessAt?.ToString("MM-dd HH:mm") ?? "尚无")
                                </div>
                            </div>
                            <div class="dt-metric" style="min-width:220px;max-width:420px;flex:1">
                                <div class="dt-metric-label">最近一次尝试</div>
                                <div class="dt-metric-value" style="font-size:.9rem">@LastAttemptText</div>
                            </div>
                        </MudStack>
                        @if (MesBacklogWarning is { } backlogWarning)
                        {
                            <MudText Typo="Typo.caption" Class="mt-1" Style="color:var(--mud-palette-error)">@backlogWarning</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="dt-muted mt-1">
                                推送失败会按退避一直重试并留在队列里，不会丢记录；积压增长时请先确认 MES 地址与网络。
                            </MudText>
                        }
                    }
                </MudPaper>

                <MudPaper Class="pa-4 mb-3 dt-settings-section" id="sec-security" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-1">安全</MudText>
                    <MudText Typo="Typo.caption" Class="dt-muted mb-3">
                        首次部署请到「用户」页修改 admin / engineer 等出厂口令。应用不强制改密，需由管理员自行确认。
                        @if (_softCapWarning is { Length: > 0 })
                        {
                            <text> 另：@_softCapWarning</text>
                        }
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="/users"
                               StartIcon="@Icons.Material.Filled.ManageAccounts">打开用户页</MudButton>

                    <div class="dt-danger-zone">
                        <div class="dt-danger-zone-title">危险操作</div>
                        <MudText Typo="Typo.caption" Class="dt-muted mb-3">
                            停用采集后采集端不再读取任何工站；实时看板与查询仍可看历史数据。开关只改页面值，需点「保存」才会下发。
                            当前状态：<b>@(_edit.CollectEnabled ? "采集已启用" : "采集已停用")</b>
                            <span class="dt-src-badge edit" style="margin-left:8px">可在此修改·配置库</span>
                        </MudText>
                        @if (_edit.CollectEnabled)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_saving"
                                       StartIcon="@Icons.Material.Filled.PowerSettingsNew"
                                       OnClick="DisableCollect">停用采集…</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="EnableCollect">重新启用采集</MudButton>
                        }
                    </div>
                </MudPaper>

                <MudPaper Class="pa-4 mb-3 dt-settings-section" id="sec-about" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-3">关于</MudText>
                    <MudStack Row="true" Spacing="3" Class="flex-wrap">
                        <div class="dt-metric">
                            <div class="dt-metric-label">应用版本 <span class="dt-src-badge rt">运行时</span></div>
                            <div class="dt-metric-value">@_appVersion</div>
                        </div>
                        <div class="dt-metric">
                            <div class="dt-metric-label">客户标识 <span class="dt-src-badge ro">客户配置·只读</span></div>
                            <div class="dt-metric-value">@(_identity.CustomerId is { Length: > 0 } ? _identity.CustomerId : "—")</div>
                        </div>
                        <div class="dt-metric">
                            <div class="dt-metric-label">运行环境 <span class="dt-src-badge rt">运行时</span></div>
                            <div class="dt-metric-value">@_envName</div>
                        </div>
                    </MudStack>
                </MudPaper>

                @if (Dirty)
                {
                    <div class="dt-settings-savebar">
                        <span class="dt-settings-savebar-note">有未保存的更改</span>
                        <MudButton Variant="Variant.Outlined" OnClick="Reload" Disabled="_saving"
                                   StartIcon="@Icons.Material.Filled.RestartAlt">放弃</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_saving"
                                   StartIcon="@Icons.Material.Filled.Save">
                            @(_saving ? "保存中…" : "保存")
                        </MudButton>
                    </div>
                }
                else
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_saving"
                                   StartIcon="@Icons.Material.Filled.Save">
                            @(_saving ? "保存中…" : "保存")
                        </MudButton>
                        <MudButton Variant="Variant.Text" OnClick="Reload" Disabled="_saving"
                                   StartIcon="@Icons.Material.Filled.RestartAlt">重新加载</MudButton>
                    </MudStack>
                }
            </div>
        </div>
    </div>
}

@code {
    private static readonly (string Id, string Label)[] NavItems =
    [
        ("sec-basic", "基本信息"),
        ("sec-collect", "采集与仿真"),
        ("sec-data", "数据与备份"),
        ("sec-mes", "MES 对接"),
        ("sec-security", "安全"),
        ("sec-about", "关于"),
    ];

    private SystemSettings? _settings;
    private EditFields _edit = new();
    private EditFields _loaded = new();
    private string _savedSiteName = "";
    private string? _savedLogoPath;
    private bool _loading = true;
    private bool _saving;
    private bool _backingUp;
    private bool _canEditBrand;
    private string _editSiteName = "";
    private string? _editLogoPath;
    private CustomerOptions _identity = new();
    private string _envName = "";
    private string _dataRoot = "";
    private string? _bindUrl;
    private string _appVersion = "";
    private string? _softCapWarning;
    private bool _productionSimWarning;
    private BackupStatusSnapshot? _backupStatus;
    private string? _backupStatusError;
    private MesOutboxSnapshot? _mesStatus;
    private string? _scanError;
    private string? _retryError;
    private string? _retryDelayError;
    private string? _retentionError;
    private string? _mesTimeoutError;
    private string _activeSection = "sec-basic";

    /// <summary>
    /// 页面上可编辑的字段。
    /// </summary>
    /// <remarks>
    /// 数值一律用可空 int 承接输入：输入框被清空或敲进非法字符时拿到的是 null，
    /// 而不是被 MudNumericField 悄悄夹成下限 —— "保留年数"夹成 1 会在 6 小时内
    /// 把超过一年的整月库与曲线文件全删掉，而界面只提示"配置已保存"。
    /// </remarks>
    private sealed class EditFields
    {
        public int? ScanIntervalMs { get; set; }
        public int? WriteRetryCount { get; set; }
        public int? WriteRetryDelayMs { get; set; }
        public int? RetentionYears { get; set; }
        public int? MesTimeoutSeconds { get; set; }
        public bool CollectEnabled { get; set; }
        public bool MesEnabled { get; set; }
        public string? MesEndpoint { get; set; }

        public EditFields Clone() => (EditFields)MemberwiseClone();

        /// <summary>逐字段比较（脏检查用）：任何一个字段与载入值不同就算有未保存的更改。</summary>
        public bool DiffersFrom(EditFields other)
            => ScanIntervalMs != other.ScanIntervalMs
               || WriteRetryCount != other.WriteRetryCount
               || WriteRetryDelayMs != other.WriteRetryDelayMs
               || RetentionYears != other.RetentionYears
               || MesTimeoutSeconds != other.MesTimeoutSeconds
               || CollectEnabled != other.CollectEnabled
               || MesEnabled != other.MesEnabled
               || !string.Equals(MesEndpoint ?? "", other.MesEndpoint ?? "", StringComparison.Ordinal);

        public static EditFields From(SystemSettings s) => new()
        {
            ScanIntervalMs = s.ScanIntervalMs,
            WriteRetryCount = s.WriteRetryCount,
            WriteRetryDelayMs = s.WriteRetryDelayMs,
            RetentionYears = s.RetentionYears,
            MesTimeoutSeconds = s.MesTimeoutSeconds,
            CollectEnabled = s.CollectEnabled,
            MesEnabled = s.MesEnabled,
            MesEndpoint = s.MesEndpoint
        };
    }

    private bool SettingsDirty => _settings is not null && _edit.DiffersFrom(_loaded);

    private string LastAttemptText =>
        _mesStatus?.LastAttemptAt is not { } at ? "尚无"
        : _mesStatus.LastAttemptSucceeded == true ? $"{at:MM-dd HH:mm} 成功"
        : $"{at:MM-dd HH:mm} 失败：{_mesStatus.LastError ?? "未知错误"}";

    /// <summary>积压或连续失败时给一句明确的判断，而不是让人自己看数字。</summary>
    private string? MesBacklogWarning
    {
        get
        {
            if (_mesStatus is null)
            {
                return null;
            }

            if (_mesStatus.LastAttemptSucceeded == false)
            {
                return $"最近一次推送失败：{_mesStatus.LastError ?? "未知错误"}；记录仍在队列里按退避重试。";
            }

            if (_mesStatus.PendingCount > 0
                && _mesStatus.OldestPendingAt is { } oldest
                && DateTime.Now - oldest > TimeSpan.FromHours(SystemDefaults.MesBacklogWarnHours))
            {
                return $"有 {_mesStatus.PendingCount} 条记录已排队超过 {(int)(DateTime.Now - oldest).TotalHours} 小时未推送成功。";
            }

            return null;
        }
    }

    private bool BrandingDirty =>
        _canEditBrand
        && (!string.Equals((_editSiteName ?? "").Trim(), (_savedSiteName ?? "").Trim(), StringComparison.Ordinal)
            || !string.Equals((_editLogoPath ?? "").Trim(), (_savedLogoPath ?? "").Trim(), StringComparison.Ordinal));

    private bool Dirty => SettingsDirty || BrandingDirty;

    private Color BackupChipColor =>
        _backupStatus is null ? Color.Default
        : _backupStatusError is not null ? Color.Error
        : !_backupStatus.Enabled || _backupStatus.IsStaleOrFailed(TimeSpan.FromHours(SystemDefaults.BackupStaleHours)) ? Color.Error
        : Color.Success;

    private string BackupChipText =>
        _backupStatus is null ? "未知"
        : _backupStatusError is not null ? "读取失败"
        : !_backupStatus.Enabled ? "已关闭"
        : _backupStatus.IsStaleOrFailed(TimeSpan.FromHours(SystemDefaults.BackupStaleHours)) ? "异常"
        : "正常";

    private string BackupDetail
    {
        get
        {
            if (_backupStatusError is { } error) return $"读取失败：{error}";
            if (_backupStatus is null) return "状态加载中…";
            if (!_backupStatus.Enabled) return "Backup:Enabled=false";
            if (_backupStatus.LastSucceeded == false)
            {
                var err = _backupStatus.LastError ?? "未知错误";
                return $"最近失败：{err}";
            }
            var when = _backupStatus.LastSuccessAt?.ToLocalTime().ToString("HH:mm") ?? "尚无";
            return $"{when} 成功 · {FormatBytes(_backupStatus.LastBackupBytes)}";
        }
    }

    private Color SimChipColor =>
        _settings?.SimulatorAutoRun == true ? Color.Warning : Color.Default;

    private string SimChipText =>
        _settings?.SimulatorAutoRun == true ? "需关注" : "已关闭";

    private string SimDetail
    {
        get
        {
            var auto = _settings?.SimulatorAutoRun == true ? "AutoRun 开" : "AutoRun 关";
            return _productionSimWarning
                ? $"{auto} · 数据来自内置模拟器 · {_envName}"
                : $"{auto} · {_envName}";
        }
    }

        private static string SummarizeSettings(SystemSettings s)
        => $"scan={s.ScanIntervalMs}ms; retry={s.WriteRetryCount}×{s.WriteRetryDelayMs}ms; retentionYears={s.RetentionYears}; " +
           $"collect={s.CollectEnabled}; mes={s.MesEnabled}; mesTimeout={s.MesTimeoutSeconds}s; endpoint={s.MesEndpoint}";

    /// <summary>
    /// 写审计日志，失败时单独提示一次。
    /// </summary>
    /// <remarks>
    /// 这里吞掉异常只是"不阻断主操作"，不等于可以不告诉人：停用采集、改 MES 地址、手动备份
    /// 都是需要留痕的动作，审计写失败却没提示时，"谁改的"就永久缺了一条而没人知道。
    /// </remarks>
    private async Task AuditSafe(string action, string entityType, string key, string? oldValue, string? newValue)
    {
        try
        {
            var user = (await AuthState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
            await Audit.WriteAsync(user, action, entityType, key, oldValue, newValue);
        }
        catch (Exception ex)
        {
            Toast.Add($"审计记录失败：{ex.Message}", Severity.Warning);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _canEditBrand = auth.User.IsInRole("Administrator");
        await Reload();
    }

    private async Task ScrollTo(string id)
    {
        _activeSection = id;
        try { await JS.InvokeVoidAsync("dtScrollIntoView", id); }
        catch { /* ignore */ }
    }

    private async Task CopyPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return;
        try
        {
            var ok = await JS.InvokeAsync<bool>("dtCopy", path);
            Toast.Add(ok ? "路径已复制" : "复制失败", ok ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            Toast.Add($"复制失败：{ex.Message}", Severity.Warning);
        }
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (!Dirty) return;
        var ok = await DialogService.ShowMessageBox(
            "未保存的更改",
            "离开本页将丢失未保存的更改。确定离开？",
            yesText: "离开", cancelText: "留下");
        if (ok != true)
        {
            context.PreventNavigation();
        }
    }

    private async Task Reload()
    {
        _loading = true;
        try
        {
            _identity = Branding.GetSnapshot();
            _editSiteName = _identity.EffectiveSiteName;
            _editLogoPath = _identity.LogoPath;
            _savedSiteName = _editSiteName;
            _savedLogoPath = _editLogoPath;
            _envName = Branding.EnvironmentName;
            _dataRoot = Branding.ResolvedDataRoot;
            _bindUrl = Branding.BindUrl;
            _appVersion = Branding.AppVersion;

            // 只读一次快照：软上限提示与页面数据用的是同一份，之前分两次读同一个库。
            var snap = await Config.GetSnapshotAsync();

            _softCapWarning = null;
            if (_identity.MaxStations is int msCap && snap.Stations.Count > msCap)
            {
                _softCapWarning = $"工站数量 {snap.Stations.Count} 已超过客户约定上限 MaxStations={msCap}（仅提示，不阻止配置）。";
            }
            else if (_identity.MaxPlcs is int mpCap && snap.PlcConnections.Count > mpCap)
            {
                _softCapWarning = $"PLC 连接数 {snap.PlcConnections.Count} 已超过客户约定上限 MaxPlcs={mpCap}（仅提示，不阻止配置）。";
            }

            _settings = snap.Settings;
            _edit = EditFields.From(_settings);
            _loaded = _edit.Clone();
            _scanError = _retryError = _retryDelayError = _retentionError = _mesTimeoutError = null;
            _productionSimWarning = Branding.EnvironmentName.Equals("Production", StringComparison.OrdinalIgnoreCase)
                && _settings is { SimulatorAutoRun: true };
            RefreshBackupStatus();
            await RefreshMesOutboxStatusAsync();
        }
        catch (Exception ex)
        {
            _settings = null;
            Toast.Add($"读取系统设置失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DisableCollect()
    {
        if (_settings is null) return;
        var confirmed = await DialogService.ShowMessageBox(
            "停用采集",
            "停用后采集端不再读取任何工站；实时看板与查询仍可看历史数据。"
            + "这一步只改页面上的开关，要点「保存」才会真正下发并确认停用。",
            yesText: "停用采集", cancelText: "取消");
        if (confirmed == true)
        {
            _edit.CollectEnabled = false;
        }
    }

    private void EnableCollect()
    {
        if (_settings is null) return;
        _edit.CollectEnabled = true;
    }

    private async Task Save()
    {
        if (_settings is null || _saving) return;

        if (_edit.MesEnabled && !IsHttpUrl(_edit.MesEndpoint))
        {
            Toast.Add("已启用 MES 推送，但地址不是合法的 http(s) 地址", Severity.Warning);
            return;
        }

        if (!ValidateEditFields())
        {
            return;
        }

        var needSettings = SettingsDirty;
        var needBrand = BrandingDirty;
        if (!needSettings && !needBrand)
        {
            Toast.Add("没有需要保存的更改", Severity.Info);
            return;
        }

        // 保留年数是破坏性的：改小之后每 6 小时的清理任务就会把更近的历史删掉，且不可恢复。
        if (needSettings && _edit.RetentionYears != _loaded.RetentionYears && !await ConfirmRetentionChange())
        {
            return;
        }

        _saving = true;
        string? settingsErr = null;
        string? brandErr = null;
        var settingsSaved = false;
        var brandSaved = false;

        try
        {
            if (needSettings)
            {
                try
                {
                    // 库里的最新一行：只把本页真的改过的字段写回去。
                    // 整行覆盖会把另一会话刚保存的其它字段悄悄回滚（两边都看到"保存成功"）。
                    var target = (await Config.GetSnapshotAsync()).Settings;
                    var oldSnap = SummarizeSettings(target);
                    if (_edit.ScanIntervalMs != _loaded.ScanIntervalMs) target.ScanIntervalMs = _edit.ScanIntervalMs!.Value;
                    if (_edit.WriteRetryCount != _loaded.WriteRetryCount) target.WriteRetryCount = _edit.WriteRetryCount!.Value;
                    if (_edit.WriteRetryDelayMs != _loaded.WriteRetryDelayMs) target.WriteRetryDelayMs = _edit.WriteRetryDelayMs!.Value;
                    if (_edit.RetentionYears != _loaded.RetentionYears) target.RetentionYears = _edit.RetentionYears!.Value;
                    if (_edit.MesTimeoutSeconds != _loaded.MesTimeoutSeconds) target.MesTimeoutSeconds = _edit.MesTimeoutSeconds!.Value;
                    if (_edit.CollectEnabled != _loaded.CollectEnabled) target.CollectEnabled = _edit.CollectEnabled;
                    // 地址统一去掉首尾空白：带空格的 URL 能过校验、也会被原样存进库与审计里。
                    var endpoint = string.IsNullOrWhiteSpace(_edit.MesEndpoint) ? null : _edit.MesEndpoint.Trim();
                    if (!string.Equals(endpoint, _loaded.MesEndpoint ?? "", StringComparison.Ordinal)
                        || _edit.MesEnabled != _loaded.MesEnabled)
                    {
                        target.MesEndpoint = endpoint;
                        target.MesEnabled = _edit.MesEnabled;
                    }

                    await Config.SaveSettingsAsync(target);
                    await AuditSafe("Save", "SystemSettings", "settings", oldSnap, SummarizeSettings(target));
                    _settings = target;
                    _edit = EditFields.From(target);
                    _loaded = _edit.Clone();
                    Simulator.SetRunning(target.SimulatorAutoRun);
                    settingsSaved = true;
                }
                catch (Exception ex)
                {
                    settingsErr = ex.Message;
                }
            }

            if (needBrand)
            {
                try
                {
                    Branding.SaveBranding(_editSiteName, _editLogoPath);
                    _identity = Branding.GetSnapshot();
                    _savedSiteName = _identity.EffectiveSiteName;
                    _savedLogoPath = _identity.LogoPath;
                    _editSiteName = _savedSiteName;
                    _editLogoPath = _savedLogoPath;
                    brandSaved = true;
                }
                catch (Exception ex)
                {
                    brandErr = ex.Message;
                }
            }
        }
        finally
        {
            _saving = false;
        }

        // 保存成功但 Logo 文件不在：顶栏会是一片空白，用户很难想到是文件名写错了。
        // 放在成功提示之后，免得被"已写入 customer.json"盖住。
        if (settingsSaved)
        {
            await RefreshMesOutboxStatusAsync();
        }

        if (settingsErr is null && brandErr is null)
        {
            var bits = new List<string>();
            if (settingsSaved) bits.Add("配置已保存并下发采集端");
            if (brandSaved) bits.Add("品牌已写入 customer.json");
            Toast.Add(bits.Count > 0 ? string.Join("；", bits) : "已保存", Severity.Success);
        }
        else if (settingsSaved && brandErr is not null)
        {
            Toast.Add($"配置已保存，品牌保存失败：{brandErr}", Severity.Warning);
        }
        else if (brandSaved && settingsErr is not null)
        {
            Toast.Add($"品牌已保存，配置保存失败：{settingsErr}", Severity.Warning);
        }
        else if (settingsErr is not null && brandErr is not null)
        {
            Toast.Add($"配置保存失败：{settingsErr}；品牌保存失败：{brandErr}", Severity.Error);
        }
        else if (settingsErr is not null)
        {
            Toast.Add($"配置保存失败：{settingsErr}", Severity.Error);
        }
        else
        {
            Toast.Add($"品牌保存失败：{brandErr}", Severity.Error);
        }

        // 放在成功提示之后：文件名写错时顶栏是一片空白，用户很难想到是文件名的问题。
        if (brandSaved && Branding.LogoFileWarning(_savedLogoPath) is { } logoWarning)
        {
            Toast.Add(logoWarning, Severity.Warning);
        }
    }

    private static bool IsHttpUrl(string? url)
        => Uri.TryCreate(url, UriKind.Absolute, out var uri)
           && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    /// <summary>
    /// 数值字段的保存前校验：空值（输入框被清空或敲进非法字符）与越界都拦下来。
    /// </summary>
    /// <remarks>
    /// 不能任由输入框自己"夹到边界"：清空"保留年数"会得到 1，6 小时后历史整月库就被删了；
    /// 清空"扫描间隔"会得到 20ms，采集端会以十倍频率轮询 PLC。两种都显示成"保存成功"。
    /// </remarks>
    private bool ValidateEditFields()
    {
        _scanError = _edit.ScanIntervalMs is not { } scan ? "扫描间隔不能为空"
            : SettingsLimits.ScanIntervalError(scan);
        _retryError = _edit.WriteRetryCount is not { } retry ? "写回重试次数不能为空"
            : SettingsLimits.WriteRetryCountError(retry);
        _retryDelayError = _edit.WriteRetryDelayMs is not { } delay ? "写回重试间隔不能为空"
            : SettingsLimits.WriteRetryDelayError(delay);
        _retentionError = _edit.RetentionYears is not { } years ? "保留年数不能为空"
            : SettingsLimits.RetentionYearsError(years);
        _mesTimeoutError = _edit.MesTimeoutSeconds is not { } timeout ? "MES 超时不能为空"
            : SettingsLimits.MesTimeoutError(timeout);

        var bad = new[] { _scanError, _retryError, _retryDelayError, _retentionError, _mesTimeoutError }
            .Count(x => x is not null);
        if (bad == 0)
        {
            return true;
        }

        Toast.Add($"{bad} 项填写有误，已在对应输入框标出（未保存）", Severity.Warning);
        return false;
    }

    /// <summary>改小保留年数前的确认：把"会删到哪个月"说清楚，避免事后才发现历史没了。</summary>
    private async Task<bool> ConfirmRetentionChange()
    {
        var years = _edit.RetentionYears!.Value;
        var newestDeleted = SettingsLimits.NewestDeletedMonth(DateTime.Today, years);
        var confirmed = await DialogService.ShowMessageBox(
            "确认保留年数",
            $"保留年数 {_loaded.RetentionYears?.ToString() ?? "默认"} → {years} 年。\n\n"
            + $"清理任务（约每 {SystemDefaults.RetentionCheckHours} 小时一次）会删除 {newestDeleted:yyyy-MM} 及更早月份的整月记录库与曲线文件，"
            + "删除后不可恢复（配置库里的审计日志不受影响）。",
            yesText: "确认修改", cancelText: "取消");
        return confirmed == true;
    }

    private void RefreshBackupStatus()
    {
        try
        {
            _backupStatus = BackupService.GetStatus();
            _backupStatusError = null;
        }
        catch (Exception ex)
        {
            // 吞掉异常会让这一区永久停在"状态加载中…"的骨架，倒查备份时看不出是"读不到"还是"没备份过"。
            _backupStatus = null;
            _backupStatusError = ex.Message;
        }
    }

    /// <summary>MES 推送积压情况：对接区只有开关和地址时，"推不出去"没人看得出来。</summary>
    private async Task RefreshMesOutboxStatusAsync()
    {
        try { _mesStatus = await Config.GetMesOutboxStatusAsync(); }
        catch { _mesStatus = null; }
    }

    private async Task RunBackupNow()
    {
        if (_backingUp) return;
        _backingUp = true;
        try
        {
            await AuditSafe("Backup", "Backup", "manual", null, "start");
            var result = await BackupService.RunBackupAsync();
            RefreshBackupStatus();
            if (result.Success)
            {
                await AuditSafe("Backup", "Backup", "manual", "start",
                    $"success; path={result.BackupPath}; bytes={result.TotalBytes}");
                Toast.Add($"备份完成：{result.BackupPath}", Severity.Success);
            }
            else
            {
                await AuditSafe("Backup", "Backup", "manual", "start", $"fail; {result.Error}");
                Toast.Add($"备份失败：{result.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            await AuditSafe("Backup", "Backup", "manual", "start", $"fail; {ex.Message}");
            Toast.Add($"备份异常：{ex.Message}", Severity.Error);
            RefreshBackupStatus();
        }
        finally { _backingUp = false; }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "—";
        string[] units = ["B", "KB", "MB", "GB"];
        double v = bytes;
        var i = 0;
        while (v >= 1024 && i < units.Length - 1) { v /= 1024; i++; }
        return $"{v:0.##} {units[i]}";
    }
}

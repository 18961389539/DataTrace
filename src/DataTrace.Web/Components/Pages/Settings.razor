    private async Task RunBackupNow()
    {
        if (_backingUp) return;
        _backingUp = true;
        var correlationId = Guid.NewGuid().ToString("N");
        try
        {
            await AuditSafe("Backup", "Backup", "manual", null, "started", correlationId: correlationId);
            var result = await BackupService.RunBackupAsync();
            RefreshBackupStatus();
            if (result.Success)
            {
                await AuditSafe("Backup", "Backup", "manual", "start",
                    $"success; path={result.BackupPath}; db={result.DatabaseCount}; files={result.Files.Count}; verified={result.VerifiedFileCount}; bytes={result.TotalBytes}",
                    correlationId: correlationId);
                Toast.Add($"全量备份完成：{result.DatabaseCount} 个数据库，{result.VerifiedFileCount} 个文件校验通过", Severity.Success);
            }
            else
            {
                await AuditSafe("Backup", "Backup", "manual", "started", $"fail; {result.Error}",
                    outcome: "Failure", correlationId: correlationId);
                Toast.Add($"全量备份失败：{result.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            await AuditSafe("Backup", "Backup", "manual", "started", $"fail; {ex.Message}",
                outcome: "Failure", correlationId: correlationId);
            Toast.Add($"备份异常：{ex.Message}", Severity.Error);
            RefreshBackupStatus();
        }
        finally { _backingUp = false; }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "—";
        string[] units = ["B", "KB", "MB", "GB"];
        double v = bytes;
        var i = 0;
        while (v >= 1024 && i < units.Length - 1) { v /= 1024; i++; }
        return $"{v:0.##} {units[i]}";
    }

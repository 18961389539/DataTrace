@page "/logs"
@attribute [Authorize(Roles = "Administrator,Engineer")]
@using DataTrace.Application.Configuration
@using DataTrace.Domain.Entities
@using DataTrace.Web.Components.Shared
@using DataTrace.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuditLogger Audit
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime Js
@inject DtToast Toast

<PageHeader Title="审计日志" HelpRoute="logs" Busy="_loading">
    <Actions>
        <MudText Typo="Typo.caption" Class="dt-muted">
            命中 @_total 条（配置库 AuditLogs；每页 @_pageSize 条）
        </MudText>
    </Actions>
</PageHeader>

@* 说明默认折叠：常驻一条三行高的提示会把表格顶到首屏之外，
   而它只在第一次看这个页面时有用。展开与否记在 localStorage。 *@
<MudPaper Class="dt-log-notice mb-2" Elevation="0">
    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ToggleNoticeAsync"
               EndIcon="@(_noticeOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)">
        存储位置与保留策略
    </MudButton>
    @if (_noticeOpen)
    {
        <MudText Typo="Typo.body2" Class="dt-muted px-4 pb-3">
            审计日志保存在配置库（config.db / AuditLogs），与运行时月库相互独立。
            「系统设置 → 运行数据保留年数」不影响审计日志；审计日志单独设置为 0 时永久在线保留。
            设置为 1–30 年后，过期完整月份先归档到 audit-archive 并校验清单，再清理数据库记录。
        </MudText>
    }
</MudPaper>

<MudPaper Class="dt-filter-card mb-3">
    <MudGrid Class="dt-filters">
        <MudItem xs="12" sm="6" md="6">
            <MudTextField @bind-Value="_keyword" @bind-Value:after="OnFilterChanged" Label="关键字"
                          Placeholder="用户 / 对象 / 键 / 变更 / 来源 / 追踪 ID"
                          Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            <InfoHint Topic="HelpTexts.LogKeyword" />
        </MudItem>
        <MudItem xs="12" sm="6" md="6">
            <MudSelect T="string" @bind-Value="_action" @bind-Value:after="OnFilterChanged" Label="动作" Clearable="true">
                @foreach (var action in _actions)
                {
                    <MudSelectItem T="string" Value="@action">@DisplayLabels.AuditAction(action)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <div id="dt-log-advanced-filters" class="dt-log-advanced-filters" hidden="@(!_moreFiltersOpen)">
        <MudGrid Class="dt-filters">
            <MudItem xs="12" sm="6" md="6">
                <MudSelect T="string" @bind-Value="_user" @bind-Value:after="OnFilterChanged" Label="用户" Clearable="true">
                    @foreach (var user in _users)
                    {
                        <MudSelectItem T="string" Value="@user">@user</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="6">
                <MudSelect T="string" @bind-Value="_entityType" @bind-Value:after="OnFilterChanged" Label="对象" Clearable="true">
                    @foreach (var entity in _entityTypes)
                    {
                        <MudSelectItem T="string" Value="@entity">@DisplayLabels.EntityType(entity)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="string" @bind-Value="_outcome" @bind-Value:after="OnFilterChanged" Label="结果" Clearable="true">
                    <MudSelectItem T="string" Value="@("Success")">成功</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Failure")">失败</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_source" @bind-Value:after="OnFilterChanged" Label="来源"
                              Placeholder="按来源名称匹配" Immediate="true" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_correlationId" @bind-Value:after="OnFilterChanged" Label="关联 ID"
                              Placeholder="粘贴完整关联 ID" Immediate="true" Clearable="true" />
            </MudItem>
        </MudGrid>
    </div>

    @* 时间区间与数据查询页共用同一套组件与自然日口径。审计最常圈定的是「某一天」，
       只有下界的「近 N 天」做不到；而且滚动 168 小时和自然日不是一回事，
       同一个「近 7 天」在两页查出不同条数，比没有这个功能更糟。 *@
    <DateRangeFilter @bind-From="_from" @bind-To="_to" OnRangeChanged="OnFilterChanged" />

    <MudStack Row="true" Spacing="2" Class="pb-3 dt-log-filter-actions">
        <MudButton Variant="Variant.Text" Size="Size.Small"
                   aria-expanded="@(_moreFiltersOpen ? "true" : "false")"
                   aria-controls="dt-log-advanced-filters"
                   StartIcon="@(_moreFiltersOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                   OnClick="@(() => _moreFiltersOpen = !_moreFiltersOpen)">
            更多筛选@(AdvancedFilterCount > 0 ? $" · {AdvancedFilterCount}" : "")
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Reload())"
                   StartIcon="@Icons.Material.Filled.Refresh" Disabled="_loading">刷新</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="ExportCsv" Disabled="_exporting || _total == 0"
                   StartIcon="@(_exporting ? Icons.Material.Filled.Sync : Icons.Material.Filled.FileDownload)">
            @(_exporting ? $"导出中 {_exportedRows:N0}/{_exportTotal:N0}" : "完整导出")
        </MudButton>
    </MudStack>
</MudPaper>

@* 筛完只剩一个命中数，当前条件就看不回来了 —— 这里把条件摊开，逐个可删。
   与查询页/报表页同一套数据驱动写法；aria-label 带上具体条件，
   读屏用户听到的 8 个删除按钮才不是同一句话。 *@
@if (HasFilters)
{
    <div class="dt-filter-chips mb-3">
        @foreach (var filter in ActiveFilterList)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                @filter.Label
                <MudIconButton Size="Size.Small" Class="ml-1" Icon="@Icons.Material.Filled.Close"
                               aria-label="@($"移除筛选条件：{filter.Label}")"
                               OnClick="@(() => ClearOneAsync(filter.Clear))" />
            </MudChip>
        }
        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearAllAsync">清空全部</MudButton>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_timelineCorrelationId))
{
    <MudPaper Class="dt-audit-timeline-panel mb-3" Elevation="0">
        <div class="dt-audit-timeline-heading">
            <div>
                <MudText Typo="Typo.subtitle2">关联操作时间线</MudText>
                <MudText Typo="Typo.caption" Class="dt-muted">
                    @_timelineTotal 条 · @_timelineCorrelationId
                    @if (_timelineTotal > TimelineCap)
                    {
                        <span> · 仅显示最早 @TimelineCap 条</span>
                    }
                </MudText>
            </div>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                           aria-label="关闭关联操作时间线" OnClick="CloseTimeline" />
        </div>
        @if (_timelineLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_timelineItems.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="dt-muted py-2">没有找到该关联 ID 的日志。</MudText>
        }
        else
        {
            <ol class="dt-audit-timeline" aria-label="按时间排序的关联操作">
                @foreach (var entry in _timelineItems)
                {
                    <li class="dt-audit-timeline-item">
                        <div class="dt-audit-timeline-meta">
                            <time>@entry.Time.ToString("yyyy-MM-dd HH:mm:ss")</time>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@ActionColor(entry.Action)">
                                @DisplayLabels.AuditAction(entry.Action)
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@OutcomeColor(entry.Outcome)">
                                @OutcomeLabel(entry.Outcome)
                            </MudChip>
                            <span>@entry.UserName</span>
                            <span>@entry.Source</span>
                        </div>
                        <MudText Typo="Typo.body2">
                            @DisplayLabels.EntityType(entry.EntityType) · @(entry.EntityKey ?? "无对象键")
                        </MudText>
                        @if (!string.IsNullOrEmpty(entry.OldValue) || !string.IsNullOrEmpty(entry.NewValue))
                        {
                            <details class="dt-audit-timeline-change">
                                <summary>查看变更内容</summary>
                                <div class="dt-audit-timeline-values">
                                    <div><b>变更前</b><pre>@AuditValueFormatter.Format(entry.OldValue)</pre></div>
                                    <div><b>变更后</b><pre>@AuditValueFormatter.Format(entry.NewValue)</pre></div>
                                </div>
                            </details>
                        }
                    </li>
                }
            </ol>
        }
    </MudPaper>
}

@* 键 = 这条记录指向谁（用户 / 型号编码 / 月库-记录号 / 导出区间）；变更 = 改了什么。
   非变更类动作（登录、退出、导出）把说明写在变更列，不当成"旧值 → 新值"渲染。 *@
@* 50 行密表必须给容器一个高度，表头才吸得住：滚到下面时「结果 / 来源」「变更」这两列
   是最需要对照表头看的，而 JS 渲染的表格没有 FixedHeader 就整页滚。 *@
<MudTable Items="_pageItems" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Loading="_loading"
          FixedHeader="true" Height="var(--dt-grid-height)">
    <HeaderContent>
        <MudTh>
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="pa-0" OnClick="ToggleSortAsync"
                       EndIcon="@(_newestFirst ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)">
                时间
            </MudButton>
            <InfoHint Topic="HelpTexts.LogTimestamp" />
        </MudTh>
        <MudTh>用户</MudTh>
        <MudTh>动作</MudTh>
        <MudTh>对象</MudTh>
        <MudTh>键 <InfoHint Topic="HelpTexts.LogEntityKey" /></MudTh>
        <MudTh>结果 / 来源</MudTh>
        <MudTh>变更 <InfoHint Topic="HelpTexts.LogChange" /></MudTh>
    </HeaderContent>
    <RowTemplate Context="item">
        <MudTd DataLabel="时间" Class="dt-nowrap">@item.Time.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
        <MudTd DataLabel="用户">@item.UserName</MudTd>
        <MudTd DataLabel="动作">
            <MudTooltip Text="@($"原始动作码 {item.Action}")">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@ActionColor(item.Action)">
                    @DisplayLabels.AuditAction(item.Action)
                </MudChip>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="对象">@DisplayLabels.EntityType(item.EntityType)</MudTd>
        <MudTd DataLabel="键">@item.EntityKey</MudTd>
        <MudTd DataLabel="结果 / 来源" Class="dt-audit-origin">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@OutcomeColor(item.Outcome)">
                    @OutcomeLabel(item.Outcome)
                </MudChip>
                <MudText Typo="Typo.caption" Class="dt-muted">@item.Source</MudText>
            </MudStack>
        </MudTd>
        <MudTd DataLabel="变更">
            <button type="button" class="dt-change-cell"
                    @onclick="@((MouseEventArgs args) => ToggleExpandedFromClick(item.Id, args))"
                    @onkeydown="@((KeyboardEventArgs args) => ToggleExpandedFromKeyDown(item.Id, args))"
                    @onkeyup="@((KeyboardEventArgs args) => ToggleExpandedFromKeyUp(item.Id, args))"
                    aria-label="@($"展开或收起变更详情：{ChangeSummary(item)}")"
                    aria-expanded="@(_expanded.Contains(item.Id) ? "true" : "false")"
                    aria-controls="@($"dt-change-details-{item.Id}")">
                <span class="dt-change-summary">@ChangeSummary(item)</span>
                <MudIcon Icon="@(_expanded.Contains(item.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                         Size="Size.Small" />
            </button>
        </MudTd>
    </RowTemplate>
    <ChildRowContent Context="item">
        @if (_expanded.Contains(item.Id))
        {
            var differences = AuditValueFormatter.GetDifferences(item.OldValue, item.NewValue);
            <MudTr>
                <MudTd colspan="7">
                    <div class="dt-change-detail" id="@($"dt-change-details-{item.Id}")">
                        @if (differences.Count > 0)
                        {
                            <div class="dt-audit-diff">
                                <MudText Typo="Typo.caption" Class="dt-change-pane-label">字段差异</MudText>
                                @foreach (var difference in differences)
                                {
                                    <div class="dt-audit-diff-row">
                                        <code>@difference.Path</code>
                                        <span class="dt-audit-diff-old">@difference.OldValue</span>
                                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                        <span class="dt-audit-diff-new">@difference.NewValue</span>
                                    </div>
                                }
                            </div>
                        }
                        <div class="dt-audit-trace">
                            <span><b>来源：</b>@item.Source</span>
                            <span><b>结果：</b>@OutcomeLabel(item.Outcome)</span>
                            <span><b>来源 IP：</b>@(item.SourceIp ?? "未提供")</span>
                            <span class="dt-audit-trace-id">
                                <b>关联 ID：</b>
                                @if (!string.IsNullOrWhiteSpace(item.CorrelationId))
                                {
                                    <code>@item.CorrelationId</code>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Class="dt-audit-timeline-link"
                                               OnClick="@(() => LoadTimelineAsync(item.CorrelationId!))">
                                        时间线
                                    </MudButton>
                                }
                                else
                                {
                                    <span>未提供</span>
                                }
                            </span>
                        </div>
                        <div class="dt-change-pane">
                            <span class="dt-change-pane-label">变更前</span>
                            <div class="dt-change-pane-body old">@AuditValueFormatter.Format(item.OldValue)</div>
                        </div>
                        <div class="dt-change-pane">
                            <span class="dt-change-pane-label">变更后</span>
                            <div class="dt-change-pane-body new">@AuditValueFormatter.Format(item.NewValue)</div>
                        </div>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mt-4"
                                   StartIcon="@Icons.Material.Filled.ContentCopy"
                                   OnClick="@(() => CopyAsync(item))">复制</MudButton>
                    </div>
                </MudTd>
            </MudTr>
        }
    </ChildRowContent>
    <NoRecordsContent>
        @if (_loadFailed)
        {
            @* 失败时结果已在 catch 里清空，沿用「没有符合条件的日志」会把故障说成空数据。 *@
            <div class="dt-empty-hint">
                <MudText Class="dt-text-error">加载日志失败，结果已清空。</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh" Class="mt-2"
                           OnClick="@(() => Reload())">
                    重试
                </MudButton>
            </div>
        }
        else
        {
            <MudText Class="dt-muted py-4">
                @(_loading ? "正在加载…" : "没有符合条件的日志，可清空关键字或放宽时间范围。")
            </MudText>
        }
    </NoRecordsContent>
</MudTable>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3 flex-wrap" Spacing="3">
    @* 加载期间禁用：不加守卫时连点页码会重复发请求，而且点了没有任何反馈。 *@
    <MudPagination Count="_pages" Selected="_page" SelectedChanged="OnPage" BoundaryCount="1" MiddleCount="3"
                   Disabled="_loading" />
    <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Dense="true"
               Disabled="_loading" Class="dt-pagesize" Label="每页条数">
        @foreach (var size in PageSizes)
        {
            <MudSelectItem T="int" Value="size">@size 条/页</MudSelectItem>
        }
    </MudSelect>
    @* 总数在页头已经写过一次（"命中 N 条"），这里只留页码，别把同一句话摆两次。 *@
    <MudText Typo="Typo.caption" Class="dt-muted">
        第 @_page / @_pages 页
    </MudText>
</MudStack>

@code {
    private static readonly int[] PageSizes = [20, 50, 100];
    private int _pageSize = 50;
    private const int ExportBatchSize = 2000;
    private const int TimelineCap = 5000;
    private sealed record AuditExportRequest(
        string? Keyword,
        IReadOnlyList<string> MatchedActions,
        IReadOnlyList<string> MatchedEntities,
        string? Action,
        DateTime? From,
        DateTime? To,
        string? User,
        string? EntityType,
        string? Outcome,
        string? Source,
        string? CorrelationId,
        bool NewestFirst,
        long IdAtMost);

    /// <summary>变更列摘要的截断长度。整段 JSON 铺在格子里会把列宽撑爆。</summary>
    private const int SummaryMax = 90;

    private List<AuditLog> _pageItems = [];
    private List<string> _actions = [];
    private List<string> _users = [];
    private List<string> _entityTypes = [];

    private string? _keyword;
    private string _action = "";
    private string _user = "";
    private string _entityType = "";
    private string _outcome = "";
    private string? _source;
    private string? _correlationId;
    private DateTime? _from;
    private DateTime? _to;
    private bool _newestFirst = true;

    private int _page = 1;
    private int _pages = 1;
    private int _total;
    private bool _loading;
    /// <summary>查询本身失败（不是"查到 0 条"）：结果已被清空，不能再落回空态文案。</summary>
    private bool _loadFailed;
    private bool _exporting;
    private long _exportedRows;
    private int _exportTotal;
    private bool _noticeOpen;
    private bool _moreFiltersOpen;
    private readonly HashSet<long> _expanded = [];
    private readonly Dictionary<long, DateTime> _keyboardToggleAt = [];
    private string? _timelineCorrelationId;
    private List<AuditLog> _timelineItems = [];
    private int _timelineTotal;
    private bool _timelineLoading;

    private CancellationTokenSource? _filterCts;

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(_keyword)
        || !string.IsNullOrWhiteSpace(_action)
        || !string.IsNullOrWhiteSpace(_user)
        || !string.IsNullOrWhiteSpace(_entityType)
        || !string.IsNullOrWhiteSpace(_outcome)
        || !string.IsNullOrWhiteSpace(_source)
        || !string.IsNullOrWhiteSpace(_correlationId)
        || _from is not null
        || _to is not null;

    /// <summary>与查询/报表页同一套 chip 数据：只列真正生效的条件，渲染端不再逐条手抄。</summary>
    private sealed record ActiveFilter(string Label, Action Clear);

    private IReadOnlyList<ActiveFilter> ActiveFilterList
    {
        get
        {
            var list = new List<ActiveFilter>();
            if (!string.IsNullOrWhiteSpace(_keyword)) list.Add(new($"关键字 {_keyword}", () => _keyword = null));
            if (!string.IsNullOrWhiteSpace(_action)) list.Add(new($"动作 {DisplayLabels.AuditAction(_action)}", () => _action = ""));
            if (!string.IsNullOrWhiteSpace(_user)) list.Add(new($"用户 {_user}", () => _user = ""));
            if (!string.IsNullOrWhiteSpace(_entityType)) list.Add(new($"对象 {DisplayLabels.EntityType(_entityType)}", () => _entityType = ""));
            if (!string.IsNullOrWhiteSpace(_outcome)) list.Add(new($"结果 {OutcomeLabel(_outcome)}", () => _outcome = ""));
            if (!string.IsNullOrWhiteSpace(_source)) list.Add(new($"来源 {_source}", () => _source = null));
            if (!string.IsNullOrWhiteSpace(_correlationId)) list.Add(new($"关联 ID {_correlationId}", () => _correlationId = null));
            if (_from is not null || _to is not null)
            {
                list.Add(new(DateRangeFilter.Format(_from, _to), () =>
                {
                    _from = null;
                    _to = null;
                }));
            }

            return list;
        }
    }

    private int AdvancedFilterCount =>
        (!string.IsNullOrWhiteSpace(_user) ? 1 : 0)
        + (!string.IsNullOrWhiteSpace(_entityType) ? 1 : 0)
        + (!string.IsNullOrWhiteSpace(_outcome) ? 1 : 0)
        + (!string.IsNullOrWhiteSpace(_source) ? 1 : 0)
        + (!string.IsNullOrWhiteSpace(_correlationId) ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        await LoadOptionsAsync();
        await Reload();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var open = await Js.InvokeAsync<bool>("dtLogNotice.get");
            if (open != _noticeOpen)
            {
                _noticeOpen = open;
                StateHasChanged();
            }
        }
        catch
        {
            // JS 不可用就保持折叠
        }
    }

    private async Task LoadOptionsAsync()
    {
        try
        {
            var actions = await Audit.ListActionsAsync();
            _actions = DisplayLabels.KnownAuditActions
                .Concat(actions)
                .Distinct(StringComparer.Ordinal)
                .OrderBy(a => DisplayLabels.AuditAction(a), StringComparer.CurrentCulture)
                .ToList();
        }
        catch
        {
            _actions = DisplayLabels.KnownAuditActions.ToList();
        }

        try
        {
            var users = await Audit.ListUsersAsync();
            _users = users.Where(u => !string.IsNullOrWhiteSpace(u)).ToList();
        }
        catch
        {
            _users = [];
        }

        try
        {
            var entities = await Audit.ListEntityTypesAsync();
            _entityTypes = entities.Where(e => !string.IsNullOrWhiteSpace(e)).ToList();
        }
        catch
        {
            _entityTypes = [];
        }
    }

    private async Task OnFilterChanged()
    {
        if (DateRangeFilter.IsReversed(_from, _to))
        {
            _pageItems = [];
            _total = 0;
            _pages = 1;
            Toast.Add(DateRangeFilter.ReversedRangeMessage, Severity.Warning);
            return;
        }

        _page = 1;
        _filterCts?.Cancel();
        _filterCts = new CancellationTokenSource();
        var token = _filterCts.Token;
        try
        {
            await Task.Delay(250, token);
            await Reload(token);
        }
        catch (OperationCanceledException)
        {
            // 输入过程中被新一次筛选取消，正常。
        }
    }

    private async Task ClearOneAsync(Action clear)
    {
        clear();
        await OnFilterChanged();
    }

    private async Task ClearAllAsync()
    {
        _keyword = null;
        _action = "";
        _user = "";
        _entityType = "";
        _outcome = "";
        _source = null;
        _correlationId = null;
        _from = null;
        _to = null;
        await OnFilterChanged();
    }

    private async Task ToggleSortAsync()
    {
        _newestFirst = !_newestFirst;
        _page = 1;
        await Reload();
    }

    private void ToggleExpanded(long id)
    {
        if (!_expanded.Add(id))
        {
            _expanded.Remove(id);
        }
    }

    private void ToggleExpandedFromKeyDown(long id, KeyboardEventArgs args)
    {
        if (args.Repeat || args.Key != "Enter")
        {
            return;
        }

        ToggleExpandedFromKeyboard(id);
    }

    private void ToggleExpandedFromKeyUp(long id, KeyboardEventArgs args)
    {
        if (args.Key is not (" " or "Space" or "Spacebar"))
        {
            return;
        }

        ToggleExpandedFromKeyboard(id);
    }

    private void ToggleExpandedFromKeyboard(long id)
    {
        _keyboardToggleAt[id] = DateTime.Now;
        ToggleExpanded(id);
    }

    private void ToggleExpandedFromClick(long id, MouseEventArgs args)
    {
        if (args.Detail == 0
            && _keyboardToggleAt.Remove(id, out var toggledAt)
            && DateTime.Now - toggledAt < TimeSpan.FromSeconds(1))
        {
            return;
        }

        _keyboardToggleAt.Remove(id);
        ToggleExpanded(id);
    }

    private async Task LoadTimelineAsync(string correlationId)
    {
        _timelineCorrelationId = correlationId;
        _timelineLoading = true;
        _timelineItems = [];
        _timelineTotal = 0;
        try
        {

    /// <summary>时间起止。留空表示不限时间；终点取当天最后一刻，否则会吃掉结束日当天。</summary>
    private (DateTime? From, DateTime? To) Range()
        => (_from is null && _to is null)
            ? (null, null)
            : (DateRangeFilter.StartOf(_from), DateRangeFilter.EndOfInclusive(_to));

    private (string? Keyword, IReadOnlyList<string> Actions, IReadOnlyList<string> Entities) KeywordArgs()
    {
        var keyword = _keyword?.Trim();
        if (string.IsNullOrEmpty(keyword))
        {
            return (null, [], []);
        }

        return (keyword,
            DisplayLabels.ActionsMatchingKeyword(keyword),
            DisplayLabels.EntityTypesMatchingKeyword(keyword));
    }

    private async Task Reload(CancellationToken cancellationToken = default)
    {
        _loading = true;
        try
        {
            var (keyword, matchedActions, matchedEntities) = KeywordArgs();
            var (from, to) = Range();
            var (items, total) = await Audit.QueryAsync(
                keyword: keyword,
                action: string.IsNullOrWhiteSpace(_action) ? null : _action,
                fromInclusive: from,
                skip: (_page - 1) * _pageSize,
                take: _pageSize,
                keywordMatchedActions: matchedActions,
                keywordMatchedEntityTypes: matchedEntities,
                toInclusive: to,
                user: string.IsNullOrWhiteSpace(_user) ? null : _user,
                entityType: string.IsNullOrWhiteSpace(_entityType) ? null : _entityType,
                outcome: string.IsNullOrWhiteSpace(_outcome) ? null : _outcome,
                source: string.IsNullOrWhiteSpace(_source) ? null : _source,
                correlationId: string.IsNullOrWhiteSpace(_correlationId) ? null : _correlationId,
                newestFirst: _newestFirst,
                cancellationToken: cancellationToken);
            _pageItems = items.ToList();
            _total = total;
            _loadFailed = false;
            _pages = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));
            if (_page > _pages)
            {
                _page = _pages;
            }
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            _pageItems = [];
            _total = 0;
            _pages = 1;
            _loadFailed = true;
            Toast.Add($"加载日志失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string ChangeSummary(AuditLog item)
    {
        if (string.IsNullOrEmpty(item.OldValue) && string.IsNullOrEmpty(item.NewValue))
        {
            return "-";
        }

        var text = DisplayLabels.IsChangeAction(item.Action)
            ? $"{(string.IsNullOrEmpty(item.OldValue) ? "新增" : item.OldValue)} → {item.NewValue}"
            // 导出/登录不是"变更"：写"新增 → 导出 20 条"会被读成新增了一条记录。
            : item.NewValue ?? item.OldValue ?? "-";

        return text.Length <= SummaryMax ? text : text[..SummaryMax] + "…";
    }

    private async Task CopyAsync(AuditLog item)
    {
        var text = string.Join('\n',
            $"{item.Time:yyyy-MM-dd HH:mm:ss}  {item.UserName}  {DisplayLabels.AuditAction(item.Action)}  {DisplayLabels.EntityType(item.EntityType)}  {item.EntityKey}",
            $"结果：{OutcomeLabel(item.Outcome)}；来源：{item.Source}；来源 IP：{item.SourceIp ?? "未提供"}；关联 ID：{item.CorrelationId ?? "未提供"}",
            $"变更前：{item.OldValue ?? "（无）"}",
            $"变更后：{item.NewValue ?? "（无）"}");

        bool ok;
        try
        {
            ok = await Js.InvokeAsync<bool>("dtCopy", text);
        }
        catch
        {
            ok = false;
        }

        // 工控机多走 http://局域网IP，非安全上下文下剪贴板不可用，必须给得出失败反馈。
        Toast.Add(ok ? "已复制变更内容" : "复制失败，请手动选择文本", ok ? Severity.Success : Severity.Warning);
    }

    private static Color ActionColor(string action) => action switch
    {
        var a when a.StartsWith("Delete", StringComparison.OrdinalIgnoreCase) => Color.Error,
        var a when a.StartsWith("Disable", StringComparison.OrdinalIgnoreCase) => Color.Warning,
        var a when a.StartsWith("Deactivate", StringComparison.OrdinalIgnoreCase) => Color.Warning,
        var a when a.StartsWith("Save", StringComparison.OrdinalIgnoreCase) => Color.Success,
        var a when a.StartsWith("Create", StringComparison.OrdinalIgnoreCase) => Color.Success,
        var a when a.StartsWith("Enable", StringComparison.OrdinalIgnoreCase) => Color.Success,
        var a when a.StartsWith("Activate", StringComparison.OrdinalIgnoreCase) => Color.Success,
        var a when a.StartsWith("Login", StringComparison.OrdinalIgnoreCase) => Color.Info,
        var a when a.StartsWith("Logout", StringComparison.OrdinalIgnoreCase) => Color.Info,
        var a when a.StartsWith("Backup", StringComparison.OrdinalIgnoreCase) => Color.Info,
        _ => Color.Default
    };

    private static string OutcomeLabel(string outcome) => outcome switch
    {
        "Failure" => "失败",
        "Success" => "成功",
        _ => outcome
    };

    private static Color OutcomeColor(string outcome) => outcome switch
    {
        "Failure" => Color.Error,
        "Success" => Color.Success,
        _ => Color.Default
    };

    private async Task OnPage(int page)
    {
        _page = page;
        await Reload();
    }

    private async Task OnPageSizeChanged(int size)
    {
        _pageSize = size;
        // 每页条数变了，原来的页码多半已经没有意义（第 5 页可能根本不存在），回到第一页。
        _page = 1;
        await Reload();
    }

    private async Task ExportCsv()
    {
        if (_exporting)
        {
            return;
        }

        if (DateRangeFilter.IsReversed(_from, _to))
        {
            Toast.Add(DateRangeFilter.ReversedRangeMessage, Severity.Warning);
            return;
        }

        _exporting = true;
        _exportedRows = 0;
        _exportTotal = _total;
        string? tempPath = null;
        var exportSummary = "export initialization failed";
        var exportId = Guid.NewGuid();
        try
        {
            var idAtMost = await Audit.GetLatestIdAsync();
            var (keyword, matchedActions, matchedEntities) = KeywordArgs();
            var (from, to) = Range();
            var request = new AuditExportRequest(
                keyword,
                matchedActions,
                matchedEntities,
                string.IsNullOrWhiteSpace(_action) ? null : _action,
                from,
                to,
                string.IsNullOrWhiteSpace(_user) ? null : _user,
                string.IsNullOrWhiteSpace(_entityType) ? null : _entityType,
                string.IsNullOrWhiteSpace(_outcome) ? null : _outcome,
                string.IsNullOrWhiteSpace(_source) ? null : _source,
                string.IsNullOrWhiteSpace(_correlationId) ? null : _correlationId,
                _newestFirst,
                idAtMost);
            exportSummary = ExportSummary(request, 0);

            tempPath = Path.Combine(Path.GetTempPath(), $"datatrace_audit_{exportId:N}.csv");

            await using var file = new FileStream(
                tempPath,
                FileMode.CreateNew,
                FileAccess.ReadWrite,
                FileShare.Read,
                bufferSize: 64 * 1024,
                FileOptions.Asynchronous | FileOptions.SequentialScan);

            var headers = new[]
            {
                "时间", "用户", "动作", "对象", "键", "结果", "来源", "来源 IP", "关联 ID", "变更前", "变更后"
            };
            var batch = await QueryExportBatchAsync(0, request);
            _exportTotal = batch.Total;

            await using (var writer = new StreamWriter(file, new System.Text.UTF8Encoding(true), 64 * 1024, leaveOpen: true))
            {
                await writer.WriteLineAsync(CsvExporter.BuildRow(headers));
                var skip = 0;
                while (batch.Items.Count > 0)
                {
                    foreach (var item in batch.Items)
                    {
                        var row = new[]
                        {
                            item.Time.ToString("yyyy-MM-dd HH:mm:ss"),
                            item.UserName,
                            DisplayLabels.AuditAction(item.Action),
                            DisplayLabels.EntityType(item.EntityType),
                            item.EntityKey ?? "",
                            OutcomeLabel(item.Outcome),
                            item.Source,
                            item.SourceIp ?? "",
                            item.CorrelationId ?? "",
                            item.OldValue ?? "",
                            item.NewValue ?? ""
                        };
                        await writer.WriteLineAsync(CsvExporter.BuildRow(row));
                    }

                    _exportedRows += batch.Items.Count;
                    skip += batch.Items.Count;
                    await writer.FlushAsync();
                    await InvokeAsync(StateHasChanged);

                    if (batch.Items.Count < ExportBatchSize || skip >= batch.Total)
                    {
                        break;
                    }

                    batch = await QueryExportBatchAsync(skip, request);
                }
            }

            await Js.InvokeVoidAsync(
                "dtDownloadUrl",
                CsvExporter.FileName("datatrace_audit"),
                $"/audit-export/{exportId:D}");
            exportSummary = ExportSummary(request, _exportedRows);
            await TryWriteExportAuditAsync(exportId, "Success", exportSummary);
            Toast.Add($"已完整导出 {_exportedRows:N0} 条日志", Severity.Success);
        }
        catch (Exception ex)
        {
            await TryWriteExportAuditAsync(
                exportId,
                "Failure",
                $"{exportSummary}; error={ex.Message}");
            Toast.Add($"导出失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            if (tempPath is not null)
            {
                try
                {
                    File.Delete(tempPath);
                }
                catch
                {
                    // 临时文件删除失败不覆盖实际导出结果。
                }
            }
            _exporting = false;
            _exportedRows = 0;
            _exportTotal = 0;
        }
    }

    private static string ExportSummary(AuditExportRequest request, long rows)
        => $"rows={rows}; from={request.From?.ToString("O") ?? "*"}; to={request.To?.ToString("O") ?? "*"}; " +
           $"action={request.Action ?? "*"}; user={request.User ?? "*"}; entity={request.EntityType ?? "*"}; " +
           $"outcome={request.Outcome ?? "*"}; source={request.Source ?? "*"}; " +
           $"correlationId={request.CorrelationId ?? "*"}; keywordApplied={!string.IsNullOrWhiteSpace(request.Keyword)}; " +
           $"order={(request.NewestFirst ? "newest-first" : "oldest-first")}; idAtMost={request.IdAtMost}";

    private async Task TryWriteExportAuditAsync(Guid exportId, string outcome, string details)
    {
        try
        {
            var user = (await AuthState.GetAuthenticationStateAsync()).User.Identity?.Name ?? "unknown";
            await Audit.WriteAsync(
                user,
                "Export",
                "AuditLog",
                null,
                null,
                details,
                outcome: outcome,
                source: "Audit log CSV download",
                correlationId: exportId.ToString("N"));
        }
        catch (Exception ex)
        {
            Toast.Add($"导出行为已执行，但审计留痕失败：{ex.Message}", Severity.Warning);
        }
    }

    private Task<(IReadOnlyList<AuditLog> Items, int Total)> QueryExportBatchAsync(int skip, AuditExportRequest request)
        => Audit.QueryAsync(
            keyword: request.Keyword,
            action: request.Action,
            fromInclusive: request.From,
            skip: skip,
            take: ExportBatchSize,
            keywordMatchedActions: request.MatchedActions,
            keywordMatchedEntityTypes: request.MatchedEntities,
            toInclusive: request.To,
            user: request.User,
            entityType: request.EntityType,
            outcome: request.Outcome,
            source: request.Source,
            correlationId: request.CorrelationId,
            idAtMost: request.IdAtMost,
            newestFirst: request.NewestFirst);
}

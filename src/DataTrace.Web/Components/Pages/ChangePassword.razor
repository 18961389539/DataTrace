@page "/change-password"
@layout EmptyLayout
@attribute [Authorize]
@using DataTrace.Web.Services
@inject PasswordPolicy Passwords

<PageTitle>修改密码 · DataTrace</PageTitle>

@* 使用普通表单 POST 修改密码，以便在成功后更新认证 Cookie。 *@
<div class="login-page">
    <section class="login-card">
        <h1 class="login-title">修改密码</h1>
        <p class="login-hint">修改当前登录账号的密码。修改成功后本次登录保持有效，下次登录请使用新密码。</p>

        <form method="post" action="/account/change-password" data-enhance="false" data-enhance-nav="false">
            @* 与登录端点同理：本页在交互渲染下出不来防伪令牌，端点上已显式 DisableAntiforgery，
               跨站防护由 Origin/Referer 校验（SameSitePost）承担。 *@
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

            <label class="login-label" for="dt-cur">当前密码</label>
            <div class="login-pass" data-dt-pass>
                <input class="login-input" id="dt-cur" name="CurrentPassword" type="password"
                       autocomplete="current-password" autofocus />
                <button type="button" class="login-pass-toggle" data-dt-pass-toggle
                        aria-label="显示密码" aria-pressed="false">
                    <svg class="dt-eye dt-eye-show" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                        <path d="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5c-1.7-4.4-6-7.5-11-7.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                    </svg>
                    <svg class="dt-eye dt-eye-hide" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                        <path d="M12 6.5c2.8 0 5.3 1.6 6.6 4-.6 1.2-1.5 2.2-2.6 2.9l1.4 1.4a11.9 11.9 0 0 0 3.6-4.3C19.3 6.1 15 3 10 3c-1.5 0-2.9.3-4.2.8l1.7 1.7c.8-.2 1.6-.3 2.5-.3zM3.7 2.9 2.3 4.3l3 3A12 12 0 0 0 1 11.5C2.7 15.9 7 19 12 19c1.7 0 3.3-.4 4.7-1l3.3 3.3 1.4-1.4L3.7 2.9zM12 16.5a5 5 0 0 1-4.2-7.6l1.6 1.6a3 3 0 0 0 4.1 4.1l1.6 1.6c-.9.5-2 .7-3.1.7z" />
                    </svg>
                </button>
            </div>

            <label class="login-label" for="dt-new">新密码</label>
            <div class="login-pass" data-dt-pass>
                <input class="login-input" id="dt-new" name="NewPassword" type="password"
                       autocomplete="new-password" aria-describedby="dt-pass-rule" />
                <button type="button" class="login-pass-toggle" data-dt-pass-toggle
                        aria-label="显示密码" aria-pressed="false">
                    <svg class="dt-eye dt-eye-show" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                        <path d="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5c-1.7-4.4-6-7.5-11-7.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                    </svg>
                    <svg class="dt-eye dt-eye-hide" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                        <path d="M12 6.5c2.8 0 5.3 1.6 6.6 4-.6 1.2-1.5 2.2-2.6 2.9l1.4 1.4a11.9 11.9 0 0 0 3.6-4.3C19.3 6.1 15 3 10 3c-1.5 0-2.9.3-4.2.8l1.7 1.7c.8-.2 1.6-.3 2.5-.3zM3.7 2.9 2.3 4.3l3 3A12 12 0 0 0 1 11.5C2.7 15.9 7 19 12 19c1.7 0 3.3-.4 4.7-1l3.3 3.3 1.4-1.4L3.7 2.9zM12 16.5a5 5 0 0 1-4.2-7.6l1.6 1.6a3 3 0 0 0 4.1 4.1l1.6 1.6c-.9.5-2 .7-3.1.7z" />
                    </svg>
                </button>
            </div>

            <label class="login-label" for="dt-cfm">确认新密码</label>
            <div class="login-pass" data-dt-pass>
                <input class="login-input" id="dt-cfm" name="ConfirmPassword" type="password"
                       autocomplete="new-password" />
                <button type="button" class="login-pass-toggle" data-dt-pass-toggle
                        aria-label="显示密码" aria-pressed="false">
                    <svg class="dt-eye dt-eye-show" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                        <path d="M12 4.5C7 4.5 2.7 7.6 1 12c1.7 4.4 6 7.5 11 7.5s9.3-3.1 11-7.5c-1.7-4.4-6-7.5-11-7.5zm0 12.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
                    </svg>
                    <svg class="dt-eye dt-eye-hide" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                        <path d="M12 6.5c2.8 0 5.3 1.6 6.6 4-.6 1.2-1.5 2.2-2.6 2.9l1.4 1.4a11.9 11.9 0 0 0 3.6-4.3C19.3 6.1 15 3 10 3c-1.5 0-2.9.3-4.2.8l1.7 1.7c.8-.2 1.6-.3 2.5-.3zM3.7 2.9 2.3 4.3l3 3A12 12 0 0 0 1 11.5C2.7 15.9 7 19 12 19c1.7 0 3.3-.4 4.7-1l3.3 3.3 1.4-1.4L3.7 2.9zM12 16.5a5 5 0 0 1-4.2-7.6l1.6 1.6a3 3 0 0 0 4.1 4.1l1.6 1.6c-.9.5-2 .7-3.1.7z" />
                    </svg>
                </button>
            </div>

            <p class="login-hint" id="dt-pass-rule">@Passwords.HelperText</p>

            <button type="submit" class="login-btn">确认修改</button>

            @if (ErrorText is { } message)
            {
                <p class="login-error" role="alert">@message</p>
            }
        </form>

        <a class="login-back" href="/">返回首页</a>
    </section>
</div>

@code {
    /// <summary>端点用错误码回跳，页面把码翻成中文 —— 不把服务端文案塞进 URL。</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    /// <summary>改完之后去哪儿；端点只接受站内路径，这里原样续到表单里。</summary>
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? ReturnUrl { get; set; }

    private string? ErrorText => Error switch
    {
        null or "" => null,
        "missing" => "请把当前密码、新密码与确认密码都填上。",
        "mismatch" => "两次输入的新密码不一致。",
        "same" => "新密码不能与当前密码相同。",
        "current" => "当前密码不正确。",
        "policy" => $"新密码不符合要求：{Passwords.HelperText}。",
        // 全限定：本页有个同名属性 ReturnUrl，裸写会解析到那个 string 上。
        DataTrace.Shared.ReturnUrl.CrossSiteError => "改密请求来源异常，已拒绝。请重新提交。",
        _ => "修改失败，请重试；若反复失败请联系管理员。"
    };
}

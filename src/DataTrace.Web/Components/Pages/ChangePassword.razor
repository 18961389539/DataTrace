@page "/change-password"
@layout EmptyLayout
@attribute [Authorize]
@using DataTrace.Infrastructure.Identity
@using DataTrace.Web.Services
@inject PasswordPolicy Passwords
@inject AuthenticationStateProvider Auth

<PageTitle>修改密码 · DataTrace</PageTitle>

@* 强制改密的落地页。刻意不走 Blazor 事件、而是普通表单 POST：
   改完必须重发认证 Cookie 才能摘掉"必须改密"标记，而这一步在交互式渲染里做不了。
   与登录页同一套取舍，样式也复用 login-* 类。 *@
<div class="login-page">
    <section class="login-card">
        <h1 class="login-title">修改密码</h1>
        @if (_forced)
        {
            <p class="login-hint">当前账号还在使用初始口令。修改之后才能进入其它页面。</p>
        }
        else
        {
            <p class="login-hint">改的是你当前登录的这个账号。修改成功后本次登录保持有效，下次登录请用新密码。</p>
        }

        <form method="post" action="/account/change-password" data-enhance="false" data-enhance-nav="false">
            @* 与登录端点同理：本页在交互渲染下出不来防伪令牌，端点上已显式 DisableAntiforgery，
               跨站防护由 Origin/Referer 校验（SameSitePost）承担。 *@
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

            <label class="login-label" for="dt-cur">当前密码</label>
            <input class="login-input" id="dt-cur" name="CurrentPassword" type="password"
                   autocomplete="current-password" autofocus />

            <label class="login-label" for="dt-new">新密码</label>
            <input class="login-input" id="dt-new" name="NewPassword" type="password"
                   autocomplete="new-password" aria-describedby="dt-pass-rule" />

            <label class="login-label" for="dt-cfm">确认新密码</label>
            <input class="login-input" id="dt-cfm" name="ConfirmPassword" type="password"
                   autocomplete="new-password" />

            <p class="login-hint" id="dt-pass-rule">@Passwords.HelperText</p>

            <button type="submit" class="login-btn">确认修改</button>

            @if (ErrorText is { } message)
            {
                <p class="login-error" role="alert">@message</p>
            }
        </form>

        @if (_forced)
        {
            <form method="post" action="/account/logout" data-enhance="false" data-enhance-nav="false">
                <button type="submit" class="login-btn login-btn-plain">退出登录</button>
            </form>
        }
    </section>
</div>

@code {
    private bool _forced;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        _forced = state.User.HasClaim(ApplicationUserClaimsPrincipalFactory.MustChangePasswordClaim, "1");
    }

    /// <summary>端点用错误码回跳，页面把码翻成中文 —— 不把服务端文案塞进 URL。</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    /// <summary>改完之后去哪儿；端点只接受站内路径，这里原样续到表单里。</summary>
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? ReturnUrl { get; set; }

    private string? ErrorText => Error switch
    {
        null or "" => null,
        "missing" => "请把当前密码、新密码与确认密码都填上。",
        "mismatch" => "两次输入的新密码不一致。",
        "same" => "新密码不能与当前密码相同。",
        "current" => "当前密码不正确。",
        "policy" => $"新密码不符合要求：{Passwords.HelperText}。",
        // 全限定：本页有个同名属性 ReturnUrl，裸写会解析到那个 string 上。
        DataTrace.Shared.ReturnUrl.CrossSiteError => "改密请求来源异常，已拒绝。请重新提交。",
        _ => "修改失败，请重试；若反复失败请联系管理员。"
    };
}

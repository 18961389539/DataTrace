                <MudTooltip Text="复制托盘码">
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                   aria-label="复制托盘码"
                                   OnClick="@(() => CopyText(context.Record.PalletCode, "托盘码"))" />
                </MudTooltip>
                <MudButton Size="Size.Small" Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.AccountTree"
                           Disabled="@(_loading || _exporting || _displayedVersion != _queryVersion || string.IsNullOrWhiteSpace(context.Record.SerialNo))"
                           Href="@TraceUrl(context)">追溯</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ChevronRight"
                           Disabled="@(_loading || _exporting || _displayedVersion != _queryVersion)"
                           Href="@DetailUrl(context)">明细</MudButton>
            </span>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadFailed)
        {
            @* 结果已经被 catch 清空，这里再说「没有符合条件的记录」就是把故障说成空数据。
               给重试按钮：查询失败多数是月库被占用，重试一次往往就过。 *@
            <div class="dt-empty-hint">
                <MudText Typo="Typo.body2" Class="dt-text-error">查询失败，结果已清空。</MudText>
                <MudText Typo="Typo.caption" Class="dt-muted mt-1">
                    若持续失败，请检查月库是否被占用或采集端连接是否断开。
                </MudText>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh" Class="mt-2"
                           OnClick="@(() => Load())">
                    重试
                </MudButton>
            </div>
        }
        else if (_loading)
        {
            <MudText Typo="Typo.body2" Class="dt-muted py-3">正在查询…</MudText>
        }
        else
        {
            @* 默认区间是今天，最容易撞到空结果。只说一句「没有记录」等于把人晾在这，
               所以直接给出口：放宽区间（保留其它条件）与清空条件。
               放宽目标跟着当前跨度走 —— 已经查了 7 天还空，再给「放宽到近 7 天」是句废话。 *@
            <div class="dt-empty-hint">
                <MudText Typo="Typo.body2" Class="dt-muted">当前区间内没有符合条件的记录。</MudText>
                <MudStack Row="true" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap">
                    @if (WidenDays is { } days)

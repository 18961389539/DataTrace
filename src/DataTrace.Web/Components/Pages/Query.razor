@page "/query"
@attribute [Authorize]
@using DataTrace.Application.Configuration
@using DataTrace.Application.Runtime
@using DataTrace.Domain.Constants
@using Microsoft.AspNetCore.Components.Authorization
@inject IRuntimeStore Store
@inject IConfigRepository Config
@inject IAuditLogger Audit
@inject AuthenticationStateProvider Auth
@inject DtToast Toast
@inject IJSRuntime Js
@inject NavigationManager Nav
@implements IDisposable

<PageHeader Title="数据查询" HelpRoute="query">
    <Actions>
        @if (_traceMode)
        {
            <MudText Typo="Typo.caption" Class="dt-muted">按完整流水号跨月追溯</MudText>
        }
        else
        {
            <MudText Typo="Typo.caption" Class="dt-muted">
                区间 @DateRangeFilter.Format(_from, _to)　共 @_total 条
            </MudText>
            <InfoHint Topic="HelpTexts.RangeScope" />
        }
    </Actions>
</PageHeader>

<MudStack Row="true" Spacing="1" Class="mb-3">
    <MudButton Size="Size.Small" Variant="@(_traceMode ? Variant.Outlined : Variant.Filled)"
               Color="Color.Primary" StartIcon="@Icons.Material.Filled.TableRows" OnClick="ShowRecords">
        记录查询
    </MudButton>
    <MudButton Size="Size.Small" Variant="@(_traceMode ? Variant.Filled : Variant.Outlined)"
               Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountTree" OnClick="ShowTraceability">
        产品追溯
    </MudButton>
</MudStack>

@if (_traceMode)
{
    <ProductTraceabilityPanel InitialSerialNo="@TraceQuery" OnSearchCompleted="OnTraceSearchCompleted" />
}
else
{
<MudPaper Class="dt-filter-card mb-3">
    <form @onsubmit="OnSubmit" @onsubmit:preventDefault="true">
        <DateRangeFilter @bind-From="_from" @bind-To="_to" OnRangeChanged="Search" />

        <MudGrid Class="dt-filters">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudTextField T="string" Value="_pallet" ValueChanged="OnPalletChanged" Label="托盘码" Placeholder="支持模糊匹配"
                              Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.QrCode" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudTextField T="string" Value="_serialNo" ValueChanged="OnSerialChanged" Label="流水号"
                              Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Tag" />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudSelect T="int?" Value="_stationId" ValueChanged="OnStationChanged" Label="工站" Clearable="true">
                    @foreach (var s in _stations)
                    {
                        <MudSelectItem T="int?" Value="@s.Id">@s.Code @s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudSelect T="Judgement?" Value="_judgement" ValueChanged="OnJudgementChanged" Label="判定" Clearable="true">
                    <MudSelectItem T="Judgement?" Value="Judgement.Ok">OK（合格）</MudSelectItem>
                    <MudSelectItem T="Judgement?" Value="Judgement.Ng">NG（不合格）</MudSelectItem>
                    <MudSelectItem T="Judgement?" Value="Judgement.None">未判定</MudSelectItem>
                </MudSelect>
            </MudItem>

            @* 结果码描述已落库采集记录的处理结果；PLC 通讯失败没有有效产品记录，单独留在审计日志。 *@
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudSelect T="short?" Value="_resultCode" ValueChanged="OnResultCodeChanged" Label="结果码" Clearable="true">
                    @foreach (var code in ResultCodeOptions)
                    {
                        <MudSelectItem T="short?" Value="@((short?)code)">@ResultCodeLabel(code)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

                        <MudItem xs="12" sm="6" md="4" lg="3">
                <MudSelect T="RecipeFilterValue" Value="@ToOptionValue(_recipeFilter)" ValueChanged="OnRecipeFilterChanged"
                           Label="产品型号" Dense="true" Disabled="_loading">
                    <MudSelectItem T="RecipeFilterValue" Value="@RecipeFilterValue.All">全部型号</MudSelectItem>
                    <MudSelectItem T="RecipeFilterValue" Value="@RecipeFilterValue.NoRecipe">未选型号</MudSelectItem>
                    @foreach (var opt in _recipeOptions)
                    {
                        <MudSelectItem T="RecipeFilterValue" Value="@ToOptionValue(opt.Code)">@opt.Label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Spacing="2" Class="mt-1 mb-2 flex-wrap">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search" Disabled="_loading">
                @(_loading ? "查询中…" : "查询")
            </MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="Reset" StartIcon="@Icons.Material.Filled.RestartAlt">
                重置
            </MudButton>
            @if (_canExport)
            {
                @* 按钮禁用时浏览器不派发 hover，tooltip 挂在外层也收不到 —— 见 app.css 里
                   .mud-tooltip .mud-button:disabled 那条：让按钮不接指针事件，hover 落到包裹层。 *@
                <MudTooltip Arrow="true" Text="@ExportTooltipText">
                    <ChildContent>
                        <MudButton Variant="Variant.Outlined" OnClick="ExportCsv" Disabled="_exporting || _total == 0"
                                   StartIcon="@Icons.Material.Filled.FileDownload">
                            @(_exporting ? "导出中…" : "导出 CSV")
                        </MudButton>
                    </ChildContent>
                </MudTooltip>
                <InfoHint Topic="HelpTexts.ExportLimit" Extra="@ExportHintExtra" />
            }
            <MudText Typo="Typo.caption" Class="dt-muted align-self-center">改任一条件即自动重查，也可点「查询」立刻执行</MudText>
            <InfoHint Topic="HelpTexts.MatchMode" />
        </MudStack>
    </form>
</MudPaper>

@* 「变更即查询」之后，六个条件散在各个控件里，筛完只剩一个命中数，回头看不出自己是按什么在筛。
   这里把生效条件摊开，并且能只摘掉其中一个 —— 与日志页同一套 chips 写法。
   区间只在不是默认值（今天）时列出：否则默认进页面就挂着一个删掉也没变化的 chip。 *@
@if (ActiveFilters.Count > 0)
{
    <div class="dt-filter-chips mb-3">
        <MudText Typo="Typo.caption" Class="dt-muted">当前条件</MudText>
        @foreach (var filter in ActiveFilters)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                @filter.Label
                <MudIconButton Size="Size.Small" Class="ml-1" Icon="@Icons.Material.Filled.Close"
                               aria-label="@($"移除筛选条件：{filter.Label}")"
                               OnClick="@(() => ClearOneAsync(filter.Clear))" />
            </MudChip>
        }
        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearAllFiltersAsync">清空全部</MudButton>
    </div>
}

@* 表头吸附：一页最多 100 行，滚下去就没有列名可对。高度用 --dt-grid-height 统一约定，
   不写在这里是因为它和页头/筛选卡/分页条的实际高度有关，只该有一处真相。 *@
<MudTable Items="_items" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
          Loading="_loading" LoadingProgressColor="Color.Info"
          FixedHeader="true" Height="var(--dt-grid-height)"
          Class="dt-clickable" OnRowClick="@((TableRowClickEventArgs<CollectRecordListItem> args) => OnRowClicked(args))">
    <HeaderContent>
        <MudTh Class="dt-nowrap">时间</MudTh>
        <MudTh>流水号</MudTh>
        <MudTh>托盘码</MudTh>
        <MudTh>工站</MudTh>
        <MudTh>型号 <InfoHint Topic="HelpTexts.RecipeScope" /></MudTh>
        <MudTh>判定 <InfoHint Topic="HelpTexts.JudgementThreeState" /></MudTh>
        <MudTh Class="dt-nowrap">结果码</MudTh>
        <MudTh Class="dt-right">耗时</MudTh>
        <MudTh Class="dt-right">操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        @* 区间落在同一天时省掉日期：默认就是查今天，每行重复 "2026-09-27 " 这 11 个字符
           只会把型号和结果码挤窄。日期本身页头的「区间」一直写着，不会丢信息。 *@
        <MudTd DataLabel="时间" Class="dt-nowrap">@TriggerTimeText(context.Record.TriggerTime)</MudTd>
        <MudTd DataLabel="流水号" Class="dt-nowrap">@context.Record.SerialNo</MudTd>
        <MudTd DataLabel="托盘码" Class="dt-nowrap">@context.Record.PalletCode</MudTd>
        <MudTd DataLabel="工站">@context.Record.StationCode</MudTd>
        <MudTd DataLabel="型号">@RecipeLabel(context.Record.RecipeCode)</MudTd>
        <MudTd DataLabel="判定">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                     Color="@(context.Record.Judgement == Judgement.Ng ? Color.Error : context.Record.Judgement == Judgement.Ok ? Color.Success : Color.Default)">
                @DisplayLabels.JudgementText(context.Record.Judgement)
            </MudChip>
        </MudTd>
        <MudTd DataLabel="结果码">
            @* 单元格里已经有中文码名（如"PLC 读取失败"），tooltip 改讲这个概念本身：
               结果码与限值判定是两件事，否则现场会把读取失败当成工艺问题。 *@
            <MudTooltip Arrow="true" RootClass="dt-help-popover">
                <ChildContent>
                    @* 九个码里只有「采集成功」是成功，其余都是这一件没采成。全是默认色时
                       「PLC 读取失败」和「采集成功」长得一样，一屏扫下去找不出要处理的行。 *@
                    <span class="@ResultCodeClass(context.Record.ResultCode)">@ResultCodes.Describe(context.Record.ResultCode)</span>
                </ChildContent>
                <TooltipContent>
                    <HelpContent Topic="HelpTexts.ResultCode" />
                </TooltipContent>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="耗时" Class="dt-right dt-nowrap">@DurationFormat.Text(context.Record.DurationMs)</MudTd>
        <MudTd DataLabel="操作" Class="dt-right">
            @* 复制放在操作列而不是托盘码单元格里：整行可点进明细时，
               行中间的任何小控件都会抢走"点行"这一下，尤其在小屏上。
               外面这层 span 负责掐断冒泡 —— 行点击绑在 tr 上，
               不拦的话点复制会同时跳进明细。 *@
            <span @onclick:stopPropagation="true">
                <MudTooltip Text="复制托盘码">
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                   aria-label="复制托盘码"
                                   OnClick="@(() => CopyPallet(context.Record.PalletCode))" />
                </MudTooltip>
                <MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ChevronRight"
                           Href="@DetailUrl(context)">明细</MudButton>
            </span>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loading)
        {
            <MudText Typo="Typo.body2" Class="dt-muted py-3">正在查询…</MudText>
        }
        else
        {
            @* 默认区间是今天，最容易撞到空结果。只说一句「没有记录」等于把人晾在这，
               所以直接给出口：放宽区间（保留其它条件）与清空条件。
               放宽目标跟着当前跨度走 —— 已经查了 7 天还空，再给「放宽到近 7 天」是句废话。 *@
            <div class="dt-empty-hint">
                <MudText Typo="Typo.body2" Class="dt-muted">当前区间内没有符合条件的记录。</MudText>
                <MudStack Row="true" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap">
                    @if (WidenDays is { } days)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.DateRange" OnClick="@(() => WidenRangeAsync(days))">
                            放宽到近 @days 天
                        </MudButton>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="Reset">
                        清空条件
                    </MudButton>
                </MudStack>
            </div>
        }
    </NoRecordsContent>
</MudTable>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3 flex-wrap" Spacing="3">
    @* 加载期间禁用：光有 Load 的守卫会让用户点了没反应，禁掉才是说得通的反馈。 *@
    <MudPagination Count="_pages" Selected="_page" SelectedChanged="OnPage" BoundaryCount="1" MiddleCount="3"
                   Disabled="_loading" />
    <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Dense="true"
               Disabled="_loading" Class="dt-pagesize" Label="每页条数">
        @foreach (var size in PageSizes)
        {
            <MudSelectItem T="int" Value="size">@size 条/页</MudSelectItem>
        }
    </MudSelect>
    @* 总数在页头已经写了一遍（"共 N 条"），这里只留页码，别把同一句话摆两次。 *@
    <MudText Typo="Typo.caption" Class="dt-muted">
        第 @_page / @_pages 页
    </MudText>
</MudStack>
}

@code {
    private static readonly int[] PageSizes = [20, 50, 100];

    /// <summary>文本输入触发自动查询的防抖时长（毫秒）：等打字停下再发请求。</summary>
    private const int TextDebounceMs = 400;

    /// <summary>
    /// 结果码下拉的选项。不含 Trigger(1)：那是「触发待采集」的中间态，列表里不会停在这个码上。
    /// </summary>
    private static readonly short[] ResultCodeOptions =
    [
        ResultCodes.Success, ResultCodes.InvalidPalletCode,
        ResultCodes.DataValidationFailed, ResultCodes.DatabaseWriteFailed, ResultCodes.InternalError,
        ResultCodes.ProcessAbnormal, ResultCodes.FileSourceFailed, ResultCodes.ArchiveFailed
    ];

    private static string ResultCodeLabel(short code) => $"{code} · {ResultCodes.Describe(code)}";

    /// <summary>
    /// 结果码着色：9 个码里只有「采集成功」算成功，其余都是这一件没采成；
    /// Trigger 是「触发待采集」的中间态，用预警色与真失败区分开。
    /// </summary>
    private static string ResultCodeClass(short code) => code switch
    {
        ResultCodes.Success => "",
        ResultCodes.Trigger => "dt-text-warning",
        _ => "dt-text-error"
    };

    /// <summary>
    /// 时间列文本：区间落在同一天时只给时刻。跨天时日期是唯一能分行的时间信息，必须留全。
    /// </summary>
    private string TriggerTimeText(DateTime time)
        => SameDayRange ? time.ToString("HH:mm:ss") : time.ToString("yyyy-MM-dd HH:mm:ss");

    private bool SameDayRange
        => DateRangeFilter.StartOf(_from) == DateRangeFilter.StartOf(_to);

    /// <summary>当前跨度是多少天（含首尾）。</summary>
    private int RangeDays
        => (int)(DateRangeFilter.StartOf(_to) - DateRangeFilter.StartOf(_from)).TotalDays + 1;

    /// <summary>
    /// 空结果时该往宽放几天：已经 7 天就给 30 天，已经 ≥30 天就没有可放宽的余地（null = 不给这个出口）。
    /// </summary>
    private int? WidenDays => RangeDays switch
    {
        >= 30 => null,
        >= 7 => 30,
        _ => 7
    };

    private DateTime? _from = DateTime.Today;
    private DateTime? _to = DateTime.Today;
    private string? _pallet;
    private string? _serialNo;
    private int? _stationId;
    private Judgement? _judgement;
    /// <summary>结果码筛选；null = 不限。与「判定」是两个维度。</summary>
    private short? _resultCode;
    /// <summary>型号筛选：null/缺省=全部型号；<c>""</c>=未选型号；其它为精确匹配。</summary>
    private string? _recipeFilter;
    private IReadOnlyList<Station> _stations = [];
    private IReadOnlyList<CollectRecordListItem> _items = [];
    private int _total;
    private int _page = 1;
    private int _pages = 1;
    private int _pageSize = 20;
    private bool _loading;
    private bool _loadPending;
    private bool _exporting;
    private bool _canExport;
    private bool _traceMode;
    private bool _recordsLoaded;
    private CancellationTokenSource? _debounceCts;

    /// <summary>
    /// 导出 ⓘ 的动态补充行：把"这次会不会被截断"在点按钮前就说清，
    /// 而不是等导出完才在提示里看到"已导出前 N 条"。
    /// </summary>
    private string ExportHintExtra => _total > SystemDefaults.ExportRowLimit
        ? $"当前命中 {_total:N0} 条，已超过单次上限。"
        : $"当前命中 {_total:N0} 条。";

    /// <summary>支持 /query?pallet=XXX&days=30 直达，便于从明细页或工单跳转。</summary>
    [SupplyParameterFromQuery(Name = "pallet")]
    public string? PalletQuery { get; set; }

    [SupplyParameterFromQuery(Name = "serial")]
    public string? SerialQuery { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    [SupplyParameterFromQuery(Name = "trace")]
    public string? TraceQuery { get; set; }

    [SupplyParameterFromQuery(Name = "days")]
    public int? DaysQuery { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? FromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public string? ToQuery { get; set; }

    [SupplyParameterFromQuery(Name = "station")]
    public int? StationQuery { get; set; }

    [SupplyParameterFromQuery(Name = "judge")]
    public string? JudgeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "size")]
    public int? SizeQuery { get; set; }

    /// <summary>型号筛选：缺省=全部；<c>recipe=CODE</c> 精确匹配编码，<c>norecipe=1</c> 表示「未选型号」。</summary>
    [SupplyParameterFromQuery(Name = "recipe")]
    public string? RecipeQuery { get; set; }

    /// <summary>
    /// 「未选型号」用独立参数表达：与真实编码共用 recipe 时，
    /// 型号编码恰好叫 __EMPTY__ 就没法表达了。
    /// </summary>
    [SupplyParameterFromQuery(Name = "norecipe")]
    public int? NoRecipeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "result")]
    public int? ResultCodeQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _traceMode = string.Equals(ViewQuery, "trace", StringComparison.OrdinalIgnoreCase);
        var auth = await Auth.GetAuthenticationStateAsync();
        _canExport = auth.User.IsInRole(AppRoles.Administrator) || auth.User.IsInRole(AppRoles.Engineer);

        if (!string.IsNullOrWhiteSpace(PalletQuery))
        {
            _pallet = PalletQuery.Trim();
        }

        if (!string.IsNullOrWhiteSpace(SerialQuery))
        {
            _serialNo = SerialQuery.Trim();
        }

        if (DaysQuery is { } days && days > 0)
        {
            _from = DateTime.Today.AddDays(-(days - 1));
            _to = DateTime.Today;
        }

        // 显式起止日期覆盖 days，深链接里两者都给时以日期为准。
        if (DateTime.TryParse(FromQuery, out var from))
        {
            _from = from.Date;
        }

        if (DateTime.TryParse(ToQuery, out var to))
        {
            _to = to.Date;
        }

        if (StationQuery is { } station && station > 0)
        {
            _stationId = station;
        }

        if (Enum.TryParse<Judgement>(JudgeQuery, ignoreCase: true, out var judgement))
        {
            _judgement = judgement;
        }

        if (ResultCodeQuery is > 0 and <= short.MaxValue)
        {
            _resultCode = (short)ResultCodeQuery.Value;
        }

        if (SizeQuery is { } size && PageSizes.Contains(size))
        {
            _pageSize = size;
        }

        if (PageQuery is { } page && page > 0)
        {
            _page = page;
        }

        if (NoRecipeQuery == 1)
        {
            _recipeFilter = "";
        }
        else if (!string.IsNullOrWhiteSpace(RecipeQuery))
        {
            _recipeFilter = RecipeQuery.Trim();
        }

        // 工站下拉与型号选项都取自同一份配置快照：它按版本号在本电路内缓存，
        // 分头读一次工站图、再读一次型号，等于把同一批表读两遍（与报表页同一套做法）。
        _stations = (await Config.GetSnapshotAsync()).Stations;
        if (!_traceMode)
        {
            await Load();
            _recordsLoaded = true;
        }
    }

    private void ShowTraceability()
    {
        _traceMode = true;
        TraceQuery = null;
        Nav.NavigateTo("query?view=trace", replace: true);
    }

    private async Task ShowRecords()
    {
        _traceMode = false;
        TraceQuery = null;
        Nav.NavigateTo(CurrentListUrl(), replace: true);
        if (!_recordsLoaded)
        {
            await Load();
            _recordsLoaded = true;
        }
    }

    private Task OnTraceSearchCompleted(string? serialNo)
    {
        TraceQuery = string.IsNullOrWhiteSpace(serialNo) ? null : serialNo.Trim();
        var target = TraceQuery is null
            ? "query?view=trace"
            : $"query?view=trace&trace={Uri.EscapeDataString(TraceQuery)}";
        Nav.NavigateTo(target, replace: true);
        return Task.CompletedTask;
    }

    private CollectQueryRequest BuildRequest(int skip, int take) => new()
    {
        From = DateRangeFilter.StartOf(_from),
        To = DateRangeFilter.EndOfInclusive(_to),
        PalletCode = string.IsNullOrWhiteSpace(_pallet) ? null : _pallet.Trim(),
        SerialNo = string.IsNullOrWhiteSpace(_serialNo) ? null : _serialNo.Trim(),
        StationId = _stationId,
        RecipeCode = ToRecipeQueryArg(),
        Judgement = _judgement,
        ResultCode = _resultCode,
        Skip = skip,
        Take = take
    };

    private async Task OnSubmit() => await Search();

    // 筛选区统一语义：下拉即时重查，文本输入等打字停下再重查。
    // 之前改日期和改型号会立刻查、改其余字段却要点按钮，同一个筛选区里三种做法。
    private async Task OnPalletChanged(string? value)
    {
        _pallet = value;
        await DebouncedSearchAsync();
    }

    private async Task OnSerialChanged(string? value)
    {
        _serialNo = value;
        await DebouncedSearchAsync();
    }

    private async Task OnStationChanged(int? value)
    {
        _stationId = value;
        await Search();
    }

    private async Task OnJudgementChanged(Judgement? value)
    {
        _judgement = value;
        await Search();
    }

    private async Task OnResultCodeChanged(short? value)
    {
        _resultCode = value;
        await Search();
    }

    private async Task DebouncedSearchAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(TextDebounceMs, token);
            await Search();
        }
        catch (OperationCanceledException)
        {
            // 又敲了一个字符，等下一次停顿
        }
    }

    private async Task WidenRangeAsync(int days)
    {
        _from = DateTime.Today.AddDays(-(days - 1));
        _to = DateTime.Today;
        await Search();
    }

    private async Task Search()
    {
        if (DateRangeFilter.IsReversed(_from, _to))
        {
            _items = [];
            _total = 0;
            _pages = 1;
            Toast.Add(DateRangeFilter.ReversedRangeMessage, Severity.Warning);
            return;
        }

        _page = 1;
        await Load();
    }

    private async Task OnPage(int page)
    {
        _page = page;
        await Load();
    }

    private async Task OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
        await Load();
    }

    private async Task Load()
    {
        // 改日期即查询之后，并发窗口是这里开的：不加守卫时两个 Load 谁后完成谁覆盖，
        // 而先完成的那个已经把 _loading 关了，界面看着"好了"其实是被推翻的旧结果。
        // 但直接丢弃请求也不行：日期控件在加载中没禁用，"先改开始日期、再改结束日期"
        // 会丢掉后者——表格和地址栏停在旧条件上，输入框却显示新日期。
        // 所以把请求记下来，等这一轮结束立刻按最新条件再跑一次。
        if (_loading)
        {
            _loadPending = true;
            return;
        }

        _loading = true;
        try
        {
            do
            {
                _loadPending = false;
                await RefreshRecipeOptionsAsync();

                var result = await Store.QueryAsync(BuildRequest((_page - 1) * _pageSize, _pageSize));
                _items = result.Items;
                _total = result.Total;
                _pages = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));
                if (_page > _pages)
                {
                    _page = _pages;
                    result = await Store.QueryAsync(BuildRequest((_page - 1) * _pageSize, _pageSize));
                    _items = result.Items;
                }
            }
            while (_loadPending);
        }
        catch (Exception ex)
        {
            Toast.Add($"查询失败：{ex.Message}", Severity.Error);
            _items = [];
            _total = 0;
        }
        finally
        {
            _loading = false;
            SyncUrl();
        }
    }

    /// <summary>
    /// 把当前条件写回地址栏（默认值不写，保持 /query 干净）。
    /// 这样刷新和转发链接都还在同一批结果上，「重置」也不会留下 ?pallet=X 让条件幽灵回填。
    /// </summary>
    private void SyncUrl()
    {
        if (_traceMode)
        {
            return;
        }

        var target = CurrentListUrl();
        if (Nav.ToBaseRelativePath(Nav.Uri) == target)
        {
            return;
        }

        Nav.NavigateTo(target, replace: true);
    }

    /// <summary>当前列表页的相对地址，明细页的「返回查询」也用它，避免回去后条件全丢。</summary>
    private string CurrentListUrl()
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(_pallet))
        {
            parts.Add($"pallet={Uri.EscapeDataString(_pallet.Trim())}");
        }

        if (!string.IsNullOrWhiteSpace(_serialNo))
        {
            parts.Add($"serial={Uri.EscapeDataString(_serialNo.Trim())}");
        }

        if (_from is { } from && from.Date != DateTime.Today)
        {
            parts.Add($"from={from:yyyy-MM-dd}");
        }

        if (_to is { } to && to.Date != DateTime.Today)
        {
            parts.Add($"to={to:yyyy-MM-dd}");
        }

        if (_stationId is { } station)
        {
            parts.Add($"station={station}");
        }

        if (_judgement is { } judgement)
        {
            parts.Add($"judge={judgement}");
        }

        if (_resultCode is { } resultCode)
        {
            parts.Add($"result={resultCode}");
        }

        if (_recipeFilter is { Length: > 0 } recipe)
        {
            parts.Add($"recipe={Uri.EscapeDataString(recipe.Trim())}");
        }
        else if (_recipeFilter is not null)
        {
            // 未选型号：独立参数，别和真实编码挤同一个 recipe。
            parts.Add("norecipe=1");
        }

        if (_pageSize != 20)
        {
            parts.Add($"size={_pageSize}");
        }

        if (_page > 1)
        {
            parts.Add($"page={_page}");
        }

        return parts.Count == 0 ? "query" : $"query?{string.Join("&", parts)}";
    }

    private async Task Reset()
    {
        ClearFilterState();
        _pageSize = 20;
        Toast.Add("筛选条件已重置", Severity.Info);
        await Search();
    }

    /// <summary>把所有条件退回默认值。chips 的「清空全部」只清条件，不动每页条数。</summary>
    private void ClearFilterState()
    {
        _recipeFilter = null;
        _pallet = null;
        _serialNo = null;
        _stationId = null;
        _judgement = null;
        _resultCode = null;
        _from = DateTime.Today;
        _to = DateTime.Today;
    }

    private async Task ClearAllFiltersAsync()
    {
        ClearFilterState();
        await Search();
    }

    private async Task ClearOneAsync(Action clear)
    {
        // 输入框上的防抖可能还在等那 400ms，放着不管会在这一下之后又按旧值查一遍。
        _debounceCts?.Cancel();
        clear();
        await Search();
    }

    /// <summary>一个生效条件：显示文案 + 摘掉它的动作。</summary>
    private sealed record ActiveFilter(string Label, Action Clear);

    /// <summary>
    /// chips 行的数据。只列真正生效的条件，区间在等于默认（今天）时不列 ——
    /// 否则一进页面就挂着一个删掉也毫无变化的 chip。
    /// </summary>
    private IReadOnlyList<ActiveFilter> ActiveFilters
    {
        get
        {
            var list = new List<ActiveFilter>();

            if (!IsDefaultRange)
            {
                list.Add(new($"区间 {DateRangeFilter.Format(_from, _to)}",
                    () => { _from = DateTime.Today; _to = DateTime.Today; }));
            }

            if (!string.IsNullOrWhiteSpace(_pallet))
            {
                var pallet = _pallet!.Trim();
                list.Add(new($"托盘码 {pallet}", () => _pallet = null));
            }

            if (!string.IsNullOrWhiteSpace(_serialNo))
            {
                var serial = _serialNo!.Trim();
                list.Add(new($"流水号 {serial}", () => _serialNo = null));
            }

            if (_stationId is { } stationId)
            {
                list.Add(new($"工站 {StationCode(stationId)}", () => _stationId = null));
            }

            if (_judgement is { } judgement)
            {
                list.Add(new($"判定 {DisplayLabels.JudgementText(judgement)}", () => _judgement = null));
            }

            if (_resultCode is { } resultCode)
            {
                list.Add(new($"结果码 {ResultCodes.Describe(resultCode)}", () => _resultCode = null));
            }

            if (_recipeFilter is { } recipe)
            {
                list.Add(new($"型号 {RecipeLabel(recipe)}", () => _recipeFilter = null));
            }

            return list;
        }
    }

    private bool IsDefaultRange
        => DateRangeFilter.StartOf(_from) == DateTime.Today
           && DateRangeFilter.StartOf(_to) == DateTime.Today;

    /// <summary>工站 chip 上的编码；站被删掉时退成 Id，别显示一个空标签。</summary>
    private string StationCode(int id)
        => _stations.FirstOrDefault(s => s.Id == id)?.Code ?? id.ToString();

    /// <summary>
    /// 导出按钮的悬停说明。命中 0 条时按钮是禁用的，不写清楚就只是一次「点了没反应」。
    /// </summary>
    private string ExportTooltipText => _total == 0
        ? "当前没有命中记录，没有可导出的内容"
        : _total > SystemDefaults.ExportRowLimit
            ? $"当前命中 {_total:N0} 条，单次最多导出前 {SystemDefaults.ExportRowLimit:N0} 条"
            : $"导出当前命中的 {_total:N0} 条";

    private string DetailUrl(CollectRecordListItem item)
        => $"/query/{item.MonthKey}/{item.Record.Id}?back={Uri.EscapeDataString(CurrentListUrl())}";

    private void OnRowClicked(TableRowClickEventArgs<CollectRecordListItem> args)
    {
        if (args.Item is null)
        {
            return;
        }

        Nav.NavigateTo(DetailUrl(args.Item));
    }

    public void Dispose() => _debounceCts?.Dispose();

    private async Task CopyPallet(string palletCode)
    {
        if (string.IsNullOrWhiteSpace(palletCode))
        {
            return;
        }

        try
        {
            var copied = await Js.InvokeAsync<bool>("dtCopy", palletCode);
            // 浏览器拒绝剪贴板时不能照样报"已复制"：操作工拿着这条提示去贴单，结果是空码上机。
            Toast.Add(copied ? $"已复制 {palletCode}" : "复制失败：浏览器不允许写入剪贴板，请手动选中复制",
                copied ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            Toast.Add($"复制失败：{ex.Message}", Severity.Error);
        }
    }


    /// <summary>下拉选项：编码 + 显示文案（文案同时是取值的 ToString，见 <see cref="RecipeFilterValue"/>）。</summary>
    private sealed record RecipeFilterOption(string Code, string Label);

    private IReadOnlyList<RecipeFilterOption> _recipeOptions = [];
    private Dictionary<string, string> _recipeNames = new(StringComparer.Ordinal);
    private DateTime? _recipeOptionsFrom;
    private DateTime? _recipeOptionsTo;

    /// <summary>
    /// 筛选状态 → 下拉取值：null=全部、""=未选型号、其它=编码。
    /// 文案与选项里显示的必须是同一个（都走 <see cref="FormatRecipeOption"/>），
    /// 否则预渲染那一帧画出来的文案会和交互后不一致。
    /// </summary>
    private RecipeFilterValue ToOptionValue(string? recipe)
        => recipe switch
        {
            null => RecipeFilterValue.All,
            "" => RecipeFilterValue.NoRecipe,
            var code => new RecipeFilterValue(code, FormatRecipeOption(code))
        };

    /// <summary>发给查询请求的型号参数：null=不限、空串=未选型号、其它=精确匹配。</summary>
    private string? ToRecipeQueryArg()
        => _recipeFilter is { Length: > 0 } code ? code.Trim() : _recipeFilter;

    private async Task OnRecipeFilterChanged(RecipeFilterValue? value)
    {
        _recipeFilter = value?.Recipe;
        _page = 1;
        await Load();
    }

    /// <summary>
    /// 选项只在时间区间变化时重建：翻页、改每页条数、切换型号都复用它，
    /// 否则每翻一页都要重扫一遍区间内的型号编码。
    /// </summary>
    private async Task RefreshRecipeOptionsAsync()
    {
        var from = _from ?? DateTime.Today;
        var to = _to ?? DateTime.Today;
        if (_recipeOptionsFrom == from && _recipeOptionsTo == to)
        {
            return;
        }

        // 区间内出现过的编码（含空）+ 配置里已知型号，避免改码后旧码消失
        var fromRecords = await Store.ListRecipeCodesAsync(from, to);
        // 走快照而不是再查一次型号：进页面时已经读过，这里只是命中缓存。
        var known = (await Config.GetSnapshotAsync()).Recipes;
        _recipeNames = known
            .GroupBy(r => r.Code, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.First().Name ?? "", StringComparer.Ordinal);

        var codes = new HashSet<string>(StringComparer.Ordinal);
        foreach (var c in fromRecords)
        {
            if (!string.IsNullOrEmpty(c))
                codes.Add(c);
        }
        foreach (var r in known)
        {
            if (!string.IsNullOrEmpty(r.Code))
                codes.Add(r.Code);
        }

        // 当前筛选项若不在集合里也保留（例如刚改码后仍想看旧码）
        if (_recipeFilter is { Length: > 0 } current && !codes.Contains(current))
        {
            codes.Add(current);
        }

        _recipeOptions = codes
            .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
            .Select(c => new RecipeFilterOption(c, FormatRecipeOption(c)))
            .ToList();
        _recipeOptionsFrom = from;
        _recipeOptionsTo = to;
    }

    private string FormatRecipeOption(string code)
    {
        if (_recipeNames.TryGetValue(code, out var name) && !string.IsNullOrWhiteSpace(name))
            return $"{code} · {name}";
        return $"旧编码 {code}";
    }

    private static string RecipeLabel(string? code)
        => string.IsNullOrEmpty(code) ? "未选型号" : code;

    private async Task ExportCsv()
    {
        if (_exporting)
        {
            return;
        }

        if (!_canExport)
        {
            Toast.Add("当前角色无权导出查询结果（需要管理员或工程师）", Severity.Warning);
            return;
        }

        _exporting = true;
        try
        {
            var result = await Store.QueryAsync(BuildRequest(0, SystemDefaults.ExportRowLimit));
            if (result.Items.Count == 0)
            {
                Toast.Add("没有可导出的记录", Severity.Warning);
                return;
            }

            @* 列与表格对齐：表格有耗时列，导出却没有 —— 刚修完 DurationMs 落库，
               导出是唯一一个把节拍带不出去的出口。表头带单位，因为 CSV 里给的是毫秒整数。 *@
            var csv = CsvExporter.Build(
                ["触发时间", "流水号", "托盘码", "工站", "型号", "判定", "结果码", "结果说明", "耗时(ms)"],
                result.Items.Select(item => new[]
                {
                    item.Record.TriggerTime.ToString("yyyy-MM-dd HH:mm:ss"),
                    item.Record.SerialNo ?? "",
                    item.Record.PalletCode ?? "",
                    item.Record.StationCode ?? "",
                    RecipeLabel(item.Record.RecipeCode),
                    DisplayLabels.JudgementTextLong(item.Record.Judgement),
                    item.Record.ResultCode.ToString(),
                    ResultCodes.Describe(item.Record.ResultCode),
                    DurationMsText(item.Record.DurationMs)
                })
            );

            await Js.InvokeVoidAsync("dtDownload", CsvExporter.FileName("datatrace_query"), CsvExporter.ToBase64(csv));
            var message = result.Total > result.Items.Count
                ? $"共命中 {result.Total} 条，已导出前 {result.Items.Count} 条"
                : $"已导出 {result.Items.Count} 条";
            try
            {
                await WriteExportAuditAsync(result.Items.Count, result.Total);
                Toast.Add(message, result.Total > result.Items.Count ? Severity.Warning : Severity.Success);
            }
            catch (Exception ex)
            {
                // 文件已经下载完了：审计写库失败不能报成"导出失败"，现场会以为没导出去而重导。
                Toast.Add($"{message}，但审计记录写入失败：{ex.Message}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Toast.Add($"导出失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    /// <summary>
    /// 导出里的耗时：给毫秒整数而不是表格里的 "412 ms"，进 Excel 才能直接求和、求均值、做透视。
    /// 没采到耗时的老记录（DurationMs 落库之前的历史）留空而不是写 0 —— 0 会被算进均值里。
    /// </summary>
    private static string DurationMsText(int? durationMs)
        => durationMs is > 0 ? durationMs.Value.ToString() : "";

    private async Task WriteExportAuditAsync(int exported, int total)
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        var user = auth.User.Identity?.Name ?? "";
        var recipe = _recipeFilter switch
        {
            null => "全部",
            "" => "未选型号",
            var code => code.Trim()
        };
        // 键放"导的是哪个区间"，过滤条件与条数放变更列：与明细页导出的写法一致，
        // 日志页的"键"列不该塞进一长串条件。审计日志的键/明细字段唯一语义见 Logs.razor。
        var key = $"{(_from ?? DateTime.Today):yyyy-MM-dd}~{(_to ?? DateTime.Today):yyyy-MM-dd}";
        var summary =
            $"pallet={_pallet?.Trim() ?? ""};serial={_serialNo?.Trim() ?? ""};" +
            $"station={_stationId?.ToString() ?? ""};judge={_judgement?.ToString() ?? ""};" +
            $"recipe={recipe};exported={exported};total={total}";
        await Audit.WriteAsync(user, "Export", "Query", key, null, summary);
    }

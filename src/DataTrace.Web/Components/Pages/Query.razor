    [SupplyParameterFromQuery(Name = "scan")]
    public int? ScanQuery { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    [SupplyParameterFromQuery(Name = "trace")]
    public string? TraceQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sessionMonth")]
    public string? TraceMonthQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sessionId")]
    public long? TraceSessionQuery { get; set; }

    [SupplyParameterFromQuery(Name = "days")]
    public int? DaysQuery { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? FromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public string? ToQuery { get; set; }

    [SupplyParameterFromQuery(Name = "station")]
    public int? StationQuery { get; set; }
    [SupplyParameterFromQuery(Name = "stations")]
    public int[]? StationIdsQuery { get; set; }

    [SupplyParameterFromQuery(Name = "durMin")]
    public int? DurationMinQuery { get; set; }

    [SupplyParameterFromQuery(Name = "durMax")]
    public int? DurationMaxQuery { get; set; }

    [SupplyParameterFromQuery(Name = "ool")]
    public int? OolQuery { get; set; }

    [SupplyParameterFromQuery(Name = "oolTag")]
    public string? OolTagQuery { get; set; }

    [SupplyParameterFromQuery(Name = "warn")]
    public int? WarnQuery { get; set; }

    [SupplyParameterFromQuery(Name = "warnTag")]
    public string? WarnTagQuery { get; set; }

    [SupplyParameterFromQuery(Name = "wo")]
    public int? WorkOrderQuery { get; set; }

    [SupplyParameterFromQuery(Name = "sessionStatus")]
    public string? SessionStatusQuery { get; set; }

    [SupplyParameterFromQuery(Name = "judge")]
    public string? JudgeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [SupplyParameterFromQuery(Name = "size")]
    public int? SizeQuery { get; set; }

    /// <summary>型号筛选：缺省=全部；<c>recipe=CODE</c> 精确匹配编码，<c>norecipe=1</c> 表示「未选型号」。</summary>
    [SupplyParameterFromQuery(Name = "recipe")]
    public string? RecipeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "alias")]
    public string[]? RecipeAliasesQuery { get; set; }

    /// <summary>
    /// 「未选型号」用独立参数表达：与真实编码共用 recipe 时，
    /// 型号编码恰好叫 __EMPTY__ 就没法表达了。
    /// </summary>
    [SupplyParameterFromQuery(Name = "norecipe")]
    public int? NoRecipeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "result")]
    public int? ResultCodeQuery { get; set; }

    /// <summary>排序列：<c>sort=pallet</c> 这样的短名。缺省（不写）= 触发时间。</summary>
    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortQuery { get; set; }

    /// <summary>只写升序（<c>dir=asc</c>）：缺省即降序，绝大多数视图都按降序看。</summary>
    [SupplyParameterFromQuery(Name = "dir")]
    public string? DirQuery { get; set; }

    /// <summary>排序列的地址栏短名 ↔ 枚举。别名表是唯一真相，写地址栏与读地址栏都走它。</summary>
    private static readonly (string Key, CollectSortField Field)[] SortKeys = RecordListNavigation.SortKeys;

    protected override async Task OnInitializedAsync()
    {
        // 地址栏的 scan 会被结果刷新时的 SyncUrl 去掉，先记下来。
        _focusSerialAfterLoad = ScanQuery == 1;
        _viewMode = string.Equals(ViewQuery, "trace", StringComparison.OrdinalIgnoreCase)
            ? QueryViewMode.Trace
            : string.Equals(ViewQuery, "sessions", StringComparison.OrdinalIgnoreCase)
                ? QueryViewMode.Sessions
                : QueryViewMode.Records;
        var auth = await Auth.GetAuthenticationStateAsync();
        _canExport = auth.User.IsInRole(AppRoles.Administrator) || auth.User.IsInRole(AppRoles.Engineer);

        if (!string.IsNullOrWhiteSpace(PalletQuery))
        {
            _pallet = PalletQuery.Trim();
        }

        if (!string.IsNullOrWhiteSpace(SerialQuery))
        {
            _serialNo = SerialQuery.Trim();
        }

        if (DaysQuery is { } days && days > 0)
        {
            _from = DateTime.Today.AddDays(-(days - 1));
            _to = DateTime.Today;
        }

        // 显式起止日期覆盖 days，深链接里两者都给时以日期为准。
        if (DateTime.TryParse(FromQuery, out var from))
        {
            _from = from;
        }

        if (DateTime.TryParse(ToQuery, out var to))
        {
            _to = to;
        }

        if (StationIdsQuery is { Length: > 0 } stations)
        {
            _stationIds = stations.Where(id => id > 0).Distinct().ToHashSet();
        }
        else if (StationQuery is { } station && station > 0)
        {
            _stationIds = new HashSet<int> { station };
        }

        if (DurationMinQuery is >= 0) _durationMinMs = DurationMinQuery;
        if (DurationMaxQuery is >= 0) _durationMaxMs = DurationMaxQuery;
        if (OolQuery == 1) _onlyOutOfLimit = true;
        if (!string.IsNullOrWhiteSpace(OolTagQuery)) _outOfLimitTag = OolTagQuery.Trim();
        if (WarnQuery == 1) _onlyWarning = true;
        if (!string.IsNullOrWhiteSpace(WarnTagQuery)) _warningTag = WarnTagQuery.Trim();
        if (WorkOrderQuery is > 0) _workOrderId = WorkOrderQuery;
        if (Enum.TryParse<SessionStatus>(SessionStatusQuery, true, out var sessionStatus))
        {
            _sessionStatus = sessionStatus;
        }

        if (Enum.TryParse<Judgement>(JudgeQuery, ignoreCase: true, out var judgement))
        {
            _judgement = judgement;
        }

        if (ResultCodeQuery is > 0 and <= short.MaxValue)
        {
            _resultCode = (short)ResultCodeQuery.Value;
        }

        if (SizeQuery is { } size && PageSizes.Contains(size))
        {
            _pageSize = size;
        }

        if (PageQuery is { } page && page > 0)
        {
            _page = page;
        }

        // 排序：地址栏只表达"非默认"的部分，缺省即时间倒序。
        _sortBy = ParseSortField(SortQuery);
        if (string.Equals(DirQuery, "asc", StringComparison.OrdinalIgnoreCase))
        {
            _sortDesc = false;
        }

        if (NoRecipeQuery == 1)
        {
            _recipeFilter = "";
        }
        else if (!string.IsNullOrWhiteSpace(RecipeQuery))
        {
            _recipeFilter = RecipeQuery.Trim();
            _recipeAliases = (RecipeAliasesQuery ?? [])
                .Where(alias => !string.IsNullOrWhiteSpace(alias))
                .Select(alias => alias.Trim())
                .Where(alias => !string.Equals(alias, _recipeFilter, StringComparison.Ordinal))
                .Distinct(StringComparer.Ordinal)
                .ToArray();
        }

        // 工站下拉与型号选项都取自同一份配置快照：它按版本号在本电路内缓存，
        // 分头读一次工站图、再读一次型号，等于把同一批表读两遍（与报表页同一套做法）。
        var snapshot = await Config.GetSnapshotAsync();
        _stations = snapshot.Stations;
        _shiftSettings = snapshot.Settings;
        try
        {
            _workOrders = (await Config.GetWorkOrdersAsync())
                .OrderByDescending(o => o.IsCurrent)
                .ThenByDescending(o => o.CreatedAt)
                .ToList();
            if (_workOrderId is { } woId && _workOrders.All(o => o.Id != woId))
            {
                _workOrderId = null;
            }
            else if (_workOrderId is { } selected)
            {
                ApplyWorkOrderFilters(selected, toast: false);
            }
        }
        catch
        {
            _workOrders = [];
        }

        if (_viewMode != QueryViewMode.Trace)
        {
            await Load();
        }
    }

    private void ShowTraceability()
    {
        _viewMode = QueryViewMode.Trace;
        TraceQuery = null;
        Nav.NavigateTo("query?view=trace", replace: true);

    private string ExportHintExtra => _total > SystemDefaults.ExportRowLimit
        ? $"当前命中 {_total:N0} 条，已超过单次上限；请用「按月分包导出」或缩小区间。"
        : $"当前命中 {_total:N0} 条。";

    /// <summary>支持 /query?pallet=XXX&days=30 直达，便于从明细页或工单跳转。</summary>
    [SupplyParameterFromQuery(Name = "pallet")]

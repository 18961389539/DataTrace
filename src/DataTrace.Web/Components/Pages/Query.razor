@code {
    private static readonly int[] PageSizes = [20, 50, 100];

    /// <summary>文本输入触发自动查询的防抖时长（毫秒）：等打字停下再发请求。</summary>
    private const int TextDebounceMs = 400;

    /// <summary>
    /// 结果码下拉的选项。不含 Trigger(1)：那是「触发待采集」的中间态，列表里不会停在这个码上。
    /// </summary>
    private static readonly short[] ResultCodeOptions =
    [
        ResultCodes.Success, ResultCodes.QualityRejected, ResultCodes.InvalidPalletCode,
        ResultCodes.DataValidationFailed, ResultCodes.DatabaseWriteFailed, ResultCodes.InternalError,
        ResultCodes.ProcessAbnormal, ResultCodes.FileSourceFailed, ResultCodes.ArchiveFailed
    ];

    private static string ResultCodeLabel(short code) => $"{code} · {ResultCodes.Describe(code)}";

    /// <summary>
    /// 结果码着色：2 是放行；11 质量不合格和 3–10 采集故障都标红。
    /// Trigger 是「触发待采集」的中间态，用预警色与真失败区分开。
    /// </summary>
    private static string ResultCodeClass(short code) => code switch
    {
        ResultCodes.Success => "",
        ResultCodes.Trigger => "dt-text-warning",
        _ => "dt-text-error"
    };

    /// <summary>
    /// 时间列文本：区间落在同一天时只给时刻。跨天时日期是唯一能分行的时间信息，必须留全。
    /// </summary>
    private string TriggerTimeText(DateTime time)
        => SameDayRange ? time.ToString("HH:mm:ss") : time.ToString("yyyy-MM-dd HH:mm:ss");

    private bool SameDayRange
        => DateRangeFilter.StartOf(_from) == DateRangeFilter.StartOf(_to);

    /// <summary>当前跨度是多少天（含首尾）。</summary>
    private int RangeDays
        => (int)(DateRangeFilter.StartOf(_to) - DateRangeFilter.StartOf(_from)).TotalDays + 1;

    /// <summary>
    /// 空结果时该往宽放几天：已经 7 天就给 30 天，已经 ≥30 天就没有可放宽的余地（null = 不给这个出口）。
    /// </summary>
    private int? WidenDays => RangeDays switch
    {
        >= 30 => null,
        >= 7 => 30,
        _ => 7
    };

    private DateTime? _from = DateTime.Today;
    private DateTime? _to = DateTime.Today;
    private string? _pallet;
    private string? _serialNo;
    private HashSet<int> _stationIds = new();
    private Judgement? _judgement;
    private int? _durationMinMs;
    private int? _durationMaxMs;
    private bool _onlyOutOfLimit;
    private string? _outOfLimitTag;
    private SessionStatus? _sessionStatus;
    private IReadOnlyList<SessionListItem> _sessionItems = [];
    private int _sessionTotal;
    private QueryViewMode _viewMode = QueryViewMode.Records;
    /// <summary>结果码筛选；null = 不限。与「判定」是两个维度。</summary>
    private short? _resultCode;
    /// <summary>型号筛选：null/缺省=全部型号；<c>""</c>=未选型号；其它为精确匹配。</summary>
    private string? _recipeFilter;
    private IReadOnlyList<string> _recipeAliases = [];
    private int? _workOrderId;
    private IReadOnlyList<WorkOrder> _workOrders = [];
    private bool _onlyWarning;
    private string? _warningTag;
    private IReadOnlyList<Station> _stations = [];
    private SystemSettings _shiftSettings = new();
    private IReadOnlyList<CollectRecordListItem> _items = [];
    private int _total;
    private int _page = 1;
    private int _pages = 1;
    private int _pageSize = 20;
    private readonly Dictionary<int, string?> _pageCursors = new() { [1] = null };
    private bool _loading;
    private bool _loadPending;
    private int _queryVersion;
    private int _displayedVersion;
    private bool _restoreScroll = true;
    /// <summary>
    /// 查询本身失败（不是"查到了 0 条"）。清空结果后若仍走空态文案，
    /// 现场会以为区间里真没数据，转头去放宽一个本来正确的区间。
    /// </summary>
    private bool _loadFailed;
    private bool _exporting;
    private bool _canExport;
    private bool _advancedFiltersExpanded;
    private bool _focusSerialAfterLoad;
    private CancellationTokenSource? _debounceCts;

    /// <summary>当前排序列与方向。默认最近的在前，与默认视图一致。</summary>
    private CollectSortField _sortBy = CollectSortField.TriggerTime;
    private bool _sortDesc = true;

    /// <summary>
    /// 导出 ⓘ 的动态补充行：把"这次会不会被截断"在点按钮前就说清，

    /// <summary>
    /// 采集记录没有工单外键：用型号 + 生产时间窗对齐看板估算口径。
    /// </summary>
    private bool ApplyWorkOrderFilters(int workOrderId, bool toast)
    {
        var order = _workOrders.FirstOrDefault(o => o.Id == workOrderId);
        if (order is null) return false;

        if (order.Recipe is { Code.Length: > 0 } recipe)
        {
            _recipeFilter = recipe.Code;
            _recipeAliases = CurveRecipeScope.AllowedCodes(recipe.Code, recipe.PreviousCodes)
                .Where(code => !string.Equals(code, recipe.Code, StringComparison.Ordinal))
                .ToArray();
        }
        else if (!string.IsNullOrWhiteSpace(order.Model))
        {
            var matched = _recipeOptions.FirstOrDefault(opt =>
                string.Equals(opt.Label, order.Model, StringComparison.OrdinalIgnoreCase)
                || opt.Label.Contains(order.Model!, StringComparison.OrdinalIgnoreCase));
            if (matched is not null)
            {
                _recipeFilter = matched.Code;
                _recipeAliases = [];
            }
        }

        var start = order.CurrentSince ?? order.StartDate?.Date;
        var end = order.EndDate?.Date;
        if (start is { } s)
        {
            _from = s.Date;
        }

        if (end is { } e)
        {
            _to = e.Date > DateTime.Today ? DateTime.Today : e.Date;
        }
        else if (start is not null)
        {
            _to = DateTime.Today;
        }

        if (_to < _from)
        {
            _to = _from;
        }

        if (toast)
        {
            Toast.Add($"已按工单 {order.Code} 套用型号与时间窗（估算，非精确绑定）", Severity.Info);
        }

        return true;
    }


    /// <summary>
    /// 导出里的耗时：给毫秒整数而不是表格里的 "412 ms"，进 Excel 才能直接求和、求均值、做透视。
    /// 没采到耗时的老记录（DurationMs 落库之前的历史）留空而不是写 0 —— 0 会被算进均值里。
    /// </summary>
    private static string DurationMsText(int? durationMs)
        => durationMs is > 0 ? durationMs.Value.ToString() : "";

    private string ExportFilterSummary()
    {
        var recipe = _recipeFilter switch
        {
            null => "全部",
            "" => "未选型号",
            var code => code.Trim()
        };
        return $"pallet={_pallet?.Trim() ?? ""};serial={_serialNo?.Trim() ?? ""};" +
               $"station={string.Join(",", _stationIds.OrderBy(x => x))};judge={_judgement?.ToString() ?? ""};" +
               $"result={_resultCode?.ToString() ?? ""};recipe={recipe};aliases={string.Join(",", _recipeAliases)};" +
               $"warnTag={_warningTag ?? ""};onlyWarn={_onlyWarning};wo={_workOrderId?.ToString() ?? ""};" +
               $"sort={SortKeyOf(_sortBy)};dir={(_sortDesc ? "desc" : "asc")}";
    }

    private async Task WriteExportAuditAsync(int exported, int total, string key, string filters)
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        var user = auth.User.Identity?.Name ?? "";
        // 键放"导的是哪个区间"，过滤条件与条数放变更列：与明细页导出的写法一致，
        // 日志页的"键"列不该塞进一长串条件。审计日志的键/明细字段唯一语义见 Logs.razor。
        await Audit.WriteAsync(user, "Export", "Query", key, null, $"{filters};exported={exported};total={total}");
    }

    private string StationMultiLabel(List<string> selectedValues)
    {
        if (selectedValues is null || selectedValues.Count == 0) return "全部工站";
        if (selectedValues.Count == 1 && int.TryParse(selectedValues[0], out var one))
            return StationCode(one);
        return $"已选 {selectedValues.Count} 个工站";
    }

    private string StationFilterAuditLabel()
        => _stationIds.Count == 0 ? "全部工站"
            : _stationIds.Count == 1 ? StationCode(_stationIds.First())
            : string.Join(",", _stationIds.OrderBy(x => x).Select(StationCode));

    private string StationFilterFileLabel()
        => _stationIds.Count == 0 ? "all-stations"
            : _stationIds.Count == 1 ? StationCode(_stationIds.First())
            : $"stations-{_stationIds.Count}";

    private string CurrentSessionListUrl()
    {
        var parts = new List<string> { "view=sessions" };
        if (!string.IsNullOrWhiteSpace(_pallet))
            parts.Add($"pallet={Uri.EscapeDataString(_pallet.Trim())}");
        if (!string.IsNullOrWhiteSpace(_serialNo))
            parts.Add($"serial={Uri.EscapeDataString(_serialNo.Trim())}");
        if (_from is { } from && from != DateTime.Today)
            parts.Add($"from={DateRangeFilter.UrlValue(from)}");
        if (_to is { } to && to != DateTime.Today)
            parts.Add($"to={DateRangeFilter.UrlValue(to)}");
        if (_sessionStatus is { } status)
            parts.Add($"sessionStatus={status}");
        if (_judgement is { } judgement)
            parts.Add($"judge={judgement}");
        if (_recipeFilter is { Length: > 0 } recipe)
        {
            parts.Add($"recipe={Uri.EscapeDataString(recipe.Trim())}");
            parts.AddRange(_recipeAliases.Select(alias => $"alias={Uri.EscapeDataString(alias)}"));
        }
        else if (_recipeFilter is not null)
        {
            parts.Add("norecipe=1");
        }
        if (_pageSize != 20) parts.Add($"size={_pageSize}");
        if (_page > 1) parts.Add($"page={_page}");
        return $"query?{string.Join("&", parts)}";
    }



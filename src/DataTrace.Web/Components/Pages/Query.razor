@page "/query"
@attribute [Authorize]
@using DataTrace.Application.Configuration
@using DataTrace.Application.Runtime
@using DataTrace.Domain.Constants
@using DataTrace.Domain.Entities
@using DataTrace.Domain.Evaluation
@using Microsoft.AspNetCore.Components.Authorization
@inject IRuntimeStore Store
@inject IConfigRepository Config
@inject IAuditLogger Audit
@inject AuthenticationStateProvider Auth
@inject DtToast Toast
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject IDialogService DialogService
@implements IDisposable

<PageHeader Title="数据查询" HelpRoute="query" Busy="_loading">
    <Actions>
        @if (_viewMode == QueryViewMode.Trace)
        {
            <MudText Typo="Typo.caption" Class="dt-muted">按完整流水号跨月追溯</MudText>
        }
        else if (_viewMode == QueryViewMode.Sessions)
        {
            <MudText Typo="Typo.caption" Class="dt-muted">
                区间 @DateRangeFilter.Format(_from, _to)　共 @_sessionTotal 件会话
            </MudText>
            <InfoHint Topic="HelpTexts.RangeScope" />
        }
        else
        {
            <MudText Typo="Typo.caption" Class="dt-muted">
                区间 @DateRangeFilter.Format(_from, _to)　共 @_total 条
            </MudText>
            <InfoHint Topic="HelpTexts.RangeScope" />
        }
    </Actions>
</PageHeader>

<MudStack Row="true" Spacing="1" Class="mb-3 dt-view-toggle" role="group" aria-label="查询模式">
    <MudButton Size="Size.Small" Variant="@(_viewMode == QueryViewMode.Records ? Variant.Filled : Variant.Outlined)"
               Color="Color.Primary" StartIcon="@Icons.Material.Filled.TableRows"
               aria-pressed="@(_viewMode == QueryViewMode.Records ? "true" : "false")"
               OnClick="ShowRecords">
        记录查询
    </MudButton>
    <MudButton Size="Size.Small" Variant="@(_viewMode == QueryViewMode.Sessions ? Variant.Filled : Variant.Outlined)"
               Color="Color.Primary" StartIcon="@Icons.Material.Filled.ViewTimeline"
               aria-pressed="@(_viewMode == QueryViewMode.Sessions ? "true" : "false")"
               OnClick="ShowSessions">
        会话查询
    </MudButton>
    <MudButton Size="Size.Small" Variant="@(_viewMode == QueryViewMode.Trace ? Variant.Filled : Variant.Outlined)"
               Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountTree"
               aria-pressed="@(_viewMode == QueryViewMode.Trace ? "true" : "false")"
               OnClick="ShowTraceability">
        产品追溯
    </MudButton>
</MudStack>

@if (_viewMode == QueryViewMode.Trace)
{
    <ProductTraceabilityPanel InitialSerialNo="@TraceQuery"
                              InitialMonthKey="@TraceMonthQuery"
                              InitialSessionId="@TraceSessionQuery"
                              OnSearchCompleted="OnTraceSearchCompleted" />
}
else if (_viewMode == QueryViewMode.Sessions)
{
<div class="dt-query-workspace">
    <MudPaper Class="dt-filter-card mb-3" Elevation="0" Outlined="true">
        <form class="dt-query-form" @onsubmit="OnSubmit" @onsubmit:preventDefault="true">
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField T="string" Value="_serialNo" ValueChanged="OnSerialChanged" Label="流水号"
                                  Immediate="true" Disabled="_exporting" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField T="string" Value="_pallet" ValueChanged="OnPalletChanged" Label="托盘码"
                                  Immediate="true" Disabled="_exporting" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="SessionStatus?" Value="_sessionStatus" ValueChanged="OnSessionStatusChanged"
                               Label="会话状态" Clearable="true" Disabled="_exporting">
                        <MudSelectItem T="SessionStatus?" Value="SessionStatus.Open">进行中</MudSelectItem>
                        <MudSelectItem T="SessionStatus?" Value="SessionStatus.Closed">已闭环</MudSelectItem>
                        <MudSelectItem T="SessionStatus?" Value="SessionStatus.Abnormal">异常中断</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="Judgement?" Value="_judgement" ValueChanged="OnJudgementChanged"
                               Label="会话判定" Clearable="true" Disabled="_exporting">
                        <MudSelectItem T="Judgement?" Value="Judgement.Ok">OK（合格）</MudSelectItem>
                        <MudSelectItem T="Judgement?" Value="Judgement.Ng">NG（不合格）</MudSelectItem>
                        <MudSelectItem T="Judgement?" Value="Judgement.None">未判定</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <div class="dt-query-date-range mt-2">
                <DateRangeFilter @bind-From="_from" @bind-To="_to" OnRangeChanged="Search"
                                 IncludeShifts="true" ShiftStartHour="_shiftSettings.ShiftStartHour"
                                 ShiftLengthHours="_shiftSettings.ShiftLengthHours" Disabled="_exporting" />
            </div>
            <MudStack Row="true" Spacing="2" Class="mt-2 mb-1 flex-wrap">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search" Disabled="_exporting">
                    @(_loading ? "查询中…" : "查询")
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="Reset" Disabled="_exporting"
                           StartIcon="@Icons.Material.Filled.RestartAlt">重置</MudButton>
                <MudChip T="string" Size="Size.Small"
                         Variant="@(_sessionStatus == SessionStatus.Open ? Variant.Filled : Variant.Outlined)"
                         Color="Color.Info" Disabled="_exporting"
                         OnClick="ApplyOpenSessionsQuick">仅进行中</MudChip>
                <MudChip T="string" Size="Size.Small"
                         Variant="@(_sessionStatus == SessionStatus.Abnormal ? Variant.Filled : Variant.Outlined)"
                         Color="Color.Error" Disabled="_exporting"
                         OnClick="ApplyAbnormalSessionsQuick">仅异常中断</MudChip>
            </MudStack>
        </form>
    </MudPaper>

    @if (ActiveFilters.Count > 0)
    {
        <div class="dt-filter-chips mb-3">
            <MudText Typo="Typo.caption" Class="dt-muted">当前条件</MudText>
            @foreach (var filter in ActiveFilters)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                    @filter.Label
                    <MudIconButton Size="Size.Small" Class="ml-1" Icon="@Icons.Material.Filled.Close"
                                   aria-label="@($"移除筛选条件：{filter.Label}")"
                                   Disabled="_exporting"
                                   OnClick="@(() => ClearOneAsync(filter.Clear))" />
                </MudChip>
            }
            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_exporting"
                   OnClick="ClearAllFiltersAsync">清空全部</MudButton>
        </div>
    }

    <h2 class="dt-query-results-heading">会话结果</h2>
    <MudTable Items="_sessionItems" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
              Loading="@(_loading || _exporting)" LoadingProgressColor="Color.Info"
              FixedHeader="true" Height="var(--dt-grid-height)"
              Class="dt-clickable dt-query-results"
              OnRowClick="@((TableRowClickEventArgs<SessionListItem> args) => OnSessionRowClicked(args))">
        <HeaderContent>
            <MudTh>开始时间</MudTh>
            <MudTh>结束时间</MudTh>
            <MudTh>流水号</MudTh>
            <MudTh>托盘码</MudTh>
            <MudTh>型号</MudTh>
            <MudTh>状态</MudTh>
            <MudTh>判定</MudTh>
            <MudTh Class="dt-right">站数</MudTh>
            <MudTh>首因工站</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="开始时间" Class="dt-nowrap">@context.Session.StartTime.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
            <MudTd DataLabel="结束时间" Class="dt-nowrap">@(context.Session.EndTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</MudTd>
            <MudTd DataLabel="流水号">@context.Session.SerialNo</MudTd>
            <MudTd DataLabel="托盘码">@context.Session.PalletCode</MudTd>
            <MudTd DataLabel="型号">@RecipeLabel(context.RecipeCode)</MudTd>
            <MudTd DataLabel="状态">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                         Color="@(context.Session.Status == SessionStatus.Abnormal ? Color.Error : context.Session.Status == SessionStatus.Open ? Color.Info : Color.Success)">
                    @DisplayLabels.SessionStatusText(context.Session.Status)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="判定">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                         Color="@(context.Session.Judgement == Judgement.Ng ? Color.Error : context.Session.Judgement == Judgement.Ok ? Color.Success : Color.Default)">
                    @DisplayLabels.JudgementText(context.Session.Judgement)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="站数" Class="dt-num">@context.RecordCount</MudTd>
            <MudTd DataLabel="首因工站">@(context.Session.FirstNgStationCode ?? "—")</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ChevronRight"
                           OnClick="@(() => OpenSessionTrace(context))">履历</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="dt-muted py-4">当前条件下没有会话。</MudText>
        </NoRecordsContent>
    </MudTable>

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-2 flex-wrap">
        <MudText Typo="Typo.caption" Class="dt-muted">共 @_sessionTotal.ToString("N0") 件 · 第 @_page / @_pages 页</MudText>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Dense="true" Style="width: 6.5rem" Disabled="_loading || _exporting">
                @foreach (var size in PageSizes)
                {
                    <MudSelectItem T="int" Value="@size">@size 条/页</MudSelectItem>
                }
            </MudSelect>
            <MudPagination Count="_pages" Selected="_page" SelectedChanged="OnPage" Disabled="_loading || _exporting" BoundaryCount="1" MiddleCount="3" />
        </MudStack>
    </MudStack>
</div>
}
else
{
<div class="dt-query-workspace">
    <div class="dt-query-presets">
        <QueryPresetsPanel Url="@CurrentListUrl()" From="_from" To="_to"
                           StartHour="_shiftSettings.ShiftStartHour" LengthHours="_shiftSettings.ShiftLengthHours"
                           Disabled="_exporting" Apply="ApplyPresetAsync" />
    </div>
    <div class="dt-page-toolbar" aria-label="查询筛选"><MudPaper Class="dt-filter-card mb-0" Elevation="0" Outlined="true">
        <form class="dt-query-form" @onsubmit="OnSubmit" @onsubmit:preventDefault="true">
            <section class="dt-query-primary" aria-labelledby="dt-query-primary-heading">
                <h2 id="dt-query-primary-heading" class="dt-query-section-heading">快速查询</h2>
                <MudGrid Class="dt-query-core-inputs">
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudTextField T="string" Value="_serialNo" ValueChanged="OnSerialChanged" Label="流水号"
                                      Immediate="true" Disabled="_exporting"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Tag" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudTextField T="string" Value="_pallet" ValueChanged="OnPalletChanged" Label="托盘码"
                                      Placeholder="扫码或输入托盘码" Immediate="true" Disabled="_exporting"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.QrCode" />
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" Spacing="2" Class="dt-query-primary-actions">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search" Disabled="_exporting">
                        @(_loading ? "查询中…" : "查询")
                    </MudButton>
                </MudStack>
            </section>

            <button type="button" class="dt-query-advanced-toggle"
                    aria-controls="dt-query-advanced-fields"
                    aria-expanded="@(_advancedFiltersExpanded ? "true" : "false")"
                    @onclick="ToggleAdvancedFilters">
                <span>@(_advancedFiltersExpanded ? "收起更多筛选" : "更多筛选条件")</span>
                <span class="dt-query-advanced-count">@SecondaryFilterSummary</span>
            </button>

            <div id="dt-query-advanced-fields"
                 class="dt-query-advanced @(_advancedFiltersExpanded ? "is-expanded" : "is-collapsed")">
                <div class="dt-query-date-range">
                    <DateRangeFilter @bind-From="_from" @bind-To="_to" OnRangeChanged="Search"
                                     IncludeShifts="true" ShiftStartHour="_shiftSettings.ShiftStartHour"
                                     ShiftLengthHours="_shiftSettings.ShiftLengthHours" Disabled="_exporting" />
                </div>

                <MudGrid Class="dt-filters dt-query-secondary-filters">
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSelect T="int" MultiSelection="true" SelectedValues="_stationIds" SelectedValuesChanged="OnStationsChanged"
                                   Label="工站（可多选）" Clearable="true" Dense="true" Disabled="_exporting"
                                  >
                            @foreach (var st in _stations)
                            {
                                <MudSelectItem T="int" Value="@st.Id">@st.Code @st.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSelect T="Judgement?" Value="_judgement" ValueChanged="OnJudgementChanged" Label="判定" Clearable="true"
                                   Disabled="_exporting">
                            <MudSelectItem T="Judgement?" Value="Judgement.Ok">OK（合格）</MudSelectItem>
                            <MudSelectItem T="Judgement?" Value="Judgement.Ng">NG（不合格）</MudSelectItem>
                            <MudSelectItem T="Judgement?" Value="Judgement.None">未判定</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    @* 结果码描述已落库采集记录的处理结果；PLC 通讯失败没有有效产品记录，单独留在审计日志。 *@
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSelect T="short?" Value="_resultCode" ValueChanged="OnResultCodeChanged" Label="结果码" Clearable="true"
                                   Disabled="_exporting">
                            @foreach (var code in ResultCodeOptions)
                            {
                                <MudSelectItem T="short?" Value="@((short?)code)">@ResultCodeLabel(code)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSelect T="RecipeFilterValue" Value="@ToOptionValue(_recipeFilter)" ValueChanged="OnRecipeFilterChanged"
                                   Label="产品型号" Dense="true" Disabled="_exporting">
                            <MudSelectItem T="RecipeFilterValue" Value="@RecipeFilterValue.All">全部型号</MudSelectItem>
                            <MudSelectItem T="RecipeFilterValue" Value="@RecipeFilterValue.NoRecipe">未选型号</MudSelectItem>
                            @foreach (var opt in _recipeOptions)
                            {
                                <MudSelectItem T="RecipeFilterValue" Value="@ToOptionValue(opt.Code)">@opt.Label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudSelect T="int?" Value="_workOrderId" ValueChanged="OnWorkOrderChanged"
                                   Label="工单（型号+时间窗）" Clearable="true" Dense="true" Disabled="_exporting"
                                   HelperText="采集未绑定工单号；按工单型号与生产时间窗估算">
                            @foreach (var order in _workOrders)
                            {
                                <MudSelectItem T="int?" Value="@((int?)order.Id)">
                                    @(order.IsCurrent ? "★ " : "")@order.Code
                                    @(string.IsNullOrWhiteSpace(order.Model) ? "" : $" · {order.Model}")
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudNumericField T="int?" Value="_durationMinMs" ValueChanged="OnDurationMinChanged"
                                         Label="耗时 ≥ (ms)" Clearable="true" Min="0" Disabled="_exporting" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudNumericField T="int?" Value="_durationMaxMs" ValueChanged="OnDurationMaxChanged"
                                         Label="耗时 ≤ (ms)" Clearable="true" Min="0" Disabled="_exporting" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudTextField T="string" Value="_outOfLimitTag" ValueChanged="OnOutOfLimitTagChanged"
                                      Label="超限点位名" Placeholder="精确匹配点位名" Immediate="true"
                                      Disabled="_exporting" Clearable="true"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.WarningAmber" />
                    </MudItem>
                </MudGrid>

                <MudStack Row="true" Spacing="2" Class="mt-1 mb-2 flex-wrap dt-query-secondary-actions">
                    <MudButton Variant="Variant.Outlined" OnClick="Reset" Disabled="_exporting"
                               StartIcon="@Icons.Material.Filled.RestartAlt">
                        重置
                    </MudButton>
                                                            @if (_canExport)
                    {
                        @* 主按钮仍是「导出 CSV」：现场最常用标准表；宽表/按月挂在旁边下拉。 *@
                        <MudTooltip Arrow="true" Text="@ExportTooltipText">
                            <ChildContent>
                                <MudButton Variant="Variant.Outlined" OnClick="@(() => ExportCsv(wide: false))"
                                           Disabled="@(_loading || _exporting || _total == 0)"
                                           StartIcon="@Icons.Material.Filled.FileDownload">
                                    @(_exporting ? "导出中…" : "导出 CSV")
                                </MudButton>
                            </ChildContent>
                        </MudTooltip>
                        <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                                 Disabled="@(_loading || _exporting || _total == 0)">
                            <ActivatorContent>
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDropDown" Disabled="@(_loading || _exporting || _total == 0)"
                                               aria-label="更多导出选项" />
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem OnClick="@(async _ => await ExportCsv(wide: true))" Disabled="_exporting">宽表 CSV（含点位值）</MudMenuItem>
                                <MudMenuItem OnClick="@(async _ => await ExportByMonthAsync(wide: false))" Disabled="_exporting">
                                    @(_total > SystemDefaults.ExportRowLimit ? "按月分包（标准，完整）" : "按月分包（标准）")
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(async _ => await ExportByMonthAsync(wide: true))" Disabled="_exporting">按月分包（宽表）</MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                        <InfoHint Topic="HelpTexts.ExportLimit" Extra="@ExportHintExtra" />
                        <MudText Typo="Typo.caption" Class="dt-muted align-self-center" role="status">
                            导出范围 @DateRangeFilter.Format(_from, _to) · 命中 @_total.ToString("N0") 条 · 单次上限 @SystemDefaults.ExportRowLimit.ToString("N0") 条
                        </MudText>
                    }
                    <MudText Typo="Typo.caption" Class="dt-muted align-self-center">改任一条件即自动重查，也可点「查询」立刻执行</MudText>
                    <InfoHint Topic="HelpTexts.MatchMode" />
                </MudStack>
            </div>
        </form>
    </MudPaper>
</div>
</div>

@* 快捷筛选放在更多条件外面：现场最常要的「仅 NG / 仅流程异常」不必再展开下拉。 *@
<div class="dt-filter-chips mb-3" aria-label="快捷筛选">
    <MudText Typo="Typo.caption" Class="dt-muted">快捷筛选</MudText>
    <MudChip T="string" Size="Size.Small"
             Variant="@(_resultCode == ResultCodes.ProcessAbnormal ? Variant.Filled : Variant.Outlined)"
             Color="Color.Error" Disabled="_exporting"
             OnClick="ApplyProcessAbnormalQuick">仅流程异常</MudChip>
    <MudChip T="string" Size="Size.Small"
             Variant="@(_judgement == Judgement.Ng ? Variant.Filled : Variant.Outlined)"
             Color="Color.Error" Disabled="_exporting"
             OnClick="ApplyNgQuick">仅 NG</MudChip>
    <MudChip T="string" Size="Size.Small"
             Variant="@(_onlyOutOfLimit || !string.IsNullOrWhiteSpace(_outOfLimitTag) ? Variant.Filled : Variant.Outlined)"
             Color="Color.Warning" Disabled="_exporting"
             OnClick="ApplyOutOfLimitQuick">仅超限</MudChip>
</div>

@* 「变更即查询」之后，六个条件散在各个控件里，筛完只剩一个命中数，回头看不出自己是按什么在筛。
   这里把生效条件摊开，并且能只摘掉其中一个 —— 与日志页同一套 chips 写法。
   区间只在不是默认值（今天）时列出：否则默认进页面就挂着一个删掉也没变化的 chip。 *@
@if (ActiveFilters.Count > 0)
{
    <div class="dt-filter-chips mb-3">
        <MudText Typo="Typo.caption" Class="dt-muted">当前条件</MudText>
        @foreach (var filter in ActiveFilters)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                @filter.Label
                <MudIconButton Size="Size.Small" Class="ml-1" Icon="@Icons.Material.Filled.Close"
                               aria-label="@($"移除筛选条件：{filter.Label}")"
                               Disabled="_exporting"
                               OnClick="@(() => ClearOneAsync(filter.Clear))" />
            </MudChip>
        }
        <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_exporting"
               OnClick="ClearAllFiltersAsync">清空全部</MudButton>
    </div>
}

@* 表头吸附：一页最多 100 行，滚下去就没有列名可对。高度用 --dt-grid-height 统一约定，
   不写在这里是因为它和页头/筛选卡/分页条的实际高度有关，只该有一处真相。 *@
<h2 id="dt-query-results-heading" class="dt-query-results-heading" tabindex="-1">查询结果</h2>
<MudTable Items="_items" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
          Loading="@(_loading || _exporting)" LoadingProgressColor="Color.Info"
          FixedHeader="true" Height="var(--dt-grid-height)"
          Class="dt-clickable dt-query-results" data-dt-query-key="@CurrentListUrl()"
          OnRowClick="@((TableRowClickEventArgs<CollectRecordListItem> args) => OnRowClicked(args))">
    <HeaderContent>
        @* 表头即排序入口：服务端分页下只排当前页等于没排，所以点表头是重新查询，
           箭头只画在当前排序列上（见 SortIcon）。 *@
        <MudTh Class="dt-nowrap" aria-sort="@SortAria(CollectSortField.TriggerTime)">
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="pa-0" EndIcon="@SortIcon(CollectSortField.TriggerTime)"
                       OnClick="@(() => OnSortClicked(CollectSortField.TriggerTime))">时间</MudButton>
        </MudTh>
        <MudTh aria-sort="@SortAria(CollectSortField.SerialNo)">
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="pa-0" EndIcon="@SortIcon(CollectSortField.SerialNo)"
                       OnClick="@(() => OnSortClicked(CollectSortField.SerialNo))">流水号</MudButton>
        </MudTh>
        <MudTh aria-sort="@SortAria(CollectSortField.PalletCode)">
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="pa-0" EndIcon="@SortIcon(CollectSortField.PalletCode)"
                       OnClick="@(() => OnSortClicked(CollectSortField.PalletCode))">托盘码</MudButton>
        </MudTh>
        <MudTh aria-sort="@SortAria(CollectSortField.StationCode)">
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="pa-0" EndIcon="@SortIcon(CollectSortField.StationCode)"

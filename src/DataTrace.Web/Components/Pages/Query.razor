    private Task OnTraceSearchCompleted(string? serialNo)
    {
        var nextSerial = string.IsNullOrWhiteSpace(serialNo) ? null : serialNo.Trim();
        if (!string.Equals(nextSerial, TraceQuery, StringComparison.Ordinal))
        {
            TraceMonthQuery = null;
            TraceSessionQuery = null;
        }

        TraceQuery = nextSerial;
        var target = TraceQuery is null
            ? "query?view=trace"
            : $"query?view=trace&trace={Uri.EscapeDataString(TraceQuery)}"
              + (TraceMonthQuery is not null && TraceSessionQuery is { } sessionId
                  ? $"&sessionMonth={Uri.EscapeDataString(TraceMonthQuery)}&sessionId={sessionId}"
                  : "");
        Nav.NavigateTo(target, replace: true);
        return Task.CompletedTask;
    }

    private CollectQueryRequest BuildRequest(
        int skip,
        int take,
        string? afterCursor = null,
        DateTime? from = null,
        DateTime? to = null,
        bool includeTagValues = false)
    {
        var stationIds = _stationIds.Count > 1 ? _stationIds.OrderBy(x => x).ToArray() : null;
        var stationId = _stationIds.Count == 1 ? _stationIds.First() : (int?)null;
        return new()
        {
            From = DateRangeFilter.QueryStart(from ?? _from),
            To = DateRangeFilter.QueryEnd(to ?? _to),
            PalletCode = string.IsNullOrWhiteSpace(_pallet) ? null : _pallet.Trim(),
            SerialNo = string.IsNullOrWhiteSpace(_serialNo) ? null : _serialNo.Trim(),
            StationId = stationId,
            StationIds = stationIds,
            Judgement = _judgement,
            ResultCode = _resultCode,
            DurationMinMs = _durationMinMs,
            DurationMaxMs = _durationMaxMs,
            OnlyOutOfLimit = _onlyOutOfLimit || !string.IsNullOrWhiteSpace(_outOfLimitTag),
            OutOfLimitTagName = string.IsNullOrWhiteSpace(_outOfLimitTag) ? null : _outOfLimitTag.Trim(),
            OnlyWarning = _onlyWarning || !string.IsNullOrWhiteSpace(_warningTag),
            WarningTagName = string.IsNullOrWhiteSpace(_warningTag) ? null : _warningTag.Trim(),
            IncludeTagValues = includeTagValues,
            RecipeCodes = _recipeAliases.Count > 0
                ? new[] { _recipeFilter! }.Concat(_recipeAliases).Distinct(StringComparer.Ordinal).ToArray()
                : null,
            RecipeCode = _recipeAliases.Count > 0 ? null : ToRecipeQueryArg(),
            Skip = skip,
            Take = take,
            AfterCursor = afterCursor,
            SortBy = _sortBy,
            SortDescending = _sortDesc
        };
    }

    private SessionQueryRequest BuildSessionRequest(int skip, int take) => new()
    {
        From = DateRangeFilter.QueryStart(_from),
        To = DateRangeFilter.QueryEnd(_to),
        PalletCode = string.IsNullOrWhiteSpace(_pallet) ? null : _pallet.Trim(),
        SerialNo = string.IsNullOrWhiteSpace(_serialNo) ? null : _serialNo.Trim(),
        Status = _sessionStatus,
        Judgement = _judgement,
        RecipeCodes = _recipeAliases.Count > 0
            ? new[] { _recipeFilter! }.Concat(_recipeAliases).Distinct(StringComparer.Ordinal).ToArray()
            : null,
        RecipeCode = _recipeAliases.Count > 0 ? null : ToRecipeQueryArg(),
        Skip = skip,
        Take = take
    };

    private async Task OnSubmit()
    {
        _debounceCts?.Cancel();
        await Search();
    }

    // 筛选区统一语义：下拉即时重查，文本输入等打字停下再重查。
    // 之前改日期和改型号会立刻查、改其余字段却要点按钮，同一个筛选区里三种做法。
    private async Task OnPalletChanged(string? value)
    {
        _pallet = value;
        _queryVersion++;
        await DebouncedSearchAsync();
    }

    private async Task OnSerialChanged(string? value)
    {
        _serialNo = value;
        _queryVersion++;
        await DebouncedSearchAsync();
    }

    private async Task OnStationsChanged(IEnumerable<int> values)
    {
        var next = values?.ToHashSet() ?? new HashSet<int>();
        if (_stationIds.SetEquals(next)) return;
        _stationIds = next;
        await Search();
    }

    private async Task OnDurationMinChanged(int? value)
    {
        if (_durationMinMs == value) return;
        _durationMinMs = value;
        await Search();
    }

    private async Task OnDurationMaxChanged(int? value)
    {
        if (_durationMaxMs == value) return;
        _durationMaxMs = value;
        await Search();
    }

    private async Task OnOutOfLimitTagChanged(string? value)
    {
        _outOfLimitTag = value;
        _queryVersion++;
        await DebouncedSearchAsync();
    }

    private async Task OnSessionStatusChanged(SessionStatus? value)
    {
        if (_sessionStatus == value) return;
        _sessionStatus = value;
        await Search();
    }

    private async Task OnJudgementChanged(Judgement? value)
    {
        if (_judgement == value) return;
        _judgement = value;
        await Search();
    }

    private async Task OnResultCodeChanged(short? value)
    {
        if (_resultCode == value) return;
        _resultCode = value;
        await Search();
    }

    private async Task DebouncedSearchAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(TextDebounceMs, token);
            await Search();
        }
        catch (OperationCanceledException)
        {
            // 又敲了一个字符，等下一次停顿
        }
    }

    private async Task WidenRangeAsync(int days)
    {
        _from = DateTime.Today.AddDays(-(days - 1));
        _to = DateTime.Today;
        await Search();
    }

    private async Task Search()
    {
        _queryVersion++;
        if (DateRangeFilter.IsReversed(_from, _to))
        {
            _items = [];
            _sessionItems = [];
            _total = 0;
            _sessionTotal = 0;
            _pages = 1;
            _loadFailed = false;
            Toast.Add(DateRangeFilter.ReversedRangeMessage, Severity.Warning);
            return;
        }

        _page = 1;
        await Load();
    }

    private async Task OnPage(int page)
    {
        if (page <= 1 || page < _page)
        {
            _pageCursors.Remove(page + 1);
            _pageCursors[page] = page == 1 ? null : _pageCursors.GetValueOrDefault(page);
        }
        _page = page;
        _queryVersion++;
        await Load();
    }

    private async Task OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
        _queryVersion++;
        await Load();
    }

    private async Task Load()
    {
        // 改日期即查询之后，并发窗口是这里开的：不加守卫时两个 Load 谁后完成谁覆盖，
        // 而先完成的那个已经把 _loading 关了，界面看着"好了"其实是被推翻的旧结果。
        // 但直接丢弃请求也不行：日期控件在加载中没禁用，"先改开始日期、再改结束日期"
        // 会丢掉后者——表格和地址栏停在旧条件上，输入框却显示新日期。
        // 所以把请求记下来，等这一轮结束立刻按最新条件再跑一次。
        if (_exporting)
        {
            _loadPending = true;
            return;
        }

        if (_loading)
        {
            _loadPending = true;
            return;
        }

        _loading = true;
        try
        {
            do
            {
                _loadPending = false;
                var version = _queryVersion;
                if (_page == 1)
                {
                    foreach (var stalePage in _pageCursors.Keys.Where(page => page > 1).ToArray()) _pageCursors.Remove(stalePage);
                    _pageCursors[1] = null;
                }
                if (DateRangeFilter.IsReversed(_from, _to))
                {
                    break;
                }
                await RefreshRecipeOptionsAsync();

                try
                {
                    if (_viewMode == QueryViewMode.Sessions)
                    {
                        var sessionResult = await Store.QuerySessionsAsync(BuildSessionRequest((_page - 1) * _pageSize, _pageSize));
                        if (version != _queryVersion)
                        {
                            _loadPending = true;
                            continue;
                        }
                        var sessionPages = Math.Max(1, (int)Math.Ceiling(sessionResult.Total / (double)_pageSize));
                        if (_page > sessionPages)
                        {
                            _page = sessionPages;
                            sessionResult = await Store.QuerySessionsAsync(BuildSessionRequest((_page - 1) * _pageSize, _pageSize));
                        }
                        if (version != _queryVersion)
                        {
                            _loadPending = true;
                            continue;
                        }
                        _sessionItems = sessionResult.Items;
                        _sessionTotal = sessionResult.Total;
                        _items = [];
                        _total = 0;
                        _displayedVersion = version;
                        _loadFailed = false;
                        _pages = sessionPages;
                    }
                    else
                    {
                        var cursor = _pageCursors.GetValueOrDefault(_page);
                        var request = cursor is not null
                            ? BuildRequest((_page - 1) * _pageSize, _pageSize, cursor)
                            : BuildRequest((_page - 1) * _pageSize, _pageSize);
                        var result = await Store.QueryAsync(request);
                        if (version != _queryVersion)
                        {
                            _loadPending = true;
                            continue;
                        }
                        var pages = Math.Max(1, (int)Math.Ceiling(result.Total / (double)_pageSize));
                        if (_page > pages)
                        {
                            _page = pages;
                            result = await Store.QueryAsync(BuildRequest((_page - 1) * _pageSize, _pageSize));
                        }
                        if (version != _queryVersion)
                        {
                            _loadPending = true;
                            continue;
                        }
                        _items = result.Items;
                        if (result.NextCursor is not null)
                            _pageCursors[_page + 1] = result.NextCursor;
                        _sessionItems = [];
                        _sessionTotal = 0;
                        _displayedVersion = version;
                        _total = result.Total;
                        _loadFailed = false;
                        _pages = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));
                    }
                }
                catch (Exception) when (version != _queryVersion)
                {
                    _loadPending = true;
                    continue;
                }
            }
            while (_loadPending);
        }
        catch (Exception ex)
        {
            Toast.Add($"查询失败：{ex.Message}", Severity.Error);
            _items = [];
            _sessionItems = [];
            _total = 0;
            _sessionTotal = 0;
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
            SyncUrl();
        }
    }

    /// <summary>
    /// 把当前条件写回地址栏（默认值不写，保持 /query 干净）。
    /// 这样刷新和转发链接都还在同一批结果上，「重置」也不会留下 ?pallet=X 让条件幽灵回填。
    /// </summary>
    private void SyncUrl()
    {
        if (_viewMode == QueryViewMode.Trace)
        {
            return;
        }

        var target = _viewMode == QueryViewMode.Sessions ? CurrentSessionListUrl() : CurrentListUrl();
        if (Nav.ToBaseRelativePath(Nav.Uri) == target)
        {
            return;
        }

        Nav.NavigateTo(target, replace: true);
    }

    /// <summary>当前列表页的相对地址，明细页的「返回查询」也用它，避免回去后条件全丢。</summary>
    private string CurrentListUrl()
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(_pallet))
        {
            parts.Add($"pallet={Uri.EscapeDataString(_pallet.Trim())}");
        }

        if (!string.IsNullOrWhiteSpace(_serialNo))
        {
            parts.Add($"serial={Uri.EscapeDataString(_serialNo.Trim())}");
        }

        if (_from is { } from && from != DateTime.Today)
        {
            parts.Add($"from={DateRangeFilter.UrlValue(from)}");
        }

        if (_to is { } to && to != DateTime.Today)
        {
            parts.Add($"to={DateRangeFilter.UrlValue(to)}");
        }

        foreach (var station in _stationIds.OrderBy(x => x))
        {
            parts.Add($"station={station}");
        }

        if (_judgement is { } judgement)
        {
            parts.Add($"judge={judgement}");
        }

        if (_resultCode is { } resultCode)
        {
            parts.Add($"result={resultCode}");
        }

        if (_durationMinMs is { } durMin)
        {
            parts.Add($"durMin={durMin}");
        }

        if (_durationMaxMs is { } durMax)
        {
            parts.Add($"durMax={durMax}");
        }

        if (!string.IsNullOrWhiteSpace(_outOfLimitTag))
        {
            parts.Add($"oolTag={Uri.EscapeDataString(_outOfLimitTag.Trim())}");
        }
        else if (_onlyOutOfLimit)
        {
            parts.Add("ool=1");
        }

        if (!string.IsNullOrWhiteSpace(_warningTag))
        {
            parts.Add($"warnTag={Uri.EscapeDataString(_warningTag.Trim())}");
        }
        else if (_onlyWarning)
        {
            parts.Add("warn=1");
        }

        if (_workOrderId is { } workOrderId)
        {
            parts.Add($"wo={workOrderId}");
        }

        if (_recipeFilter is { Length: > 0 } recipe)
        {
            parts.Add($"recipe={Uri.EscapeDataString(recipe.Trim())}");
            parts.AddRange(_recipeAliases.Select(alias => $"alias={Uri.EscapeDataString(alias)}"));
        }
        else if (_recipeFilter is not null)
        {
            // 未选型号：独立参数，别和真实编码挤同一个 recipe。
            parts.Add("norecipe=1");
        }

        if (_pageSize != 20)
        {
            parts.Add($"size={_pageSize}");
        }

        // 排序不是筛选条件，"重置/清空全部"不动它（下拉与表头都还指着这一列），
        // 但地址栏要带着：刷新、转发、从明细页返回都得停在同一批结果上。
        if (_sortBy != CollectSortField.TriggerTime)
        {
            parts.Add($"sort={SortKeyOf(_sortBy)}");
        }

        if (!_sortDesc)
        {
            parts.Add("dir=asc");
        }

        if (_page > 1)
        {
            parts.Add($"page={_page}");
        }

        return parts.Count == 0 ? "query" : $"query?{string.Join("&", parts)}";
    }

    private async Task ApplyPresetAsync(string url)
    {
        if (_exporting) return;
        _debounceCts?.Cancel();
        var request = RecordListNavigation.ReadRequest(url, 0, 20);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(url.Contains('?') ? url[url.IndexOf('?')..] : "");
        _from = request.From;
        _to = DateTime.TryParse(query.GetValueOrDefault("to"), System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var to) ? to : DateTime.Today;
        _pallet = request.PalletCode;
        _serialNo = request.SerialNo;
        _stationIds = request.StationIds is { Count: > 0 } multi
            ? multi.ToHashSet()
            : request.StationId is { } one ? new HashSet<int> { one } : new HashSet<int>();
        _judgement = request.Judgement;
        _resultCode = request.ResultCode;
        _durationMinMs = request.DurationMinMs;
        _durationMaxMs = request.DurationMaxMs;
        _onlyOutOfLimit = request.OnlyOutOfLimit && string.IsNullOrWhiteSpace(request.OutOfLimitTagName);
        _outOfLimitTag = request.OutOfLimitTagName;
        _onlyWarning = request.OnlyWarning && string.IsNullOrWhiteSpace(request.WarningTagName);
        _warningTag = request.WarningTagName;
        _workOrderId = int.TryParse(query.GetValueOrDefault("wo"), out var wo) && wo > 0 ? wo : null;
        _recipeFilter = request.RecipeCodes?.FirstOrDefault() ?? request.RecipeCode;
        _recipeAliases = request.RecipeCodes?.Skip(1).ToArray() ?? [];
        _sortBy = request.SortBy;
        _sortDesc = request.SortDescending;
        _pageSize = int.TryParse(query.GetValueOrDefault("size"), out var size) && PageSizes.Contains(size) ? size : 20;
        await Search();
    }

    private async Task Reset()
    {
        ClearFilterState();
        _pageSize = 20;
        Toast.Add("筛选条件已重置", Severity.Info);
        await Search();
    }

    /// <summary>把所有条件退回默认值。chips 的「清空全部」只清条件，不动每页条数。</summary>
    private void ClearFilterState()
    {
        _recipeFilter = null;
        _recipeAliases = [];
        _pallet = null;
        _serialNo = null;
        _stationIds = new();
        _judgement = null;
        _resultCode = null;
        _durationMinMs = null;
        _durationMaxMs = null;
        _onlyOutOfLimit = false;
        _outOfLimitTag = null;
        _onlyWarning = false;
        _warningTag = null;
        _workOrderId = null;
        _sessionStatus = null;
        _from = DateTime.Today;
        _to = DateTime.Today;
    }

    private async Task ClearAllFiltersAsync()
    {
        ClearFilterState();
        await Search();
    }

    private async Task ClearOneAsync(Action clear)
    {
        // 输入框上的防抖可能还在等那 400ms，放着不管会在这一下之后又按旧值查一遍。
        _debounceCts?.Cancel();
        clear();
        await Search();
    }

    /// <summary>一个生效条件：显示文案 + 摘掉它的动作。</summary>
    private sealed record ActiveFilter(string Label, Action Clear);

    /// <summary>
    /// chips 行的数据。只列真正生效的条件，区间在等于默认（今天）时不列 ——
    /// 否则一进页面就挂着一个删掉也毫无变化的 chip。
    /// </summary>
    private IReadOnlyList<ActiveFilter> ActiveFilters
    {
        get
        {
            var list = new List<ActiveFilter>();

            if (!IsDefaultRange)
            {
                list.Add(new($"区间 {DateRangeFilter.Format(_from, _to)}",
                    () => { _from = DateTime.Today; _to = DateTime.Today; }));
            }

            if (!string.IsNullOrWhiteSpace(_pallet))
            {
                var pallet = _pallet!.Trim();
                list.Add(new($"托盘码 {pallet}", () => _pallet = null));
            }

            if (!string.IsNullOrWhiteSpace(_serialNo))
            {
                var serial = _serialNo!.Trim();
                list.Add(new($"流水号 {serial}", () => _serialNo = null));
            }

            if (_stationIds.Count > 0)
            {
                var label = _stationIds.Count == 1
                    ? $"工站 {StationCode(_stationIds.First())}"
                    : $"工站 {_stationIds.Count} 个";
                list.Add(new(label, () => _stationIds = new()));
            }

            if (_judgement is { } judgement)
            {
                list.Add(new($"判定 {DisplayLabels.JudgementText(judgement)}", () => _judgement = null));
            }

            if (_resultCode is { } resultCode)
            {
                list.Add(new($"结果码 {ResultCodes.Describe(resultCode)}", () => _resultCode = null));
            }

            if (_durationMinMs is { } dMin || _durationMaxMs is { } dMax)
            {
                var text = _durationMinMs is { } a && _durationMaxMs is { } b
                    ? $"耗时 {a}–{b} ms"
                    : _durationMinMs is { } minOnly ? $"耗时 ≥ {minOnly} ms" : $"耗时 ≤ {_durationMaxMs} ms";
                list.Add(new(text, () => { _durationMinMs = null; _durationMaxMs = null; }));
            }

            if (!string.IsNullOrWhiteSpace(_outOfLimitTag))
            {
                var tag = _outOfLimitTag!.Trim();
                list.Add(new($"超限点位 {tag}", () => { _outOfLimitTag = null; _onlyOutOfLimit = false; }));
            }
            else if (_onlyOutOfLimit)
            {
                list.Add(new("仅超限", () => _onlyOutOfLimit = false));
            }

            if (!string.IsNullOrWhiteSpace(_warningTag))
            {
                var tag = _warningTag!.Trim();
                list.Add(new($"预警点位 {tag}", () => { _warningTag = null; _onlyWarning = false; }));
            }
            else if (_onlyWarning)
            {
                list.Add(new("仅预警", () => _onlyWarning = false));
            }

            if (_workOrderId is { } woId)
            {
                var code = _workOrders.FirstOrDefault(o => o.Id == woId)?.Code ?? woId.ToString();
                list.Add(new($"工单 {code}", () => _workOrderId = null));
            }

            if (_viewMode == QueryViewMode.Sessions && _sessionStatus is { } status)
            {
                list.Add(new($"会话 {DisplayLabels.SessionStatusText(status)}", () => _sessionStatus = null));
            }

            if (_recipeFilter is { } recipe)
            {
                var suffix = _recipeAliases.Count > 0 ? $"（含历史编码 {_recipeAliases.Count} 个）" : "";
                list.Add(new($"型号 {RecipeLabel(recipe)}{suffix}", () =>
                {
                    _recipeFilter = null;
                    _recipeAliases = [];
                }));
            }

            return list;
        }
    }

    private int ActiveSecondaryFilterCount => ActiveFilters.Count(filter =>
        !filter.Label.StartsWith("托盘码 ", StringComparison.Ordinal)
        && !filter.Label.StartsWith("流水号 ", StringComparison.Ordinal));

    private string SecondaryFilterSummary => ActiveSecondaryFilterCount == 0
        ? "日期、工站、判定、结果码、型号"
        : $"{ActiveSecondaryFilterCount} 项已生效";

    private bool IsDefaultRange
        => _from == DateTime.Today && _to == DateTime.Today;

    /// <summary>工站 chip 上的编码；站被删掉时退成 Id，别显示一个空标签。</summary>
    private string StationCode(int id)
        => _stations.FirstOrDefault(s => s.Id == id)?.Code ?? id.ToString();

    /// <summary>
    /// 导出按钮的悬停说明。命中 0 条时按钮是禁用的，不写清楚就只是一次「点了没反应」。
    /// </summary>
    private string ExportTooltipText => _total == 0
        ? "当前没有命中记录，没有可导出的内容"
        : _total > SystemDefaults.ExportRowLimit
            ? $"当前命中 {_total:N0} 条，单次最多导出前 {SystemDefaults.ExportRowLimit:N0} 条；可用「按月分包导出」拿全量"
            : $"导出当前命中的 {_total:N0} 条（标准或宽表）";

    private string DetailUrl(CollectRecordListItem item)
        => RecordListNavigation.DetailUrl(item, CurrentListUrl(), (_page - 1) * _pageSize + _items.ToList().IndexOf(item));

    private async Task OnRowClicked(TableRowClickEventArgs<CollectRecordListItem> args)
    {
        if (args.Item is null || _loading || _exporting || _displayedVersion != _queryVersion)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("dtQueryScroll.save", CurrentListUrl());
        }
        catch (JSException) { }
        Nav.NavigateTo(DetailUrl(args.Item));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSerialAfterLoad)
        {
            _focusSerialAfterLoad = false;
            ScanQuery = 0;
            try
            {
                // 页面导航会把焦点交给 h1，等它落定后再把焦点放回流水号框。
                await Js.InvokeVoidAsync("dtFocusSoon", ".dt-query-core-inputs input", 150);
            }
            catch (JSException)
            {
                // 聚焦失败不影响查询结果。
            }
        }

        if (_loading || !_restoreScroll || _viewMode != QueryViewMode.Records) return;
        _restoreScroll = false;
        try
        {
            await Js.InvokeVoidAsync("dtQueryScroll.restore", CurrentListUrl());
        }
        catch (JSException) { }
    }

    public void Dispose() => _debounceCts?.Dispose();

    private async Task CopyText(string? value, string label)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        try
        {
            var copied = await Js.InvokeAsync<bool>("dtCopy", value);
            // 浏览器拒绝剪贴板时不能照样报"已复制"：操作工拿着这条提示去贴单，结果是空码上机。
            Toast.Add(copied ? $"已复制{label} {value}" : "复制失败：浏览器不允许写入剪贴板，请手动选中复制",
                copied ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex)
        {
            Toast.Add($"复制失败：{ex.Message}", Severity.Error);
        }
    }

    private string TraceUrl(CollectRecordListItem item)
    {
        var serial = item.Record.SerialNo?.Trim() ?? "";
        if (serial.Length == 0)
        {
            return "query?view=trace";
        }

        var url = $"query?view=trace&trace={Uri.EscapeDataString(serial)}";
        if (item.Record.PalletSessionId > 0)
        {
            url += $"&sessionMonth={Uri.EscapeDataString(item.MonthKey)}&sessionId={item.Record.PalletSessionId}";
        }

        return url;
    }

    /// <summary>快捷「仅流程异常」：结果码=流程异常。再次点同一 chip 则取消该条件。</summary>
    private async Task ApplyProcessAbnormalQuick()
    {
        if (_exporting) return;
        _resultCode = _resultCode == ResultCodes.ProcessAbnormal ? null : ResultCodes.ProcessAbnormal;
        _advancedFiltersExpanded = true;
        await Search();
    }

    /// <summary>快捷「仅 NG」：判定=NG。再次点同一 chip 则取消该条件。</summary>
    private async Task ApplyNgQuick()
    {
        if (_exporting) return;
        _judgement = _judgement == Judgement.Ng ? null : Judgement.Ng;
        _advancedFiltersExpanded = true;
        await Search();
    }

    private async Task ApplyOutOfLimitQuick()
    {
        if (_exporting) return;
        if (_onlyOutOfLimit || !string.IsNullOrWhiteSpace(_outOfLimitTag))
        {
            _onlyOutOfLimit = false;
            _outOfLimitTag = null;
        }
        else
        {
            _onlyOutOfLimit = true;
        }
        _advancedFiltersExpanded = true;
        await Search();
    }


    /// <summary>下拉选项：编码 + 显示文案（文案同时是取值的 ToString，见 <see cref="RecipeFilterValue"/>）。</summary>
    private sealed record RecipeFilterOption(string Code, string Label);

    private IReadOnlyList<RecipeFilterOption> _recipeOptions = [];
    private Dictionary<string, string> _recipeNames = new(StringComparer.Ordinal);
    private DateTime? _recipeOptionsFrom;
    private DateTime? _recipeOptionsTo;

    /// <summary>
    /// 筛选状态 → 下拉取值：null=全部、""=未选型号、其它=编码。
    /// 文案与选项里显示的必须是同一个（都走 <see cref="FormatRecipeOption"/>），
    /// 否则预渲染那一帧画出来的文案会和交互后不一致。
    /// </summary>
    private RecipeFilterValue ToOptionValue(string? recipe)
        => recipe switch
        {
            null => RecipeFilterValue.All,
            "" => RecipeFilterValue.NoRecipe,
            var code => new RecipeFilterValue(code, FormatRecipeOption(code))
        };

    /// <summary>发给查询请求的型号参数：null=不限、空串=未选型号、其它=精确匹配。</summary>
    private string? ToRecipeQueryArg()
        => _recipeFilter is { Length: > 0 } code ? code.Trim() : _recipeFilter;

    /// <summary>地址栏短名 → 排序列。不认识的值退回默认，手改的链接不该把页面带进怪状态。</summary>
    private static CollectSortField ParseSortField(string? key)
    {
        foreach (var (shortName, field) in SortKeys)
        {
            if (string.Equals(shortName, key, StringComparison.OrdinalIgnoreCase))
            {
                return field;
            }
        }

        return CollectSortField.TriggerTime;
    }

    /// <summary>排序列 → 地址栏短名，<see cref="SortKeys"/> 的反向查找。</summary>
    private static string SortKeyOf(CollectSortField field)
        => SortKeys.First(s => s.Field == field).Key;

    /// <summary>
    /// 点表头：同一列换方向，换一列用该列的默认方向。
    /// 时间列默认"最近在前"，其余列默认升序 —— 按工站/托盘码看时想从前往后读。
    /// </summary>
    private async Task OnSortClicked(CollectSortField field)
    {
        if (_loading || _exporting)
        {
            return;
        }

        if (_sortBy == field)
        {
            _sortDesc = !_sortDesc;
        }
        else
        {
            _sortBy = field;
            _sortDesc = field == CollectSortField.TriggerTime;
        }

        // 换了次序，原来的第 N 页没有意义了：同一个 _page 在新次序下是另一批记录。
        _page = 1;
        _queryVersion++;
        await Load();
    }

    /// <summary>表头排序按钮的箭头：只在当前排序列上画，方向即箭头方向。</summary>
    private string? SortIcon(CollectSortField field)
        => _sortBy != field
            ? null
            : _sortDesc ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward;

    private string SortAria(CollectSortField field)
        => _sortBy != field ? "none" : _sortDesc ? "descending" : "ascending";

    private async Task OnRecipeFilterChanged(RecipeFilterValue? value)
    {
        if (_recipeFilter == value?.Recipe) return;
        _recipeFilter = value?.Recipe;
        _recipeAliases = [];
        _page = 1;
        _queryVersion++;
        await Load();
    }

    /// <summary>
    /// 选项只在时间区间变化时重建：翻页、改每页条数、切换型号都复用它，
    /// 否则每翻一页都要重扫一遍区间内的型号编码。
    /// </summary>
    private async Task RefreshRecipeOptionsAsync()
    {
        var from = _from ?? DateTime.Today;
        var to = _to ?? DateTime.Today;
        if (_recipeOptionsFrom == from && _recipeOptionsTo == to)
        {
            return;
        }

        // 区间内出现过的编码（含空）+ 配置里已知型号，避免改码后旧码消失
        var fromRecords = await Store.ListRecipeCodesAsync(from, to);
        // 走快照而不是再查一次型号：进页面时已经读过，这里只是命中缓存。
        var known = (await Config.GetSnapshotAsync()).Recipes;
        _recipeNames = known
            .GroupBy(r => r.Code, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.First().Name ?? "", StringComparer.Ordinal);

        var codes = new HashSet<string>(StringComparer.Ordinal);
        foreach (var c in fromRecords)
        {
            if (!string.IsNullOrEmpty(c))
                codes.Add(c);
        }
        foreach (var r in known)
        {
            if (!string.IsNullOrEmpty(r.Code))
                codes.Add(r.Code);
        }

        // 当前筛选项若不在集合里也保留（例如刚改码后仍想看旧码）
        if (_recipeFilter is { Length: > 0 } current && !codes.Contains(current))
        {
            codes.Add(current);
        }

        _recipeOptions = codes
            .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
            .Select(c => new RecipeFilterOption(c, FormatRecipeOption(c)))
            .ToList();
        _recipeOptionsFrom = from;
        _recipeOptionsTo = to;
    }

    private string FormatRecipeOption(string code)
    {
        if (_recipeNames.TryGetValue(code, out var name) && !string.IsNullOrWhiteSpace(name))
            return $"{code} · {name}";
        return $"旧编码 {code}";
    }

    private static string RecipeLabel(string? code)
        => string.IsNullOrEmpty(code) ? "未选型号" : code;

        private Task ExportCsv() => ExportCsv(wide: false);

    private async Task ExportCsv(bool wide)
    {
        if (_loading || _exporting)
        {
            return;
        }

        if (!_canExport)
        {
            Toast.Add("当前角色无权导出查询结果（需要管理员或工程师）", Severity.Warning);
            return;
        }

        var request = BuildRequest(0, SystemDefaults.ExportRowLimit, includeTagValues: wide);
        var auditKey = $"{request.From:yyyy-MM-dd HH:mm:ss.fffffff}~{request.To:yyyy-MM-dd HH:mm:ss.fffffff}";
        var auditFilters = ExportFilterSummary() + $";wide={(wide ? "是" : "否")}";
        _exporting = true;
        try
        {
            var result = await Store.QueryAsync(request);
            if (result.Items.Count == 0)
            {
                Toast.Add("没有可导出的记录", Severity.Warning);
                return;
            }

            if (result.Total > result.Items.Count)
            {
                var choice = await DialogService.ConfirmDangerAsync(
                    "确认截断导出",
                    $"区间：{auditKey}\n工站：{StationFilterAuditLabel()}\n" +
                    $"{auditFilters}\n命中 {result.Total:N0} 条，本次只导出按当前排序的前 {result.Items.Count:N0} 条；其余记录不会包含在文件中。\n\n" +
                    "需要完整结果请取消后选「按月分包导出」。",
                    acknowledge: "我了解此文件不是全部查询结果",
                    yesText: "导出前述记录",
                    cancelText: "取消导出");
                if (choice != true) return;
            }

            await DownloadCsvAsync(result.Items, result.Total, request.From, request.To, wide, auditKey, auditFilters);
        }
        catch (Exception ex)
        {
            Toast.Add($"导出失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
            if (_loadPending)
            {
                _loadPending = false;
                await Load();
            }
        }
    }

        private async Task ExportByMonthAsync(bool wide)
    {
        if (_loading || _exporting || _total == 0) return;
        if (!_canExport)
        {
            Toast.Add("当前角色无权导出查询结果（需要管理员或工程师）", Severity.Warning);
            return;
        }

        var from = DateRangeFilter.QueryStart(_from);
        var to = DateRangeFilter.QueryEnd(_to);
        var slices = MonthSlices(from, to).ToList();
        if (slices.Count == 0)
        {
            Toast.Add("没有可导出的月份区间", Severity.Warning);
            return;
        }

        if (await DialogService.ConfirmDangerAsync(
                "按月分包导出",
                $"将按 {slices.Count} 个月分别下载{(wide ? "宽表" : "标准")} CSV。\n区间 {DateRangeFilter.Format(_from, _to)}，命中约 {_total:N0} 条。浏览器可能会连续弹出多个下载。",
                acknowledge: "我将收到多个下载文件",
                yesText: "开始按月导出",
                cancelText: "取消") != true)
        {
            return;
        }

        _exporting = true;
        var exportedFiles = 0;
        var exportedRows = 0;
        var truncatedMonths = 0;
        try
        {
            foreach (var (sliceFrom, sliceTo, label) in slices)
            {
                var request = BuildRequest(0, SystemDefaults.ExportRowLimit, from: sliceFrom, to: sliceTo, includeTagValues: wide);
                var result = await Store.QueryAsync(request);
                if (result.Items.Count == 0) continue;
                if (result.Total > result.Items.Count) truncatedMonths++;

                var auditKey = $"{sliceFrom:yyyy-MM-dd HH:mm:ss.fffffff}~{sliceTo:yyyy-MM-dd HH:mm:ss.fffffff}";
                var auditFilters = ExportFilterSummary() + $";month={label};wide={(wide ? "是" : "否")};pack=monthly";
                await DownloadCsvAsync(result.Items, result.Total, sliceFrom, sliceTo, wide, auditKey, auditFilters, fileSuffix: label);
                exportedFiles++;
                exportedRows += result.Items.Count;
                await Task.Delay(250);
            }

            if (exportedFiles == 0)
            {
                Toast.Add("各月均无命中记录", Severity.Warning);
            }
            else
            {
                var msg = $"已按月导出 {exportedFiles} 个文件，共 {exportedRows:N0} 条";
                if (truncatedMonths > 0)
                    msg += $"（其中 {truncatedMonths} 个月仍超过单月上限 {SystemDefaults.ExportRowLimit:N0}，已截断）";
                Toast.Add(msg, truncatedMonths > 0 ? Severity.Warning : Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Toast.Add($"按月导出失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _exporting = false;
            if (_loadPending)
            {
                _loadPending = false;
                await Load();
            }
        }
    }

    private async Task DownloadCsvAsync(
        IReadOnlyList<CollectRecordListItem> items,
        int total,
        DateTime from,
        DateTime to,
        bool wide,
        string auditKey,
        string auditFilters,
        string? fileSuffix = null)
    {
        var exportedAt = DateTime.Now;
        var context = $"区间（含起止）={auditKey};工站={StationFilterAuditLabel()};" +
                      $"{auditFilters};导出时间={exportedAt:yyyy-MM-dd HH:mm:ss};命中={total};" +
                      $"导出={items.Count};截断={(total > items.Count ? "是" : "否")}";

        string csv;
        if (wide)
        {
            var tagColumns = items
                .SelectMany(item => item.Record.TagValues ?? Array.Empty<TagValue>())
                .Select(TagColumnName)
                .Distinct(StringComparer.Ordinal)
                .OrderBy(x => x, StringComparer.Ordinal)
                .ToList();
            var headers = new List<string> { "触发时间", "流水号", "托盘码", "工站", "型号", "判定", "结果码", "结果说明", "耗时(ms)" };
            headers.AddRange(tagColumns);
            headers.Add("查询上下文");
            csv = CsvExporter.Build(
                headers,
                items.Select(item =>
                {
                    var map = (item.Record.TagValues ?? Array.Empty<TagValue>())
                        .GroupBy(TagColumnName, StringComparer.Ordinal)
                        .ToDictionary(g => g.Key, g => FormatTagExportValue(g.First()), StringComparer.Ordinal);
                    var row = new List<string?>
                    {
                        item.Record.TriggerTime.ToString("yyyy-MM-dd HH:mm:ss"),
                        item.Record.SerialNo ?? "",
                        item.Record.PalletCode ?? "",
                        item.Record.StationCode ?? "",
                        RecipeLabel(item.Record.RecipeCode),
                        DisplayLabels.JudgementTextLong(item.Record.Judgement),
                        item.Record.ResultCode.ToString(),
                        ResultCodes.Describe(item.Record.ResultCode),
                        DurationMsText(item.Record.DurationMs)
                    };
                    foreach (var col in tagColumns)
                    {
                        row.Add(map.TryGetValue(col, out var value) ? value : "");
                    }

                    row.Add(context);
                    return row;
                }));
        }
        else
        {
            csv = CsvExporter.Build(
                ["触发时间", "流水号", "托盘码", "工站", "型号", "判定", "结果码", "结果说明", "耗时(ms)", "查询上下文"],
                items.Select(item => new[]
                {
                    item.Record.TriggerTime.ToString("yyyy-MM-dd HH:mm:ss"),
                    item.Record.SerialNo ?? "",
                    item.Record.PalletCode ?? "",
                    item.Record.StationCode ?? "",
                    RecipeLabel(item.Record.RecipeCode),
                    DisplayLabels.JudgementTextLong(item.Record.Judgement),
                    item.Record.ResultCode.ToString(),
                    ResultCodes.Describe(item.Record.ResultCode),
                    DurationMsText(item.Record.DurationMs),
                    context
                }));
        }

        var stationName = StationFilterFileLabel();
        var safeStation = new string(stationName.Where(character => char.IsLetterOrDigit(character) || character is '-' or '_').Take(40).ToArray());
        var prefix = wide ? "datatrace_query_wide" : "datatrace_query";
        if (!string.IsNullOrWhiteSpace(fileSuffix))
        {
            prefix += $"_{fileSuffix}";
        }

        await Js.InvokeVoidAsync(
            "dtDownload",
            CsvExporter.FileName($"{prefix}_{safeStation}_{from:yyyyMMddHHmmss}-{to:yyyyMMddHHmmss}"),
            CsvExporter.ToBase64(csv));

        var message = total > items.Count
            ? $"共命中 {total} 条，已导出前 {items.Count} 条"
            : $"已导出 {items.Count} 条";
        try
        {
            await WriteExportAuditAsync(items.Count, total, auditKey, auditFilters);
            if (fileSuffix is null)
            {
                Toast.Add(message, total > items.Count ? Severity.Warning : Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Toast.Add($"{message}，但审计记录写入失败：{ex.Message}", Severity.Warning);
        }
    }

    private static IEnumerable<(DateTime From, DateTime To, string Label)> MonthSlices(DateTime from, DateTime to)
    {
        if (to < from) yield break;
        var cursor = new DateTime(from.Year, from.Month, 1);
        while (cursor <= to)
        {
            var monthEnd = cursor.AddMonths(1).AddTicks(-1);
            var sliceFrom = cursor < from ? from : cursor;
            var sliceTo = monthEnd > to ? to : monthEnd;
            yield return (sliceFrom, sliceTo, cursor.ToString("yyyyMM"));
            cursor = cursor.AddMonths(1);
        }
    }

    private static string TagColumnName(TagValue tag)
        => tag.PositionIndex <= 0 ? tag.TagName : $"{tag.TagName}#{tag.PositionIndex}";

    private static string FormatTagExportValue(TagValue tag)
    {
        if (tag.NumericValue is { } number)
        {
            return CsvExporter.Number(number);
        }

        return tag.TextValue ?? "";
    }


                    <span class="@ResultCodeClass(context.Record.ResultCode)">@ResultCodes.Describe(context.Record.ResultCode)</span>
                </ChildContent>
                <TooltipContent>
                    <HelpContent Topic="HelpTexts.ResultCode" />
                </TooltipContent>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="耗时" Class="dt-num dt-nowrap">@DurationFormat.Text(context.Record.DurationMs)</MudTd>
                <MudTd DataLabel="操作" Class="dt-right">
            @* 复制/追溯放在操作列而不是单元格里：整行可点进明细时，
               行中间的任何小控件都会抢走"点行"这一下，尤其在小屏上。
               外面这层 span 负责掐断冒泡 —— 行点击绑在 tr 上，
               不拦的话点复制会同时跳进明细。 *@
            <span @onclick:stopPropagation="true">
                <MudTooltip Text="复制流水号">
                    <MudIconButton Icon="@Icons.Material.Filled.Tag" Size="Size.Small"
                                   aria-label="复制流水号"
                                   Disabled="@(string.IsNullOrWhiteSpace(context.Record.SerialNo))"
                                   OnClick="@(() => CopyText(context.Record.SerialNo, "流水号"))" />

@page "/users"
@attribute [Authorize(Roles = "Administrator")]
@using DataTrace.Application.Identity
@using DataTrace.Domain.Validation
@inject IUserAdministration UsersAdmin
@inject IDialogService DialogService
@inject AuthenticationStateProvider Auth
@inject DtToast Toast

<PageHeader Title="用户" HelpRoute="users">
    <Actions>
        <MudText Typo="Typo.caption" Class="dt-muted">显示 @VisibleUsers.Count / @_users.Count 个账号</MudText>
        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="_working"
                   OnClick="OpenCreateDialog">新增用户</MudButton>
        @* 锁定是"连续登录失败"的自动结果。有人在登不上来的时候，这个数得在页头就看得见，
           而不是等扫到表格里那枚小 chip。 *@
        @if (LockedCount > 0)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                @LockedCount 个已锁定
            </MudChip>
        }
    </Actions>
</PageHeader>

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" Variant="Variant.Outlined">
        @_loadError
        @* 表格里那句"请稍后重试"给不出可点的东西：整页清空之后必须留一个出口，
           否则管理员只能刷新整个页面。 *@
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Class="ml-2"
                   StartIcon="@Icons.Material.Filled.Refresh" Disabled="_loading" OnClick="Reload">
            重试
        </MudButton>
    </MudAlert>
}

<MudPaper Class="dt-filter-card mb-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
        <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged"
                      Label="搜索账号" Placeholder="用户名或显示名" Immediate="true" Clearable="true"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Class="users-search" />
        <MudSelect T="string" @bind-Value="_roleFilter" Label="角色" ShrinkLabel="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="users-filter">
            <MudSelectItem T="string" Value="@AllFilterValue">全部角色</MudSelectItem>
            @foreach (var role in AppRoles.All)
            {
                <MudSelectItem T="string" Value="@role">@DisplayLabels.RoleText(role)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" @bind-Value="_lockFilter" Label="账号状态" ShrinkLabel="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="users-filter">
            <MudSelectItem T="string" Value="@AllFilterValue">全部状态</MudSelectItem>
            <MudSelectItem T="string" Value="@("locked")">已锁定</MudSelectItem>
            <MudSelectItem T="string" Value="@("unlocked")">未锁定</MudSelectItem>
        </MudSelect>
        @if (HasFilters)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterAltOff"
                       OnClick="ClearFilters">清除筛选</MudButton>
        }
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="dt-muted">@VisibleUsers.Count 条结果</MudText>
    </MudStack>
</MudPaper>

<MudTable Items="VisibleUsers" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Loading="_loading"
          LoadingProgressColor="Color.Info">
    <HeaderContent>
        <MudTh>用户名</MudTh>
        <MudTh>显示名</MudTh>
        <MudTh>角色</MudTh>
        <MudTh Class="dt-right">操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="用户名">
            @context.UserName
            @if (context.UserName == _currentUser)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Class="ml-2">当前账号</MudChip>
            }
            @if (IsLocked(context.User))
            {
                <MudTooltip Arrow="true" RootClass="dt-help-popover">
                    <ChildContent>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" Class="ml-2">已锁定</MudChip>
                    </ChildContent>
                    <TooltipContent>
                        <HelpContent Topic="HelpTexts.Lockout" Extra="@LockTooltip(context.User)" />
                    </TooltipContent>
                </MudTooltip>
            }
        </MudTd>
        <MudTd DataLabel="显示名">@(string.IsNullOrWhiteSpace(context.DisplayName) ? "—" : context.DisplayName)</MudTd>
        <MudTd DataLabel="角色">
            @foreach (var role in context.RoleList)
            {
                <MudTooltip Arrow="true" RootClass="dt-help-popover">
                    <ChildContent>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@RoleColor(role)">
                            @DisplayLabels.RoleText(role)
                        </MudChip>
                    </ChildContent>
                    <TooltipContent>
                        <HelpContent Topic="HelpTexts.RoleScope" Extra="@DisplayLabels.RoleHint(role)" />
                    </TooltipContent>
                </MudTooltip>
            }
        </MudTd>
        @* DataLabel 不能省：卡片模式（平板）下没有它，这一行前面就是空的，
           看不出这几个按钮是在对谁操作。 *@
        <MudTd DataLabel="操作" Class="dt-right">
            <span class="dt-actions">
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Edit"
                           Disabled="_working" OnClick="@(() => EditUser(context))">编辑</MudButton>
                @if (IsLocked(context.User))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.LockOpen"
                               Disabled="_working" OnClick="@(() => UnlockUser(context))">解除锁定</MudButton>
                }
                @* 下面两个按钮的禁用跟"你正在用哪个账号"有关，不给一句话就只是一次"按不动"。
                   禁用按钮收不到 hover，靠 app.css 里 .mud-tooltip .mud-button:disabled
                   把指针事件让给外层包裹。 *@
                <MudTooltip Text="@ResetHint(context)">
                    <ChildContent>
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.LockReset"
                                   Disabled="_working || SelfResetBlocked(context)"
                                   OnClick="@(() => ResetPassword(context))">重置密码</MudButton>
                    </ChildContent>
                </MudTooltip>
                <MudTooltip Text="@DeleteHint(context)">
                    <ChildContent>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete" Disabled="_working || IsSelf(context)"
                                   OnClick="@(() => DeleteUser(context))">删除</MudButton>
                    </ChildContent>
                </MudTooltip>
                <InfoHint Topic="HelpTexts.DeleteUser" />
            </span>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="dt-muted py-4">
            @(_loading ? "正在加载…" :
              _loadError is not null ? "用户列表加载失败，请稍后重试。" :
              _users.Count == 0 ? "还没有用户账号。点击“新增用户”创建第一个。" :
              HasFilters ? "没有符合当前筛选条件的账号。" : "用户列表为空。")
        </MudText>
    </NoRecordsContent>
</MudTable>

@* 角色说明保留触屏可访问的完整文案，但默认收起，减少账号列表下方的纵向占用。 *@
<MudExpansionPanels Class="mt-3" Dense="true" Elevation="0">
    <MudExpansionPanel>
        <TitleContent>
            <MudText Typo="Typo.subtitle2">角色权限说明</MudText>
        </TitleContent>
        <ChildContent>
            <MudText Typo="Typo.caption" Class="dt-muted mb-2">角色决定可见菜单与可执行操作。</MudText>
            <MudStack Spacing="1">
                @foreach (var role in AppRoles.All)
                {
                    <MudText Typo="Typo.body2">
                        <strong>@DisplayLabels.RoleText(role)</strong>　@DisplayLabels.RoleHint(role)
                    </MudText>
                }
            </MudStack>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    private const string AllFilterValue = "__all__";

    private List<UserRow> _users = [];
    private bool _loading;
    private string? _loadError;
    private string _currentUser = "";
    private bool _working;
    private string _search = "";
    private string _roleFilter = AllFilterValue;
    private string _lockFilter = AllFilterValue;

    private List<UserRow> VisibleUsers
    {
        get
        {
            IEnumerable<UserRow> query = _users;
            var search = _search.Trim();
            if (search.Length > 0)
            {
                query = query.Where(row =>
                    row.UserName.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || row.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase));
            }

            if (_roleFilter != AllFilterValue)
            {
                query = query.Where(row => row.RoleList.Contains(_roleFilter));
            }

            if (_lockFilter == "locked")
            {
                query = query.Where(row => IsLocked(row.User));
            }
            else if (_lockFilter == "unlocked")
            {
                query = query.Where(row => !IsLocked(row.User));
            }

            return query.ToList();
        }
    }

    private bool HasFilters => !string.IsNullOrWhiteSpace(_search)
                               || _roleFilter != AllFilterValue
                               || _lockFilter != AllFilterValue;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
        await Reload();
    }

    private async Task Reload()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var list = await UsersAdmin.ListAsync();
            _users = list
                .Select(account => new UserRow(account, account.UserName, account.DisplayName, account.Roles.ToList()))
                .ToList();
        }
        catch (Exception ex)
        {
            // 逐行取角色时抛异常，前面几行已经进了列表，看起来就像"这几个账号被删了"；
            // 直接清空并说明，别让人拿半份名单下结论。
            _users = [];
            _loadError = $"加载用户失败，列表已清空：{ex.Message}";
            Toast.Add(_loadError, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnSearchChanged(string? value)
    {
        _search = value ?? "";
        return Task.CompletedTask;
    }

    private void ClearFilters()
    {
        _search = "";
        _roleFilter = AllFilterValue;
        _lockFilter = AllFilterValue;
    }

    private async Task OpenCreateDialog()
    {
        if (_working)
        {
            return;
        }

        var dialog = await DialogService.ShowAsync<UserCreateDialog>("新建用户",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not UserCreateDialog.UserCreateRequest request)
        {
            return;
        }

        await Create(request);
    }

    private async Task Create(UserCreateDialog.UserCreateRequest request)
    {
        if (_working)
        {
            return;
        }

        _working = true;
        try
        {
            var actor = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
            var created = await UsersAdmin.CreateAsync(
                request.UserName, request.DisplayName, request.Password, request.Role, actor);
            var message = created.Status == UserAdminStatus.Success
                ? $"{created.Message}（{DisplayLabels.RoleText(request.Role)}）"
                : created.Message;
            Show(created, message);
            if (created.Status != UserAdminStatus.Error)
            {
                await Reload();
            }
        }
        catch (Exception ex)
        {
            Toast.Add($"创建用户失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>账号是否处于登录锁定状态。</summary>
    private static bool IsLocked(UserAccount user) => user.IsLocked;

    /// <summary>锁定账号数：连续登录失败的结果，有人正在登不上来时这是要在页头看见的数。</summary>
    private int LockedCount => _users.Count(row => IsLocked(row.User));

    private bool IsSelf(UserRow row) => row.UserName == _currentUser;

    /// <summary>
    /// 自己的账号只剩一个角色时不给重置。这条规则来自初始提交，既没有注释也没有用例说明原委，
    /// 行为照原样保留，这里只把"为什么按不动"说出来。
    /// </summary>
    private bool SelfResetBlocked(UserRow row) => IsSelf(row) && row.RoleList.Count == 1;

    private string ResetHint(UserRow row)
        => SelfResetBlocked(row)
            ? "当前登录账号只剩一个角色，不允许在这里重置密码"
            : $"为 {row.UserName} 设置一个新密码";

    private string DeleteHint(UserRow row)
        => IsSelf(row)
            ? "不能删除当前登录账号"
            : $"删除 {row.UserName}：该账号将无法再登录，且操作不可恢复";

    private static string LockTooltip(UserAccount user)
    {
        var until = user.LockoutEnd is { } end
            ? TimeZoneInfo.ConvertTime(end, TimeZoneInfo.Local).ToString("HH:mm:ss")
            : "—";
        return $"连续登录失败 {user.AccessFailedCount} 次，锁定到 {until}；可解除锁定后让本人重试。";
    }

    /// <summary>
    /// 改显示名与角色。角色按差集只写变化的部分，避免"全撤再全加"
    /// 在中间态把用户短暂变成无角色账号。
    /// </summary>
    private async Task EditUser(UserRow row)
    {
        if (_working)
        {
            return;
        }

        var parameters = new DialogParameters<UserEditDialog>
        {
            { x => x.UserName, row.UserName },
            { x => x.DisplayName, row.DisplayName },
            { x => x.CurrentRoles, row.RoleList }
        };
        var dialog = await DialogService.ShowAsync<UserEditDialog>("编辑用户", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not UserEditDialog.UserEditRequest request)
        {
            return;
        }

        if (UserRoleRules.Error(request.Roles) is { } roleError)
        {
            Toast.Add(roleError, Severity.Warning);
            return;
        }

        var adminCount = _users.Count(item => item.RoleList.Contains(AppRoles.Administrator));
        if (UserRoleRules.RemovesLastAdministrator(row.RoleList, request.Roles, adminCount))
        {
            Toast.Add("系统至少需要保留一个管理员账号，不能撤掉最后一个管理员", Severity.Error);
            return;
        }

        if (row.UserName == _currentUser && !request.Roles.Contains(AppRoles.Administrator))
        {
            var confirmed = await DialogService.ShowMessageBox(
                "撤销自己的管理员角色",
                $"确定把当前登录账号「{row.UserName}」的管理员角色撤掉？保存后你将立即失去用户管理与系统配置的访问权。",
                yesText: "仍要保存", cancelText: "取消");
            if (confirmed != true)
            {
                return;
            }
        }

        _working = true;
        try
        {
            var actor = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
            Show(await UsersAdmin.UpdateAsync(row.UserName, request.DisplayName, request.Roles, actor));
            await Reload();
        }
        catch (Exception ex)
        {
            Toast.Add($"更新用户失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _working = false;
        }
    }

    /// <summary>解除登录锁定：锁定是连续失败的自动结果，管理员可以立刻解开。</summary>
    private async Task UnlockUser(UserRow row)
    {
        if (_working)
        {
            return;
        }

        _working = true;
        try
        {
            var actor = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
            var unlocked = await UsersAdmin.UnlockAsync(row.UserName, actor);
            Show(unlocked);
            if (unlocked.Status == UserAdminStatus.Success)
            {
                await Reload();
            }
        }
        catch (Exception ex)
        {
            Toast.Add($"解除锁定失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _working = false;
        }
    }

    private async Task ResetPassword(UserRow row)
    {
        if (_working)
        {
            return;
        }

        var parameters = new DialogParameters { ["UserName"] = row.UserName };
        var dialog = await DialogService.ShowAsync<UserPasswordDialog>("重置密码", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string password)
        {
            return;
        }

        _working = true;
        try
        {
            var actor = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
            Show(await UsersAdmin.ResetPasswordAsync(row.UserName, password, actor));
        }
        catch (Exception ex)
        {
            Toast.Add($"重置密码失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _working = false;
        }
    }

    private async Task DeleteUser(UserRow row)
    {
        if (_working)
        {
            return;
        }

        if (row.UserName == _currentUser)
        {
            Toast.Add("不能删除当前登录账号", Severity.Warning);
            return;
        }

        var adminCount = _users.Count(item => item.RoleList.Contains(AppRoles.Administrator));
        if (row.RoleList.Contains(AppRoles.Administrator) && adminCount <= 1)
        {
            Toast.Add("系统至少需要保留一个管理员账号", Severity.Error);
            return;
        }

        var confirmed = await DialogService.ShowMessageBox(
            "删除用户",
            $"确定删除用户「{row.UserName}」？该账号将无法再登录，且操作不可恢复。",
            yesText: "删除", cancelText: "取消");
        if (confirmed != true)
        {
            return;
        }

        _working = true;
        try
        {
            var actor = (await Auth.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
            var deleted = await UsersAdmin.DeleteAsync(row.UserName, actor);
            Show(deleted);
            if (deleted.Status == UserAdminStatus.Success)
            {
                await Reload();
            }
        }
        catch (Exception ex)
        {
            Toast.Add($"删除用户失败：{ex.Message}", Severity.Error);
        }
        finally
        {
            _working = false;
        }
    }

    private void Show(UserAdminResult result, string? message = null)
    {
        var text = message ?? result.Message;
        if (!string.IsNullOrEmpty(text))
        {
            var severity = result.Status switch
            {
                UserAdminStatus.Success => Severity.Success,
                UserAdminStatus.Warning => Severity.Warning,
                _ => Severity.Error
            };
            Toast.Add(text, severity);
        }

        if (result.AuditError is { } auditError)
        {
            Toast.Add($"操作已完成，但审计记录失败：{auditError}", Severity.Warning);
        }
    }

    private static Color RoleColor(string role) => role switch
    {
        AppRoles.Administrator => Color.Error,
        AppRoles.Engineer => Color.Primary,
        AppRoles.Operator => Color.Info,
        _ => Color.Default
    };

    private sealed record UserRow(UserAccount User, string UserName, string DisplayName, List<string> RoleList);
}

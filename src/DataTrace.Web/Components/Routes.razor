@using Microsoft.AspNetCore.Components.Authorization
<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        @* 端点层的角色拒绝不会走到这里 —— 那种情况由 Cookie 认证按
                           AccessDeniedPath 跳到 /denied。这里兜的是 circuit 层的拒绝。 *@
                        <DeniedPanel UserName="@context.User.Identity.Name" />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <PageFocusOnNavigate Selector="h5" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <MudPaper Class="pa-6">
                    <MudText Typo="Typo.h5" Class="mb-2">页面不存在</MudText>
                    <MudText Typo="Typo.body2" Class="dt-muted mb-4">
                        链接可能已经过期，或者地址输入有误。可以从下面两个入口继续。
                    </MudText>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">实时看板</MudButton>
                        <MudButton Variant="Variant.Outlined" Href="/query">数据查询</MudButton>
                    </MudStack>
                </MudPaper>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

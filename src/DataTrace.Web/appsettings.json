{
  "DataRoot": "data",
  "Customer": {
    "CustomerId": "dev",
    "SiteName": "DataTrace",
    "SimulatorAutoRun": true
  },
  // 日志级别写在 Serilog 段下，而不是 Logging 段：
  // Program.cs 用的是 UseSerilog + ReadFrom.Configuration，它只读 Serilog 段，
  // 原来那个 Logging:LogLevel 一个字都没被读过（实测：这里配着 Warning，
  // 日志文件里照样躺着上千条 EF Core 的 SQL 语句）。
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "Backup": {
    "Enabled": true,
    "DailyTime": "02:30",
    "BackupDirectory": "",
    "RetentionDays": 30,
    "MaxBackups": 60
  }
}

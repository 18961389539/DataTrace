{
  "DataRoot": "data",
  "Customer": {
    "CustomerId": "dev",
    "SiteName": "DataTrace",
    "SimulatorAutoRun": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5080"
      }
    }
  },
  "Backup": {
    "Enabled": true,
    "DailyTime": "02:30",
    "BackupDirectory": "",
    "RetentionDays": 30,
    "MaxBackups": 60
  }
}

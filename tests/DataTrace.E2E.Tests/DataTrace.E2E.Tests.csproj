<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DataTrace.E2E.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.60.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- 引用 Web 工程，好让 dotnet test 一并把应用编出来；E2E 直接跑编好的产物。 -->
    <ProjectReference Include="..\..\src\DataTrace.Web\DataTrace.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 三个集合各自要起一个应用实例和一个浏览器；CI runner 只有 4 核，
         并行会把依赖采集时序的 journey 用例饿到超时（本机也观察到同样现象），
         所以集合之间串行跑，集合内部仍然并行。 -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Microsoft.Playwright" />
  </ItemGroup>
</Project>
